@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Choose a new password";
    ViewData["Description"] = "Set a new password for your extra efficient account.";
}

<div class="container" style="padding-top: var(--space-6); padding-bottom: var(--space-8)">
  <div class="grid-2">
    <div class="stack">
      <h1 class="m-0 mb-1">Choose a new password</h1>

      @if (Model.LinkInvalid)
      {
        <div class="card">
          <div class="card__body">
            <div class="state-block" role="alert">
              <div class="state-block__icon state-block__icon--danger" aria-hidden="true">!</div>
              <div class="state-block__title">This link no longer works</div>
              <p class="state-block__desc">Reset links work once and expire after 15 minutes. Ask for a new one.</p>
              <a class="btn btn--primary" href="/auth/forgot-password">Send a new link</a>
            </div>
          </div>
        </div>
      }
      else
      {
        @if (!string.IsNullOrEmpty(Model.FormError))
        {
          <div class="alert alert--danger" role="alert">@Model.FormError</div>
        }

        <form method="post" asp-action="ResetPassword" class="card">
          <div class="card__body stack">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token">

            <div class="field">
              <label class="field__label" asp-for="NewPassword">New password</label>
              <input class="field__input" asp-for="NewPassword" type="password" autocomplete="new-password" required>
              <span asp-validation-for="NewPassword" class="field__error"></span>
              <p class="field__hint">At least 8 characters, with letters and numbers.</p>
            </div>

            <div class="field">
              <label class="field__label" asp-for="ConfirmPassword">Confirm new password</label>
              <input class="field__input" asp-for="ConfirmPassword" type="password" autocomplete="new-password" required>
              <span asp-validation-for="ConfirmPassword" class="field__error"></span>
            </div>
          </div>

          <div class="card__footer">
            <button type="submit" class="btn btn--primary btn--lg w-100" style="width: 100%">Save new password</button>
          </div>
        </form>
      }
    </div>

    <aside class="card">
      <div class="card__header"><strong>Password requirements</strong></div>
      <div class="card__body stack">
        <ol class="stack--tight m-0" style="padding-left: var(--space-5)">
          <li>Use <strong>at least 8 characters</strong>.</li>
          <li>Include both letters and numbers for safety.</li>
          <li>After saving, sign in with your new password.</li>
        </ol>
        <p class="text-xs text-muted no-margin">Never share your password with anyone.</p>
      </div>
    </aside>
  </div>
</div>
