@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Choose a new password";
    ViewData["Description"] = "Set a new password for your extra efficient account.";
}

<div class="container stack" style="padding-top: var(--space-6); padding-bottom: var(--space-8); max-width: 480px">
  <h1 class="m-0 mb-1">Choose a new password</h1>

  @if (Model.LinkInvalid)
  {
    <div class="card">
      <div class="card__body">
        <div class="state-block" role="alert">
          <div class="state-block__icon state-block__icon--danger" aria-hidden="true">!</div>
          <div class="state-block__title">This link no longer works</div>
          <p class="state-block__desc">Reset links work once and expire after 15 minutes. Ask for a new one.</p>
          <a class="btn btn--primary" href="/auth/forgot-password">Send a new link</a>
        </div>
      </div>
    </div>
  }
  else
  {
    <form method="post" asp-action="ResetPassword" class="card">
      <div class="card__body stack">
        @if (!string.IsNullOrEmpty(Model.FormError))
        {
          <div class="alert alert--danger" role="alert">@Model.FormError</div>
        }
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Token">

        <div>
          <label asp-for="NewPassword"></label>
          <input asp-for="NewPassword" autocomplete="new-password">
          <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div>
          <label asp-for="ConfirmPassword"></label>
          <input asp-for="ConfirmPassword" autocomplete="new-password">
          <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <p class="text-xs text-muted no-margin">At least 8 characters.</p>
        <div>
          <button type="submit" class="btn btn--primary btn--lg">Save new password</button>
        </div>
      </div>
    </form>
  }
</div>
