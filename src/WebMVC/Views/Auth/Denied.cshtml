@{
    ViewData["Title"] = "Not allowed";
    ViewData["Description"] = "This page needs a different role.";
}

<div class="container" style="padding-top: var(--space-6); padding-bottom: var(--space-8); max-width: 560px">
  <div class="card">
    <div class="card__body">
      <div class="state-block" role="alert">
        <div class="state-block__icon state-block__icon--danger" aria-hidden="true">!</div>
        <div class="state-block__title">Access restricted</div>
        <p class="state-block__desc">
          This area requires administrator privileges. If you believe this is an error, try signing out and signing in with an administrative account.
        </p>
        <a class="btn btn--primary" href="/">Return to home</a>
      </div>
    </div>
  </div>
</div>
