@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    ViewData["Description"] = "Reset your extra efficient password by email.";
}

<div class="container" style="padding-top: var(--space-6); padding-bottom: var(--space-8)">
  <div class="grid-2">
    <div class="stack">
      <h1 class="m-0 mb-1">Forgot password</h1>

      @if (Model.Sent)
      {
        <div class="card">
          <div class="card__body">
            <div class="state-block" role="status">
              <div class="state-block__icon" aria-hidden="true">SENT</div>
              <div class="state-block__title">Link sent</div>
              <p class="state-block__desc">
                If <strong>@Model.Email</strong> has an account, a reset link is on its way.
                The link expires in 15 minutes.
              </p>
              <a class="btn" href="/auth/sign-in">Back to sign in</a>
            </div>
          </div>
        </div>
      }
      else
      {
        @if (!string.IsNullOrEmpty(Model.FormError))
        {
          <div class="alert alert--danger" role="alert">@Model.FormError</div>
        }

        <form method="post" asp-action="ForgotPassword" class="card">
          <div class="card__body stack">
            <p class="text-muted no-margin">Enter your email and we will send you a password reset link.</p>
            @Html.AntiForgeryToken()

            <div class="field">
              <label class="field__label" asp-for="Email">Email</label>
              <input class="field__input" asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com" required>
              <span asp-validation-for="Email" class="field__error"></span>
            </div>
          </div>

          <div class="card__footer">
            <button type="submit" class="btn btn--primary btn--lg w-100" style="width: 100%">Send link</button>
          </div>
        </form>
      }
    </div>

    <aside class="card">
      <div class="card__header"><strong>What happens next</strong></div>
      <div class="card__body stack">
        <ol class="stack--tight m-0" style="padding-left: var(--space-5)">
          <li><strong>We email a reset link</strong> to the address you enter.</li>
          <li><strong>The link works for 15 minutes.</strong> After that, ask for a new one.</li>
          <li><strong>Choose a new password</strong> of at least 8 characters, with letters and numbers, then sign in.</li>
        </ol>
        <p class="text-xs text-muted no-margin">Remembered it? <a href="/auth/sign-in">Back to sign in</a>.</p>
      </div>
    </aside>
  </div>
</div>
