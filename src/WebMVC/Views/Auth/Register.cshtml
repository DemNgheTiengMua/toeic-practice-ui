@model RegisterViewModel
@{
    ViewData["Title"] = "Sign up";
    ViewData["Description"] = "Create a free extra efficient account.";
}

<div class="container" style="padding-top: var(--space-6); padding-bottom: var(--space-8)">
  <div class="grid-2">
    <div class="stack">
      <h1 class="m-0 mb-1">Sign up</h1>
      <p class="text-muted no-margin">Free placement exam, practice drills, and a learning path that follows your certificate.</p>

      @if (!string.IsNullOrEmpty(Model.FormError))
      {
        <div class="alert alert--danger" role="alert">@Model.FormError</div>
      }

      <form method="post" asp-action="Register" class="card">
        <div class="card__body stack">
          @Html.AntiForgeryToken()
          <input type="hidden" asp-for="ReturnUrl">

          <div class="field">
            <label class="field__label" asp-for="FullName">Full name</label>
            <input class="field__input" asp-for="FullName" type="text" autocomplete="name" placeholder="Nguyễn Văn A" required>
            <span asp-validation-for="FullName" class="field__error"></span>
          </div>

          <div class="field">
            <label class="field__label" asp-for="Email">Email</label>
            <input class="field__input" asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com" required>
            <span asp-validation-for="Email" class="field__error"></span>
          </div>

          <div class="field">
            <label class="field__label" asp-for="Phone">Phone number <span class="text-muted">(optional)</span></label>
            <input class="field__input" asp-for="Phone" type="tel" autocomplete="tel" placeholder="0901 234 567">
            <span asp-validation-for="Phone" class="field__error"></span>
          </div>

          <div class="field">
            <label class="field__label" asp-for="Password">Password</label>
            <input class="field__input" asp-for="Password" type="password" autocomplete="new-password" required>
            <span asp-validation-for="Password" class="field__error"></span>
            <p class="field__hint">At least 8 characters, with letters and numbers.</p>
          </div>

          <div>
            <label class="row" style="gap: var(--space-2); align-items: center; cursor: pointer">
              <input asp-for="TermsAccepted" type="checkbox">
              <span class="text-sm">I agree to the terms of use</span>
            </label>
            <span asp-validation-for="TermsAccepted" class="field__error"></span>
          </div>
        </div>

        <div class="card__footer stack">
          <button type="submit" class="btn btn--primary btn--lg w-100" style="width: 100%">
            Create account
          </button>
          <p class="text-sm text-muted m-0 text-center">
            Already have an account? <a href="/auth/sign-in@(string.IsNullOrEmpty(Model.ReturnUrl) ? "" : $"?returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}")">Sign in</a>.
          </p>
        </div>
      </form>
    </div>

    <aside class="card">
      <div class="card__header"><strong>What you get on day one</strong></div>
      <div class="card__body stack">
        <ol class="stack--tight m-0" style="padding-left: var(--space-5)">
          <li><strong>Take the placement exam.</strong> It is free and sets your starting level.</li>
          <li><strong>Get a learning path.</strong> Modules run from your level to your target.</li>
          <li><strong>Practise as much as you like.</strong> Listening and reading practice never costs a credit.</li>
        </ol>
        <table class="table">
          <caption class="visually-hidden">The actions that cost credits</caption>
          <thead><tr><th scope="col">Costs credits</th><th scope="col">Cost</th></tr></thead>
          <tbody>
            <tr><th scope="row">Start a mock exam</th><td>1 credit</td></tr>
            <tr><th scope="row">AI grading of speaking or writing</th><td>1 credit</td></tr>
            <tr><th scope="row">Book a mentor session</th><td>1 credit</td></tr>
            <tr><th scope="row">Premium learning path</th><td>5 credits</td></tr>
          </tbody>
        </table>
        <p class="text-xs text-muted no-margin">Credits do not expire once bought.</p>
      </div>
    </aside>
  </div>
</div>
