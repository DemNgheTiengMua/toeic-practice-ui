@{
    ViewData["Title"] = "Certificates unavailable";
    ViewData["Description"] = "The certificate catalogue could not be loaded.";
}

<div class="container stack" style="padding-top: var(--space-6); padding-bottom: var(--space-8)">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/" class="breadcrumbs__item">Home</a>
    <span class="breadcrumbs__separator" aria-hidden="true">›</span>
    <span class="breadcrumbs__item" aria-current="page">Certificates</span>
  </nav>

  <div class="card">
    <div class="card__body stack">
      <h1 class="m-0">We can't load the certificate catalogue right now</h1>
      <p class="text-muted no-margin">
        The service that provides certificate details didn't answer. This is usually temporary —
        try again in a moment.
      </p>
      <div>
        <a class="btn btn--primary" href="/certificates">Try again</a>
      </div>
    </div>
  </div>
</div>
