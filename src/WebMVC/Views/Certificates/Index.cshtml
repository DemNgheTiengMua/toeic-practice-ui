@model WebMVC.Models.CertificateCatalogViewModel
@{
    ViewData["Title"] = "Certificates";
    ViewData["Description"] = Model.Description;
}

<div class="container stack" style="padding-top: var(--space-6); padding-bottom: var(--space-8)">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/" class="breadcrumbs__item">Home</a>
    <span class="breadcrumbs__separator" aria-hidden="true">›</span>
    <span class="breadcrumbs__item" aria-current="page">Certificates</span>
  </nav>

  <div style="max-width: 640px">
    <h1 class="m-0 mb-1">@Model.Heading</h1>
    <p class="text-muted no-margin">
      Pick the certificate you are working toward. Your placement exam, learning path, practice bank and
      mock exams all follow that certificate's real structure and scoring — and you can switch at any time.
    </p>
  </div>

  @foreach (var cert in Model.Certificates)
  {
    <section class="stack" aria-labelledby="cert-@cert.Code.ToLowerInvariant()">
      <h2 id="cert-@cert.Code.ToLowerInvariant()" class="section-group__title">@cert.Code — @cert.Name</h2>
      <div class="card">
        <div class="card__body stack">
          @if (!string.IsNullOrEmpty(cert.Description))
          {
            <p class="no-margin">@cert.Description</p>
          }
          <div class="grid-2">
            @foreach (var skill in cert.Skills)
            {
              <div>
                <strong>
                  @skill.Name
                  @if (skill.DurationMinutes is not null)
                  {
                    <text> — @skill.DurationMinutes minutes</text>
                  }
                  @if (skill.Sections.Count > 0)
                  {
                    var total = Model.QuestionCounts[(cert.Code, skill.Code)];
                    if (total > 0)
                    {
                      <text> · @total questions</text>
                    }
                  }
                </strong>
                @if (skill.Sections.Count > 0)
                {
                  <ul class="text-sm text-muted mt-1 mb-0 pl-5">
                    @foreach (var sec in skill.Sections)
                    {
                      <li>
                        @sec.Code — @sec.Name
                        <text>(@sec.ExpectedQuestionCount)</text>
                      </li>
                    }
                  </ul>
                }
              </div>
            }
          </div>
          @if (cert.Bands.Count > 0)
          {
            @* #161: the strip draws the bands this certificate has, in score order, each column as wide as
               the range that band covers. The note carries the range, so the scale is stated rather than
               assumed — `First()`/`Last()` on an unordered list printed the wrong one when rows arrived out
               of order. *@
            <div>
              <strong class="text-sm">Score bands</strong>
              <div class="cefr mt-2">
                <partial name="_BandStrip" model="Model.BandStrips[cert.Code]" />
                <p class="cefr__note">@Model.BandStrips[cert.Code].Note</p>
              </div>
            </div>
          }
        </div>
        <div class="card__footer">
          @* Switching the active certificate is a learner action (admins have none). *@
          @if (Model.IsSignedIn && !Model.IsStaff)
          {
            <form method="post" action="/learner/active-certificate" style="display:inline; margin:0;">
              @Html.AntiForgeryToken()
              <input type="hidden" name="returnUrl" value="/dashboard" />
              <button type="submit" name="code" value="@cert.Code" class="btn btn--primary">
                Switch to @cert.Code
              </button>
            </form>
          }
          else if (!Model.IsSignedIn)
          {
            <a class="btn btn--primary" href="/auth/register">Start with @cert.Code</a>
          }
        </div>
      </div>
    </section>
  }

  <div class="card">
    <div class="card__body row row--between" style="flex-wrap: wrap; gap: var(--space-4)">
      <p class="no-margin"><strong>Not sure which one fits your goal?</strong><br>
        <span class="text-muted">Create a free account and take the placement exam — it works for every certificate.</span></p>
      @if (Model.IsSignedIn && !Model.IsStaff)
      {
        <a class="btn btn--primary btn--lg" href="/placement">Take placement test</a>
      }
      else if (!Model.IsSignedIn)
      {
        <a class="btn btn--primary btn--lg" href="/auth/register">Start for free</a>
      }
    </div>
  </div>
</div>
