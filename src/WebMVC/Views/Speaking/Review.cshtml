@model SpeakingReviewViewModel
@{
    Layout = "_LearnerLayout";
    var r = Model.Review;
    ViewData["Title"] = $"Speaking Result — {r.ExamName}";
    ViewData["Description"] = $"Speaking practice grading result for {r.ExamName}.";
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/dashboard" class="breadcrumbs__item">Home</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/practice" class="breadcrumbs__item">Practice</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Speaking result</span>
</nav>

<div class="context-bar mb-4">
  <div class="context-bar__item">
    <span class="context-bar__label">Certificate:</span>
    <span class="context-bar__value">@r.CertCode</span>
  </div>
  <div class="context-bar__item">
    <span class="context-bar__label">Attempt:</span>
    <span class="context-bar__value">Speaking practice</span>
  </div>
  <div class="context-bar__item">
    <span class="context-bar__label">Cost:</span>
    <span class="context-bar__value">1 credit · AI grading</span>
  </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
  <div class="alert alert--danger mb-3" role="alert">@Model.ErrorMessage</div>
}

<div class="stack">
  <div class="row row--between">
    <div>
      <h1 class="m-0 mb-1">Speaking result</h1>
      <p class="text-sm text-muted no-margin">
        @(r.SubmittedAt.HasValue ? $"Graded {r.SubmittedAt.Value:dd MMMM yyyy · HH:mm} · " : "")
        @r.AnsweredQuestions of @r.TotalQuestions questions recorded
      </p>
    </div>
    <div class="row">
      <a class="btn" href="/practice">Practice by section</a>
      <a class="btn btn--primary" href="/speaking/@r.ExamId/instructions">Practise speaking again</a>
    </div>
  </div>

  <!-- Score Hero -->
  <div class="score-hero">
    <div class="score-hero__total">
      <div class="score-hero__total-value">@Model.ScoreDisplay</div>
      <div class="score-hero__total-label">@Model.ScoreScaleLabel</div>
    </div>
    <div class="score-hero__section">
      <div class="score-hero__section-value">@r.TotalScore.ToString("0.#")</div>
      <div class="text-sm text-muted">Points earned · @r.MaxScore.ToString("0.#") available</div>
      <p class="text-xs text-muted m-0 mt-1">Sum of all scored criteria</p>
    </div>
    <div class="score-hero__section">
      <div class="score-hero__section-value">1</div>
      <div class="text-sm text-muted">Credit used</div>
      <p class="text-xs text-muted m-0 mt-1">AI evaluation and rubric scoring</p>
    </div>
  </div>

  <!-- Table of answers -->
  <section>
    <h2 class="section-group__title">Your @r.AnsweredQuestions recorded answers</h2>
    <div class="card">
      <div class="card__body">
        <table class="table">
          <caption class="visually-hidden">Score and audio for each speaking question</caption>
          <thead>
            <tr>
              <th scope="col">Question</th>
              <th scope="col">Task / Section</th>
              <th scope="col">Score</th>
              <th scope="col">Recording</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var q in r.Questions)
            {
              <tr>
                <th scope="row">@q.DisplayOrder</th>
                <td>@q.SectionName</td>
                <td>
                  <strong>@q.TotalScore.ToString("0.#")</strong> / @q.MaxScore.ToString("0.#")
                </td>
                <td>
                  @if (!string.IsNullOrEmpty(q.AudioPath))
                  {
                    <button class="btn btn--sm" type="button" data-play-question-id="@q.QuestionId" aria-label="Play recording for question @q.DisplayOrder">
                      Play
                    </button>
                  }
                  else
                  {
                    <span class="text-muted text-xs">No recording</span>
                  }
                </td>
              </tr>
            }
          </tbody>
          <tfoot>
            <tr>
              <th scope="row" colspan="2">Total points</th>
              <td colspan="2"><strong>@r.TotalScore.ToString("0.#") / @r.MaxScore.ToString("0.#")</strong></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </section>

  <!-- Highlight Lowest Scored Question if available -->
  @if (r.LowestScoredQuestion != null && r.LowestScoredQuestion.Criteria.Count > 0)
  {
    var lowest = r.LowestScoredQuestion;
    <section>
      <h2 class="section-group__title">Lowest score: question @lowest.DisplayOrder</h2>
      <div class="card">
        <div class="card__body stack">
          <p class="no-margin">
            <strong>@lowest.SectionName</strong> · Scored <strong>@lowest.TotalScore.ToString("0.#") of @lowest.MaxScore.ToString("0.#")</strong>.
            Listen to your response and review the AI feedback below:
          </p>

          @if (!string.IsNullOrEmpty(lowest.AudioPath))
          {
            <div class="mb-3" style="max-width: 540px;">
              @await Html.PartialAsync("_ExamAudioPlayer", new ExamAudioPlayerModel(
                  AudioPath: $"/speaking/audio/{r.AttemptId}/{lowest.QuestionId}",
                  AllowReplay: true,
                  SectionTitle: $"Question {lowest.DisplayOrder} Recording",
                  BadgeText: "RECORDING",
                  PlayerId: $"exam-audio-lowest-{lowest.QuestionId}",
                  Mode: "study"
              ))
            </div>
          }

          @if (!string.IsNullOrEmpty(lowest.Transcript))
          {
            <div class="explain explain--neutral my-2">
              <div class="explain__title">Transcript</div>
              <p class="no-margin text-sm">@lowest.Transcript</p>
            </div>
          }

          <ul class="stack m-0 pl-5">
            @foreach (var c in lowest.Criteria)
            {
              <li>
                <strong>@c.Name (@c.Score.ToString("0.#")/@c.MaxScore.ToString("0.#")):</strong>
                @* #239: the score is not the evidence; the note is. A missing note says so. *@
                @if (!string.IsNullOrWhiteSpace(c.Comment))
                {
                  @c.Comment
                }
                else
                {
                  <span class="text-muted text-xs">No note was recorded for this criterion on this grading.</span>
                }
              </li>
            }
          </ul>
        </div>
      </div>
    </section>
  }

  <!-- Per-question detailed criteria & transcripts -->
  <section>
    <h2 class="section-group__title">Detailed feedback by question</h2>
    <div class="stack">
      @foreach (var q in r.Questions)
      {
        <div class="card">
          <div class="card__header">
            <div class="row row--between">
              <strong>Question @q.DisplayOrder: @q.SectionName</strong>
              <span>
                Score: <strong>@q.TotalScore.ToString("0.#") / @q.MaxScore.ToString("0.#")</strong>
              </span>
            </div>
          </div>
          <div class="card__body stack">
            <p class="text-sm text-muted no-margin">@q.Stem</p>

            @if (!string.IsNullOrEmpty(q.AudioPath))
            {
              <div class="mb-3" style="max-width: 540px;">
                @await Html.PartialAsync("_ExamAudioPlayer", new ExamAudioPlayerModel(
                    AudioPath: $"/speaking/audio/{r.AttemptId}/{q.QuestionId}",
                    AllowReplay: true,
                    SectionTitle: $"Question {q.DisplayOrder} Recording",
                    BadgeText: "RECORDING",
                    PlayerId: $"exam-audio-q-{q.QuestionId}",
                    Mode: "study"
                ))
              </div>
            }

            @if (!string.IsNullOrEmpty(q.Transcript))
            {
              <div class="explain explain--neutral my-2">
                <div class="explain__title">Transcript</div>
                <div class="text-sm">@q.Transcript</div>
              </div>
            }

            @if (q.Criteria.Count > 0)
            {
              <div class="stack" style="gap: var(--space-2); margin-top: var(--space-2)">
                <div class="text-xs text-muted font-bold uppercase" style="letter-spacing: 0.05em">Evaluation Criteria</div>
                <div class="grid-2">
                  @foreach (var c in q.Criteria)
                  {
                    <div class="card p-3">
                      <div class="row row--between mb-1">
                        <strong>@c.Name</strong>
                        <span class="badge badge--info font-mono">@c.Score.ToString("0.#") / @c.MaxScore.ToString("0.#")</span>
                      </div>
                      @* #239: the note is the evidence a criterion was actually judged. A missing one
                         says so rather than reading as praise ("Criteria satisfied."). *@
                      @if (!string.IsNullOrWhiteSpace(c.Comment))
                      {
                        <p class="text-xs text-muted no-margin">@c.Comment</p>
                      }
                      else
                      {
                        <p class="text-xs text-muted no-margin">No note was recorded for this criterion on this grading.</p>
                      }
                    </div>
                  }
                </div>
              </div>
            }
          </div>
        </div>
      }
    </div>
  </section>

  @if (!string.IsNullOrEmpty(Model.Review.EstimatedBandCode))
  {
    <div class="alert alert--info">
      <strong>Estimated band: <span class="font-mono">@Model.Review.EstimatedBandCode</span>@(string.IsNullOrEmpty(Model.Review.EstimatedBandName) ? "" : $" — {Model.Review.EstimatedBandName}")</strong>
      <p class="text-sm no-margin mt-1">
        An estimate from this speaking rubric alone, placed on @Model.Review.CertCode's band scale. It is an
        estimate for this skill: whether it also becomes your certificate band depends on how
        @Model.Review.CertCode reports its skills, and that is a rule of the certificate, not of this page.
      </p>
      @* #239: one task is not a level. A single graded task generalises poorly (r(1) = 0.55), so the
         band says which it is rather than letting one task's mark read as a measurement of the skill. *@
      @if (r.GradedQuestions == 1)
      {
        <p class="text-sm no-margin mt-2">
          <strong>Estimated from one task.</strong> One graded task is a reading of this answer, not of
          your speaking: the same skill measured over several tasks is what supports a level.
        </p>
      }
      else if (r.GradedQuestions > 1)
      {
        <p class="text-sm no-margin mt-2 font-mono">
          Measured over @r.GradedQuestions graded tasks.
        </p>
      }
    </div>
  }
  else if (r.AnsweredQuestions == 0 || r.TotalScore <= 0)
  {
    <div class="alert alert--warning">
      <strong>No estimated band: nothing was scored.</strong>
      <p class="text-sm no-margin mt-1">
        An empty rubric earns no band. Record an answer, or answer more of the questions, to get an
        estimate on @r.CertCode's band scale.
      </p>
    </div>
  }
  else
  {
    <div class="alert alert--warning">
      <strong>@Model.Review.CertCode has no bands configured.</strong>
      <p class="text-sm no-margin mt-1">
        Your rubric scores above are complete, but there is no band scale to place them on yet.
      </p>
    </div>
  }
</div>

<script src="~/js/speaking/review.js" asp-append-version="true"></script>
