@model SpeakingTakeViewModel
@{
    Layout = null;
    var take = Model.Take;
    var q = take.Question;
    ViewData["Title"] = $"Speaking — Question {take.CurrentQuestionIndex} of {take.TotalQuestions}";
    ViewData["Description"] = $"Speaking practice attempt #{take.AttemptId}, question {take.CurrentQuestionIndex}.";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@ViewData["Title"] — extra efficient</title>
  <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="~/css/tokens.css">
  <link rel="stylesheet" href="~/css/base.css">
  <link rel="stylesheet" href="~/css/components.css">
</head>
<body>
<div class="app-shell">
  <header class="app-topbar">
    <div class="exam-topbar-group">
      <strong>Speaking practice</strong>
      <span class="badge badge--info">Question @take.CurrentQuestionIndex of @take.TotalQuestions</span>
    </div>
    <div class="exam-topbar-group">
      <span class="save-status save-status--saved" id="save-status-text" role="status" aria-live="polite">
        @take.SavedCount of @take.TotalQuestions saved
      </span>
      <span class="timer" role="timer" aria-label="Time remaining in the exam">
        <span class="text-sm text-muted">Exam time remaining</span>
        <span class="timer__value" id="test-timer-val">--:--</span>
      </span>
    </div>
  </header>

  <main class="app-main">
    <h1 class="visually-hidden">Speaking practice — question @take.CurrentQuestionIndex of @take.TotalQuestions</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
      <div class="container mb-4">
        <div class="alert alert--danger" role="alert">@Model.ErrorMessage</div>
      </div>
    }

    <div class="container mb-4 d-none" id="save-failed-banner">
      <div class="alert alert--danger" role="alert">
        <strong>Question @take.CurrentQuestionIndex did not upload.</strong>
        Your recording is still held in memory on this device. Click "Retry upload" below.
      </div>
    </div>

    <div class="container">
      <div class="exam-layout">
        <div class="stack">
          <div class="question">
            <div class="question__meta">
              <span class="question__number">Question @take.CurrentQuestionIndex</span>
              <span class="badge badge--muted">@q.SectionName</span>
            </div>
            
            <p class="question__stem">
              @q.Stem
            </p>

            @if (!string.IsNullOrEmpty(q.GroupImagePath))
            {
              <div class="question__image-wrapper my-3">
                <img class="question__image" src="@q.GroupImagePath" alt="@(q.GroupImageAlt ?? "Question illustration")">
              </div>
            }

            <div class="grid-2 mt-4">
              <div class="stat">
                <div class="stat__label">Preparation</div>
                <div class="stat__value" id="stat-prep-val">@(q.PrepSeconds)s</div>
                <div class="stat__hint">plan what to say</div>
              </div>
              <div class="stat">
                <div class="stat__label">Speaking time</div>
                <div class="stat__value" id="stat-resp-val">@(q.ResponseSeconds)s</div>
                <div class="stat__hint">recording stops automatically</div>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card__header">
              <div class="row row--between">
                <strong>Your answer</strong>
                @if (q.DraftSavedAt.HasValue && !string.IsNullOrEmpty(q.AudioPath))
                {
                  <span class="badge badge--success">Saved @q.DraftSavedAt.Value.ToString("HH:mm:ss")</span>
                }
              </div>
            </div>
            <div class="card__body">

              <!-- PREPARE STATE -->
              <div class="state-block" id="block-prepare">
                <div class="state-block__icon" aria-hidden="true">PREPARE</div>
                <div class="state-block__title">Recording starts when preparation ends</div>
                <p class="state-block__desc">Look at the prompt and plan your response. You are not being recorded yet.</p>
                <span class="timer" role="timer" aria-label="Preparation time left">
                  <span class="text-sm text-muted">Starts in</span>
                  <span class="timer__value" id="prep-timer">00:@(q.PrepSeconds.ToString("D2"))</span>
                </span>
                <div class="progress mx-auto mt-4" style="max-width: 320px">
                  <div class="progress__bar" id="prep-progress" style="width: 0%"></div>
                </div>
              </div>

              <!-- RECORDING STATE -->
              <div class="state-block d-none" id="block-recording">
                <div class="state-block__icon state-block__icon--danger" role="status">RECORDING</div>
                <div class="state-block__title">Speak now</div>
                <p class="state-block__desc">Speak into your microphone clearly. Recording stops automatically when speaking time ends.</p>
                <span class="timer timer--critical" role="timer" aria-label="Speaking time left">
                  <span class="text-sm">Time to speak</span>
                  <span class="timer__value" id="speak-timer">00:@(q.ResponseSeconds.ToString("D2"))</span>
                </span>
                <div class="progress mx-auto mt-4" style="max-width: 320px">
                  <div class="progress__bar progress__bar--danger" id="speak-progress" style="width: 0%"></div>
                </div>
              </div>

              <!-- RECORDED / PREVIEW STATE -->
              <div class="state-block d-none" id="block-recorded">
                <div class="state-block__icon state-block__icon--success" aria-hidden="true">RECORDED</div>
                <div class="state-block__title" id="recorded-title">Answer recorded</div>
                <p class="state-block__desc" id="recorded-desc">Listen to your recording before saving it. Saving advances to the next question.</p>
                <div class="exam-audio text-left" style="max-width: 480px; margin: var(--space-4) auto 0">
                  <span class="badge badge--muted">Audio</span>
                  <div style="flex: 1 1 auto">
                    <audio id="audio-player" controls class="w-100"></audio>
                  </div>
                </div>
              </div>

              <!-- SAVING STATE -->
              <div class="state-block d-none" id="block-saving">
                <div class="state-block__icon" aria-hidden="true">UPLOADING</div>
                <div class="state-block__title">Saving your recording…</div>
                <p class="state-block__desc">Uploading your audio file to secure storage. Do not close the window.</p>
                <div class="progress mx-auto mt-4" style="max-width: 320px">
                  <div class="progress__bar" style="width: 65%"></div>
                </div>
              </div>

            </div>
            <div class="card__footer">
              <div class="row row--between">
                <div class="row" id="control-buttons">
                  <button class="btn btn--primary" id="btn-start-now" type="button">Start recording now</button>
                  <button class="btn btn--danger d-none" id="btn-stop-now" type="button">Stop recording</button>
                  <button class="btn btn--primary d-none" id="btn-save-continue" type="button">Save and continue</button>
                  <button class="btn d-none" id="btn-record-again" type="button">Record again</button>
                  <button class="btn btn--primary d-none" id="btn-retry-upload" type="button">Retry upload</button>
                </div>
                <p class="text-xs text-muted no-margin" id="record-again-hint" style="display: none">
                  Recording again replaces this take.
                </p>
              </div>
            </div>
          </div>

          <p class="text-xs text-muted no-margin">
            Questions are completed in order. Once an answer is saved, you move forward to the next task.
          </p>
        </div>

        <!-- SIDEBAR -->
        <aside class="exam-sidebar stack">
          <div class="card">
            <div class="card__header">
              <div class="row row--between">
                <strong class="text-sm">Questions</strong>
                <span class="text-xs text-muted">@take.SavedCount of @take.TotalQuestions recorded</span>
              </div>
            </div>
            <div class="card__body stack">
              <div class="progress" role="progressbar" aria-valuenow="@take.SavedCount" aria-valuemin="0" aria-valuemax="@take.TotalQuestions">
                <div class="progress__bar" style="width: @((take.SavedCount * 100) / Math.Max(1, take.TotalQuestions))%"></div>
              </div>

              <div class="navigator" role="group" aria-label="Speaking question navigator">
                <div class="navigator__grid">
                  @for (int i = 0; i < take.Questions.Count; i++)
                  {
                    var item = take.Questions[i];
                    var cellClass = item.IsCurrent ? "is-current" : (item.IsAnswered ? "is-answered" : "is-unanswered");
                    <a href="/speaking/take/@take.AttemptId?q=@item.QuestionId"
                       class="navigator__cell @cellClass"
                       aria-current="@(item.IsCurrent ? "step" : "false")"
                       aria-label="Question @(i + 1) (@(item.IsAnswered ? "Recorded" : "Not yet recorded"))">
                      @(i + 1)
                    </a>
                  }
                </div>
              </div>

              <div class="text-xs stack" style="gap: var(--space-1)">
                <div class="row"><span class="navigator__cell navigator__cell--swatch is-answered" aria-hidden="true">1</span> Saved</div>
                <div class="row"><span class="navigator__cell navigator__cell--swatch is-current" aria-hidden="true">2</span> Current</div>
                <div class="row"><span class="navigator__cell navigator__cell--swatch is-unanswered" aria-hidden="true">3</span> Remaining</div>
              </div>
            </div>
          </div>

          <div class="stack">
            <button class="btn btn--danger btn--full" type="button" @(take.SavedCount == 0 ? "disabled" : "") id="btn-open-submit-modal">
              Finish and submit
            </button>
            <p class="text-xs text-muted no-margin text-center">
              Deducts 1 credit upon submission for AI evaluation. Questions without recordings are not graded.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </main>
</div>

<!-- Submit Confirmation Modal -->
<div id="submit-modal" class="modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="submit-modal-title">
  <div class="modal">
    <div class="modal__header">
      <h2 id="submit-modal-title" class="no-margin">Finish & Submit Speaking Practice?</h2>
    </div>
    <div class="modal__body stack">
      <p class="no-margin">
        Submitting will send your recordings for AI evaluation and deduct <strong>1 credit</strong> from your wallet.
      </p>
      @if (take.SavedCount < take.TotalQuestions)
      {
        <div class="alert alert--warning">
          <strong>Notice:</strong> You have recorded @take.SavedCount of @take.TotalQuestions questions. Unrecorded questions will receive 0 marks.
        </div>
      }
    </div>
    <div class="modal__footer row row--between">
      <button type="button" class="btn js-close-submit-modal">Return to practice</button>
      <form method="post" action="/speaking/submit/@take.AttemptId" style="margin:0;">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn--danger">Confirm & Submit (1 credit)</button>
      </form>
    </div>
  </div>
</div>

<!-- Anti-forgery form token helper -->
<form id="antiforgery-form" style="display:none">@Html.AntiForgeryToken()</form>

<script>
(function() {
  const attemptId = @take.AttemptId;
  const questionId = @q.QuestionId;
  const prepSecondsTotal = @q.PrepSeconds;
  const speakSecondsTotal = @q.ResponseSeconds;
  let remainingTestSeconds = @take.RemainingSeconds;
  const hasExistingAudio = @((!string.IsNullOrEmpty(q.AudioPath)).ToString().ToLower());
  const existingAudioUrl = '/speaking/audio/' + attemptId + '/' + questionId;

  // Elements
  const blockPrepare = document.getElementById('block-prepare');
  const blockRecording = document.getElementById('block-recording');
  const blockRecorded = document.getElementById('block-recorded');
  const blockSaving = document.getElementById('block-saving');
  const saveFailedBanner = document.getElementById('save-failed-banner');

  const btnStartNow = document.getElementById('btn-start-now');
  const btnStopNow = document.getElementById('btn-stop-now');
  const btnSaveContinue = document.getElementById('btn-save-continue');
  const btnRecordAgain = document.getElementById('btn-record-again');
  const btnRetryUpload = document.getElementById('btn-retry-upload');
  const recordAgainHint = document.getElementById('record-again-hint');

  const prepTimerEl = document.getElementById('prep-timer');
  const prepProgressEl = document.getElementById('prep-progress');
  const speakTimerEl = document.getElementById('speak-timer');
  const speakProgressEl = document.getElementById('speak-progress');
  const recordedTitleEl = document.getElementById('recorded-title');
  const recordedDescEl = document.getElementById('recorded-desc');
  const audioPlayer = document.getElementById('audio-player');
  const testTimerVal = document.getElementById('test-timer-val');

  let prepCountdown = prepSecondsTotal;
  let speakCountdown = speakSecondsTotal;
  let prepInterval = null;
  let speakInterval = null;
  let mediaRecorder = null;
  let audioChunks = [];
  let recordedBlob = null;
  let recordedDurationMs = 0;
  let recordingStartTime = 0;

  // Format MM:SS
  function formatTime(sec) {
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
  }

  // Update whole-exam timer
  function updateTestTimer() {
    testTimerVal.textContent = formatTime(remainingTestSeconds);
    if (remainingTestSeconds > 0) {
      remainingTestSeconds--;
    } else {
      alert("Exam time has expired. Submitting your saved answers...");
      document.querySelector('form[action^="/speaking/submit/"]').submit();
    }
  }
  setInterval(updateTestTimer, 1000);
  updateTestTimer();

  function showState(state) {
    blockPrepare.classList.add('d-none');
    blockRecording.classList.add('d-none');
    blockRecorded.classList.add('d-none');
    blockSaving.classList.add('d-none');

    btnStartNow.classList.add('d-none');
    btnStopNow.classList.add('d-none');
    btnSaveContinue.classList.add('d-none');
    btnRecordAgain.classList.add('d-none');
    btnRetryUpload.classList.add('d-none');
    recordAgainHint.style.display = 'none';

    if (state === 'prepare') {
      blockPrepare.classList.remove('d-none');
      btnStartNow.classList.remove('d-none');
    } else if (state === 'recording') {
      blockRecording.classList.remove('d-none');
      btnStopNow.classList.remove('d-none');
    } else if (state === 'recorded') {
      blockRecorded.classList.remove('d-none');
      btnSaveContinue.classList.remove('d-none');
      btnRecordAgain.classList.remove('d-none');
      recordAgainHint.style.display = 'block';
    } else if (state === 'saving') {
      blockSaving.classList.remove('d-none');
    } else if (state === 'save-failed') {
      blockRecorded.classList.remove('d-none');
      btnRetryUpload.classList.remove('d-none');
      btnRecordAgain.classList.remove('d-none');
      saveFailedBanner.classList.remove('d-none');
      recordAgainHint.style.display = 'block';
    }
  }

  // If question already had saved audio, show recorded state directly
  if (hasExistingAudio) {
    recordedTitleEl.textContent = 'Existing saved answer';
    recordedDescEl.textContent = 'You previously saved an answer for this question. You can listen to it or record again.';
    audioPlayer.src = existingAudioUrl;
    showState('recorded');
  } else {
    startPreparation();
  }

  function startPreparation() {
    showState('prepare');
    prepCountdown = prepSecondsTotal;
    updatePrepUI();

    clearInterval(prepInterval);
    prepInterval = setInterval(() => {
      prepCountdown--;
      updatePrepUI();
      if (prepCountdown <= 0) {
        clearInterval(prepInterval);
        startRecording();
      }
    }, 1000);
  }

  function updatePrepUI() {
    prepTimerEl.textContent = '00:' + (prepCountdown < 10 ? '0' : '') + prepCountdown;
    const pct = ((prepSecondsTotal - prepCountdown) / prepSecondsTotal) * 100;
    prepProgressEl.style.width = pct + '%';
  }

  async function startRecording() {
    clearInterval(prepInterval);
    audioChunks = [];
    showState('recording');
    speakCountdown = speakSecondsTotal;
    updateSpeakUI();

    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      mediaRecorder = new MediaRecorder(stream);
      mediaRecorder.ondataavailable = e => { if (e.data.size > 0) audioChunks.push(e.data); };
      mediaRecorder.onstop = () => {
        recordedDurationMs = Date.now() - recordingStartTime;
        recordedBlob = new Blob(audioChunks, { type: 'audio/webm' });
        audioPlayer.src = URL.createObjectURL(recordedBlob);
        recordedTitleEl.textContent = 'You spoke for ' + Math.round(recordedDurationMs / 1000) + ' of ' + speakSecondsTotal + ' seconds';
        recordedDescEl.textContent = 'Your recording is ready on this device. Save it to proceed, or record again.';
        stream.getTracks().forEach(t => t.stop());
        showState('recorded');
      };

      recordingStartTime = Date.now();
      mediaRecorder.start();

      clearInterval(speakInterval);
      speakInterval = setInterval(() => {
        speakCountdown--;
        updateSpeakUI();
        if (speakCountdown <= 0) {
          stopRecording();
        }
      }, 1000);
    } catch (err) {
      alert("Microphone permission was not granted or microphone is not available. Please allow microphone access.");
      showState('prepare');
    }
  }

  function updateSpeakUI() {
    speakTimerEl.textContent = '00:' + (speakCountdown < 10 ? '0' : '') + speakCountdown;
    const pct = ((speakSecondsTotal - speakCountdown) / speakSecondsTotal) * 100;
    speakProgressEl.style.width = pct + '%';
  }

  function stopRecording() {
    clearInterval(speakInterval);
    if (mediaRecorder && mediaRecorder.state === 'recording') {
      mediaRecorder.stop();
    }
  }

  btnStartNow.addEventListener('click', () => {
    clearInterval(prepInterval);
    startRecording();
  });

  btnStopNow.addEventListener('click', () => {
    stopRecording();
  });

  btnRecordAgain.addEventListener('click', () => {
    if (confirm("Recording again replaces this take. Proceed?")) {
      saveFailedBanner.classList.add('d-none');
      startPreparation();
    }
  });

  async function uploadRecording() {
    if (!recordedBlob) {
      // If user had existing audio and just clicked save, advance to next question
      advanceToNextQuestion();
      return;
    }

    showState('saving');
    saveFailedBanner.classList.add('d-none');

    const token = document.querySelector('#antiforgery-form input[name="__RequestVerificationToken"]')?.value || '';
    const formData = new FormData();
    formData.append('attemptId', attemptId);
    formData.append('questionId', questionId);
    formData.append('audioFile', recordedBlob, 'recording.webm');
    formData.append('durationMs', Math.round(recordedDurationMs));
    formData.append('__RequestVerificationToken', token);

    try {
      const response = await fetch('/speaking/upload-audio', {
        method: 'POST',
        body: formData
      });

      if (response.ok) {
        advanceToNextQuestion();
      } else {
        showState('save-failed');
      }
    } catch (err) {
      showState('save-failed');
    }
  }

  function advanceToNextQuestion() {
    // Find next question from navigator
    const currentCell = document.querySelector('.navigator__cell.is-current');
    let nextLink = null;
    if (currentCell) {
      const allCells = Array.from(document.querySelectorAll('.navigator__cell:not(.navigator__cell--swatch)'));
      const idx = allCells.indexOf(currentCell);
      if (idx !== -1 && idx < allCells.length - 1) {
        nextLink = allCells[idx + 1].getAttribute('href');
      }
    }

    if (nextLink) {
      window.location.href = nextLink;
    } else {
      // All done or on last question
      alert("All questions recorded! You can now finish and submit your attempt.");
      window.location.reload();
    }
  }

  const submitModal = document.getElementById('submit-modal');
  const btnOpenSubmit = document.getElementById('btn-open-submit-modal');
  const closeSubmitBtns = document.querySelectorAll('.js-close-submit-modal');

  function openModal() {
    if (submitModal) {
      submitModal.classList.add('modal-overlay--open');
      submitModal.setAttribute('aria-hidden', 'false');
    }
  }

  function closeModal() {
    if (submitModal) {
      submitModal.classList.remove('modal-overlay--open');
      submitModal.setAttribute('aria-hidden', 'true');
    }
  }

  if (btnOpenSubmit) {
    btnOpenSubmit.addEventListener('click', openModal);
  }
  closeSubmitBtns.forEach(btn => {
    btn.addEventListener('click', closeModal);
  });
  if (submitModal) {
    submitModal.addEventListener('click', (e) => {
      if (e.target === submitModal) closeModal();
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && submitModal && submitModal.classList.contains('modal-overlay--open')) {
      closeModal();
    }
  });

  btnSaveContinue.addEventListener('click', uploadRecording);
  btnRetryUpload.addEventListener('click', uploadRecording);
})();
</script>
</body>
</html>
