@model SpeakingInstructionsViewModel
@{
    Layout = "_LearnerLayout";
    var instr = Model.Instructions;
    ViewData["Title"] = $"Speaking Instructions — {instr.ExamName}";
    ViewData["Description"] = $"Speaking practice instructions for {instr.ExamName}.";
    var hasCredits = instr.CreditBalance >= instr.CreditCost;
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/dashboard" class="breadcrumbs__item">Home</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/practice" class="breadcrumbs__item">Practice</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Speaking instructions</span>
</nav>

<div class="row row--between">
  <div>
    <h1 class="m-0 mb-1">Before you begin: @instr.ExamName</h1>
    <p class="text-muted no-margin">
      Certificate: <strong>@instr.CertCode</strong> · Duration: <strong>@instr.DurationMinutes minutes</strong> · Questions: <strong>@instr.QuestionCount</strong>
    </p>
  </div>
  <div>
    <span class="badge @(hasCredits ? "badge--info" : "badge--warning")">
      @instr.CreditBalance @(instr.CreditBalance == 1 ? "credit" : "credits") left
    </span>
  </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
  <div class="alert alert--danger" role="alert">@Model.ErrorMessage</div>
}

@if (!hasCredits)
{
  <div class="card">
    <div class="card__body">
      <div class="state-block">
        <div class="state-block__icon" aria-hidden="true">LOCKED</div>
        <h2 class="state-block__title">You are out of credits</h2>
        <p class="state-block__desc">
          Speaking practice uses <strong>@instr.CreditCost credit</strong> for AI grading of your audio recordings. Listening and reading practice stay free.
        </p>
        <div class="row row--center">
          <a class="btn btn--primary btn--lg" href="/pricing">View pricing</a>
          <a class="btn btn--lg" href="/practice">Practice free</a>
        </div>
      </div>
    </div>
  </div>
}
else
{
  <div class="stack">
    <div class="card">
      <div class="card__header"><strong>Speaking structure</strong></div>
      <div class="card__body">
        <table class="table">
          <caption class="visually-hidden">The speaking tasks with preparation and speaking time</caption>
          <thead>
            <tr>
              <th scope="col">Section / Task</th>
              <th scope="col">Preparation</th>
              <th scope="col">Speaking time</th>
              <th scope="col">Questions</th>
            </tr>
          </thead>
          <tbody>
            @if (instr.Sections.Count > 0)
            {
              @foreach (var sec in instr.Sections)
              {
                <tr>
                  <td><strong>@sec.Code</strong>: @sec.Name</td>
                  <td>@(sec.PrepSeconds.HasValue ? $"{sec.PrepSeconds}s" : "45s")</td>
                  <td>@(sec.ResponseSeconds.HasValue ? $"{sec.ResponseSeconds}s" : "30s")</td>
                  <td>@sec.ExpectedQuestionCount</td>
                </tr>
              }
            }
            else
            {
              <tr><td>1–2: Read a text aloud</td><td>45s</td><td>45s</td><td>2</td></tr>
              <tr><td>3–4: Describe a picture</td><td>45s</td><td>30s</td><td>2</td></tr>
              <tr><td>5–7: Respond to questions</td><td>3s</td><td>15 or 30s</td><td>3</td></tr>
              <tr><td>8–10: Respond using info</td><td>45s to read, then 3s</td><td>15 or 30s</td><td>3</td></tr>
              <tr><td>11: Express an opinion</td><td>45s</td><td>60s</td><td>1</td></tr>
            }
          </tbody>
          <tfoot>
            <tr>
              <th scope="row" colspan="3">Total</th>
              <td>@instr.QuestionCount questions · @instr.DurationMinutes min</td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <div class="alert alert--warning">
      <strong>Recording starts and stops by itself.</strong>
      It starts when preparation ends and stops when speaking time ends. You can stop early and review your recording before saving it. Once saved, you move to the next question.
    </div>

    <!-- Microphone test card -->
    <div class="card" id="mic-test-card">
      <div class="card__header"><strong>Microphone check</strong></div>
      <div class="card__body stack">
        <p class="no-margin">Say your name and today's date out loud. Play it back to make sure your voice is loud and clear.</p>
        <div class="exam-audio">
          <span class="badge badge--muted">Test clip</span>
          <div style="flex: 1 1 auto">
            <div class="progress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="5" aria-label="Playback position">
              <div class="progress__bar" id="mic-progress" style="width: 0%"></div>
            </div>
            <p class="exam-audio__status m-0 mt-2" id="mic-status">Ready to test microphone</p>
          </div>
          <div class="row">
            <button class="btn btn--sm" type="button" id="btn-record-test">Record test clip</button>
            <button class="btn btn--sm" type="button" id="btn-play-test" disabled>Play back</button>
          </div>
        </div>
        <p class="text-xs text-muted no-margin">The test clip stays on your device, is not saved to the server, and is not graded.</p>
      </div>
    </div>

    <div class="card">
      <div class="card__header"><strong>Important notes</strong></div>
      <div class="card__body">
        <ul class="stack m-0 pl-5">
          <li>Find a quiet place without background noise or voices.</li>
          <li>Each recording is saved as soon as you finish it. Saved audio is stored securely and accessible only to you.</li>
          <li>Starting the attempt does not charge. <strong>@instr.CreditCost credit</strong> is deducted upon final submit for AI grading.</li>
          <li>If an AI grading fails, retrying is completely free and will never charge again.</li>
        </ul>
      </div>
    </div>

    <form method="post" action="/speaking/@instr.ExamId/start" class="stack">
      @Html.AntiForgeryToken()
      <label class="row">
        <input type="checkbox" id="confirm-ready" required>
        <span class="text-sm">I have tested my microphone, read the instructions, and am ready to begin</span>
      </label>

      <div class="row">
        <button type="submit" class="btn btn--primary btn--lg" id="btn-start" disabled>
          Start speaking practice — uses @instr.CreditCost credit on submit
        </button>
        <a class="btn btn--lg" href="/practice">Later</a>
      </div>
    </form>
  </div>

  <script>
    document.getElementById('confirm-ready')?.addEventListener('change', function() {
      const btn = document.getElementById('btn-start');
      if (btn) btn.disabled = !this.checked;
    });

    // Browser audio test clip implementation
    (function() {
      let mediaRecorder = null;
      let audioChunks = [];
      let testAudio = null;
      const recBtn = document.getElementById('btn-record-test');
      const playBtn = document.getElementById('btn-play-test');
      const statusText = document.getElementById('mic-status');
      const progressBar = document.getElementById('mic-progress');

      if (!recBtn) return;

      recBtn.addEventListener('click', async function() {
        if (mediaRecorder && mediaRecorder.state === 'recording') {
          mediaRecorder.stop();
          recBtn.textContent = 'Record test clip';
          return;
        }

        try {
          const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
          audioChunks = [];
          mediaRecorder = new MediaRecorder(stream);
          mediaRecorder.ondataavailable = e => { if (e.data.size > 0) audioChunks.push(e.data); };
          mediaRecorder.onstop = () => {
            const blob = new Blob(audioChunks, { type: 'audio/webm' });
            testAudio = new Audio(URL.createObjectURL(blob));
            if (playBtn) playBtn.disabled = false;
            if (statusText) statusText.textContent = 'Test recording ready to play';
            if (progressBar) progressBar.style.width = '100%';
            stream.getTracks().forEach(track => track.stop());
          };

          mediaRecorder.start();
          recBtn.textContent = 'Stop recording (max 5s)';
          if (statusText) statusText.textContent = 'Recording… say something';
          if (progressBar) progressBar.style.width = '50%';

          setTimeout(() => {
            if (mediaRecorder && mediaRecorder.state === 'recording') {
              mediaRecorder.stop();
              recBtn.textContent = 'Record test clip';
            }
          }, 5000);
        } catch (err) {
          if (statusText) statusText.textContent = 'Microphone access denied or not available.';
        }
      });

      if (playBtn) {
        playBtn.addEventListener('click', function() {
          if (testAudio) {
            testAudio.currentTime = 0;
            testAudio.play();
            if (statusText) statusText.textContent = 'Playing test clip…';
            testAudio.onended = () => {
              if (statusText) statusText.textContent = 'Playback finished.';
            };
          }
        });
      }
    })();
  </script>
}
