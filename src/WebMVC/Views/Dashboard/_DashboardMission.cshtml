@model Contracts.LearnerDashboardDto
@{
    var steps = Model.MissionSteps;
    string SeverityBadgeClass(string severity) => severity switch
    {
        "danger" => "badge--danger",
        "warning" => "badge--warning",
        "success" => "badge--success",
        "info" => "badge--info",
        _ => "badge--muted",
    };
}

@if (steps is { Count: > 0 })
{
    var clearedCount = steps.Count(s => s.IsCleared);
    <section class="mission-checklist" aria-labelledby="mission-heading">
      <header class="mission-checklist__header">
        <h2 class="mission-checklist__title" id="mission-heading">Today's Directive · @Model.Certificate.Code 3-Step Milestones</h2>
        <span class="badge @(clearedCount == steps.Count ? "badge--success" : "badge--muted") font-mono">@clearedCount / @steps.Count CLEARED</span>
      </header>
      <div class="mission-checklist__list" role="list">
        @foreach (var step in steps)
        {
          <article class="mission-checklist__item @(step.IsCleared ? "mission-checklist__item--cleared" : "")" data-mission-step="@step.StepNumber" role="listitem">
            <div>
              <div class="mission-checklist__item-top">
                <span class="mission-checklist__item-num">STEP @step.StepNumber.ToString("00")</span>
                <div class="row row--tight" style="gap: var(--space-1, 4px);">
                  <span class="badge @SeverityBadgeClass(step.Severity) text-xs">@step.BadgeLabel</span>
                  @if (step.IsCleared)
                  {
                    <span class="badge badge--success text-xs">Cleared</span>
                  }
                </div>
              </div>
              <div class="text-xs text-muted font-mono uppercase" style="letter-spacing: 0.04em;">@step.Eyebrow</div>
              <h3 class="mission-checklist__item-title">@step.Title</h3>
              <p class="mission-checklist__item-desc">@step.Description</p>
            </div>
            <div class="mission-checklist__item-foot">
              <span class="font-mono text-xs text-muted uppercase">@step.MetaLabel</span>
              <a class="btn btn--sm @(step.IsCleared ? "btn--ghost" : "btn--primary")" href="@step.ActionUrl">@step.ActionLabel</a>
            </div>
          </article>
        }
      </div>
    </section>
}
