@model DashboardViewModel
@{
    var presentation = Model.Presentation;
    var goal = Model.Dashboard.Goal;
    var cert = Model.Dashboard.Certificate;
}

@* #241 / D21a block 2 of 3: goal standing and feasibility, as FOUR TABULAR CELLS and no progress
   bars. The cells are current level against target, remaining guided hours, pacing comparison and
   the stored verdict. Every figure was measured by the service that owns it; this block prints it.

   #241 removed the "this week" cell's progress bar. The week's execution now lives in block 1, where
   D21a puts it, stated as two numbers - so this block is exactly the four cells and has no fifth. *@
<section class="dashboard-goal" aria-labelledby="dashboard-goal-title">
  <header class="dashboard-goal__header">
    <h2 class="dashboard-goal__title" id="dashboard-goal-title">Goal Standing Â· @cert.Code</h2>
    @* #211: the overall is the weakest measured skill, and the skill that produced it is named
       beside it. An overall with no name lets a learner read a low number and guess. *@
    @if (Model.OverallLevelCode is { } overall)
    {
      <span class="badge badge--muted font-mono">
        OVERALL @overall@(string.IsNullOrEmpty(Model.LimitingSkillName) ? "" : $" Â· {Model.LimitingSkillName}")
      </span>
    }
  </header>

  <table class="dashboard-goal__cells">
    <tbody>
      <tr>
        <th scope="row">Level against target</th>
        <td class="font-mono tabular">@presentation.LevelCell</td>
      </tr>
      <tr>
        <th scope="row">Remaining guided hours</th>
        <td class="font-mono tabular">@presentation.RemainingHoursCell</td>
      </tr>
      <tr>
        <th scope="row">Pacing</th>
        <td class="font-mono tabular">@presentation.PacingCell</td>
      </tr>
      <tr>
        <th scope="row">Verdict</th>
        <td class="tabular">
          @* LRN-15 / U22: the exam date as a date normally, a gold countdown inside 14 days. *@
          @if (goal.TargetDate is not null)
          {
            <span class="dashboard-goal__date@(presentation.IsCountdown ? " dashboard-goal__date--countdown" : "")"
                  id="exam-date">@presentation.TargetDateDisplay</span>
          }
          else
          {
            <span class="dashboard-goal__date dashboard-goal__date--none" id="exam-date">No exam date set</span>
          }
          <span class="badge @presentation.VerdictBadge font-mono" id="feasibility-verdict">@presentation.VerdictLabel</span>
        </td>
      </tr>
    </tbody>
  </table>

  <footer class="dashboard-goal__footer">
    <a class="dashboard-goal__link" href="/placement/target-band">@(goal.TargetBandCode is null ? "Set your target band" : "Change your goal")</a>
    @if (goal.TotalPathSteps > 0)
    {
      <a class="dashboard-goal__link" href="/learning-path">Open your learning path</a>
    }
  </footer>
</section>
