@model DashboardPresentation
@{
    var goal = Model.Dashboard.Goal;
    var cert = Model.Dashboard.Certificate;
    var hasTarget = !string.IsNullOrEmpty(goal.TargetBandCode);
    var hasStanding = goal.CurrentScore.HasValue || !string.IsNullOrEmpty(goal.CurrentBandCode);
}

@* #159: block 2 of 3. "Where do I stand against the goal I set?" - the band pair, the date, and this
   week's planned-vs-done minutes. Every figure is stored; nothing here recomputes a score or a plan. *@
<section class="dashboard-goal" aria-labelledby="dashboard-goal-title">
  <header class="dashboard-goal__header">
    <h2 class="dashboard-goal__title" id="dashboard-goal-title">Goal Standing · @cert.Code</h2>
    @if (!string.IsNullOrEmpty(Model.GoalStatusLabel))
    {
      <span class="badge @Model.GoalStatusBadge font-mono">@Model.GoalStatusLabel</span>
    }
  </header>

  <dl class="dashboard-goal__facts">
    <div class="dashboard-goal__fact">
      <dt>Current band</dt>
      <dd>
        @if (hasStanding)
        {
          <span class="dashboard-goal__figure">@(goal.CurrentBandCode ?? "—")</span>
          @if (goal.CurrentScore.HasValue)
          {
            @* The stored integer is not the number the learner reads: a half-step certificate keeps
               its marks in tenths, so IELTS 8.5 is stored 85. #159 review. *@
            <span class="dashboard-goal__sub font-mono">@ScoreDisplay.Format(goal.CurrentScore.Value, goal.ScoreDisplayFactor) pts</span>
          }
          @if (!string.IsNullOrEmpty(goal.CurrentBandName))
          {
            <span class="dashboard-goal__sub">@goal.CurrentBandName</span>
          }
          @if (goal.CurrentSource == "placement")
          {
            <span class="badge badge--muted text-xs">placement</span>
          }
        }
        else
        {
          <span class="dashboard-goal__figure">—</span>
          <span class="dashboard-goal__sub">Not placed yet. <a href="/placement">Take the free placement test</a></span>
        }
      </dd>
    </div>

    <div class="dashboard-goal__fact">
      <dt>Target band</dt>
      <dd>
        @if (hasTarget)
        {
          <span class="dashboard-goal__figure">@goal.TargetBandCode</span>
          @if (goal.TargetMinScore.HasValue)
          {
            <span class="dashboard-goal__sub font-mono">@goal.TargetMinScore+ pts</span>
          }
          @if (!string.IsNullOrEmpty(goal.TargetBandName))
          {
            <span class="dashboard-goal__sub">@goal.TargetBandName</span>
          }
          <a class="dashboard-goal__link" href="/placement/target-band">Change</a>
        }
        else
        {
          <span class="dashboard-goal__figure">NOT SET</span>
          <a class="dashboard-goal__link" href="/placement/target-band">Set your target band</a>
        }
      </dd>
    </div>

    <div class="dashboard-goal__fact">
      <dt>Exam date</dt>
      <dd>
        @if (goal.TargetDate is not null)
        {
          <span class="dashboard-goal__figure">@Model.TargetDateDisplay</span>
          @if (goal.WeeklyStudyHours.HasValue)
          {
            <span class="dashboard-goal__sub font-mono">@goal.WeeklyStudyHours h/week</span>
          }
        }
        else
        {
          <span class="dashboard-goal__figure">NO DATE</span>
          <span class="dashboard-goal__sub">A date is what makes the plan measurable.</span>
        }
      </dd>
    </div>

    <div class="dashboard-goal__fact">
      <dt>This week</dt>
      <dd>
        <span class="dashboard-goal__figure font-mono">@Model.WeekPaceText</span>
        @if (goal.WeekPlannedMinutes > 0)
        {
          <div class="progress dashboard-goal__progress" role="progressbar"
               aria-label="Minutes done this week" aria-valuenow="@Model.WeekProgressValue"
               aria-valuemin="0" aria-valuemax="100">
            <div class="progress__bar" style="width: @Model.WeekProgressPercent;"></div>
          </div>
        }
        @if (goal.TotalPathSteps > 0)
        {
          <span class="dashboard-goal__sub font-mono">@goal.CompletedPathSteps / @goal.TotalPathSteps path steps done</span>
        }
        <a class="dashboard-goal__link" href="/learning-path">
          @(goal.TotalPathSteps > 0 ? "Open your learning path" : "Build a learning path")
        </a>
      </dd>
    </div>
  </dl>
</section>
