@model DashboardPresentation
@{
    var cert = Model.Dashboard.Certificate;
    var strips = Model.Strips;
    var hasTestedStrips = Model.HasTestedStrips;
}

<link rel="stylesheet" href="~/css/dashboard/weakness-radar.css" asp-append-version="true" />

<section class="card mt-4 weakness-radar" id="dashboard-weakness-radar" aria-label="Weakness radar accuracy matrix">
  <div class="card__header">
    <div class="row row--between row--middle row--wrap">
      <div class="row row--middle">
        <span class="badge badge--info font-mono uppercase font-bold">Weakness Radar</span>
        <strong>Category &amp; Section Accuracy Matrix · @cert.Code</strong>
      </div>
      <div class="row row--middle">
        <a class="btn btn--sm" href="/weakness-analysis">Weakness analysis</a>
      </div>
    </div>
  </div>

  <div class="card__body">
    <div class="weakness-radar__meta-bar">
      @if (hasTestedStrips)
      {
        <p class="text-sm text-muted no-margin">
          Lowest-accuracy categories and sections for <strong>@cert.Name</strong> across practice sessions and graded exams.
        </p>
      }
      else
      {
        <p class="text-sm text-muted no-margin">
          Starter diagnostic syllabus for <strong>@cert.Name</strong>. Complete a free practice session to calibrate your accuracy matrix.
        </p>
      }
      <div class="weakness-radar__legend" aria-label="Severity tier legend">
        <span class="badge badge--danger font-mono text-xs">CRITICAL &lt;50%</span>
        <span class="badge badge--warning font-mono text-xs">BORDER 50–64%</span>
        <span class="badge badge--info font-mono text-xs">STABLE 65–79%</span>
        <span class="badge badge--success font-mono text-xs">MASTERY 80%+</span>
      </div>
    </div>

    @if (strips.Count == 0)
    {
      <div class="p-4 text-center text-muted" style="border: 1px solid var(--line-soft, #ccd2d6);">
        No sections configured for @cert.Code yet. <a href="/practice">Practice by section</a>
      </div>
    }
    else
    {
      <div class="weakness-radar__list" role="list">
        @foreach (var item in strips)
        {
            var source = item;
            var strip = item.Strip;
            var isUntested = source.IsUntested;
            var badgeClass = source.BadgeClass;
            var barClass = source.BarClass;
            var scopeEyebrow = source.ScopeEyebrow;

            <div class="weakness-radar__row" role="listitem">
              <div class="weakness-radar__info">
                <div class="weakness-radar__eyebrow">
                  <span class="badge @badgeClass font-mono text-xs">@strip.Tier</span>
                  <span class="font-mono text-xs text-muted uppercase">@scopeEyebrow</span>
                </div>
                <strong class="weakness-radar__name">@strip.Name</strong>
              </div>

              <div class="weakness-radar__telemetry">
                <div class="weakness-radar__counts">
                  @if (isUntested)
                  {
                    <span class="font-mono text-xs text-muted uppercase">Not attempted yet</span>
                    <span class="font-mono text-xs text-muted tabular-nums">0 / 0 correct</span>
                  }
                  else
                  {
                    <span class="font-mono font-bold text-base tabular-nums">@strip.AccuracyPercent%</span>
                    <span class="font-mono text-xs text-muted tabular-nums">@strip.Correct / @strip.Answered correct</span>
                  }
                </div>
                <div class="progress weakness-radar__progress"
                     role="progressbar"
                     aria-label="@strip.Name accuracy"
                     aria-valuenow="@strip.AccuracyPercent"
                     aria-valuemin="0"
                     aria-valuemax="100">
                  <div class="progress__bar @barClass" style="width: @(isUntested ? 0 : strip.AccuracyPercent)%;"></div>
                </div>
              </div>

              <div class="weakness-radar__action">
                <a class="btn btn--sm @(strip.Tier == "CRITICAL" || isUntested ? "btn--primary" : "")"
                   href="@strip.ActionUrl">@strip.ActionLabel</a>
              </div>
            </div>
        }
      </div>
    }
  </div>
</section>

