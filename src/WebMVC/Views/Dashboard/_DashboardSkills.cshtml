@model DashboardViewModel
@{
    var table = Model.Skills;
    var cert = Model.Dashboard.Certificate;
}

@* #241 / D21a block 3 of 3: per-skill standing, one column per EXAMINED SKILL.

   The column count is the certificate's own (Model.Skills.ColumnCount), rendered as a class so CSS
   has no fixed four-track template. A two-skill certificate is two columns; it is never a
   four-column grid with two empty cells. That is why this is a table and not a card grid: a
   `repeat(auto-fit, minmax(...))` grid silently accepts a fourth track, and a table's header is the
   certificate's own list, so a skill the paper does not examine has no column to leave empty.

   LRN-18: an unmeasured skill is attention (sign gold), never a low band and never grey. #211 keeps
   it absent from the stored vector rather than present at A1, and this renders that absence as a
   sentence - "not measured yet" - not as a figure. *@
<section class="dashboard-skills" aria-labelledby="dashboard-skills-title">
  <header class="dashboard-skills__header">
    <h2 class="dashboard-skills__title" id="dashboard-skills-title">Per-Skill Standing · @cert.Code</h2>
    <span class="badge badge--muted font-mono">@table.ColumnCount @(table.ColumnCount == 1 ? "SKILL" : "SKILLS")</span>
  </header>

  @if (table.IsEmpty)
  {
    <p class="text-muted no-margin dashboard-skills__empty">
      @cert.Name has no skills configured yet, so there is nothing to show here.
      <a href="@Model.Presentation.CertificateUrl">See what @cert.Code tests</a>
    </p>
  }
  else
  {
    <table class="@Model.Presentation.SkillsGridClass" id="skill-standing">
      <thead>
        <tr>
          @foreach (var column in table.Columns)
          {
            <th scope="col" class="skill-standing__head">
              <span class="skill-standing__code font-mono">@column.Code</span>
              <span class="skill-standing__name">@column.Name</span>
            </th>
          }
        </tr>
      </thead>
      <tbody>
        <tr>
          @foreach (var column in table.Columns)
          {
            <td class="@column.RowClass" data-skill-id="@column.SkillId">
              @if (column.IsMeasured)
              {
                <span class="skill-standing__level font-mono tabular">@column.Level</span>
                @* LRN-19: a position, never a bare percentage - crossing a band resets it downward. *@
                <span class="skill-standing__position font-mono tabular">@column.PositionText</span>
                @if (column.HasMeasurementDate)
                {
                  <span class="skill-standing__date">measured @column.MeasuredAt!.Value.ToString("d MMM yyyy")</span>
                }
                @if (column.IsStale)
                {
                  <span class="badge badge--warning font-mono text-xs">Needs re-measuring</span>
                }
              }
              else
              {
                @* Never "A1", never a dash. The words are the state. *@
                <span class="skill-standing__unmeasured">Not measured yet</span>
                <a class="skill-standing__action" href="/placement">Measure @column.Name</a>
              }
            </td>
          }
        </tr>
      </tbody>
    </table>
  }
</section>
