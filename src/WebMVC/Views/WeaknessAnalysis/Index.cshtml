@model WebMVC.Models.WeaknessAnalysisViewModel
@{
    Layout = "_LearnerLayout";
    ViewData["Title"] = "Weakness analysis";
    ViewData["Description"] = "Deterministic accuracy across sections and categories from practice and mock exams.";
    var data = Model.Data;
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/dashboard" class="breadcrumbs__item">Home</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Weakness analysis</span>
</nav>

<div class="row row--between row--wrap">
  <div>
    <h1 class="m-0 mb-1">Weakness analysis</h1>
    <p class="text-sm text-muted no-margin">
      Combined from @data.GradedExamCount @(data.GradedExamCount == 1 ? "graded exam" : "graded exams") and @data.CompletedPracticeCount @(data.CompletedPracticeCount == 1 ? "practice session" : "practice sessions").
    </p>
  </div>
  <span class="badge badge--success">Free</span>
</div>

@if (TempData["SuccessMessage"] is string successMsg)
{
  <div class="alert alert--success mt-4" role="status">@successMsg</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
  <div class="alert alert--danger mt-4" role="alert">@Model.ErrorMessage</div>
}

@if (!data.HasData)
{
  @if (Model.InsightPanel.Insight != null)
  {
    <partial name="_AiInsightPanel" model='Model.InsightPanel' />
  }
  <!-- Empty state: not enough data to analyse -->
  <div class="card mt-4">
    <div class="card__body">
      <div class="state-block">
        <div class="state-block__icon" aria-hidden="true">EMPTY</div>
        <div class="state-block__title">Not enough data to analyse</div>
        <p class="state-block__desc">
          At least one completed practice session or one graded exam is required. Practicing any single section gives you results right away — <strong>free, no credit deducted</strong>.
        </p>
        <div class="row row--center mt-3">
          <a class="btn btn--primary btn--lg" href="/practice">Practice a section</a>
          <a class="btn btn--lg" href="/exams">Take a mock exam</a>
        </div>
      </div>
    </div>
  </div>
}
else
{
  <div class="alert alert--info mt-4">
    This is a study tool, not an exam result. The figures come from every question you have answered, including practice sessions.
  </div>

  <partial name="_AiInsightPanel" model='Model.InsightPanel' />

  @* #243 / D3: the topic axis, which is the product's own unit. The section axis below survives for
     mock exams; this block is what answers "which topic at which level is my weakest", and it says so
     in words so the ranking is never carried by the ordering alone. *@
  <div class="card mt-4" id="topic-weakness">
    <div class="card__header"><strong>Weakest topic at its level</strong></div>
    <div class="card__body stack">
      @if (Model.WeakestTopic is not null)
      {
        <p class="text-sm no-margin">
          <strong>@Model.WeakestTopic.TopicCode — @Model.WeakestTopic.TopicName</strong>
          <span class="badge ml-1">@Model.WeakestTopic.LevelLabel</span>
          <span class="badge badge--danger ml-1">Weakest</span>
        </p>
        <p class="text-sm text-muted no-margin">
          <span class="font-mono">@Model.WeakestTopic.AccuracyPercent%</span>
          · @Model.WeakestTopic.EvidenceNote
        </p>
        @if (Model.WeakestTopic.LessonHref is not null)
        {
          <div class="row mt-2">
            <a class="btn btn--sm" href="@Model.WeakestTopic.LessonHref">Read the lesson for this cell</a>
          </div>
        }
      }
      else
      {
        @* #243: nothing is rankable. Not "your weakest is the least bad cell", and not a fabricated
           percentage - the reason in words, and the honest next step. *@
        <p class="text-sm text-muted no-margin" id="no-ranked-weakness">
          No topic holds enough answers to be called a weakness yet. A cell is ranked at 12 answers in
          listening and reading, or 3 tasks in speaking and writing, so one short session cannot name
          your weakest topic.
        </p>
      }

      @if (Model.TopicRows.Count > 0)
      {
        <table class="table mt-3">
          <caption class="text-sm text-muted">Every topic at a level you have answered in. Ranked cells come first.</caption>
          <thead>
            <tr>
              <th scope="col">Topic</th>
              <th scope="col">Level</th>
              <th scope="col">Skill</th>
              <th scope="col">Accuracy</th>
              <th scope="col">Evidence</th>
              <th scope="col">Lesson</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var c in Model.TopicRows)
            {
              <tr data-topic-id="@c.TopicId">
                <td>
                  <strong>@c.TopicCode</strong> @c.TopicName
                  @if (c.IsWeakest)
                  {
                    @* Not colour alone: the badge is a word, and the caption above states the order. *@
                    <span class="badge badge--danger ml-1">Weakest</span>
                  }
                </td>
                <td><span class="badge">@c.LevelLabel</span></td>
                <td>@c.ModalityLabel</td>
                <td class="font-mono">@c.AccuracyPercent%</td>
                <td class="text-muted">@c.EvidenceNote</td>
                <td>
                  @if (c.LessonHref is not null)
                  {
                    <a href="@c.LessonHref">Review the rule</a>
                  }
                  else
                  {
                    <span class="text-muted">No lesson yet</span>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>

  <div class="card mt-4">
    <div class="card__header"><strong>Accuracy by section</strong></div>
    <div class="card__body stack">
      <p class="text-sm text-muted no-margin">
        Sorted weakest first. The "questions" column is the total number of questions answered, across both exams and practice.
      </p>

      @foreach (var s in data.Sections)
      {
        <div>
          <div class="row row--between text-sm">
            <span>
              <strong>@data.Certificate.SectionNoun @s.Code — @s.Name</strong>
              @if (s.IsWeakest)
              {
                <span class="badge badge--danger ml-1">Weakest</span>
              }
              else if (s.IsStrongest)
              {
                <span class="badge badge--success ml-1">Strongest</span>
              }
            </span>
            <span class="text-muted">
              @if (s.Answered > 0)
              {
                <span>@s.AccuracyPercentage% · @s.Correct/@s.Answered questions</span>
              }
              else
              {
                <span>Not attempted yet</span>
              }
            </span>
          </div>
          <div class="progress mt-1">
            <div class="progress__bar @Model.SectionBarClasses[s.SectionId]" style="width: @(s.Answered > 0 ? s.AccuracyPercentage : 0)%" role="progressbar" aria-valuenow="@s.AccuracyPercentage" aria-valuemin="0" aria-valuemax="100"></div>
          </div>
        </div>
      }
    </div>
  </div>

  <div class="grid-2 mt-4">
    <div class="card">
      <div class="card__header"><strong>What to practice first</strong></div>
      <div class="card__body stack">
        @if (data.PriorityPracticeSection is not null)
        {
          <p class="text-sm text-muted no-margin">
            @data.Certificate.SectionNoun @data.PriorityPracticeSection.Code sits at your lowest accuracy level (@data.PriorityPracticeSection.AccuracyPercentage%). This is where you can improve your score fastest.
          </p>
          <div class="row mt-2">
            <a class="btn btn--primary" href="/practice">Practice @data.Certificate.SectionNoun @data.PriorityPracticeSection.Code now</a>
            <a class="btn btn--sm" href="/saved-questions?sectionId=@data.PriorityPracticeSection.SectionId">View saved questions in @data.Certificate.SectionNoun @data.PriorityPracticeSection.Code</a>
          </div>
        }
        else
        {
          <p class="text-sm text-muted no-margin">
            Keep practicing across all sections to uncover your target areas for improvement.
          </p>
          <div class="row mt-2">
            <a class="btn btn--primary" href="/practice">Practice now</a>
          </div>
        }
      </div>
    </div>

    <div class="card">
      <div class="card__header"><strong>Frequently missed question types</strong></div>
      <div class="card__body">
        @if (data.FrequentlyMissedCategories.Count > 0)
        {
          <ul class="m-0 pl-5">
            @foreach (var cat in data.FrequentlyMissedCategories)
            {
              <li class="mb-1">
                <strong>@cat.Name</strong>: @cat.AccuracyPercentage% (@cat.Correct/@cat.Answered correct@(cat.Answered > cat.Correct ? $", {cat.Answered - cat.Correct} missed" : ""))
              </li>
            }
          </ul>
          <p class="text-sm text-muted mt-3 no-margin">
            Grouped by the question-type label each question carries, across exams and practice.
          </p>
        }
        else
        {
          <p class="text-sm text-muted no-margin">
            No question category weaknesses detected yet.
          </p>
        }
      </div>
    </div>
  </div>
}

<div class="card mt-4" id="recommendations-card">
    <div class="card__header">
      <strong>Recommendations</strong>
    </div>
    <div class="card__body stack" id="recommendations-list">
      <p class="text-sm text-muted no-margin">
        Actionable recommendations from your study history. Open items remain until marked resolved.
      </p>

      @if (data.Recommendations.Count > 0)
      {
        @foreach (var reco in data.Recommendations)
        {
          <div class="p-3 border stack reco-item" id="reco-@reco.RecId">
            <div class="row row--between">
              <div class="row">
                @if (reco.Severity == RecommendationSeverityDto.Major)
                {
                  <span class="badge badge--danger">Priority</span>
                }
                else if (reco.Severity == RecommendationSeverityDto.Minor)
                {
                  <span class="badge badge--warning">Suggestion</span>
                }
                else
                {
                  <span class="badge badge--info">Tip</span>
                }
                @if (!string.IsNullOrEmpty(reco.TargetBandCode))
                {
                  <span class="badge ml-1">Target @reco.TargetBandCode</span>
                }
                @if (!string.IsNullOrEmpty(reco.SkillName))
                {
                  <span class="text-sm text-muted ml-1">(@reco.SkillName)</span>
                }
              </div>
              <form method="post" action="/weakness-analysis/recommendations/@reco.RecId/resolve" class="no-margin js-resolve-form" data-reco-id="@reco.RecId">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn--sm">Mark resolved</button>
              </form>
            </div>
            <div class="text-sm mt-1">@reco.Text</div>
          </div>
        }
      }
      else
      {
        <div class="p-4 text-center text-muted border" id="no-recos-message">
          All recommendations resolved. Great work!
        </div>
      }
    </div>
  </div>

<script src="~/js/weakness-analysis/index.js" asp-append-version="true"></script>
