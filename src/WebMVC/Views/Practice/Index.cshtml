@model PracticeCatalogViewModel
@{
    Layout = "_LearnerLayout";
    ViewData["Title"] = "Practice by section";
    ViewData["Description"] = "Ten questions per session, chosen by what you have not mastered yet.";
    var catalog = Model.Catalog;
}

<div class="row row--between">
  <div>
    <h1 class="m-0 mb-1">Practice</h1>
    <p class="text-muted no-margin">
      Smart Practice gives you <strong>ten questions</strong>, drawn from the topics you have not mastered yet.
      You never pick the count or the source: a topic you just answered wrongly rests for <strong>24 hours</strong>,
      so you cannot make a miss disappear by clicking it again.
      <strong>Free, no credit deducted.</strong> A written answer is checked against the question's word limit
      and required keywords. A spoken answer is given by voice, so those sections link to their own recorded
      practice, graded by AI for 1 credit.
    </p>
  </div>
</div>

@* #159: five sidebar items means this page has to be the way on to the rest, not a leaf. Every
   door the old seventeen-item rail carried is still one click from here. *@
<nav class="row row--wrap" aria-label="More practice tools">
  <a class="btn btn--sm" href="/weakness-analysis">Weakness analysis</a>
  <a class="btn btn--sm" href="/saved-questions">Saved questions</a>
  <a class="btn btn--sm" href="/exams/history">Exam history</a>
  <a class="btn btn--sm" href="/learning-path">My learning path</a>
  <a class="btn btn--sm" href="/placement">Placement test</a>
  <a class="btn btn--sm" href="/mentors">Find a mentor</a>
  <a class="btn btn--sm" href="/certificates">Certificates</a>
</nav>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
  <div class="alert alert--danger" role="alert">@Model.ErrorMessage</div>
}

@if (catalog.UnfinishedSession is { } unfinished)
{
  <div class="alert alert--info row row--between row--middle row--wrap" role="status">
    <div>
      <strong>Unfinished practice:</strong> You have an in-progress session in <strong>@unfinished.SectionName</strong> started @Model.UnfinishedStartedAtDisplay.
      <div class="text-sm text-muted">@unfinished.CorrectCount of @unfinished.QuestionCount questions answered so far.</div>
    </div>
    <a class="btn btn--primary btn--sm" href="/practice/@unfinished.SessionId">Resume drill <span aria-hidden="true">&rarr;</span></a>
  </div>
}

@if (catalog.WeakestSection is { } weakest && weakest.AccuracyPercentage.HasValue)
{
  <div class="alert alert--info">
    <strong>@weakest.Name is your weakest section</strong> at @weakest.AccuracyPercentage% accuracy — start there to improve your score fastest.
  </div>
}

@if (!Model.HasAnySections)
{
  <div class="card"><div class="card__body">
    <div class="state-block">
      <div class="state-block__icon" aria-hidden="true">EMPTY</div>
      <h2 class="state-block__title">No questions to practice yet</h2>
      <p class="state-block__desc">
        The practice question bank is being updated. You can still take a full mock exam, or come back later.
      </p>
      <div class="row row--center">
        <a class="btn btn--primary" href="/certificates">View certificates</a>
        <a class="btn" href="/dashboard">Back to home</a>
      </div>
    </div>
  </div></div>
}
else
{
  @if (catalog.ListeningSections.Count > 0)
  {
    <div class="mt-4">
      <partial name="_AudioEquipmentCheck" model='Model.AudioCheck' />
    </div>
  }

  @* #150: the form is only meaningful when a section button is inside it. A Speaking-only
     certificate has none - it links to its recorded practice below instead. *@
  @if (Model.HasDrillableSections)
  {
  <form method="post" action="/practice/start" id="practice-form">
    @Html.AntiForgeryToken()
    @* #155: one button, no count, no source. The ten questions are the mastery planner's decision. *@
    <div class="card">
      <div class="card__body">
        <h2 class="h4 m-0 mb-1">Smart Practice &mdash; 10 questions</h2>
        <p class="text-sm text-muted no-margin">
          Chosen by what is due for revision: up to 4 questions you have met before, and the rest new ones from the same topics.
        </p>
      </div>
    </div>

    @* #161: one group per skill the certificate actually has, named by the skill. The page used to
       carry a literal "Listening" heading and a literal "Reading" one, so a certificate whose skills
       are Comprehension and Expression rendered two headings that named neither. *@
    @foreach (var group in Model.DrillableSectionGroups)
    {
      <section class="mt-4">
        <h2 class="section-group__title">@group.Name</h2>
        <div class="grid-2">
          @foreach (var sec in group.Sections)
          {
            ViewData["NextReviewDue"] = Model.NextReviewDueDisplay;
            <partial name="_PracticeSectionCard" model="sec" />
          }
        </div>
      </section>
    }
  </form>
  }

  @if (Model.SpeakingSections.Count > 0)
  {
    <section class="mt-4">
      <h2 class="section-group__title">@Model.SpeakingSectionName</h2>
      <div class="grid-2">
        @foreach (var sec in Model.SpeakingSections)
        {
          @* #150: a spoken answer cannot be typed, so this is not a drill button. It links to the
             recorded, AI-graded speaking practice whose exam the catalog named. *@
          <div class="part-card">
            <div class="part-card__header">
              <strong>@sec.Code</strong>
              @if (Model.SpeakingPracticeExamId.HasValue)
              {
                <span class="badge badge--muted">Recorded + AI</span>
              }
              else
              {
                <span class="badge badge--warning">No practice exam yet</span>
              }
            </div>
            <p class="part-card__desc">@sec.Name</p>
            <div class="part-card__meta">
              @if (Model.SpeakingPracticeExamId.HasValue)
              {
                <a class="btn btn--primary btn--sm" href="/speaking/@Model.SpeakingPracticeExamId/instructions">
                  Practise speaking <span aria-hidden="true">&rarr;</span>
                </a>
              }
              else
              {
                <span>Answered by voice. Practice opens once a speaking practice exam is published.</span>
              }
            </div>
          </div>
        }
      </div>
    </section>
  }
}
