@model PracticeSectionDto
@using Contracts
@*
  #155: a section card that says, when it needs to, that it is resting.
  The button stays, because a section is not "closed" while one of its topics is due - the whole
  category would have to be in cooldown for that. Saying so up front is the difference between
  "the system refused me for no reason" and "this topic is being rested until 09:00".
*@
@{
    var allResting = Model.TotalCategoryCount > 0 && Model.CategoriesInCooldown >= Model.TotalCategoryCount;

    // The controller formats every cooldown instant in the learner's zone; this only reads it.
    // Falling back keeps a card rendered without that dictionary readable rather than blank.
    string NextReviewDue(int sectionId, DateTimeOffset instant) =>
        ViewData["NextReviewDue"] is IReadOnlyDictionary<int, string> formatted
            && formatted.TryGetValue(sectionId, out var text)
                ? text
                : instant.UtcDateTime.ToString("HH:mm 'UTC' dd MMM");
    var badgeClass = Model.AccuracyPercentage is < 60 ? "badge--danger" : "badge--muted";
}
<button type="submit" name="SectionId" value="@Model.SectionId" class="part-card text-left w-100">
  <div class="part-card__header">
    <strong>@Model.Code</strong>
    @if (allResting)
    {
      <span class="badge badge--warning">Rested</span>
    }
    else if (Model.AccuracyPercentage.HasValue)
    {
      <span class="badge @badgeClass">@Model.AccuracyPercentage%</span>
    }
    else
    {
      <span class="badge badge--muted">Not taken</span>
    }
  </div>
  <p class="part-card__desc">@Model.Name</p>
  <div class="part-card__meta">
    @if (allResting && Model.NextReviewDueAt is { } due)
    {
      @* Cooldown is the point of the ticket, so the learner is told the moment it lifts rather than
         finding an empty session. The instant is formatted in the learner's own zone by the controller
         - printing it as UTC told a UTC+7 learner a time seven hours in the past. *@
      <span>All topics resting &mdash; next due @(NextReviewDue(Model.SectionId, due))</span>
    }
    else if (Model.CategoriesInCooldown > 0 && Model.NextReviewDueAt is { } next)
    {
      <span>@Model.CategoriesInCooldown of @Model.TotalCategoryCount topics resting &mdash; next due @(NextReviewDue(Model.SectionId, next))</span>
    }
    else
    {
      <span>@Model.AvailableQuestionCount questions available</span>
    }
  </div>
</button>
