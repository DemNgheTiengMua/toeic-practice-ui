@model PracticeTakeViewModel
@{ var q = Model.Take.Question; }
              <div id="transcript-drawer" class="transcript-drawer mt-2" style="display: none;">
                <span class="text-xs uppercase text-muted font-sign" style="display:block; margin-bottom: 0.25rem; font-weight:700;">Transcript / Lời thoại:</span>
                <p id="transcript-drawer-text" class="no-margin" style="white-space: pre-line; font-size: 0.95rem;">@(q.Transcript ?? "")</p>
              </div>
