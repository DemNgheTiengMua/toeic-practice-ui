@model Contracts.PracticeSummaryDto
@inject WebMVC.DateTimeFormatter Dates
@{
    Layout = "_LearnerLayout";
    ViewData["Title"] = $"Practice summary — {Model.SectionName}";
    ViewData["Description"] = "Results and review of your practice session.";
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/dashboard" class="breadcrumbs__item">Home</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/practice" class="breadcrumbs__item">Practice by section</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Session summary</span>
</nav>

<div class="row row--between">
  <div>
    <h1 class="m-0 mb-1">Practice session summary</h1>
    <p class="text-sm text-muted no-margin">
      @Model.SectionName · @Model.TotalQuestions questions · @Dates.Format(Model.StartedAt)
    </p>
  </div>
  <div class="row">
    <a class="btn btn--ghost" href="/saved-questions">Saved questions bank</a>
    <a class="btn" href="/practice">Choose another section</a>
    <a class="btn btn--primary" href="/practice">Practice more questions</a>
  </div>
</div>

<div class="grid-3 mt-4">
  <div class="stat">
    <div class="stat__label">Correct</div>
    <div class="stat__value" style="color: var(--color-success)">@Model.CorrectCount</div>
    <div class="stat__hint">
      out of @Model.AnsweredCount answered · @Model.AccuracyPercentage% accuracy
      @if (Model.CorrectWithHintCount > 0)
      {
        <span>· @Model.CorrectWithHintCount with a hint</span>
      }
    </div>
  </div>
  <div class="stat">
    <div class="stat__label">Incorrect</div>
    <div class="stat__value" style="color: var(--color-danger)">@Model.IncorrectCount</div>
    <div class="stat__hint">
      @if (Model.IncorrectCount > 0)
      {
        <span>saved to your <a href="/saved-questions" style="color: var(--sign-blue); font-weight: 600;">saved questions bank</a></span>
      }
      else
      {
        <span>No incorrect answers · great job!</span>
      }
    </div>
  </div>
  <div class="stat">
    <div class="stat__label">Skipped</div>
    <div class="stat__value">@Model.SkippedCount</div>
    <div class="stat__hint">not counted in accuracy rate</div>
  </div>
</div>

@if (Model.HintUsedCount > 0)
{
  <div class="alert alert--info mt-4">
    You used a hint on <strong>@Model.HintUsedCount</strong> of @Model.TotalQuestions questions
    (@Model.CorrectWithHintCount correct with a hint). Try the next set without hints to see your true baseline!
  </div>
}

<partial name="_AiInsightPanel" model='new WebMVC.Models.AiInsightPanelViewModel("practice_session", Model.SessionId, ViewBag.Insight as Contracts.AiInsightDto)' />

<div class="card mt-4">
  <div class="card__header">
    <div class="row row--between row--wrap">
      <strong>Questions review</strong>
      <span class="text-sm text-muted">@Model.Questions.Count questions (@Model.CorrectCount correct, @Model.IncorrectCount incorrect, @Model.SkippedCount skipped)</span>
    </div>
  </div>
  <div class="card__body p-0">
    <table class="table table--striped" style="margin-bottom: 0;">
      <caption class="visually-hidden">Detailed question review for this practice session</caption>
      <thead>
        <tr>
          <th scope="col" style="width: 120px;"># & Status</th>
          <th scope="col" style="width: 38%;">Question</th>
          <th scope="col" style="width: 32%;">Answer Result</th>
          <th scope="col" style="width: 30%;">Explanation</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var q in Model.Questions)
        {
          <tr>
            <td style="vertical-align: top;">
              <div class="stack" style="gap: var(--space-1); align-items: flex-start;">
                <span style="font-family: var(--font-data); font-weight: 700; font-size: 15px;">#@q.DisplayOrder</span>
                @if (q.IsCorrect == true)
                {
                  <span class="badge badge--success">Correct</span>
                }
                else if (q.IsCorrect == false)
                {
                  <span class="badge badge--danger">Incorrect</span>
                }
                else
                {
                  <span class="badge badge--muted">Skipped</span>
                }
                @if (q.HintUsed)
                {
                  <span class="badge badge--warning text-xs">Hint used</span>
                }
                <a href="/practice/@Model.SessionId?q=@q.DisplayOrder" class="text-xs mt-1" style="font-weight: 600; color: var(--sign-blue);">Read in test ›</a>
              </div>
            </td>
            <td style="vertical-align: top;">
              @if (!string.IsNullOrEmpty(q.CategoryName))
              {
                <span class="badge badge--muted text-xs mb-1" style="display: inline-block;">@q.CategoryName</span>
              }
              <div class="question-stem text-sm" style="line-height: 1.6; color: var(--ink); white-space: pre-wrap;">@q.Stem</div>
            </td>
            <td style="vertical-align: top;">
              @if (q.IsCorrect == true)
              {
                <div class="stack" style="gap: var(--space-1);">
                  <div>
                    <span class="badge badge--success" style="white-space: normal; text-align: left; line-height: 1.4;">✓ @q.CorrectOptionLabel — @q.CorrectOptionText</span>
                  </div>
                  <span class="text-xs text-muted">Your answer · Correct</span>
                </div>
              }
              else if (q.IsCorrect == false)
              {
                <div class="stack" style="gap: var(--space-2);">
                  <div>
                    <div class="text-xs uppercase text-muted mb-1" style="font-weight: 700; letter-spacing: 0.04em;">Your choice:</div>
                    <span class="badge badge--danger" style="white-space: normal; text-align: left; line-height: 1.4;">✗ @q.SelectedOptionLabel — @q.SelectedOptionText</span>
                  </div>
                  <div>
                    <div class="text-xs uppercase text-muted mb-1" style="font-weight: 700; letter-spacing: 0.04em;">Correct answer:</div>
                    <span class="badge badge--success" style="white-space: normal; text-align: left; line-height: 1.4;">✓ @q.CorrectOptionLabel — @q.CorrectOptionText</span>
                  </div>
                </div>
              }
              else
              {
                <div class="stack" style="gap: var(--space-2);">
                  <div>
                    <span class="badge badge--muted">Skipped</span>
                  </div>
                  <div>
                    <div class="text-xs uppercase text-muted mb-1" style="font-weight: 700; letter-spacing: 0.04em;">Correct answer:</div>
                    <span class="badge badge--success" style="white-space: normal; text-align: left; line-height: 1.4;">✓ @q.CorrectOptionLabel — @q.CorrectOptionText</span>
                  </div>
                </div>
              }
            </td>
            <td style="vertical-align: top;">
              @if (!string.IsNullOrEmpty(q.Explanation))
              {
                <details>
                  <summary class="text-sm" style="font-weight: 600; color: var(--sign-blue); cursor: pointer; text-decoration: underline;">
                    Why @q.CorrectOptionLabel is correct
                  </summary>
                  <div class="explain mt-2" style="margin-top: var(--space-2); padding: var(--space-2) var(--space-3); border-left: 3px solid var(--sign-blue); background: var(--color-surface); font-size: var(--text-sm);">
                    <p class="no-margin">@q.Explanation</p>
                  </div>
                </details>
              }
              else
              {
                <span class="text-muted text-sm">—</span>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
