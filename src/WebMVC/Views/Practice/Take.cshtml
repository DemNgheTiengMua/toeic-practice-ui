@model PracticeTakeViewModel
@{
    Layout = null;
    var session = Model.Take.Session;
    var q = Model.Take.Question;
    var questions = Model.Take.Questions;
    var isFinished = Model.Take.IsFinished;
    var totalCount = Model.Take.TotalCount;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Practice @session.SectionName — Question @q.DisplayOrder — extra efficient</title>
  <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="~/css/tokens.css">
  <link rel="stylesheet" href="~/css/base.css">
  <link rel="stylesheet" href="~/css/components.css">
  <link rel="stylesheet" href="~/css/practice/take.css" asp-append-version="true">
</head>
<body class="exam-body-protected">
  <div class="app-shell">
@await Html.PartialAsync("_TakeTopbar", Model)


    <main class="app-main">
      <div class="container" style="max-width: 1200px">
        <form id="anti-forgery-holder" style="display:none;">@Html.AntiForgeryToken()</form>

        <script id="practice-data" type="application/json" data-session-id="@session.SessionId" data-total-questions="@totalCount" data-finished="@(isFinished ? "true" : "false")" data-initial-order="@q.DisplayOrder">@Html.Raw(Model.Take.QuestionsJson)</script>

        <div id="ajax-error-alert" class="alert alert--danger mb-4" style="display: none;" role="alert"></div>

        <div class="exam-layout">
@await Html.PartialAsync("_TakeQuestion", Model)
@await Html.PartialAsync("_TakeSidebar", Model)

        </div>
      </div>
    </main>
  </div>

@await Html.PartialAsync("_TakeControls", Model)
  <!-- Toast Notification Container -->
  <div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true"></div>

  <script src="~/js/icons.js"></script>
  <script src="~/js/ee-audio.js"></script>
  <script src="~/js/exam-audio.js"></script>
  <script src="~/js/practice/take.js" asp-append-version="true"></script>
</body>
</html>
