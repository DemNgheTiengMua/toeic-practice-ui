@model PracticeTakeViewModel
@{
    var q = Model.Take.Question;
    var isCurrentAnswered = Model.Take.IsCurrentAnswered;
}
              <div id="explanation-container" class="mt-4">
                @if (isCurrentAnswered && (!string.IsNullOrEmpty(q.Explanation) || !string.IsNullOrEmpty(q.AcceptedAnswersJson) || !string.IsNullOrEmpty(q.Transcript)))
                {
                  <div class="accordion-explanation" id="accordion-explanation">
                    <button type="button" class="accordion-explanation__header" id="btn-toggle-explanation" aria-expanded="true">
                      <span>[Xem Lời giải chi tiết / Explanation & Rationale]</span>
                      <span id="exp-chevron">[-]</span>
                    </button>
                    <div class="accordion-explanation__body" id="explanation-body">
                      @* #238 / U18: the level is named here, and only here — after the answer has
                         locked. It arrives in the payload only for a locked question, so this is the
                         reveal, not a hidden span. *@
                      @if (Model.Take.RevealedLevelCode is { } revealedLevel)
                      {
                        <div id="revealed-level" class="mb-2">
                          <span class="badge badge--muted">Item level &middot; <span class="font-mono">@revealedLevel</span></span>
                        </div>
                      }
                      @if (!string.IsNullOrEmpty(q.Explanation))
                      {
                        @* #238: "bound to its evidence" — the heading names the option the rationale
                           explains, so the paragraph is not free-floating. A free response has no
                           option to name and prints the rationale alone. *@
                        <div class="font-sign uppercase text-xs mb-1" style="font-weight:700;">
                          @if (Model.Take.ExplanationSubjectLabel is { } subjectLabel)
                          {
                            <text>Why @subjectLabel is correct</text>
                            @if (Model.Take.ExplanationSubjectText is { } subjectText)
                            {
                              <text> &mdash; @subjectText</text>
                            }
                          }
                          else
                          {
                            <text>Giải thích chi tiết:</text>
                          }
                        </div>
                        <p class="no-margin" style="white-space: pre-line;">@q.Explanation</p>
                      }
                      @if (!string.IsNullOrEmpty(q.AcceptedAnswersJson))
                      {
                        <div class="mt-3">
                          <span class="font-sign uppercase text-xs text-muted" style="display:block; margin-bottom: 0.25rem; font-weight:700;">Đáp án chấp nhận / Accepted answers:</span>
                          <code class="font-mono" style="padding: 0.25rem 0.5rem; background: #f4f6f8; border: 1px solid #ccd2d6; display: inline-block;">@q.AcceptedAnswersJson</code>
                        </div>
                      }
                      @if (!string.IsNullOrEmpty(q.Transcript))
                      {
                        <div class="explain__transcript mt-3 pt-2" style="border-top: 1px dashed #ccd2d6;">
                          <strong class="font-sign uppercase text-xs">Transcript:</strong> <span style="white-space: pre-line;">@q.Transcript</span>
                        </div>
                      }
                    </div>
                  </div>
                }
              </div>

