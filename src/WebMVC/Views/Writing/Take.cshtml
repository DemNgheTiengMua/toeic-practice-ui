@model WritingTakeViewModel
@{
    Layout = null;
    var take = Model.Take;
    var q = take.Question;
    ViewData["Title"] = $"Writing — Question {take.CurrentQuestionIndex} of {take.TotalQuestions}";
    ViewData["Description"] = $"Writing attempt {take.AttemptId} on {take.ExamName}.";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@ViewData["Title"] — extra efficient</title>
  <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="~/css/tokens.css">
  <link rel="stylesheet" href="~/css/base.css">
  <link rel="stylesheet" href="~/css/components.css">
  <link rel="stylesheet" href="~/css/writing/take.css" asp-append-version="true">
</head>
<body>
  <div class="app-shell">
    <header class="app-topbar">
      <div class="exam-topbar-group">
        <strong>@take.ExamName</strong>
        <span class="badge badge--info">Question @take.CurrentQuestionIndex of @take.TotalQuestions</span>
      </div>
      <div class="exam-topbar-group">
        <span id="save-status-text" class="save-status save-status--saved" role="status" aria-live="polite">
          @(q.DraftSavedAt.HasValue ? $"Saved {q.DraftSavedAt.Value:HH:mm:ss}" : "Draft ready")
        </span>
        <span class="timer" role="timer" aria-label="Time remaining">
          <span class="text-sm text-muted">Time left</span>
          <span id="timer-display" class="timer__value" data-remaining="@take.RemainingSeconds">--:--</span>
        </span>
      </div>
    </header>

    <main class="app-main">
      <div class="writing-container container stack">
        @Html.AntiForgeryToken()

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
          <div class="alert alert--danger mb-3" role="alert">@Model.ErrorMessage</div>
        }

@await Html.PartialAsync("_TakeEditor", Model)

<!-- Question Navigator -->
<div class="mt-4">
  <div class="card">
    <div class="card__header">
      <div class="row row--between">
        <strong class="text-sm">Questions navigator</strong>
        <span class="text-xs text-muted">
          @Model.AnsweredCount of @take.TotalQuestions answered
        </span>
      </div>
    </div>
    <div class="card__body">
      <div class="navigator navigator--strip" role="group" aria-label="Questions list">
        @foreach (var nav in take.Questions)
        {
          <a href="/writing/take/@take.AttemptId?q=@nav.QuestionId"
             class="navigator__cell @Model.NavigatorClasses[nav.QuestionId]"
             aria-label="Question @nav.DisplayOrder (@(nav.IsAnswered ? "Answered" : "Unanswered"))"
             data-question-id="@nav.QuestionId">
            @nav.DisplayOrder
          </a>
        }
      </div>
    </div>
  </div>
</div>



<!-- Submit Confirmation Modal -->
<div id="submit-modal" class="modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="submit-modal-title">
  <div class="modal">
    <div class="modal__header">
      <h2 id="submit-modal-title" class="no-margin">Finish & Submit Writing for AI Grading?</h2>
    </div>
    <div class="modal__body stack">
      <p class="no-margin">
        Submitting will save your current responses and dispatch them to the AI grading engine. This action cannot be undone.
      </p>
      @if (Model.AnsweredCount < take.TotalQuestions)
      {
        <div class="alert alert--warning">
          <strong>Notice:</strong> You have answered @Model.AnsweredCount of @take.TotalQuestions questions. Unanswered questions will receive 0 marks.
        </div>
      }
    </div>
    <div class="modal__footer row row--between">
      <button type="button" class="btn js-close-submit-modal">Return to writing</button>
      <form id="submit-form" method="post" action="/writing/submit/@take.AttemptId" class="writing-submit-form">
        @Html.AntiForgeryToken()
        <button id="btn-submit-exam" type="submit" class="btn btn--primary">Confirm & Submit</button>
      </form>
    </div>
  </div>
</div>
      </div>
    </main>
  </div>
  <script src="~/js/icons.js"></script>
  <script src="~/js/writing/take.js" asp-append-version="true"></script>
</body>
</html>
