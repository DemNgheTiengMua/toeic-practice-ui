@model WritingTakeViewModel
@{
    var take = Model.Take;
    var q = take.Question;
    // #239: the task's own demands, read from the row. Nothing here is a constant: the range comes from
    // Questions.MinWords/MaxWords, the budget from the task's own ResponseSeconds.
    var hasRange = q.MinWords.HasValue || q.MaxWords.HasValue;
    var rangeText = q.MinWords.HasValue && q.MaxWords.HasValue ? $"{q.MinWords}–{q.MaxWords}"
        : q.MinWords.HasValue ? $"{q.MinWords} or more"
        : q.MaxWords.HasValue ? $"up to {q.MaxWords}"
        : "no declared range";
}
<div class="writing-panes">
  <!-- Left pane: the task checklist, beside the editor rather than above it (spec §5) -->
  <aside class="writing-panes__prompt stack" aria-labelledby="task-checklist-title">
    <div class="card">
      <div class="card__header">
        <div class="row row--between">
          <span class="question__number">Question @take.CurrentQuestionIndex</span>
          <span class="badge badge--muted">@q.SectionName</span>
        </div>
      </div>
      <div class="card__body stack">
        @if (!string.IsNullOrEmpty(q.GroupImagePath))
        {
          <div class="mb-3">
            <img src="@q.GroupImagePath" alt="@(q.GroupImageAlt ?? "Question illustration")" class="question__image" />
          </div>
        }

        <p class="question__stem">@q.Stem</p>

        @if (!string.IsNullOrEmpty(q.Hint))
        {
          <div class="alert alert--info text-sm">
            <strong>Hint:</strong> @q.Hint
          </div>
        }
      </div>
    </div>

    @* The checklist. Each row is a demand the task itself declares and the rubric scores, and each
       carries a live state the composer updates as the learner types — so the requirement is readable
       while composing rather than recalled from the instructions page. *@
    <div class="card">
      <div class="card__header">
        <strong id="task-checklist-title">Task checklist</strong>
      </div>
      <div class="card__body">
        <ul class="task-checklist stack m-0">
          <li class="task-checklist__item" data-checklist="length">
            <span class="task-checklist__mark" aria-hidden="true" data-checklist-mark="length"></span>
            <span class="task-checklist__body">
              <span class="task-checklist__label">Length</span>
              <span class="task-checklist__detail font-mono" data-checklist-detail="length">
                @if (hasRange)
                {
                  <text>@rangeText words</text>
                }
                else
                {
                  <text>no declared range</text>
                }
              </span>
            </span>
            @* Announced, not only coloured: this is the one checklist row whose state changes on every
               keystroke, and a screen reader must hear it settle rather than discover it later. *@
            <span class="visually-hidden" role="status" aria-live="polite" data-checklist-status="length"></span>
          </li>

          <li class="task-checklist__item" data-checklist="time">
            <span class="task-checklist__mark" aria-hidden="true" data-checklist-mark="time"></span>
            <span class="task-checklist__body">
              <span class="task-checklist__label">Writing time</span>
              <span class="task-checklist__detail font-mono">
                @if (q.ResponseSeconds.HasValue)
                {
                  <text>@(q.ResponseSeconds.Value / 60) min @(q.ResponseSeconds.Value % 60) s</text>
                }
                else
                {
                  <text>the exam clock</text>
                }
              </span>
            </span>
          </li>

          <li class="task-checklist__item" data-checklist="answered">
            <span class="task-checklist__mark" aria-hidden="true" data-checklist-mark="answered"></span>
            <span class="task-checklist__body">
              <span class="task-checklist__label">Answer written</span>
              <span class="task-checklist__detail" data-checklist-detail="answered">anything above zero words is submitted</span>
            </span>
          </li>
        </ul>
      </div>
    </div>
  </aside>

  <!-- Right pane: the editor -->
  <div class="stack">
    <div class="card">
      <div class="card__header">
        <div class="row row--between">
          <strong>Your answer</strong>
          <span class="text-xs text-muted">No spell check, as on test day</span>
        </div>
      </div>
      <div class="card__body stack">
        <label class="visually-hidden" for="writing-editor">Your writing response</label>
        <textarea
          id="writing-editor"
          class="answer-sheet"
          rows="14"
          spellcheck="false"
          placeholder="Type your response here..."
          data-attempt-id="@take.AttemptId"
          data-question-id="@q.QuestionId"
          data-min-words="@(q.MinWords ?? 0)"
          data-max-words="@(q.MaxWords ?? 0)"
          data-word-pattern="@Model.WordCountPattern">@(q.ResponseText ?? "")</textarea>

        <!-- Live Word Meter -->
        <div class="word-meter" id="word-meter-container">
          <div class="word-meter__readout">
            <span id="word-count" class="word-meter__count font-mono">0</span>
            <span id="word-status" class="word-meter__state">words</span>
          </div>
          <div class="word-meter__track">
            @if (q.MinWords.HasValue && q.MinWords.Value > 0)
            {
              <div class="writing-minimum-tick word-meter__tick" aria-hidden="true">
                <span class="word-meter__tick-label">min @q.MinWords</span>
              </div>
            }
            else if (q.MaxWords.HasValue && q.MaxWords.Value > 0)
            {
              <div class="writing-maximum-tick word-meter__tick" aria-hidden="true">
                <span class="word-meter__tick-label">max @q.MaxWords</span>
              </div>
            }
            <div id="word-meter-fill" class="writing-meter-empty word-meter__fill"></div>
          </div>
        </div>

        <p class="text-xs text-muted no-margin">
          Writing under the minimum, or over the maximum, costs marks in AI grading but is still accepted.
        </p>
      </div>

      <div class="card__footer">
        <div class="row row--between">
          <div class="writing-actions row">
            <button type="button" class="btn btn--secondary" id="btn-save-draft">Save draft</button>
            <button type="button" class="btn btn--primary" id="btn-open-submit-modal">
              Finish and submit for AI grading
            </button>
          </div>
          <span class="text-xs text-muted">Question @take.CurrentQuestionIndex of @take.TotalQuestions</span>
        </div>
      </div>
    </div>
  </div>
</div>
