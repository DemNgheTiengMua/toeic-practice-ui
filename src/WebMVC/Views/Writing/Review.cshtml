@model WritingReviewViewModel
@{
    Layout = "_LearnerLayout";
    var rev = Model.Review;
    ViewData["Title"] = $"Writing Result — {rev.ExamName}";
    ViewData["Description"] = $"Writing practice evaluation for attempt {rev.AttemptId}.";
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/dashboard" class="breadcrumbs__item">Home</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/practice" class="breadcrumbs__item">Practice</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Writing result</span>
</nav>

<div class="context-bar mb-4">
  <div class="context-bar__item">
    <span class="context-bar__label">Certificate:</span>
    <span class="context-bar__value">@rev.CertCode</span>
  </div>
  <div class="context-bar__item">
    <span class="context-bar__label">Attempt:</span>
    <span class="context-bar__value">Writing practice</span>
  </div>
  <div class="context-bar__item">
    <span class="context-bar__label">Cost:</span>
    <span class="context-bar__value">1 credit · AI grading</span>
  </div>
</div>

<div class="stack">
  <div class="row row--between">
    <div>
      <h1 class="m-0 mb-1">Writing result: @rev.ExamName</h1>
      <p class="text-sm text-muted no-margin">
        @(rev.SubmittedAt.HasValue ? $"Graded {rev.SubmittedAt.Value:d MMMM yyyy} · " : "")
        @rev.AnsweredQuestions of @rev.TotalQuestions questions answered
      </p>
    </div>
    <div class="row">
      <a class="btn" href="/practice">Practice by section</a>
      <a class="btn btn--primary" href="/writing/@rev.ExamId/instructions">Practise writing again</a>
    </div>
  </div>

  <!-- Score Hero -->
  <div class="score-hero">
    <div class="score-hero__total">
      <div class="score-hero__total-value">@rev.TotalScore.ToString("0.#")</div>
      <div class="score-hero__total-label">Points earned · out of @rev.MaxScore.ToString("0.#")</div>
    </div>
    <div class="score-hero__section">
      <div class="score-hero__section-value">@rev.AnsweredQuestions / @rev.TotalQuestions</div>
      <div class="text-sm text-muted">Questions completed</div>
      <p class="text-xs text-muted m-0 mt-1">Free response AI rubric evaluation</p>
    </div>
    <div class="score-hero__section">
      <div class="score-hero__section-value">1</div>
      <div class="text-sm text-muted">Credit used</div>
      <p class="text-xs text-muted m-0 mt-1">AI grading, charged upon submission</p>
    </div>
  </div>

  @if (!string.IsNullOrEmpty(rev.EstimatedBandCode))
  {
    <div class="alert alert--info">
      <strong>Estimated band: <span class="font-mono">@rev.EstimatedBandCode</span>@(string.IsNullOrEmpty(rev.EstimatedBandName) ? "" : $" — {rev.EstimatedBandName}")</strong>
      <p class="text-sm no-margin mt-1">
        An estimate from this writing rubric alone, placed on @rev.CertCode's band scale. It is an
        estimate for this skill: whether it also becomes your certificate band depends on how @rev.CertCode
        reports its skills, and that is a rule of the certificate, not of this page.
      </p>
      @* #239: one task is not a level. A single graded task generalises poorly (r(1) = 0.55), so the
         band says which it is rather than letting one task's mark read as a measurement of the skill. *@
      @if (rev.GradedQuestions == 1)
      {
        <p class="text-sm no-margin mt-2">
          <strong>Estimated from one task.</strong> One graded task is a reading of this answer, not of
          your writing: the same skill measured over several tasks is what supports a level.
        </p>
      }
      else if (rev.GradedQuestions > 1)
      {
        <p class="text-sm no-margin mt-2 font-mono">
          Measured over @rev.GradedQuestions graded tasks.
        </p>
      }
    </div>
  }
  else if (rev.AnsweredQuestions == 0 || rev.TotalScore <= 0)
  {
    <div class="alert alert--warning">
      <strong>No estimated band: nothing was scored.</strong>
      <p class="text-sm no-margin mt-1">
        An empty rubric earns no band. Write an answer, or answer more of the tasks, to get an
        estimate on @rev.CertCode's band scale.
      </p>
    </div>
  }
  else
  {
    <div class="alert alert--warning">
      <strong>@rev.CertCode has no bands configured.</strong>
      <p class="text-sm no-margin mt-1">
        Your rubric scores below are complete, but there is no band scale to place them on yet.
      </p>
    </div>
  }

  <!-- Questions Summary Table -->
  <section class="mt-4">
    <h2 class="section-group__title">Your answers overview</h2>
    <div class="card">
      <div class="card__body">
        <table class="table">
          <caption class="visually-hidden">Score and word count for each writing question</caption>
          <thead>
            <tr>
              <th scope="col">Question</th>
              <th scope="col">Task</th>
              <th scope="col">Words</th>
              <th scope="col">Score</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var q in rev.Questions)
            {
              <tr>
                <th scope="row">@q.DisplayOrder</th>
                <td>@q.SectionName</td>
                <td>@q.WordCount</td>
                <td><strong>@q.TotalScore.ToString("0.#") / @q.MaxScore.ToString("0.#")</strong></td>
              </tr>
            }
          </tbody>
          <tfoot>
            <tr>
              <th scope="row" colspan="3">Total</th>
              <td><strong>@rev.TotalScore.ToString("0.#") / @rev.MaxScore.ToString("0.#")</strong></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </section>

  <!-- Detailed Per-Question & Per-Criterion Feedback -->
  <section class="mt-4 stack">
    <h2 class="section-group__title">Per-question criteria and feedback</h2>
    @foreach (var q in rev.Questions)
    {
      <div class="card mb-4">
        <div class="card__header">
          <div class="row row--between">
            <strong>Question @q.DisplayOrder: @q.SectionName</strong>
            <span class="badge badge--info">@q.TotalScore.ToString("0.#") / @q.MaxScore.ToString("0.#") pts</span>
          </div>
        </div>
        <div class="card__body stack">
          <p class="text-sm text-muted no-margin"><strong>Prompt:</strong> @q.Stem</p>
          <div class="graded-text">
            @if (string.IsNullOrWhiteSpace(q.ResponseText))
            {
              <em class="text-muted">No response was provided.</em>
            }
            else
            {
              @q.ResponseText
            }
          </div>
        </div>
        @if (q.Criteria.Count > 0)
        {
          <div class="card__footer">
            <table class="table">
              <caption class="visually-hidden">What the grader noted on each criterion for question @q.DisplayOrder</caption>
              <thead>
                <tr>
                  <th scope="col" style="width: 25%">Criterion</th>
                  <th scope="col" style="width: 15%">Score</th>
                  <th scope="col">What the grader saw</th>
                </tr>
              </thead>
              <tbody>
                @foreach (var crit in q.Criteria)
                {
                  <tr>
                    <th scope="row">@crit.Name</th>
                    <td><strong>@crit.Score.ToString("0.#") / @crit.MaxScore.ToString("0.#")</strong></td>
                    @* #239: a score is not evidence. The note is the evidence, and when the grader
                       stored none the cell says so as a fact instead of filling the gap with a phrase
                       that reads like feedback but names nothing ("Evaluated against rubric."). *@
                    <td>
                      @if (!string.IsNullOrWhiteSpace(crit.Comment))
                      {
                        @crit.Comment
                      }
                      else
                      {
                        <span class="text-muted text-xs">No note was recorded for this criterion on this grading.</span>
                      }
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }

        @* E2.1 (#151): what makes the feedback usable is a located error plus a rewrite, not a
           paragraph of praise. Each block is conditional on the grader having stored it, so an
           older grading shows nothing rather than an empty heading. *@
        @if (q.ErrorSpans is { Count: > 0 })
        {
          <div class="card__footer">
            <h3 class="section-group__title">Errors to fix</h3>
            <table class="table">
              <caption class="visually-hidden">Located errors and their corrections for question @q.DisplayOrder</caption>
              <thead>
                <tr>
                  <th scope="col">Category</th>
                  <th scope="col">Your text</th>
                  <th scope="col">Correction</th>
                  <th scope="col">Why</th>
                </tr>
              </thead>
              <tbody>
                @for (var spanIndex = 0; spanIndex < q.ErrorSpans.Count; spanIndex++)
                {
                  var span = q.ErrorSpans[spanIndex];
                  <tr>
                    @* #220: the grader's category is a code; the cell a reader sees is its word. *@
                    <td class="text-xs" data-category="@span.Category">@Model.ErrorCategoryLabels[q.QuestionId][spanIndex]</td>
                    <td><del>@span.OriginalSnippet</del></td>
                    <td><ins>@span.CorrectedSnippet</ins></td>
                    <td class="text-sm">@span.ExplanationVi</td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }

        @if (!string.IsNullOrWhiteSpace(q.PriorityFix))
        {
          <div class="card__footer">
            <div class="alert alert--warning">
              <strong>Fix this first</strong>
              <p class="text-sm no-margin mt-1">@q.PriorityFix</p>
            </div>
          </div>
        }

        @if (!string.IsNullOrWhiteSpace(q.ModelRewrite))
        {
          <div class="card__footer">
            <h3 class="section-group__title">A stronger version of your weakest sentence</h3>
            <div class="graded-text">@q.ModelRewrite</div>
          </div>
        }
      </div>
    }
  </section>
</div>
