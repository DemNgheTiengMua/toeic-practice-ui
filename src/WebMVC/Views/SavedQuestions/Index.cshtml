@model WebMVC.Models.SavedQuestionsIndexViewModel
@{
    Layout = "_LearnerLayout";
    ViewData["Title"] = "Saved questions";
    ViewData["Description"] = "Review your saved questions and bank of incorrect answers.";
    var data = Model.Data;
    var hasActiveFilters = Model.HasActiveFilters;
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/dashboard" class="breadcrumbs__item">Home</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Saved questions</span>
</nav>

<div class="row row--between row--wrap">
  <div>
    <h1 class="m-0 mb-1">Saved questions</h1>
    <p class="text-sm text-muted no-margin">
      @data.TotalSavedCount @(data.TotalSavedCount == 1 ? "question" : "questions") in your bank — @data.IncorrectSavedCount saved automatically from wrong answers, @data.ManualSavedCount saved by you.
      <strong>Practicing them is free, no credit deducted.</strong>
    </p>
  </div>
  @if (data.TotalSavedCount > 0)
  {
    <a class="btn btn--primary" href="/practice">Start a practice session</a>
  }
</div>

@if (TempData["SuccessMessage"] is string successMsg)
{
  <div class="alert alert--success mt-4" role="status">@successMsg</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
  <div class="alert alert--danger mt-4" role="alert">@Model.ErrorMessage</div>
}

@if (data.TotalSavedCount == 0 && !hasActiveFilters)
{
  <!-- Empty state: no questions saved yet -->
  <div class="card mt-4">
    <div class="card__body">
      <div class="state-block">
        <div class="state-block__icon" aria-hidden="true">EMPTY</div>
        <div class="state-block__title">No saved questions yet</div>
        <p class="state-block__desc">
          Questions land here two ways: you tap <strong>Save question</strong> while reviewing, or you answer a multiple-choice practice question wrong and it is saved automatically. A written answer has no options to compare, so it is never filed here — its feedback stays on the drill.
        </p>
        <div class="row row--center mt-3">
          <a class="btn btn--primary btn--lg" href="/practice">Start a practice session</a>
        </div>
      </div>
    </div>
  </div>
}
else
{
  <!-- Filters bar -->
  <div class="card mt-4">
    <div class="card__body">
      <form method="get" action="/saved-questions" class="row row--wrap row--end" id="filter-form">
        <div class="field mb-0">
          <label class="field__label" for="sq-source">Source</label>
          <select class="field__input" id="sq-source" name="source" onchange="this.form.submit()">
            <option value="" selected="@(string.IsNullOrEmpty(Model.CurrentSource))">All sources (@data.TotalSavedCount)</option>
            <option value="incorrect" selected="@(Model.CurrentSource == "incorrect")">Wrong answers (@data.IncorrectSavedCount)</option>
            <option value="manual" selected="@(Model.CurrentSource == "manual")">Saved by me (@data.ManualSavedCount)</option>
          </select>
        </div>

        @if (data.Sections.Count > 0)
        {
          <div class="field mb-0">
            <label class="field__label" for="sq-section">Section</label>
            <select class="field__input" id="sq-section" name="sectionId" onchange="this.form.submit()">
              <option value="" selected="@(!Model.CurrentSectionId.HasValue)">All sections</option>
              @foreach (var sec in data.Sections)
              {
                <option value="@sec.SectionId" selected="@(Model.CurrentSectionId == sec.SectionId)">@sec.Code — @sec.Name (@sec.Count)</option>
              }
            </select>
          </div>
        }

        @if (data.Categories.Count > 0)
        {
          <div class="field mb-0">
            <label class="field__label" for="sq-category">Question type</label>
            <select class="field__input" id="sq-category" name="categoryId" onchange="this.form.submit()">
              <option value="" selected="@(!Model.CurrentCategoryId.HasValue)">All types</option>
              @foreach (var cat in data.Categories)
              {
                <option value="@cat.CategoryId" selected="@(Model.CurrentCategoryId == cat.CategoryId)">@cat.Name (@cat.Count)</option>
              }
            </select>
          </div>
        }

        @if (hasActiveFilters)
        {
          <div>
            <a href="/saved-questions" class="btn btn--ghost btn--sm">Reset filters</a>
          </div>
        }
      </form>
    </div>
  </div>

  @if (data.Questions.Count == 0)
  {
    <div class="card mt-4">
      <div class="card__body">
        <div class="state-block">
          <div class="state-block__icon" aria-hidden="true">EMPTY</div>
          <div class="state-block__title">No matching saved questions</div>
          <p class="state-block__desc">No saved questions matched your current filter criteria.</p>
          <div class="row row--center mt-2">
            <a class="btn btn--primary" href="/saved-questions">Show all saved questions</a>
          </div>
        </div>
      </div>
    </div>
  }
  else
  {
    <div class="stack mt-4" style="gap: var(--space-4);" id="saved-questions-list">
      @foreach (var item in data.Questions)
      {
        <article class="card saved-question-card" id="card-@item.SavedQuestionId" data-saved-question-id="@item.SavedQuestionId">
          <div class="card__body stack" style="gap: var(--space-3);">
            <div class="row row--between row--wrap">
              <span class="text-sm">
                @if (item.Source == SavedQuestionSourceDto.Incorrect)
                {
                  <span class="badge badge--danger">Wrong answer</span>
                }
                else
                {
                  <span class="badge badge--info">Saved by you</span>
                }
                @if (item.IsRetiredDefective)
                {
                  @* #224 / D21: the item was withdrawn as defective. What the learner saved still
                     renders below, but a wrong key must never look like a normal answer. *@
                  <span class="badge badge--warning">Withdrawn as defective</span>
                }
                <span class="badge badge--muted">@item.ScopeCode — @item.ScopeName</span>
                @if (!string.IsNullOrEmpty(item.CategoryName))
                {
                  <span class="badge badge--muted">@item.CategoryName</span>
                }
              </span>
              <span class="text-sm text-muted">Saved @Model.SavedAtDisplays[item.SavedQuestionId]</span>
            </div>

            @if (item.IsRetiredDefective)
            {
              <div class="alert alert--warning no-margin" role="note">
                This item was withdrawn because its key was wrong. What you saved is shown so you can
                review your thinking, but do not treat the marked answer as correct.
              </div>
            }

            <p class="no-margin" style="white-space: pre-wrap;">@item.Stem</p>

            <div class="row row--between row--middle row--wrap">
              <span class="text-xs text-muted">@item.ScopeCode · @item.Options.Count options</span>
              <div class="row">
                <button type="button" class="btn btn--sm review-toggle-btn" data-target="review-@item.SavedQuestionId" aria-expanded="false" aria-controls="review-@item.SavedQuestionId">
                  Review explanation
                </button>
                <form method="post" action="/saved-questions/@item.SavedQuestionId/remove" class="no-margin remove-form" data-saved-question-id="@item.SavedQuestionId">
                  @Html.AntiForgeryToken()
                  <button type="submit" class="btn btn--ghost btn--sm">Remove</button>
                </form>
              </div>
            </div>

            <!-- Review panel (expanded inline) -->
            <div class="saved-review-panel mt-3 pt-3" id="review-@item.SavedQuestionId" style="display: none; border-top: 1px solid var(--rule-soft);" role="region" aria-label="Saved question @item.SavedQuestionId review and explanation">
              @if (!string.IsNullOrEmpty(item.Passage))
              {
                <div class="card mb-3">
                  <div class="card__body">
                    <p class="no-margin text-sm" style="white-space: pre-line;">@item.Passage</p>
                  </div>
                </div>
              }

              @if (!string.IsNullOrEmpty(item.ImagePath))
              {
                <div class="mb-3">
                  <img src="@item.ImagePath" alt="Question illustration" class="question__image" />
                </div>
              }

              @if (!string.IsNullOrEmpty(item.AudioPath))
              {
                @await Html.PartialAsync("_ExamAudioPlayer", Model.QuestionAudio[item.SavedQuestionId])
              }

              <div class="option-list" aria-label="Answer options">
                @foreach (var opt in item.Options)
                {
                  @* #224: a version stores labels and a key, not option rows, so the learner's own
                     choice has no id to match here. Every option is shown with the key marked, which is
                     what a review screen is for. *@
                  var isCorrect = opt.IsCorrect;
                  var optClass = isCorrect ? "option option--correct" : "option";
                  <div class="@optClass">
                    <span class="option__marker">@opt.Label</span>
                    <span class="option__text">@opt.Text</span>
                    @if (isCorrect)
                    {
                      <span class="badge badge--success">Correct answer</span>
                    }
                  </div>
                }
              </div>

              @if (!string.IsNullOrEmpty(item.Explanation))
              {
                <div class="explain mt-3">
                  <div class="explain__title">Explanation</div>
                  <p class="no-margin text-sm">@item.Explanation</p>
                  @if (!string.IsNullOrEmpty(item.Transcript))
                  {
                    <div class="explain__transcript mt-2 text-xs">
                      <strong>Transcript:</strong> @item.Transcript
                    </div>
                  }
                </div>
              }

              <div class="row row--between mt-3 text-xs text-muted">
                <a href="/saved-questions/@item.SavedQuestionId" class="text-muted" style="text-decoration: underline;">Open dedicated review page ›</a>
                <button type="button" class="btn btn--ghost btn--sm close-review-btn" data-target="review-@item.SavedQuestionId">Close review</button>
              </div>
            </div>
          </div>
        </article>
      }
    </div>

    <div class="card mt-4">
      <div class="card__header"><strong>About your bank</strong></div>
      <div class="card__body">
        <p class="text-sm no-margin">
          Remove a question once it stops being useful. Review questions anytime with complete explanations and answer keys.
        </p>
      </div>
    </div>
  }
}

@section Scripts {
  <script src="~/js/saved-questions/index.js" asp-append-version="true"></script>
}
