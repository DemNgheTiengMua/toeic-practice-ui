@model WebMVC.Models.QuestionEditorViewModel
@{
    Layout = "_AdminLayout";
    var data = Model.QuestionsData;
    ViewData["Title"] = $"Questions — {data.ExamName}";

    var selectedSectionId = Model.SelectedSectionId ?? data.AvailableSections.FirstOrDefault()?.SectionId;
    var currentSection = data.AvailableSections.FirstOrDefault(s => s.SectionId == selectedSectionId);
    var groups = data.Groups.Where(g => selectedSectionId == null || g.SectionId == selectedSectionId).ToList();
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/admin" class="breadcrumbs__item">Admin</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/admin/exams" class="breadcrumbs__item">Exams</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Write questions</span>
</nav>

<div class="row row--between">
  <div>
    <h1 class="m-0 mb-1">Write questions</h1>
    <p class="text-muted no-margin">@data.ExamName (@data.CertCode.ToUpperInvariant())</p>
  </div>
  <a class="btn btn--ghost" href="/admin/exams/@data.ExamId/edit?step=3">Back to exam progress</a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
  <div class="alert alert--danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
  <div class="alert alert--success">@Model.SuccessMessage</div>
}

<!-- Toolbar to select section -->
<form method="get" action="/admin/exams/@data.ExamId/questions" class="toolbar">
  <div class="field">
    <label class="field__label" for="q-part">Part / Section</label>
    <select class="field__input" id="q-part" name="sectionId" onchange="this.form.submit()">
      @foreach (var s in data.AvailableSections)
      {
        <option value="@s.SectionId" selected="@(s.SectionId == selectedSectionId)">
          @s.Name (@s.Code) @(s.ExpectedQuestionCount.HasValue ? $"— {s.ExpectedQuestionCount.Value} questions" : "")
        </option>
      }
    </select>
  </div>
  <button type="submit" class="btn">Filter</button>
</form>

<!-- Question groups and questions in this section -->
@if (groups.Count == 0)
{
  <div class="card">
    <div class="card__body stack">
      <div class="alert alert--info">
        No question groups created yet for this section. Create a question group to begin entering questions.
      </div>
      <form method="post" action="/admin/exams/@data.ExamId/groups" class="stack">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SectionId" value="@selectedSectionId" />
        <div class="field">
          <label class="field__label" for="grp-passage">Passage / Reading Text (optional)</label>
          <textarea class="field__input" id="grp-passage" name="Passage" rows="3"></textarea>
        </div>
        <div class="grid-2">
          <div class="field">
            <label class="field__label" for="grp-img">Image Path (optional)</label>
            <input class="field__input" id="grp-img" name="ImagePath" placeholder="img/part1/q1.jpg" />
          </div>
          <div class="field">
            <label class="field__label" for="grp-alt">Image Description (alt, required if image provided)</label>
            <input class="field__input" id="grp-alt" name="ImageAlt" placeholder="A woman is holding a cup" />
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="grp-script">Transcript / Audio Script (optional)</label>
          <textarea class="field__input" id="grp-script" name="Transcript" rows="2"></textarea>
        </div>
        <button type="submit" class="btn btn--primary">Create Question Group</button>
      </form>
    </div>
  </div>
}
else
{
  @foreach (var group in groups)
  {
    <div class="card stack" style="margin-bottom:2rem; border:2px solid #14181d;">
      <div class="card__header row row--between" style="background:#f4f5f6;">
        <div>
          <strong>Group #@group.GroupId — @group.SectionName</strong>
          <span class="text-sm text-muted">(@group.Questions.Count questions)</span>
        </div>
        <div class="row">
          @if (group.Questions.Count == 0)
          {
            <form method="post" action="/admin/exams/@data.ExamId/groups/@group.GroupId/delete" onsubmit="return confirm('Delete this group?');" style="display:inline; margin:0;">
              @Html.AntiForgeryToken()
              <input type="hidden" name="sectionId" value="@selectedSectionId" />
              <button type="submit" class="btn btn--sm btn--danger">Delete Group</button>
            </form>
          }
        </div>
      </div>

      <div class="card__body stack">
        @if (!string.IsNullOrEmpty(group.Passage))
        {
          <div class="p-2" style="background:#f9f9f9; border-left:4px solid #0b4ea2;">
            <strong>Passage:</strong>
            <p style="white-space:pre-wrap; margin:0.5rem 0 0 0;">@group.Passage</p>
          </div>
        }
        @if (!string.IsNullOrEmpty(group.ImagePath))
        {
          <div>
            <strong>Image:</strong> @group.ImagePath (alt: <em>@group.ImageAlt</em>)
          </div>
        }
        @if (!string.IsNullOrEmpty(group.Transcript))
        {
          <div class="text-sm text-muted">
            <strong>Script / Transcript:</strong> @group.Transcript
          </div>
        }

        <!-- Existing questions in this group -->
        @foreach (var q in group.Questions)
        {
          var isMcq = q.QuestionType == Contracts.QuestionTypeDto.Mcq;
          var optionLabels = isMcq ? string.Join("/", q.Options.Select(o => o.Label)) : "";

          <div class="card" style="border:1px solid #ccd2d6; margin-top:1rem;">
            <div class="card__header row row--between">
              <strong>Question @q.DisplayOrder — @group.SectionName</strong>
              <span class="badge badge--info">@(isMcq ? $"{q.Options.Count} answers ({optionLabels})" : "Free response")</span>
            </div>

            <form method="post" action="/admin/exams/@data.ExamId/questions">
              @Html.AntiForgeryToken()
              <input type="hidden" name="QuestionId" value="@q.QuestionId" />
              <input type="hidden" name="GroupId" value="@group.GroupId" />
              <input type="hidden" name="SectionId" value="@group.SectionId" />
              <input type="hidden" name="QuestionType" value="@q.QuestionType" />
              <input type="hidden" name="DisplayOrder" value="@q.DisplayOrder" />

              <div class="card__body stack">
                <div class="field">
                  <label class="field__label" for="q-stem-@q.QuestionId">Question Stem / Prompt</label>
                  <textarea class="field__input" id="q-stem-@q.QuestionId" name="Stem" rows="2" required>@q.Stem</textarea>
                </div>

                @if (isMcq)
                {
                  <div class="stack">
                    <span class="field__label">Answer Options (select the correct radio button)</span>
                    @for (var i = 0; i < q.Options.Count; i++)
                    {
                      var opt = q.Options[i];
                      <div class="row row--middle" style="gap:0.5rem; margin-bottom:0.5rem;">
                        <input type="hidden" name="Options[@i].OptionId" value="@opt.OptionId" />
                        <input type="hidden" name="Options[@i].Label" value="@opt.Label" />
                        <input class="option__input" type="radio" name="CorrectOptionLabel" value="@opt.Label" checked="@(opt.IsCorrect)" required />
                        <span class="option__marker" style="min-width:24px; font-weight:bold;">@opt.Label</span>
                        <input class="field__input toolbar__grow" name="Options[@i].Text" value="@opt.Text" aria-label="Answer @opt.Label text" required />
                        <input class="field__input" style="max-width:200px;" name="Options[@i].Rationale" value="@opt.Rationale" placeholder="Rationale (optional)" />
                      </div>
                    }
                  </div>
                }
                else
                {
                  <div class="grid-2">
                    <div class="field">
                      <label class="field__label">Prep Seconds</label>
                      <input class="field__input" name="PrepSeconds" type="number" min="0" value="@q.PrepSeconds" />
                    </div>
                    <div class="field">
                      <label class="field__label">Response Seconds</label>
                      <input class="field__input" name="ResponseSeconds" type="number" min="1" value="@q.ResponseSeconds" />
                    </div>
                  </div>
                  <div class="grid-2">
                    <div class="field">
                      <label class="field__label">Min Words</label>
                      <input class="field__input" name="MinWords" type="number" min="1" value="@q.MinWords" />
                    </div>
                    <div class="field">
                      <label class="field__label">Max Words</label>
                      <input class="field__input" name="MaxWords" type="number" min="1" value="@q.MaxWords" />
                    </div>
                  </div>
                }

                <div class="grid-2">
                  <div class="field">
                    <label class="field__label" for="q-diff-@q.QuestionId">Difficulty (1–5)</label>
                    <select class="field__input" id="q-diff-@q.QuestionId" name="DifficultyLevel">
                      @for (var d = 1; d <= 5; d++)
                      {
                        <option value="@d" selected="@(d == q.DifficultyLevel)">@d @(d == 1 ? "(Easiest)" : d == 5 ? "(Hardest)" : "")</option>
                      }
                    </select>
                  </div>
                  <div class="field">
                    <label class="field__label" for="q-cat-@q.QuestionId">Category</label>
                    <select class="field__input" id="q-cat-@q.QuestionId" name="CategoryId">
                      <option value="">No category</option>
                      @foreach (var cat in data.AvailableCategories)
                      {
                        <option value="@cat.CategoryId" selected="@(cat.CategoryId == q.CategoryId)">@cat.Name (@cat.Code)</option>
                      }
                    </select>
                  </div>
                </div>

                <div class="field">
                  <label class="field__label" for="q-exp-@q.QuestionId">Explanation</label>
                  <textarea class="field__input" id="q-exp-@q.QuestionId" name="Explanation" rows="2">@q.Explanation</textarea>
                </div>

                <div class="field">
                  <label class="field__label" for="q-hint-@q.QuestionId">Hint (practice only)</label>
                  <input class="field__input" id="q-hint-@q.QuestionId" name="Hint" value="@q.Hint" maxlength="1000" />
                </div>
              </div>

              <div class="card__footer row row--between">
                <span class="text-sm text-muted">
                  @(q.UpdatedAt.HasValue ? $"Last saved: {q.UpdatedAt.Value:HH:mm}" : "Saved")
                </span>
                <div class="row">
                  <button type="submit" class="btn btn--primary">Save question @q.DisplayOrder</button>
                  @if (!q.HasAnswers)
                  {
                    <button type="submit" formaction="/admin/exams/@data.ExamId/questions/@q.QuestionId/delete" formnovalidate onclick="return confirm('Delete this question?');" class="btn btn--danger">Delete</button>
                  }
                </div>
              </div>
            </form>
          </div>
        }

        <!-- Add question form for this group -->
        <details style="margin-top:1.5rem;">
          <summary class="btn btn--sm" style="cursor:pointer; display:inline-block;">+ Add Question to Group #@group.GroupId</summary>
          <div class="card" style="margin-top:1rem; border:1px solid #0b4ea2; padding:1rem;">
            <form method="post" action="/admin/exams/@data.ExamId/questions">
              @Html.AntiForgeryToken()
              <input type="hidden" name="GroupId" value="@group.GroupId" />
              <input type="hidden" name="SectionId" value="@group.SectionId" />
              @{
                var nextDisplayOrder = (data.Groups.SelectMany(g => g.Questions).MaxBy(q => q.DisplayOrder)?.DisplayOrder ?? 0) + 1;
                var defaultIsMcq = group.Modality != Contracts.ModalityDto.Speaking && group.Modality != Contracts.ModalityDto.Writing;
              }
              <input type="hidden" name="DisplayOrder" value="@nextDisplayOrder" />

              <div class="stack">
                <h3>New Question (@group.SectionName)</h3>

                <div class="grid-2">
                  <div class="field">
                    <label class="field__label">Question Type</label>
                    <select class="field__input" name="QuestionType">
                      <option value="Mcq" selected="@defaultIsMcq">Multiple Choice (MCQ)</option>
                      <option value="FreeResponse" selected="@(!defaultIsMcq)">Free Response</option>
                    </select>
                  </div>
                  <div class="field">
                    <label class="field__label">Question Number</label>
                    <input class="field__input" name="DisplayOrder" type="number" value="@nextDisplayOrder" required />
                  </div>
                </div>

                <div class="field">
                  <label class="field__label">Question Stem</label>
                  <textarea class="field__input" name="Stem" rows="2" required placeholder="Enter the question text…"></textarea>
                </div>

                <div class="stack">
                  <span class="field__label">Options (for MCQ, select correct answer)</span>
                  @{
                    var optionCount = group.SectionCode.Equals("PART2", StringComparison.OrdinalIgnoreCase) ? 3 : 4;
                    var defaultLabels = new[] { "A", "B", "C", "D" };
                  }
                  @for (var i = 0; i < optionCount; i++)
                  {
                    var lbl = defaultLabels[i];
                    <div class="row row--middle" style="gap:0.5rem; margin-bottom:0.5rem;">
                      <input type="hidden" name="Options[@i].Label" value="@lbl" />
                      <input class="option__input" type="radio" name="CorrectOptionLabel" value="@lbl" checked="@(i == 0)" />
                      <span class="option__marker" style="min-width:24px; font-weight:bold;">@lbl</span>
                      <input class="field__input toolbar__grow" name="Options[@i].Text" placeholder="Option @lbl text" value="@(i == 0 ? "Correct answer option" : $"Option {lbl}")" />
                      <input class="field__input" style="max-width:200px;" name="Options[@i].Rationale" placeholder="Rationale" />
                    </div>
                  }
                </div>

                <div class="grid-2">
                  <div class="field">
                    <label class="field__label">Difficulty (1–5)</label>
                    <select class="field__input" name="DifficultyLevel">
                      <option value="1">1 (Easiest)</option>
                      <option value="2">2</option>
                      <option value="3" selected>3 (Standard)</option>
                      <option value="4">4</option>
                      <option value="5">5 (Hardest)</option>
                    </select>
                  </div>
                  <div class="field">
                    <label class="field__label">Category</label>
                    <select class="field__input" name="CategoryId">
                      <option value="">None</option>
                      @foreach (var cat in data.AvailableCategories)
                      {
                        <option value="@cat.CategoryId">@cat.Name</option>
                      }
                    </select>
                  </div>
                </div>

                <div class="field">
                  <label class="field__label">Explanation</label>
                  <textarea class="field__input" name="Explanation" rows="2" placeholder="Why the correct option is right…"></textarea>
                </div>

                <button type="submit" class="btn btn--primary">Create Question</button>
              </div>
            </form>
          </div>
        </details>
      </div>
    </div>
  }

  <!-- Button to add another QuestionGroup to this section -->
  <details style="margin-top:2rem;">
    <summary class="btn" style="cursor:pointer; display:inline-block;">+ Add New Question Group to @currentSection?.Name</summary>
    <div class="card" style="margin-top:1rem; border:1px solid #ccd2d6; padding:1.5rem;">
      <form method="post" action="/admin/exams/@data.ExamId/groups" class="stack">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SectionId" value="@selectedSectionId" />
        <div class="field">
          <label class="field__label" for="new-grp-passage">Passage / Reading Text (optional)</label>
          <textarea class="field__input" id="new-grp-passage" name="Passage" rows="3"></textarea>
        </div>
        <div class="grid-2">
          <div class="field">
            <label class="field__label" for="new-grp-img">Image Path (optional)</label>
            <input class="field__input" id="new-grp-img" name="ImagePath" placeholder="img/sample.jpg" />
          </div>
          <div class="field">
            <label class="field__label" for="new-grp-alt">Image Description (alt, required if image provided)</label>
            <input class="field__input" id="new-grp-alt" name="ImageAlt" placeholder="Image description" />
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="new-grp-script">Transcript / Audio Script (optional)</label>
          <textarea class="field__input" id="new-grp-script" name="Transcript" rows="2"></textarea>
        </div>
        <button type="submit" class="btn btn--primary">Create Question Group</button>
      </form>
    </div>
  </details>
}
