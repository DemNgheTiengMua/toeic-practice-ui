@model WebMVC.Models.IngestionBatchListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Ingestion and staging";
}

@* #205 / S-02: drop a file, then read a verdict per record. The upload names one skill per file
   (CNT-02), and nothing is written for the skill it does not name. *@
<div id="ingestion-csrf-holder" style="display:none;">
  @Html.AntiForgeryToken()
</div>

@section Styles {
  <link rel="stylesheet" href="~/css/admin/ingestion.css" asp-append-version="true" />
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/admin" class="breadcrumbs__item">Admin</a>
  <span class="breadcrumbs__separator" aria-hidden="true">/</span>
  <span class="breadcrumbs__item" aria-current="page">Ingestion</span>
</nav>

<div class="row row--between row--wrap ingestion-head">
  <div>
    <h1 class="ingestion-head__title">Ingestion and staging</h1>
    <p class="text-sm text-muted ingestion-head__lede">
      One file per skill. Every record is judged by the four gates before anything is written, and the
      records that pass wait as staged until a reviewer clears them - they are not live.
    </p>
  </div>
</div>

@if (Model.SuccessMessage is not null)
{
  <div class="alert alert--success" role="status">@Model.SuccessMessage</div>
}
@if (Model.ErrorMessage is not null)
{
  <div class="alert alert--danger" role="alert">@Model.ErrorMessage</div>
}

<section class="ingestion-upload" aria-labelledby="ingestion-upload-title">
  <h2 class="ingestion-subhead" id="ingestion-upload-title">Upload a file</h2>

  <form class="ingestion-form" method="post" action="/admin/ingestion" enctype="multipart/form-data"
        id="ingestion-upload-form">
    @Html.AntiForgeryToken()

    <div class="ingestion-field">
      <label class="ingestion-label" for="ingestion-skill">Skill</label>
      @* One skill per file (CNT-02): a mixed file has no single topic vocabulary to be judged against. *@
      <select class="ingestion-select" id="ingestion-skill" name="skill" required>
        <option value="reading">Reading</option>
        <option value="listening">Listening</option>
      </select>
    </div>

    <div class="ingestion-field">
      <label class="ingestion-label" for="ingestion-file">Skill content pool file</label>
      <input class="ingestion-input" type="file" id="ingestion-file" name="file"
             accept=".json,application/json" required />
      <p class="ingestion-hint">UnifiedSkillContentPool 2.0.0. Another version is refused by name.</p>
    </div>

    <button class="btn btn--primary ingestion-submit" type="submit" id="ingestion-upload-submit">
      Judge the file
    </button>
  </form>
</section>

<section class="ingestion-batches" aria-labelledby="ingestion-batches-title">
  <h2 class="ingestion-subhead" id="ingestion-batches-title">Batches</h2>

  @if (Model.Batches.Count == 0)
  {
    <p class="ingestion-empty">No batch has been uploaded yet.</p>
  }
  else
  {
    @* Tabular data: the counts and the time are mono, and the rows are keyed by batch id. *@
    <table class="ingestion-table" id="ingestion-batch-table">
      <thead>
        <tr>
          <th scope="col" class="ingestion-table__num font-mono">Batch</th>
          <th scope="col">File</th>
          <th scope="col">State</th>
          <th scope="col">Submitted by</th>
          <th scope="col">Submitted</th>
          <th scope="col" class="ingestion-table__num font-mono">Records</th>
          <th scope="col" class="ingestion-table__num font-mono">Accepted</th>
          <th scope="col" class="ingestion-table__num font-mono">Discarded</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var batch in Model.Batches)
        {
          <tr class="ingestion-table__row" data-batch-id="@batch.BatchId">
            <td class="ingestion-table__num font-mono">
              <a href="/admin/ingestion/@batch.BatchId">@batch.BatchId</a>
            </td>
            <td class="ingestion-table__file">@batch.SourceName</td>
            <td>
              <span class="ingestion-state @(batch.AllRefused ? "ingestion-state--refused" : "ingestion-state--judged")">
                @batch.StatusLabel
              </span>
            </td>
            <td>@batch.UploadedBy</td>
            <td class="font-mono">@batch.CreatedAt</td>
            <td class="ingestion-table__num font-mono">@batch.Records</td>
            <td class="ingestion-table__num font-mono">@batch.Accepted</td>
            <td class="ingestion-table__num font-mono">@batch.Discarded</td>
          </tr>
        }
      </tbody>
    </table>
  }
</section>
