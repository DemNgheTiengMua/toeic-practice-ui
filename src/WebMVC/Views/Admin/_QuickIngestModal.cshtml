@* Reusable Quick Ingest Modal for Admin Exams and Exam Studio *@
<div class="modal-overlay" id="quick-ingest-modal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="quick-ingest-title">
  <div class="modal" style="max-width: 960px; width: 95%; max-height: 90vh; display: flex; flex-direction: column; border: 2px solid var(--color-ink, #14181d); border-radius: 0; box-shadow: none; background: #ffffff;">
    <div class="modal__header row row--between" style="border-bottom: 2px solid var(--color-ink, #14181d); padding: 1rem 1.5rem; background: var(--color-surface, #f8f9fa);">
      <div>
        <h2 id="quick-ingest-title" style="margin: 0; font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-size: 1.25rem;">
          Quick Ingest &amp; Staging Box
        </h2>
        <span class="text-sm text-muted" style="font-family: var(--font-mono, monospace);">Paste raw questions from Word/PDF/text or JSON</span>
      </div>
      <button type="button" class="btn btn--ghost" id="quick-ingest-close" aria-label="Close dialog" style="font-size: 1.25rem; font-weight: bold; border-radius: 0;">&times;</button>
    </div>

    <div class="modal__body stack" style="padding: 1.5rem; overflow-y: auto; flex: 1; gap: 1.25rem;">
      <!-- Controls bar: Section target, Mode toggle, and sample button -->
      <div class="row row--between row--wrap" style="gap: 1rem; padding: 0.75rem; background: #f0f4f8; border: 1px solid var(--color-border, #ccd2d6);">
        <div class="row" style="gap: 0.75rem; align-items: center;">
          <label for="qi-section-select" style="font-weight: 600; text-transform: uppercase; font-size: 0.85rem;">Target Section:</label>
          <select id="qi-section-select" class="field__input" style="padding: 0.4rem 0.6rem; border-radius: 0; border: 2px solid var(--color-ink, #14181d); min-width: 180px;">
            <!-- Populated dynamically or via server markup -->
          </select>
        </div>

        <div class="row" style="gap: 1rem; align-items: center;">
          <div class="row" style="gap: 0.5rem; align-items: center;">
            <span style="font-weight: 600; text-transform: uppercase; font-size: 0.85rem;">Mode:</span>
            <label style="display: flex; align-items: center; gap: 0.25rem; cursor: pointer; font-size: 0.9rem;">
              <input type="radio" name="qi-mode" value="append" checked style="accent-color: var(--color-ink, #14181d);">
              Append to section
            </label>
            <label style="display: flex; align-items: center; gap: 0.25rem; cursor: pointer; font-size: 0.9rem; color: var(--color-danger, #b31217);">
              <input type="radio" name="qi-mode" value="replace" style="accent-color: var(--color-danger, #b31217);">
              Replace section
            </label>
          </div>
          <button type="button" class="btn btn--secondary btn--sm" id="qi-sample-btn" style="border-radius: 0;">
            Load Sample Template
          </button>
        </div>
      </div>

      <!-- Syntax guide collapsed / expander -->
      <details style="background: #ffffff; border: 1px solid var(--color-border, #ccd2d6); padding: 0.5rem 0.75rem; font-size: 0.85rem;">
        <summary style="font-weight: 600; cursor: pointer; color: var(--color-primary, #0b4ea2);">
          Quick Syntax Guide (Asterisk or Trailing Keys, Explanation, JSON)
        </summary>
        <div style="margin-top: 0.5rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; font-family: var(--font-mono, monospace); font-size: 0.8rem;">
          <div style="padding: 0.5rem; background: #f8f9fa; border: 1px dashed #ccd2d6;">
            <strong>Format 1 (Inline Asterisk):</strong><br>
            1. Question stem text here...<br>
            *A. Correct choice text<br>
            B. Distractor choice 1<br>
            C. Distractor choice 2<br>
            D. Distractor choice 3<br>
            EXPLANATION: Pedagogical rationale...
          </div>
          <div style="padding: 0.5rem; background: #f8f9fa; border: 1px dashed #ccd2d6;">
            <strong>Format 2 (Trailing Answer Key):</strong><br>
            Câu 2: Question stem text...<br>
            (A) First choice<br>
            (B) Second choice<br>
            ANSWER: B<br>
            CATEGORY: grammar_prep<br>
            GIẢI THÍCH: Giải thích chi tiết...
          </div>
        </div>
      </details>

      <!-- Scratchpad area -->
      <div>
        <label for="qi-raw-text" style="display: block; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; margin-bottom: 0.25rem;">
          Paste Questions Text or JSON:
        </label>
        <textarea id="qi-raw-text" class="field__input" rows="8" placeholder="Paste questions here or click 'Load Sample Template'..." style="width: 100%; font-family: var(--font-mono, monospace); font-size: 0.875rem; border: 2px solid var(--color-ink, #14181d); border-radius: 0; padding: 0.75rem;"></textarea>
      </div>

      <div class="row row--between" style="align-items: center;">
        <button type="button" class="btn btn--secondary" id="qi-parse-btn" style="border-radius: 0;">
          Pre-flight Staging Parse
        </button>
        <div id="qi-summary-badge" style="font-family: var(--font-mono, monospace); font-weight: 600; font-size: 0.875rem;"></div>
      </div>

      <!-- Live Staging Preview Table -->
      <div id="qi-preview-container" style="display: none;">
        <h3 style="font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-size: 1rem; margin: 0 0 0.5rem 0;">
          Pre-Flight Staging Preview
        </h3>
        <div style="overflow-x: auto; border: 1px solid var(--color-ink, #14181d);">
          <table class="table" style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
            <thead>
              <tr style="background: var(--color-surface, #f8f9fa); border-bottom: 2px solid var(--color-ink, #14181d); text-align: left;">
                <th style="padding: 0.5rem; width: 45px;">#</th>
                <th style="padding: 0.5rem; width: 70px;">Lines</th>
                <th style="padding: 0.5rem;">Stem</th>
                <th style="padding: 0.5rem;">Options &amp; Correct Key</th>
                <th style="padding: 0.5rem; width: 90px;">Status</th>
              </tr>
            </thead>
            <tbody id="qi-preview-body">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="modal__footer row row--between" style="border-top: 2px solid var(--color-ink, #14181d); padding: 1rem 1.5rem; background: var(--color-surface, #f8f9fa);">
      <button type="button" class="btn btn--ghost" id="quick-ingest-cancel" style="border-radius: 0;">Cancel</button>
      <div class="row" style="gap: 0.75rem; align-items: center;">
        <span id="qi-commit-status" style="font-family: var(--font-mono, monospace); font-size: 0.85rem;"></span>
        <button type="button" class="btn btn--primary" id="quick-ingest-commit" disabled style="border-radius: 0;">
          Commit Questions to Section
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var modal = document.getElementById('quick-ingest-modal');
  var closeBtn = document.getElementById('quick-ingest-close');
  var cancelBtn = document.getElementById('quick-ingest-cancel');
  var sampleBtn = document.getElementById('qi-sample-btn');
  var parseBtn = document.getElementById('qi-parse-btn');
  var commitBtn = document.getElementById('quick-ingest-commit');
  var rawText = document.getElementById('qi-raw-text');
  var sectionSelect = document.getElementById('qi-section-select');
  var summaryBadge = document.getElementById('qi-summary-badge');
  var previewContainer = document.getElementById('qi-preview-container');
  var previewBody = document.getElementById('qi-preview-body');
  var commitStatus = document.getElementById('qi-commit-status');

  var currentExamId = null;
  var currentParsedResult = null;
  var onCommitCallback = null;

  var sampleTemplate = `1. Ms. Tanaka requested that all department managers submit their quarterly budgets by _____ Friday.
*A. next
B. nearly
C. soon
D. highly
EXPLANATION: The temporal adjective 'next' correctly modifies a specific day of the week to denote future timing.
CATEGORY: grammar_prep

Question 2: All visitors must present valid photo identification upon _____ the research facility.
(A) enter
*(B) entering
(C) entered
(D) entrance
ANSWER: B
EXPLANATION: The preposition 'upon' must be followed by a gerund ('entering').
CATEGORY: grammar_gerund

Câu 3. The newly opened branch will _____ express courier delivery throughout the metropolitan area.
A. provide
B. provision
C. provider
D. provides
ANSWER: A
EXPLANATION: Modal auxiliary 'will' is followed by the base form of the verb ('provide').
CATEGORY: grammar_verb`;

  function openModal(examId, sections, initialSectionId, callback) {
    currentExamId = examId;
    onCommitCallback = callback;

    sectionSelect.innerHTML = '';
    if (sections && sections.length > 0) {
      sections.forEach(function(s) {
        var opt = document.createElement('option');
        opt.value = s.sectionId || s.SectionId;
        opt.textContent = '[' + (s.code || s.Code || '') + '] ' + (s.name || s.Name || '');
        if (s.sectionId === initialSectionId || s.SectionId === initialSectionId) {
          opt.selected = true;
        }
        sectionSelect.appendChild(opt);
      });
    }

    rawText.value = '';
    currentParsedResult = null;
    previewContainer.style.display = 'none';
    previewBody.innerHTML = '';
    summaryBadge.textContent = '';
    commitStatus.textContent = '';
    commitBtn.disabled = true;

    modal.style.display = 'flex';
  }

  function closeModal() {
    modal.style.display = 'none';
  }

  closeBtn.addEventListener('click', closeModal);
  cancelBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', function(e) {
    if (e.target === modal) closeModal();
  });

  sampleBtn.addEventListener('click', function() {
    rawText.value = sampleTemplate;
    parseQuestions();
  });

  parseBtn.addEventListener('click', parseQuestions);

  var parseDebounceTimer = null;
  rawText.addEventListener('input', function() {
    clearTimeout(parseDebounceTimer);
    parseDebounceTimer = setTimeout(function() {
      if (rawText.value.trim().length > 10) {
        parseQuestions();
      }
    }, 800);
  });

  function getAntiForgeryToken() {
    var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
    return tokenInput ? tokenInput.value : '';
  }

  function parseQuestions() {
    var text = rawText.value;
    if (!text.trim()) {
      summaryBadge.innerHTML = '<span style="color: var(--color-danger, #b31217);">Text is empty.</span>';
      commitBtn.disabled = true;
      previewContainer.style.display = 'none';
      return;
    }

    summaryBadge.innerHTML = '<span>Parsing syntax...</span>';

    var secId = parseInt(sectionSelect.value, 10);
    var body = {
      rawText: text,
      sectionId: isNaN(secId) ? null : secId
    };

    fetch('/admin/exams/' + currentExamId + '/quick-ingest/parse', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'RequestVerificationToken': getAntiForgeryToken()
      },
      body: JSON.stringify(body)
    })
    .then(function(res) {
      if (!res.ok) throw new Error('HTTP ' + res.status);
      return res.json();
    })
    .then(function(data) {
      currentParsedResult = data;
      renderPreview(data);
    })
    .catch(function(err) {
      summaryBadge.innerHTML = '<span style="color: var(--color-danger, #b31217);">Parsing failed: ' + err.message + '</span>';
      commitBtn.disabled = true;
    });
  }

  function renderPreview(data) {
    previewContainer.style.display = 'block';
    previewBody.innerHTML = '';

    if (data.globalIssues && data.globalIssues.length > 0) {
      data.globalIssues.forEach(function(iss) {
        var tr = document.createElement('tr');
        tr.style.background = '#ffebe6';
        tr.innerHTML = '<td colspan="5" style="padding: 0.5rem; color: #b31217; font-weight: bold;">[Global Error L' + iss.lineNumber + ']: ' + iss.message + '</td>';
        previewBody.appendChild(tr);
      });
    }

    if (data.questions && data.questions.length > 0) {
      data.questions.forEach(function(q) {
        var tr = document.createElement('tr');
        tr.style.borderBottom = '1px solid #ccd2d6';
        if (!q.isValid) {
          tr.style.background = '#fff8f7';
        }

        var optHtml = '<div style="display: flex; flex-direction: column; gap: 0.2rem;">';
        if (q.options) {
          q.options.forEach(function(o) {
            var badge = o.isCorrect
              ? '<span style="background: var(--color-ink, #14181d); color: #fff; padding: 0.1rem 0.35rem; font-weight: bold; margin-right: 0.35rem;">' + o.label + '</span>'
              : '<span style="border: 1px solid #ccd2d6; padding: 0.1rem 0.35rem; margin-right: 0.35rem;">' + o.label + '</span>';
            optHtml += '<div>' + badge + (o.text || '') + (o.rationale ? ' <em style="color:#666;">(' + o.rationale + ')</em>' : '') + '</div>';
          });
        }
        optHtml += '</div>';

        if (q.explanation) {
          optHtml += '<div style="margin-top: 0.35rem; font-size: 0.8rem; color: #555;"><strong>Expl:</strong> ' + q.explanation + '</div>';
        }

        var statusHtml = q.isValid
          ? '<span style="background: #e6f4ea; color: #0a6b3c; padding: 0.2rem 0.4rem; font-weight: 600; font-size: 0.8rem;">READY</span>'
          : '<div style="color: #b31217; font-size: 0.8rem; font-weight: 600;">';

        if (!q.isValid && q.issues) {
          q.issues.forEach(function(iss) {
            statusHtml += '<div>L' + iss.lineNumber + ': ' + iss.message + '</div>';
          });
          statusHtml += '</div>';
        }

        tr.innerHTML = '<td style="padding: 0.5rem; font-weight: 600;">' + q.index + '</td>' +
                       '<td style="padding: 0.5rem; font-family: var(--font-mono, monospace); color: #666;">' + q.startLineNumber + '-' + q.endLineNumber + '</td>' +
                       '<td style="padding: 0.5rem; font-weight: 500;">' + (q.stem || '<em>[Empty stem]</em>') + (q.categoryCode ? ' <span class="badge" style="font-size:0.75rem; background:#eef;">' + q.categoryCode + '</span>' : '') + '</td>' +
                       '<td style="padding: 0.5rem;">' + optHtml + '</td>' +
                       '<td style="padding: 0.5rem;">' + statusHtml + '</td>';

        previewBody.appendChild(tr);
      });
    }

    if (data.success) {
      summaryBadge.innerHTML = '<span style="color: var(--color-success, #0a6b3c);">&#10004; ' + data.validQuestions + ' question(s) parsed cleanly. Ready to commit.</span>';
      commitBtn.disabled = false;
    } else {
      summaryBadge.innerHTML = '<span style="color: var(--color-danger, #b31217);">&#10008; Found ' + data.errorCount + ' error(s). Please review highlighted rows before committing.</span>';
      commitBtn.disabled = true;
    }
  }

  commitBtn.addEventListener('click', function() {
    if (!currentParsedResult || !currentParsedResult.success || !currentParsedResult.questions || currentParsedResult.questions.length === 0) {
      return;
    }

    var secId = parseInt(sectionSelect.value, 10);
    if (isNaN(secId)) {
      alert('Please select a target section.');
      return;
    }

    var selectedMode = document.querySelector('input[name="qi-mode"]:checked')?.value || 'append';

    if (selectedMode === 'replace') {
      var ok = confirm('WARNING: Replace mode will permanently delete all existing questions in this section for this exam. Are you sure you want to proceed?');
      if (!ok) return;
    }

    commitBtn.disabled = true;
    commitStatus.textContent = 'Committing questions...';

    var commitPayload = {
      sectionId: secId,
      mode: selectedMode,
      questions: currentParsedResult.questions
    };

    fetch('/admin/exams/' + currentExamId + '/quick-ingest/commit', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'RequestVerificationToken': getAntiForgeryToken()
      },
      body: JSON.stringify(commitPayload)
    })
    .then(function(res) {
      return res.json().then(function(data) {
        if (!res.ok) throw new Error(data.message || ('HTTP ' + res.status));
        return data;
      });
    })
    .then(function(data) {
      commitStatus.textContent = data.message || 'Committed successfully.';
      setTimeout(function() {
        closeModal();
        if (typeof onCommitCallback === 'function') {
          onCommitCallback(data);
        } else {
          window.location.reload();
        }
      }, 700);
    })
    .catch(function(err) {
      commitStatus.textContent = 'Commit failed: ' + err.message;
      commitBtn.disabled = false;
    });
  });

  // Expose global controller
  window.QuickIngestModal = {
    open: openModal,
    close: closeModal
  };
})();
</script>
