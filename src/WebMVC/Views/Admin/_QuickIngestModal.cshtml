@* Reusable Quick Ingest Modal for Admin Exams and Exam Studio *@
<div class="modal-overlay" id="quick-ingest-modal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="quick-ingest-title">
  <div class="modal" style="max-width: 1040px; width: 95%; max-height: 92vh; display: flex; flex-direction: column; border: 2px solid var(--color-ink, #14181d); border-radius: 0; box-shadow: none; background: #ffffff;">
    <div class="modal__header row row--between" style="border-bottom: 2px solid var(--color-ink, #14181d); padding: 1rem 1.5rem; background: var(--color-surface, #f8f9fa);">
      <div>
        <h2 id="quick-ingest-title" style="margin: 0; font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-size: 1.25rem;">
          Section-Aware Quick Ingest &amp; Staging Box
        </h2>
        <span class="text-sm text-muted" style="font-family: var(--font-mono, monospace);">Pasting plain text or JSON dynamically validated against active section blueprint</span>
      </div>
      <button type="button" class="btn btn--ghost" id="quick-ingest-close" aria-label="Close dialog" style="font-size: 1.25rem; font-weight: bold; border-radius: 0;">&times;</button>
    </div>

    <div class="modal__body stack" style="padding: 1.5rem; overflow-y: auto; flex: 1; gap: 1.25rem;">
      <!-- Controls bar: Section target, Mode toggle, and sample button -->
      <div class="row row--between row--wrap" style="gap: 1rem; padding: 0.75rem; background: #f0f4f8; border: 1px solid var(--color-border, #ccd2d6);">
        <div class="row" style="gap: 0.75rem; align-items: center;">
          <label for="qi-section-select" style="font-weight: 600; text-transform: uppercase; font-size: 0.85rem;">Target Section:</label>
          <select id="qi-section-select" class="field__input" style="padding: 0.4rem 0.6rem; border-radius: 0; border: 2px solid var(--color-ink, #14181d); min-width: 220px;">
            <!-- Populated dynamically via JS -->
          </select>
        </div>

        <div class="row" style="gap: 1rem; align-items: center;">
          <div class="row" style="gap: 0.5rem; align-items: center;">
            <span style="font-weight: 600; text-transform: uppercase; font-size: 0.85rem;">Mode:</span>
            <label style="display: flex; align-items: center; gap: 0.25rem; cursor: pointer; font-size: 0.9rem;">
              <input type="radio" name="qi-mode" value="append" checked style="accent-color: var(--color-ink, #14181d);">
              Append
            </label>
            <label style="display: flex; align-items: center; gap: 0.25rem; cursor: pointer; font-size: 0.9rem; color: var(--color-danger, #b31217);">
              <input type="radio" name="qi-mode" value="replace" style="accent-color: var(--color-danger, #b31217);">
              Replace section
            </label>
          </div>
          <button type="button" class="btn btn--secondary btn--sm" id="qi-sample-btn" style="border-radius: 0; font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-weight: bold;">
            Load Section Sample
          </button>
        </div>
      </div>

      <!-- Dynamic Section Blueprint Rule Placard -->
      <div id="qi-blueprint-banner" style="background: #ffffff; border: 2px solid var(--color-ink, #14181d); padding: 0.75rem 1rem;">
        <div class="row row--between" style="align-items: center; margin-bottom: 0.35rem;">
          <span style="font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-weight: bold; font-size: 0.85rem; color: var(--color-primary, #0b4ea2);" id="qi-bp-title">
            Active Section Blueprint
          </span>
          <div id="qi-bp-badges" class="row" style="gap: 0.35rem; font-family: var(--font-mono, monospace); font-size: 0.75rem;">
            <!-- Dynamic badges populated via JS -->
          </div>
        </div>
        <div id="qi-bp-guide" style="font-size: 0.82rem; color: #333; line-height: 1.4;">
          <!-- Tailored instructions populated via JS -->
        </div>
      </div>

      <!-- Scratchpad area -->
      <div>
        <div class="row row--between" style="margin-bottom: 0.25rem; align-items: flex-end;">
          <label for="qi-raw-text" style="font-weight: 600; text-transform: uppercase; font-size: 0.85rem;">
            Paste Questions Text or JSON:
          </label>
          <span class="text-xs text-muted" style="font-family: var(--font-mono, monospace);">
            Supports rapid keys (1. A), passages, inline completion, multi-select, and keywords
          </span>
        </div>
        <textarea id="qi-raw-text" class="field__input" rows="8" placeholder="Paste questions here or click 'Load Section Sample'..." style="width: 100%; font-family: var(--font-mono, monospace); font-size: 0.875rem; border: 2px solid var(--color-ink, #14181d); border-radius: 0; padding: 0.75rem;"></textarea>
      </div>

      <div class="row row--between" style="align-items: center;">
        <button type="button" class="btn btn--secondary" id="qi-parse-btn" style="border-radius: 0; font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-weight: bold;">
          Pre-flight Blueprint Validation
        </button>
        <div id="qi-summary-badge" style="font-family: var(--font-mono, monospace); font-weight: 600; font-size: 0.875rem;"></div>
      </div>

      <!-- Live Staging Preview Table -->
      <div id="qi-preview-container" style="display: none;">
        <h3 style="font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-size: 1rem; margin: 0 0 0.5rem 0;">
          Pre-Flight Blueprint Preview
        </h3>
        <div style="overflow-x: auto; border: 2px solid var(--color-ink, #14181d);">
          <table class="table" style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
            <thead>
              <tr style="background: var(--color-surface, #f8f9fa); border-bottom: 2px solid var(--color-ink, #14181d); text-align: left;">
                <th style="padding: 0.5rem; width: 40px;">#</th>
                <th style="padding: 0.5rem; width: 90px;">Type</th>
                <th style="padding: 0.5rem; width: 65px;">Lines</th>
                <th style="padding: 0.5rem;">Stem &amp; Cluster Context</th>
                <th style="padding: 0.5rem;">Options / Keys / Accepted Answers</th>
                <th style="padding: 0.5rem; width: 130px;">Validation</th>
              </tr>
            </thead>
            <tbody id="qi-preview-body">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="modal__footer row row--between" style="border-top: 2px solid var(--color-ink, #14181d); padding: 1rem 1.5rem; background: var(--color-surface, #f8f9fa);">
      <button type="button" class="btn btn--ghost" id="quick-ingest-cancel" style="border-radius: 0;">Cancel</button>
      <div class="row" style="gap: 0.75rem; align-items: center;">
        <span id="qi-commit-status" style="font-family: var(--font-mono, monospace); font-size: 0.85rem;"></span>
        <button type="button" class="btn btn--primary" id="quick-ingest-commit" disabled style="border-radius: 0; font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-weight: bold;">
          Commit Questions to Section
        </button>
      </div>
    </div>
  </div>
</div>

<script src="~/js/admin/quick-ingest.js" asp-append-version="true"></script>
