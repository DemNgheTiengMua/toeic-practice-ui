@using Contracts
@model WebMVC.Models.AdminRefundDetailViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Refund #R-{Model.Refund.RefundId}";
    ViewData["Description"] = "Refund detail, the decision, and the settlement.";

    var refund = Model.Refund;
    var statusClass = refund.Status switch
    {
        RefundStatusDto.Requested => "badge badge--warning",
        RefundStatusDto.Approved => "badge badge--success",
        RefundStatusDto.Settled => "badge badge--info",
        _ => "badge badge--danger",
    };
}

<div class="stack">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/admin" class="breadcrumbs__item">Admin</a>
    <span class="breadcrumbs__separator" aria-hidden="true">›</span>
    <a href="/admin/refunds" class="breadcrumbs__item">Refunds</a>
    <span class="breadcrumbs__separator" aria-hidden="true">›</span>
    <span class="breadcrumbs__item" aria-current="page">#R-@refund.RefundId</span>
  </nav>

  @if (!string.IsNullOrEmpty(Model.ErrorMessage))
  {
    <div class="alert alert--danger" role="alert">@Model.ErrorMessage</div>
  }

  <div class="row row--between">
    <h1 class="m-0">Refund #R-@refund.RefundId</h1>
    <span class="@statusClass">@Model.StatusLabel</span>
  </div>

  <div class="grid-3">
    <div class="stat">
      <div class="stat__label">@(Model.IsMoney ? "Amount" : "Credits")</div>
      <div class="stat__value">@(Model.IsMoney ? Model.Amount : Model.CreditCount)</div>
      <div class="stat__hint">@Model.MethodLabel refund</div>
    </div>
    <div class="stat">
      <div class="stat__label">Learner</div>
      <div class="stat__value">#@refund.UserId</div>
      <div class="stat__hint">@refund.LearnerName · @refund.LearnerEmail</div>
    </div>
    @if (Model.IsMoney)
    {
      <div class="stat">
        <div class="stat__label">Order paid</div>
        <div class="stat__value">@(Model.OrderPaidAmount ?? "No order")</div>
        <div class="stat__hint">@(Model.OrderPaidAmount is null ? "capped by policy instead" : "the ceiling this refund is held to")</div>
      </div>
    }
    else
    {
      <div class="stat">
        <div class="stat__label">@(refund.CreditTxnId.HasValue ? "Ledger row" : "Balance effect")</div>
        <div class="stat__value">@(refund.CreditTxnId.HasValue ? $"#{refund.CreditTxnId.Value}" : "None yet")</div>
        <div class="stat__hint">@(refund.CreditTxnId.HasValue ? "refund_credit in the ledger" : "credits move on approval")</div>
      </div>
    }
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="card__header"><strong>Refund details</strong></div>
      <div class="card__body">
        <dl class="dl-grid">
          <div>
            <dt class="text-muted">Learner</dt>
            <dd class="m-0 fw-600">@refund.LearnerName (user #@refund.UserId)</dd>
          </div>
          <div>
            <dt class="text-muted">Email</dt>
            <dd class="m-0">@refund.LearnerEmail</dd>
          </div>
          <div>
            <dt class="text-muted">Method</dt>
            <dd class="m-0">@Model.MethodLabel</dd>
          </div>
          <div>
            <dt class="text-muted">Value</dt>
            <dd class="m-0 tabular-nums">@(Model.IsMoney ? Model.Amount : $"{Model.CreditCount} credits")</dd>
          </div>
          <div>
            <dt class="text-muted">Order</dt>
            <dd class="m-0">@(refund.OrderCode ?? "No order behind this refund")</dd>
          </div>
          <div>
            <dt class="text-muted">Complaint</dt>
            <dd class="m-0">@(refund.ComplaintId.HasValue ? $"#C-{refund.ComplaintId.Value}" : "—")</dd>
          </div>
          <div>
            <dt class="text-muted">Requested</dt>
            <dd class="m-0">@Model.CreatedAt</dd>
          </div>
          <div>
            <dt class="text-muted">Requested by</dt>
            <dd class="m-0">@(refund.RequestedByUserName ?? "Staff")</dd>
          </div>
          <div>
            <dt class="text-muted">Reason</dt>
            <dd class="m-0">@refund.Reason</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="card">
      <div class="card__header"><strong>Decision</strong></div>
      <div class="card__body">
        @if (refund.DecidedByUserId.HasValue)
        {
          <dl class="dl-grid">
            <div>
              <dt class="text-muted">Decided by</dt>
              <dd class="m-0 fw-600">@(refund.DecidedByUserName ?? "Staff")</dd>
            </div>
            <div>
              <dt class="text-muted">Decided at</dt>
              <dd class="m-0">@Model.DecidedAt</dd>
            </div>
            @if (Model.IsMoney)
            {
              <div>
                <dt class="text-muted">Settled by</dt>
                <dd class="m-0">@(refund.SettledByUserName ?? "Not settled yet")</dd>
              </div>
              <div>
                <dt class="text-muted">Settled at</dt>
                <dd class="m-0">@(Model.SettledAt ?? "—")</dd>
              </div>
            }
            else
            {
              <div>
                <dt class="text-muted">Credits granted</dt>
                <dd class="m-0">
                  @if (refund.GrantedCredits.HasValue && refund.GrantedCredits.Value > 0)
                  {
                    <span>@refund.GrantedCredits.Value credit (refund_credit, txn #@refund.CreditTxnId)</span>
                  }
                  else
                  {
                    <span>None — nothing was paid</span>
                  }
                </dd>
              </div>
            }
          </dl>
          <p class="text-muted text-sm">
            @if (Model.IsMoney)
            {
              <span>A decided money refund is final, and the money counts against revenue only once an accountant settles it. Nothing has left the company before that.</span>
            }
            else
            {
              <span>A decided refund is final. There is no reversal: the ledger is append-only, so a mistake is corrected by an opposing entry rather than by deleting this one.</span>
            }
          </p>
        }
        else
        {
          <p class="text-muted no-margin">
            @(Model.IsMoney
              ? "Nothing has been decided yet. Approval records the decision; the accountant settles it once the transfer is made."
              : "Nothing has been decided yet. Approving pays the credits immediately.")
          </p>
        }
      </div>
      <div class="card__footer">
        <a href="/admin/refunds" class="btn">Back to refunds</a>
      </div>
    </div>
  </div>

  @if (Model.IsRequested)
  {
    <div class="grid-2">
      <form method="post" action="/admin/refunds/@refund.RefundId/approve" class="card" novalidate>
        @Html.AntiForgeryToken()
        <div class="card__header"><strong>Approve</strong></div>
        <div class="card__body stack">
          @if (Model.IsMoney)
          {
            <p class="m-0">Approving records the decision to pay <span class="tabular-nums fw-600">@Model.Amount</span> to @refund.LearnerName. No money moves here.</p>
            <p class="text-muted text-sm no-margin">An accountant pays it outside the product, then settles it here. Settlement is when it counts against revenue.</p>
          }
          else
          {
            <p class="m-0">Approving posts <span class="tabular-nums fw-600">@Model.CreditCount</span> credits to @refund.LearnerName in the same transaction, as a <code>refund_credit</code> ledger row.</p>
            <p class="text-muted text-sm no-margin">The learner's balance moves before this request returns. This cannot be undone.</p>
          }
        </div>
        <div class="card__footer">
          <button type="submit" class="btn btn--primary">@(Model.IsMoney ? "Approve refund" : "Approve and pay credits")</button>
        </div>
      </form>

      <form method="post" action="/admin/refunds/@refund.RefundId/reject" class="card" novalidate>
        @Html.AntiForgeryToken()
        <div class="card__header"><strong>Reject</strong></div>
        <div class="card__body stack">
          <div class="field">
            <label class="field__label" for="rf-reject-reason">Reason for refusal</label>
            <textarea class="field__input" id="rf-reject-reason" name="reason" rows="3" placeholder="Why is this refund refused?…" required></textarea>
            <span class="field__hint">Recorded on the refund. Nothing is paid.</span>
          </div>
        </div>
        <div class="card__footer">
          <button type="submit" class="btn btn--danger">Reject refund</button>
        </div>
      </form>
    </div>
  }

  @if (Model.CanSettle)
  {
    <form method="post" action="/admin/refunds/@refund.RefundId/settle" class="card" novalidate>
      @Html.AntiForgeryToken()
      <div class="card__header"><strong>Settle</strong></div>
      <div class="card__body stack">
        <p class="m-0">Record that <span class="tabular-nums fw-600">@Model.Amount</span> was transferred to @refund.LearnerEmail.</p>
        <p class="text-muted text-sm no-margin">Settlement stamps who confirmed it and when, and is the moment the amount counts against net revenue. It moves no credits and changes no order.</p>
      </div>
      <div class="card__footer">
        <button type="submit" class="btn btn--primary">Mark settled</button>
      </div>
    </form>
  }
</div>
