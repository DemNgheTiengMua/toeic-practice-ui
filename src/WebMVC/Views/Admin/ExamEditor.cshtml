@model WebMVC.Models.ExamEditorViewModel
@{
    Layout = "_AdminLayout";
    var isEdit = Model.IsEdit;
    ViewData["Title"] = isEdit ? $"Edit {Model.Form.Name}" : "Create new exam";
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/admin" class="breadcrumbs__item">Admin</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/admin/exams" class="breadcrumbs__item">Exams</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">@(isEdit ? "Edit exam" : "Create new exam")</span>
</nav>

<div class="row row--between row--wrap" style="align-items: center; margin-bottom: 0.75rem; gap: 0.5rem;">
  <h1 class="no-margin">@(isEdit ? $"Edit: {Model.Form.Name}" : "Create new exam")</h1>
  @if (isEdit && Model.Form.ExamId.HasValue)
  {
    <a href="/admin/exams/@Model.Form.ExamId.Value/studio" class="btn btn--primary" style="border-radius: 0; font-family: var(--font-condensed, sans-serif); text-transform: uppercase;">
      Open in Exam Studio ›
    </a>
  }
</div>

<div class="stepper">
  <a href="@(isEdit ? $"/admin/exams/{Model.Form.ExamId}/edit?step=1" : "#")" class="stepper__item @(Model.Form.Step == 1 ? "is-current" : isEdit ? "is-done" : "")">1. Exam information</a>
  <a href="@(isEdit ? $"/admin/exams/{Model.Form.ExamId}/edit?step=2" : "#")" class="stepper__item @(Model.Form.Step == 2 ? "is-current" : Model.Form.Step > 2 ? "is-done" : "")">2. Upload Listening audio</a>
  <a href="@(isEdit ? $"/admin/exams/{Model.Form.ExamId}/edit?step=3" : "#")" class="stepper__item @(Model.Form.Step == 3 ? "is-current" : "")">3. Enter questions</a>
</div>

@if (!string.IsNullOrEmpty(Model.Form.ErrorMessage))
{
  <div class="alert alert--danger">@Model.Form.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.Form.SuccessMessage))
{
  <div class="alert alert--success">@Model.Form.SuccessMessage</div>
}

@await Html.PartialAsync("~/Views/Admin/_ExamEditorStep1.cshtml", Model)
@await Html.PartialAsync("~/Views/Admin/_ExamEditorStep2.cshtml", Model)
@await Html.PartialAsync("~/Views/Admin/_ExamEditorStep3.cshtml", Model)
@section Scripts {
<script src="~/js/admin/exam-editor.js" asp-append-version="true"></script>
}
