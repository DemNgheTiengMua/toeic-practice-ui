@model WebMVC.Models.CertificateWizardPageViewModel
@{
    Layout = "_AdminLayout";
    var isEdit = Model.IsEdit;
    ViewData["Title"] = isEdit ? $"Edit Certificate: {Model.Form.Name}" : "Certificate Blueprint Wizard";
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/admin" class="breadcrumbs__item">Admin</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/admin/certificates" class="breadcrumbs__item">Certificates</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">@(isEdit ? "Edit Certificate" : "Certificate Wizard")</span>
</nav>

<div class="row row--between row--wrap" style="align-items: center; margin-bottom: 1rem; gap: 0.5rem;">
  <div>
    <h1 class="no-margin" style="font-family: var(--font-condensed, sans-serif); text-transform: uppercase; letter-spacing: 0.05em;">
      @(isEdit ? $"Edit: {Model.Form.Name}" : "Certificate Blueprint Wizard")
    </h1>
    <p class="text-sm text-muted no-margin" style="margin-top: 0.25rem;">Configure the 6 rule axes, timing policies, sitting mechanics, and section authoring blueprints.</p>
  </div>
  @if (isEdit)
  {
    <span class="badge" style="background: var(--color-ink, #14181d); color: #fff; border-radius: 0; font-family: var(--font-mono, monospace);">
      ID: @Model.Form.CertId
    </span>
  }
</div>

<!-- Stepper Navigation -->
<div class="stepper" style="display: flex; gap: 2px; margin-bottom: 1.5rem; background: var(--color-border, #ccd2d6); border: 2px solid var(--color-ink, #14181d);">
  <button type="button" class="stepper__item @(Model.Form.Step == 1 ? "is-current" : Model.Form.Step > 1 ? "is-done" : "")" onclick="goToStep(1)" style="flex: 1; text-align: left; padding: 0.75rem 1rem; border: none; cursor: pointer; border-radius: 0; font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-weight: 700; background: @(Model.Form.Step == 1 ? "var(--color-ink, #14181d)" : "#fff"); color: @(Model.Form.Step == 1 ? "#fff" : "var(--color-ink, #14181d)");">
    1. Starting Blueprint Preset
  </button>
  <button type="button" class="stepper__item @(Model.Form.Step == 2 ? "is-current" : Model.Form.Step > 2 ? "is-done" : "")" onclick="goToStep(2)" style="flex: 1; text-align: left; padding: 0.75rem 1rem; border: none; cursor: pointer; border-radius: 0; font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-weight: 700; background: @(Model.Form.Step == 2 ? "var(--color-ink, #14181d)" : "#fff"); color: @(Model.Form.Step == 2 ? "#fff" : "var(--color-ink, #14181d)");">
    2. Skills &amp; Timing Policies
  </button>
  <button type="button" class="stepper__item @(Model.Form.Step == 3 ? "is-current" : Model.Form.Step > 3 ? "is-done" : "")" onclick="goToStep(3)" style="flex: 1; text-align: left; padding: 0.75rem 1rem; border: none; cursor: pointer; border-radius: 0; font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-weight: 700; background: @(Model.Form.Step == 3 ? "var(--color-ink, #14181d)" : "#fff"); color: @(Model.Form.Step == 3 ? "#fff" : "var(--color-ink, #14181d)");">
    3. Section Blueprint &amp; Tools
  </button>
  <button type="button" class="stepper__item @(Model.Form.Step == 4 ? "is-current" : "")" onclick="goToStep(4)" style="flex: 1; text-align: left; padding: 0.75rem 1rem; border: none; cursor: pointer; border-radius: 0; font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-weight: 700; background: @(Model.Form.Step == 4 ? "var(--color-ink, #14181d)" : "#fff"); color: @(Model.Form.Step == 4 ? "#fff" : "var(--color-ink, #14181d)");">
    4. Scoring Rules &amp; Live Preview
  </button>
</div>

@if (!string.IsNullOrEmpty(Model.Form.ErrorMessage))
{
  <div class="alert alert--danger" style="border: 2px solid #b31217; border-radius: 0; box-shadow: none; margin-bottom: 1.5rem; background: #fff; color: #b31217; font-weight: 600;">
    <strong>Error:</strong> @Model.Form.ErrorMessage
  </div>
}

<form id="wizardForm" method="post" action="/admin/certificates/wizard">
  @Html.AntiForgeryToken()
  <input type="hidden" id="certId" name="CertId" value="@Model.Form.CertId" />
  <input type="hidden" id="presetCode" name="PresetCode" value="@Model.Form.PresetCode" />
  <input type="hidden" id="currentStep" name="Step" value="@Model.Form.Step" />

  @await Html.PartialAsync("~/Views/Admin/_CertificateWizardStep1.cshtml", Model)
  @await Html.PartialAsync("~/Views/Admin/_CertificateWizardStep2.cshtml", Model)
  @await Html.PartialAsync("~/Views/Admin/_CertificateWizardStep3.cshtml", Model)
  @await Html.PartialAsync("~/Views/Admin/_CertificateWizardStep4.cshtml", Model)
</form>

<script src="~/js/admin/certificate-wizard.js" asp-append-version="true"></script>
