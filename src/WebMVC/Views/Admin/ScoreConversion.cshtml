@model AdminScoreConversionViewModel
@{
    Layout = "_AdminLayout";
    var conv = Model.Conversion;
    ViewData["Title"] = "Score conversion";
    ViewData["Description"] = $"Admin score conversion and CEFR band editor for {conv.CertName}.";
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/admin" class="breadcrumbs__item">Admin</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Score conversion</span>
</nav>

<form method="post" action="/admin/score-conversion/@conv.CertId" id="score-conversion-form">
  @Html.AntiForgeryToken()
  <input type="hidden" name="CertCode" value="@conv.CertCode" />
  @if (conv.ExamId.HasValue)
  {
    <input type="hidden" name="ExamId" value="@conv.ExamId.Value" />
  }

  <div class="row row--between row--baseline mb-3">
    <div>
      <h1 class="m-0 mb-1">Score conversion — @conv.CertName</h1>
      <p class="text-sm text-muted no-margin">The number of correct answers is converted to scaled scores and proficiency bands.</p>
    </div>
    <div class="row row--middle">
      <!-- Certificate Switcher -->
      <div class="row row--middle">
        <label for="cert-select" class="text-sm font-semibold m-0">Certificate:</label>
        <select id="cert-select" class="field__input" style="width: auto;" onchange="if (this.value) window.location.href='/admin/score-conversion?cert=' + encodeURIComponent(this.value);">
          @foreach (var c in conv.Certificates)
          {
            <option value="@c.Code" selected="@(c.Code == conv.CertCode ? "selected" : null)">@c.Code — @c.Name</option>
          }
        </select>
      </div>

      <button type="submit" class="btn btn--primary">Save table</button>
    </div>
  </div>

  @if (!string.IsNullOrEmpty(Model.ErrorMessage))
  {
    <div class="alert alert--danger mb-4" role="alert">@Model.ErrorMessage</div>
  }
  @if (!string.IsNullOrEmpty(Model.SuccessMessage))
  {
    <div class="alert alert--success mb-4" role="status">@Model.SuccessMessage</div>
  }

  <div class="alert alert--warning mb-4">
    <strong>Notice:</strong> Score conversions are <strong>monotonic</strong>. An incorrect edit shifts the scores of subsequent mock exam attempts. Previously scored attempts preserve their snapshotted band.
  </div>

  @await Html.PartialAsync("~/Views/Admin/_ScoreConversionScales.cshtml", Model)
  @await Html.PartialAsync("~/Views/Admin/_ScoreConversionBands.cshtml", Model)
  @await Html.PartialAsync("~/Views/Admin/_ScoreConversionPreview.cshtml", Model)
  <script src="~/js/admin/score-conversion.js" asp-append-version="true"></script>

  <div class="row row--end mb-4">
    <button type="submit" class="btn btn--primary">Save table</button>
  </div>
</form>
