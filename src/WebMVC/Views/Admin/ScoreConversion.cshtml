@model AdminScoreConversionViewModel
@{
    Layout = "_AdminLayout";
    var conv = Model.Conversion;
    ViewData["Title"] = "Score conversion";
    ViewData["Description"] = $"Admin score conversion and CEFR band editor for {conv.CertName}.";
    int scaleIndex = 0;
    int bandIndex = 0;
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/admin" class="breadcrumbs__item">Admin</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Score conversion</span>
</nav>

<form method="post" action="/admin/score-conversion/@conv.CertId" id="score-conversion-form">
  @Html.AntiForgeryToken()
  <input type="hidden" name="CertCode" value="@conv.CertCode" />
  @if (conv.ExamId.HasValue)
  {
    <input type="hidden" name="ExamId" value="@conv.ExamId.Value" />
  }

  <div class="row row--between row--baseline mb-3">
    <div>
      <h1 class="m-0 mb-1">Score conversion — @conv.CertName</h1>
      <p class="text-sm text-muted no-margin">The number of correct answers is converted to scaled scores and proficiency bands.</p>
    </div>
    <div class="row row--middle">
      <!-- Certificate Switcher -->
      <div class="row row--middle">
        <label for="cert-select" class="text-sm font-semibold m-0">Certificate:</label>
        <select id="cert-select" class="field__input" style="width: auto;" onchange="if (this.value) window.location.href='/admin/score-conversion?cert=' + encodeURIComponent(this.value);">
          @foreach (var c in conv.Certificates)
          {
            <option value="@c.Code" selected="@(c.Code == conv.CertCode ? "selected" : null)">@c.Code — @c.Name</option>
          }
        </select>
      </div>

      <button type="submit" class="btn btn--primary">Save table</button>
    </div>
  </div>

  @if (!string.IsNullOrEmpty(Model.ErrorMessage))
  {
    <div class="alert alert--danger mb-4" role="alert">@Model.ErrorMessage</div>
  }
  @if (!string.IsNullOrEmpty(Model.SuccessMessage))
  {
    <div class="alert alert--success mb-4" role="status">@Model.SuccessMessage</div>
  }

  <div class="alert alert--warning mb-4">
    <strong>Notice:</strong> Score conversions are <strong>monotonic</strong>. An incorrect edit shifts the scores of subsequent mock exam attempts. Previously scored attempts preserve their snapshotted band.
  </div>

  <!-- Score Scales by Skill -->
  <div class="grid-2 mb-4">
    @foreach (var skillGroup in conv.SkillScales)
    {
      <div class="card">
        <div class="card__header">
          <strong>@skillGroup.SkillName (@skillGroup.SkillCode)</strong>
        </div>
        <div class="card__body" style="max-height: 520px; overflow-y: auto;">
          <table class="table table--striped">
            <thead>
              <tr>
                <th scope="col" style="width: 50%;">Correct answers (Raw)</th>
                <th scope="col" style="width: 50%;">Scaled Score</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var row in skillGroup.Scales)
              {
                var curIdx = scaleIndex++;
                <tr>
                  <td>
                    <strong>@row.RawScore</strong>
                    <input type="hidden" name="Scales[@curIdx].SkillId" value="@row.SkillId" />
                    <input type="hidden" name="Scales[@curIdx].RawScore" value="@row.RawScore" />
                  </td>
                  <td>
                    <input class="field__input"
                           type="number"
                           name="Scales[@curIdx].ScaledScore"
                           value="@row.ScaledScore"
                           min="0"
                           required
                           style="width: 120px;"
                           aria-label="@skillGroup.SkillName score for @row.RawScore correct answers" />
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    }
  </div>

  <!-- Score Bands / CEFR Reference Table -->
  <div class="card mb-4">
    <div class="card__header">
      <div class="row row--between">
        <strong>Proficiency Bands / CEFR Reference (@conv.CertCode)</strong>
        <span class="text-xs text-muted">Ranges must be non-overlapping and monotonic</span>
      </div>
    </div>
    <div class="card__body">
      <p class="text-sm text-muted m-0 mb-3">
        Edit band score thresholds for this certificate. Ranges must not overlap.
      </p>
      <table class="table table--striped">
        <thead>
          <tr>
            <th scope="col">Code</th>
            <th scope="col">Band Name</th>
            <th scope="col">Min Total</th>
            <th scope="col">Max Total</th>
            <th scope="col">Order</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var band in conv.Bands)
          {
            var curBandIdx = bandIndex++;
            <tr>
              <td>
                <input type="hidden" name="Bands[@curBandIdx].BandId" value="@band.BandId" />
                <input class="field__input"
                       type="text"
                       name="Bands[@curBandIdx].Code"
                       value="@band.Code"
                       readonly
                       style="width: 120px; font-weight: 700; background: var(--surface-soft); cursor: not-allowed;"
                       aria-label="Band Code" />
              </td>
              <td>
                <input class="field__input"
                       type="text"
                       name="Bands[@curBandIdx].Name"
                       value="@band.Name"
                       required
                       style="width: 220px;"
                       aria-label="Band Name" />
              </td>
              <td>
                <input class="field__input"
                       type="number"
                       name="Bands[@curBandIdx].MinTotal"
                       value="@band.MinTotal"
                       min="0"
                       required
                       style="width: 100px;"
                       aria-label="Min Total Score" />
              </td>
              <td>
                <input class="field__input"
                       type="number"
                       name="Bands[@curBandIdx].MaxTotal"
                       value="@band.MaxTotal"
                       min="0"
                       required
                       style="width: 100px;"
                       aria-label="Max Total Score" />
              </td>
              <td>
                <input class="field__input"
                       type="number"
                       name="Bands[@curBandIdx].DisplayOrder"
                       value="@band.DisplayOrder"
                       style="width: 70px;"
                       aria-label="Display Order" />
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>

  
  <!-- Interactive Live Score Preview Calculator Sandbox -->
  <div class="card mb-4" style="border: 2px solid var(--color-ink, #14181d); border-radius: 0; box-shadow: none;">
    <div class="card__header" style="background: #0b4ea2; color: #fff; padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center;">
      <strong style="font-family: var(--font-condensed, sans-serif); text-transform: uppercase;">
        BẢNG HIỆU PHÒNG THI &bull; LIVE SCORE PREVIEW SANDBOX
      </strong>
      <span class="badge" style="background: #fff; color: #0b4ea2; border-radius: 0; font-family: var(--font-mono, monospace); font-weight: 700;">
        Interactive Sandbox
      </span>
    </div>
    <div class="card__body" style="padding: 1.25rem;">
      <p class="text-sm text-muted m-0 mb-3">
        Test raw score conversions and band matching in real time. Adjust sample correct answers to see calculated totals against configured bands.
      </p>

      <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; align-items: start;">
        <div>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem;">
            @foreach (var skillGroup in conv.SkillScales)
            {
              var maxQ = skillGroup.MaxQuestions > 0 ? skillGroup.MaxQuestions : 100;
              var defaultVal = maxQ * 3 / 4;
              <div style="border: 1px solid var(--color-ink, #14181d); padding: 0.75rem; background: #fafafa;">
                <div style="font-family: var(--font-condensed, sans-serif); font-weight: 700; text-transform: uppercase; font-size: 0.85rem; margin-bottom: 0.35rem;">
                  @skillGroup.SkillName (@skillGroup.SkillCode)
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
                  <input type="number" min="0" max="@maxQ"
                         class="field__input sc-sandbox-input"
                         data-skill-id="@skillGroup.SkillId"
                         data-max-q="@maxQ"
                         value="@defaultVal"
                         oninput="recalculateConversionSandbox()"
                         style="width: 80px; border: 2px solid var(--color-ink, #14181d); border-radius: 0; font-family: var(--font-mono, monospace); font-weight: 700; text-align: center;">
                  <span class="text-xs text-muted">/ @maxQ raw</span>
                </div>
                <div class="text-xs text-muted" style="font-family: var(--font-mono, monospace);">
                  Scaled: <strong class="sc-sandbox-scaled" data-skill-id="@skillGroup.SkillId">--</strong>
                </div>
              </div>
            }
          </div>
        </div>

        <div style="border: 2px solid var(--color-ink, #14181d); padding: 1.25rem; background: var(--color-ink, #14181d); color: #fff;">
          <div style="font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.1em; opacity: 0.8; margin-bottom: 0.25rem;">
            SIMULATED TOTAL SCORE
          </div>
          <div id="scSandboxTotal" style="font-family: var(--font-mono, monospace); font-size: 2.75rem; font-weight: 700; line-height: 1; color: #f2b705; margin-bottom: 0.5rem;">
            --
          </div>
          <div style="border-top: 1px solid rgba(255,255,255,0.2); padding-top: 0.75rem; margin-top: 0.75rem;">
            <div style="font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-size: 0.75rem; opacity: 0.8; margin-bottom: 0.35rem;">
              MATCHED PROFICIENCY BAND
            </div>
            <div id="scSandboxBand" style="display: inline-block; background: #0a6b3c; color: #fff; padding: 0.35rem 0.75rem; font-family: var(--font-mono, monospace); font-weight: 700; font-size: 1rem;">
              --
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function recalculateConversionSandbox() {
      var inputs = document.querySelectorAll('.sc-sandbox-input');
      var total = 0;
      inputs.forEach(function(inp) {
        var skillId = inp.getAttribute('data-skill-id');
        var rawVal = parseInt(inp.value, 10) || 0;
        var maxQ = parseInt(inp.getAttribute('data-max-q'), 10) || 100;

        // Try to lookup from the scale table on the page
        var scaleInput = document.querySelector('input[name$=".RawScore"][value="' + rawVal + '"]');
        var scaled = 0;
        if (scaleInput) {
          var row = scaleInput.closest('tr');
          var scaledInput = row ? row.querySelector('input[name$=".ScaledScore"]') : null;
          if (scaledInput) scaled = parseInt(scaledInput.value, 10) || 0;
        } else {
          // Fallback proportional
          scaled = Math.round((rawVal / maxQ) * 495 / 5) * 5;
        }

        var scaledLabel = document.querySelector('.sc-sandbox-scaled[data-skill-id="' + skillId + '"]');
        if (scaledLabel) scaledLabel.textContent = scaled;
        total += scaled;
      });

      var totalEl = document.getElementById('scSandboxTotal');
      if (totalEl) totalEl.textContent = total;

      // Check bands on page
      var bandRows = document.querySelectorAll('input[name$=".MinTotal"]');
      var matchedBand = null;
      bandRows.forEach(function(minInp) {
        var row = minInp.closest('tr');
        var minVal = parseInt(minInp.value, 10) || 0;
        var maxInp = row ? row.querySelector('input[name$=".MaxTotal"]') : null;
        var maxVal = maxInp ? parseInt(maxInp.value, 10) || 0 : 0;
        var nameInp = row ? row.querySelector('input[name$=".Name"]') : null;
        var codeInp = row ? row.querySelector('input[name$=".Code"]') : null;

        if (total >= minVal && total <= maxVal) {
          matchedBand = (codeInp ? codeInp.value : '') + ' • ' + (nameInp ? nameInp.value : '');
        }
      });

      var bandEl = document.getElementById('scSandboxBand');
      if (bandEl) bandEl.textContent = matchedBand || 'NO BAND MATCH';
    }

    document.addEventListener('DOMContentLoaded', function() {
      recalculateConversionSandbox();
    });
  </script>

  <div class="row row--end mb-4">
    <button type="submit" class="btn btn--primary">Save table</button>
  </div>
</form>
