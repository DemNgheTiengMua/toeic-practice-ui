@model WebMVC.Models.AuditKeyRevealViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Sample {Model.SampleItemId} key";
}

@* #206 / S-03 / W-01: the authored key, on its own page and only after a solve. This page is what
   "solve blind before seeing the AI key" means in practice: the key has no other route to the screen. *@
@section Styles {
  <link rel="stylesheet" href="~/css/admin/audit.css" asp-append-version="true" />
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/admin" class="breadcrumbs__item">Admin</a>
  <span class="breadcrumbs__separator" aria-hidden="true">/</span>
  <a href="/admin/ingestion/@Model.BatchId" class="breadcrumbs__item">Batch @Model.BatchId</a>
  <span class="breadcrumbs__separator" aria-hidden="true">/</span>
  <a href="/admin/audit/@Model.BatchId" class="breadcrumbs__item">Audit</a>
  <span class="breadcrumbs__separator" aria-hidden="true">/</span>
  <span class="breadcrumbs__item" aria-current="page">Key of item @Model.ItemId</span>
</nav>

<div class="audit-head">
  <h1 class="audit-head__title">The authored key of item @Model.ItemId</h1>
  <p class="text-sm text-muted audit-head__lede">
    Your solve was <span class="font-mono audit-reveal__solve">@Model.SolvedLabel</span>, recorded
    before this key was read. Read <span class="font-mono">@Model.RevealedAt</span>.
  </p>
</div>

@if (Model.ErrorMessage is not null)
{
  <div class="alert alert--danger" role="alert">@Model.ErrorMessage</div>
}

@* The comparison the reviewer's judgement is made of, stated as two values rather than left to memory. *@
<section class="audit-reveal" aria-labelledby="audit-reveal-title">
  <h2 class="audit-subhead" id="audit-reveal-title">Your answer against the key</h2>

  <div class="audit-reveal__pair">
    <div class="audit-reveal__side">
      <span class="audit-reveal__label">Your solve</span>
      <span class="audit-reveal__value font-mono" id="audit-solved-label">@Model.SolvedLabel</span>
    </div>
    <div class="audit-reveal__side">
      <span class="audit-reveal__label">Authored key</span>
      <span class="audit-reveal__value font-mono" id="audit-key-label">@Model.KeyLabel</span>
    </div>
  </div>

  @if (Model.Explanation is not null)
  {
    <div class="audit-reveal__explanation">
      <h3 class="audit-reveal__subhead">The author's explanation</h3>
      <p>@Model.Explanation</p>
    </div>
  }

  <p class="audit-hint">
    A <strong>key error</strong> is a wrong answer key. One of these quarantines the whole stratum,
    because a wrong key is systematic rather than occasional. A <strong>non-key defect</strong> is level
    drift, an unnatural distractor or a broken explanation: real, but not the same finding.
  </p>

  <form class="audit-verdict audit-verdict--reveal" method="post"
        action="/admin/audit/@Model.BatchId/samples/@Model.SampleItemId/verdict">
    @Html.AntiForgeryToken()
    <button class="btn btn--primary" type="submit" name="verdict" value="correct">
      The key is correct
    </button>
    <button class="btn audit-verdict__key-error" type="submit" name="verdict" value="key_error">
      Key error
    </button>
    <button class="btn audit-verdict__defect" type="submit" name="verdict" value="non_key_defect">
      Non-key defect
    </button>
  </form>

  <p class="audit-hint">
    <a class="audit-back" href="/admin/audit/@Model.BatchId">Back to the queue</a>
  </p>
</section>
