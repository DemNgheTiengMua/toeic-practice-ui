@model WebMVC.Models.ExamAssemblyViewModel
@using WebMVC.Models
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Assembly — {Model.ExamName}";
}

@* #225 / S-09: the assembly workbench. A paper is assembled from the warehouse, so the screen's whole
   subject is the gap between what the certificate declares and what the pool can supply. The two
   number columns are the table's spine and they are aligned, mono and right-hand, so a shortfall is
   read as a distance rather than noticed by eye. *@

@section Styles {
  <link rel="stylesheet" href="~/css/admin/exam-assembly.css" asp-append-version="true" />
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/admin" class="breadcrumbs__item">Admin</a>
  <span class="breadcrumbs__separator" aria-hidden="true">/</span>
  <a href="/admin/exams" class="breadcrumbs__item">Exams</a>
  <span class="breadcrumbs__separator" aria-hidden="true">/</span>
  <span class="breadcrumbs__item" aria-current="page">Assembly</span>
</nav>

<div class="row row--between row--wrap assembly-head">
  <div>
    <h1 class="assembly-head__title">@Model.ExamName</h1>
    <p class="text-sm text-muted assembly-head__lede">
      @Model.CertCode · @Model.TierLabel · @Model.DurationMinutes min
      @if (Model.IsProductionTier)
      {
        <text> · production paper: demo stock cannot be bound (INV-6)</text>
      }
    </p>
  </div>

  <div class="row" style="gap: var(--space-2);">
    <a class="btn btn--secondary btn--sm" href="/admin/exams/@Model.ExamId/preview">Preview as a learner</a>
    <a class="btn btn--secondary btn--sm" href="/admin/exams/@Model.ExamId/studio">Question studio</a>
    <a class="btn btn--ghost btn--sm" href="/admin/exams">All exams</a>
  </div>
</div>

@if (Model.IsLocked)
{
  <div class="assembly-lock" role="note">
    <span class="assembly-lock__mark">LOCKED</span>
    <p class="assembly-lock__text">
      @Model.FinishedAttemptCount learner @(Model.FinishedAttemptCount == 1 ? "attempt has" : "attempts have")
      finished this paper, so its structure is fixed. Nothing here can be bound or moved: the reading
      stays so an audit can see the paper those attempts were scored against.
    </p>
  </div>
}

@if (Model.HasNoSections)
{
  <div class="card">
    <div class="card__body">
      <div class="state-block">
        <div class="state-block__icon state-block__icon--danger" aria-hidden="true">EMPTY</div>
        <h2 class="state-block__title">This certificate declares no section</h2>
        <p class="state-block__desc">
          A paper is assembled into the shape its certificate declares, so there is nothing to fill.
          Declare the certificate's sections first, then come back.
        </p>
      </div>
    </div>
  </div>
}
else
{
  <div class="assembly-legend" role="note" aria-label="How to read a section">
    <span class="assembly-legend__item assembly-row--empty">Nothing servable</span>
    <span class="assembly-legend__item assembly-row--short">Short of the declared count</span>
    <span class="assembly-legend__item assembly-row--met">Can fill what is declared</span>
    <span class="assembly-legend__note">
      Supply counts active versions only, in this paper's tier. Draft, validated, quarantined and
      retired items are not stock a learner is served.
    </span>
  </div>

  <div class="assembly-table-wrap">
    <table class="assembly-table">
      <caption class="visually-hidden">Sections, the count each declares, and the active stock the pool supplies</caption>
      <thead>
        <tr>
          <th scope="col" class="assembly-table__section">Section</th>
          <th scope="col" class="assembly-table__num">Declares</th>
          <th scope="col" class="assembly-table__num">Servable</th>
          <th scope="col" class="assembly-table__num">Gap</th>
          <th scope="col" class="assembly-table__num">Bound</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var sec in Model.Sections)
        {
          <tr class="assembly-row @sec.StateClass" id="assembly-section-@sec.SectionId">
            <th scope="row" class="assembly-table__section">
              <span class="assembly-section__code font-mono">@sec.Code</span>
              <span class="assembly-section__name">@sec.Name</span>
              <span class="assembly-section__skill">@sec.ModalityLabel</span>
            </th>
            <td class="assembly-table__num font-mono assembly-figure assembly-figure--declared"
                data-figure="declared">@sec.Declared</td>
            <td class="assembly-table__num font-mono assembly-figure assembly-figure--supply"
                data-figure="supply">@sec.Supply</td>
            <td class="assembly-table__num font-mono assembly-figure assembly-figure--gap"
                data-figure="shortfall">@sec.ShortfallText</td>
            <td class="assembly-table__num font-mono assembly-figure" data-figure="bound">@sec.BoundText</td>
          </tr>
        }
      </tbody>
    </table>
  </div>

  @foreach (var sec in Model.Sections)
  {
    <section class="assembly-section" aria-labelledby="assembly-plan-@sec.SectionId">
      <div class="assembly-section__head">
        <h2 class="assembly-section__title" id="assembly-plan-@sec.SectionId">
          <span class="font-mono">@sec.Code</span> @sec.Name
        </h2>
        <span class="badge assembly-section__state @sec.StateClass">
          @if (sec.IsEmpty)
          {
            <text>Nothing servable</text>
          }
          else if (sec.IsShort)
          {
            <text>@sec.ShortfallText</text>
          }
          else
          {
            <text>Can fill @sec.Declared</text>
          }
        </span>
      </div>

      <div class="assembly-section__body">
        @* ---------------- positions: the shape the paper declares ---------------- *@
        <div class="assembly-positions">
          <h3 class="assembly-subhead">Positions</h3>
          <ol class="assembly-position-list">
            @foreach (var position in sec.Positions)
            {
              <li class="assembly-position @(position.IsBound ? "assembly-position--bound" : "assembly-position--open")">
                <span class="assembly-position__number font-mono">@position.DisplayOrder</span>
                <span class="assembly-position__body">
                  @if (position.IsBound)
                  {
                    <span class="assembly-position__topic font-mono">@position.TopicCode</span>
                    <span class="assembly-position__meta">@position.CefrLevelLabel · unit @position.UnitNumber</span>
                  }
                  else
                  {
                    <span class="assembly-position__topic assembly-position__topic--empty">Unbound</span>
                    <span class="assembly-position__meta">No version sits here</span>
                  }
                </span>
              </li>
            }
          </ol>
        </div>

        @* ---------------- candidates: what the pool can supply ---------------- *@
        <div class="assembly-candidates">
          <h3 class="assembly-subhead">Servable versions</h3>
          <p class="assembly-candidates__summary text-sm text-muted" data-candidate-summary>
            @sec.CandidateSummary
          </p>

          @if (sec.Candidates.Count == 0)
          {
            <p class="assembly-empty-note">
              No active version in this paper's tier serves this skill. The pool cannot fill this
              section, and binding will refuse until stock is made servable.
            </p>
          }
          else
          {
            <ul class="assembly-candidate-list">
              @foreach (var candidate in sec.Candidates)
              {
                <li class="assembly-candidate">
                  <div class="assembly-candidate__text">
                    <span class="assembly-candidate__stem">@candidate.Stem</span>
                    <span class="assembly-candidate__meta font-mono">
                      @candidate.TopicCode · @candidate.CefrLevelLabel · v@candidate.VersionNumber · @candidate.ItemTypeLabel
                    </span>
                    <span class="assembly-candidate__tier">@candidate.TierLabel</span>
                  </div>

                  @if (!Model.IsLocked)
                  {
                    <form method="post" action="/admin/exams/@Model.ExamId/assembly/bind" class="assembly-bind">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="SectionId" value="@sec.SectionId" />
                      <input type="hidden" name="SectionCode" value="@sec.Code" />
                      <input type="hidden" name="ItemVersionId" value="@candidate.ItemVersionId" />
                      <label class="assembly-bind__field">
                        <span class="assembly-bind__label">Position</span>
                        <input class="assembly-bind__input font-mono" type="number" name="DisplayOrder"
                               min="1" max="@sec.Declared" value="@sec.NextOpenPosition" required />
                      </label>
                      <label class="assembly-bind__field">
                        <span class="assembly-bind__label">Unit</span>
                        <input class="assembly-bind__input font-mono" type="number" name="UnitNumber"
                               min="1" value="1" required />
                      </label>
                      <button type="submit" class="btn btn--primary btn--sm">Bind</button>
                    </form>
                  }
                </li>
              }
            </ul>
          }
        </div>
      </div>
    </section>
  }
}
