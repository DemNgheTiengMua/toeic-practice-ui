@model WebMVC.Models.StimulusStudioViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Stimulus studio — {Model.SkillLabel}";
}

@* #203 / S-05: the split canvas. ADM-07's two halves are the two panels: the stimulus is pinned left,
   its children stack right, and both are one document until the save. *@
<div id="studio-csrf-holder" style="display:none;">
  @Html.AntiForgeryToken()
</div>

@section Styles {
  <link rel="stylesheet" href="~/css/admin/stimulus-studio.css" asp-append-version="true" />
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/admin" class="breadcrumbs__item">Admin</a>
  <span class="breadcrumbs__separator" aria-hidden="true">/</span>
  <span class="breadcrumbs__item" aria-current="page">Stimulus studio</span>
</nav>

<div class="row row--between row--wrap studio-head">
  <div>
    <h1 class="studio-head__title">Stimulus and children</h1>
    <p class="text-sm text-muted studio-head__lede">
      One passage or audio track, authored with the two to four questions that cite it. Nothing is
      written until the whole bundle passes: a stimulus and its children enter the pool together.
    </p>
  </div>

  <div class="studio-skill-switch" role="group" aria-label="Skill">
    @foreach (var skill in new[] { ("reading", "Reading"), ("listening", "Listening") })
    {
      <a href="/admin/studio/stimulus?skill=@skill.Item1"
         class="studio-skill-switch__item @(Model.SkillCode == skill.Item1 ? "is-selected" : string.Empty)"
         aria-current="@(Model.SkillCode == skill.Item1 ? "page" : "false")">@skill.Item2</a>
    }
  </div>
</div>

@if (Model.ErrorMessage is not null)
{
  <div class="alert alert--danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.HasOptions)
{
  <div class="studio-config" data-configuration="@Model.ConfigurationJson" data-skill="@Model.SkillCode"></div>

  <div class="studio-canvas">

    @* ---------------- left: the stimulus, pinned ---------------- *@
    <section class="studio-pane studio-pane--stimulus" aria-labelledby="studio-stimulus-title">
      <div class="studio-pane__head">
        <h2 id="studio-stimulus-title" class="studio-pane__title">Stimulus</h2>
        <span class="studio-pane__code font-mono" id="studio-span-unit">@(Model.SkillCode == "listening" ? "sec" : "char")</span>
      </div>

      <div class="studio-field">
        <label class="studio-label" for="studio-level">Stimulus level</label>
        @* ADM-08: not a plain dropdown. The six bands are painted placards, and the gauges below report
           what the text actually measures, naming the band it fits when that differs. *@
        <div class="studio-levels" role="radiogroup" aria-label="Stimulus level">
          @foreach (var level in Model.Levels)
          {
            <button type="button" class="studio-level" role="radio" aria-checked="false"
                    data-level="@level.Code" value="@level.Code">@level.Label</button>
          }
        </div>
        <input type="hidden" id="studio-level" name="stimulusLevel" value="" />
      </div>

      <div class="studio-field">
        <label class="studio-label" for="studio-type">Item type</label>
        <select class="studio-select" id="studio-type" name="itemType">
          @foreach (var type in Model.Types)
          {
            <option value="@type.Code">@type.Label</option>
          }
        </select>
      </div>

      <div class="studio-field">
        <label class="studio-label" for="studio-domain">Domain context</label>
        <select class="studio-select" id="studio-domain" name="domainContext">
          <option value="general">General</option>
          <option value="workplace">Workplace</option>
          <option value="academic">Academic</option>
        </select>
      </div>

      @* The gauges. Four, or fewer for a skill D0.2 does not profile; a gauge with no bound says so. *@
      <div class="studio-gauges" id="studio-gauges" role="status" aria-live="polite">
        <h3 class="studio-subhead">Measured</h3>
        <ul class="studio-gauge-list" id="studio-gauge-list">
          <li class="studio-gauge studio-gauge--unmeasured">
            <span class="studio-gauge__label">Nothing measured yet</span>
            <span class="studio-gauge__value font-mono">—</span>
          </li>
        </ul>
        <p class="studio-verdict" id="studio-verdict">Select a level and paste the text to see which band it fits.</p>
      </div>

      <div class="studio-field">
        <label class="studio-label" for="studio-passage" id="studio-text-label">
          @(Model.SkillCode == "listening" ? "Transcript" : "Passage")
        </label>
        <textarea class="studio-textarea" id="studio-passage" name="stimulusText" rows="12"
                  aria-describedby="studio-text-hint"></textarea>
        <p class="studio-hint" id="studio-text-hint">
          Select text, then press a child's Bind button. Each child keeps its own colour, and the
          overlap figure below the stack turns red at the 0.15 ceiling.
        </p>
      </div>

      @* A textarea cannot paint a highlight, so the bound spans are drawn here, over a copy of the same
         text. The spans a child cites are the one thing this screen exists to show. *@
      <div class="studio-field">
        <span class="studio-label">Bound spans</span>
        <div class="studio-preview" id="studio-preview" aria-live="polite">
          <p class="studio-preview__empty" id="studio-preview-empty">No child is bound to a span yet.</p>
        </div>
      </div>

      @if (Model.SkillCode == "listening")
      {
        <div class="studio-field">
          <label class="studio-label" for="studio-audio">Audio file</label>
          <input class="studio-input" type="text" id="studio-audio" name="audioPath"
                 placeholder="audio/b1-monologue.mp3" />
        </div>
      }
    </section>

    @* ---------------- right: the children, stacked ---------------- *@
    <section class="studio-pane studio-pane--children" aria-labelledby="studio-children-title">
      <div class="studio-pane__head">
        <h2 id="studio-children-title" class="studio-pane__title">Child items</h2>
        <span class="studio-pane__count font-mono" id="studio-slot-count" data-locked="0">0 slots</span>
      </div>

      <div class="studio-slots" id="studio-slots" aria-live="polite">
        <p class="studio-empty" id="studio-slots-empty">
          Select a stimulus level. The count of children is fixed by the level, and that many slots
          appear here.
        </p>
      </div>

      @* AC2 and AC3: the two live indicators. Both are painted fields with the figure and the word, so
         colour is a second layer and never the only thing that says "over the ceiling". *@
      <div class="studio-indicators">
        <div class="studio-indicator" id="studio-overlap-indicator" data-state="clear">
          <span class="studio-indicator__label">Sibling overlap</span>
          <span class="studio-indicator__value font-mono" id="studio-overlap-value">0.00</span>
          <span class="studio-indicator__note" id="studio-overlap-note">No child is bound to a span yet.</span>
        </div>

        <div class="studio-indicator" id="studio-gap-indicator" data-state="clear"
             @(Model.SkillCode == "listening" ? string.Empty : "hidden")>
          <span class="studio-indicator__label">Evidence gap</span>
          <span class="studio-indicator__value font-mono" id="studio-gap-value">—</span>
          <span class="studio-indicator__note" id="studio-gap-note">Adjacent detail items need 8.0 s.</span>
        </div>
      </div>

      <div class="studio-save-row">
        <p class="studio-save-status" id="studio-save-status" role="status" aria-live="polite">
          Nothing to save yet.
        </p>
        <button type="button" class="btn btn--primary" id="studio-save" disabled>Save bundle</button>
      </div>

      <div class="studio-refusals" id="studio-refusals" aria-live="polite"></div>
    </section>
  </div>

  <template id="studio-slot-template">
    <article class="studio-slot" data-colour="1">
      <header class="studio-slot__head">
        <span class="studio-slot__number font-mono" data-slot-number>1</span>
        <span class="studio-slot__swatch" data-slot-swatch aria-hidden="true"></span>
        <label class="studio-label studio-label--inline">
          <span class="visually-hidden">Child level</span>
          <select class="studio-select studio-select--sm" data-slot-level></select>
        </label>
        <label class="studio-label studio-label--inline">
          <span class="visually-hidden">Child topic</span>
          <select class="studio-select studio-select--sm" data-slot-topic>
            @foreach (var topic in Model.Topics)
            {
              <option value="@topic.Code">@topic.Code · @topic.Name</option>
            }
          </select>
        </label>
      </header>

      <div class="studio-field">
        <label class="studio-label">Stem</label>
        <input class="studio-input" type="text" data-slot-stem maxlength="200" />
      </div>

      <div class="studio-options">
        @foreach (var label in new[] { "A", "B", "C", "D" })
        {
          <div class="studio-option" data-option="@label">
            <label class="studio-option__key">
              <input type="radio" name="key-@label" data-slot-key value="@label" />
              <span class="studio-option__badge font-mono">@label</span>
              <span class="visually-hidden">Mark @label as the key</span>
            </label>
            <input class="studio-input studio-input--option" type="text" data-slot-option maxlength="200"
                   placeholder="Option @label" />
            <input class="studio-input studio-input--rationale" type="text" data-slot-rationale maxlength="200"
                   placeholder="Why this option is what it is" />
          </div>
        }
      </div>

      <div class="studio-field studio-field--row">
        <div>
          <label class="studio-label">Evidence span</label>
          <div class="studio-span">
            <input class="studio-input studio-input--num font-mono" type="number" data-slot-span-start
                   placeholder="start" min="0" />
            <span class="studio-span__dash" aria-hidden="true">–</span>
            <input class="studio-input studio-input--num font-mono" type="number" data-slot-span-end
                   placeholder="end" min="0" />
            <span class="studio-span__unit font-mono" data-slot-span-unit>@(Model.SkillCode == "listening" ? "sec" : "char")</span>
          </div>
        </div>
        <div>
          <label class="studio-label">Bind</label>
          <button type="button" class="btn btn--secondary btn--sm studio-bind" data-slot-bind>
            Bind selected text
          </button>
        </div>
      </div>

      <div class="studio-field">
        <label class="studio-label">Explanation</label>
        <textarea class="studio-textarea studio-textarea--sm" rows="2" data-slot-explanation></textarea>
      </div>

      <p class="studio-slot__refusals" data-slot-refusals></p>
    </article>
  </template>
}

@section Scripts {
  <script src="~/js/admin/stimulus-studio.js" asp-append-version="true"></script>
}
