@model WebMVC.Models.AdminImportsViewModel
@inject WebMVC.DateTimeFormatter Formatter
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Question import";
    ViewData["Description"] = "Import exams and questions from an ingest manifest or package.";
    var certs = Model.Batches.Certificates;
    var selected = Model.SelectedBatch;

    string StatusClass(ImportBatchStatusDto status) => status switch
    {
        ImportBatchStatusDto.Done => "badge badge--success",
        ImportBatchStatusDto.Failed => "badge badge--danger",
        _ => "badge badge--warning",
    };

    string StatusLabel(ImportBatchStatusDto status) => status switch
    {
        ImportBatchStatusDto.Done => "Imported",
        ImportBatchStatusDto.Failed => "Failed",
        _ => "Pending",
    };
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/admin" class="breadcrumbs__item">Admin</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Question import</span>
</nav>

<h1>Question import</h1>

<div class="card">
  <div class="card__header"><h2>Upload</h2></div>
  <div class="card__body">
    <p class="text-muted">
      Each upload becomes one <strong>draft</strong> exam. The whole file is checked first: if anything is wrong,
      nothing is imported and every problem is listed in the log. Use a <code>.json</code> manifest for text-only
      content, or a <code>.zip</code> with <code>manifest.json</code> and a <code>media/</code> folder when questions
      have audio or images. The format is described in ADR-0007, with examples in <code>docs/samples</code>.
    </p>
    <form method="post" action="/admin/imports" enctype="multipart/form-data" class="stack">
      @Html.AntiForgeryToken()
      <div class="grid-2">
        <div class="field">
          <label class="field__label" for="imp-cert">Certificate</label>
          <select class="field__input" id="imp-cert" name="certId" required>
            <option value="">Choose a certificate</option>
            @foreach (var cert in certs)
            {
              <option value="@cert.CertId" selected="@(cert.CertId == Model.CertId)">@cert.Code — @cert.Name</option>
            }
          </select>
          <div class="field__hint">Section, category and criterion codes are looked up in this certificate.</div>
        </div>
        <div class="field">
          <label class="field__label" for="imp-file">Manifest or package</label>
          <div class="upload">
            <div class="upload__zone">
              <input class="field__input" id="imp-file" name="file" type="file" accept=".json,.zip,application/json,application/zip" required aria-describedby="imp-file-hint">
            </div>
          </div>
          <div class="field__hint" id="imp-file-hint">.json or .zip, up to 100 MB. Audio: .mp3, .wav. Images: .jpg, .png.</div>
        </div>
      </div>
      <div>
        <button type="submit" class="btn btn--primary">Validate and import</button>
      </div>
    </form>
  </div>
</div>

@if (selected is not null)
{
  var batch = selected.Batch;
  <div class="card" id="batch-@batch.BatchId">
    <div class="card__header row row--between">
      <h2>Batch @batch.BatchId — <code>@batch.SourceName</code></h2>
      <span class="@StatusClass(batch.Status)">@StatusLabel(batch.Status)</span>
    </div>
    <div class="card__body">
      <p class="text-muted">
        @batch.CertCode · uploaded by @batch.UploadedByEmail · @Formatter.Format(batch.CreatedAt)
        @if (batch.Status == ImportBatchStatusDto.Done)
        {
          <span>· <a href="/admin/exams?certId=@batch.CertId">Open the exam list</a> to review and publish it.</span>
        }
      </p>
      @if (selected.Logs.Count == 0)
      {
        <p>No log entries.</p>
      }
      else
      {
        <table class="table">
          <caption class="visually-hidden">Import log for batch @batch.BatchId</caption>
          <thead>
            <tr>
              <th scope="col">Level</th>
              <th scope="col">Question</th>
              <th scope="col">Message</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var log in selected.Logs)
            {
              <tr>
                <td>
                  <span class="badge @(log.Level switch { ImportLogLevelDto.Error => "badge--danger", ImportLogLevelDto.Warn => "badge--warning", _ => "badge--info" })">@log.Level.ToWireCode()</span>
                </td>
                <td>@(log.RowNo?.ToString() ?? "—")</td>
                <td>@log.Message</td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>
}

<div class="card">
  <div class="card__header row row--between">
    <h2>Import history</h2>
    <form method="get" action="/admin/imports" class="row">
      <label class="visually-hidden" for="hist-cert">Filter by certificate</label>
      <select class="field__input" id="hist-cert" name="certId">
        <option value="">All certificates</option>
        @foreach (var cert in certs)
        {
          <option value="@cert.CertId" selected="@(cert.CertId == Model.CertId)">@cert.Code</option>
        }
      </select>
      <button type="submit" class="btn btn--sm">Filter</button>
    </form>
  </div>
  <div class="card__body">
    @if (Model.Batches.Batches.Count == 0)
    {
      <div class="state-block">
        <div class="state-block__icon" aria-hidden="true">EMPTY</div>
        <h2 class="state-block__title">No imports yet</h2>
        <p class="state-block__desc">Upload a manifest above. Try <code>docs/samples/sample-reading-mcq.json</code> with TOEIC first.</p>
      </div>
    }
    else
    {
      <table class="table table--striped">
        <thead>
          <tr>
            <th scope="col">Batch</th>
            <th scope="col">File</th>
            <th scope="col">Certificate</th>
            <th scope="col">Uploaded</th>
            <th scope="col">Problems</th>
            <th scope="col">Status</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var b in Model.Batches.Batches)
          {
            <tr>
              <td>@b.BatchId</td>
              <td><code>@b.SourceName</code></td>
              <td>@b.CertCode</td>
              <td>@Formatter.Format(b.CreatedAt)<br><small class="text-muted">@b.UploadedByEmail</small></td>
              <td>@(b.ErrorCount == 0 ? "—" : b.ErrorCount.ToString())</td>
              <td><span class="@StatusClass(b.Status)">@StatusLabel(b.Status)</span></td>
              <td><a class="btn btn--sm btn--ghost" href="/admin/imports?@(Model.CertId is { } c ? $"certId={c}&" : "")batchId=@b.BatchId#batch-@b.BatchId">View log</a></td>
            </tr>
          }
        </tbody>
      </table>
    }
  </div>
</div>
