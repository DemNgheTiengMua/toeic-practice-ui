@model WebMVC.Models.RubricStudioViewModel
@{
    // #208 / S-08: the rubric and grader calibration studio. A 4x7 grid is dense, so the layout is a
    // table: the criterion is the row, the band is the column, and the coordinate is on every cell as
    // data-criterion / data-band. Depth is carried by keylines, never by a shadow.
    ViewData["Title"] = "Rubric studio";
    var studio = Model;
}
<link rel="stylesheet" href="~/css/admin/rubric-studio.css" asp-append-version="true" />
<script src="~/js/icons.js" asp-append-version="true"></script>

<div class="studio-canvas rubric-studio" id="rubric-studio"
     data-cert-id="@studio.CertId"
     data-skill-id="@studio.SkillId"
     data-locked="@studio.IsLocked.ToString().ToLowerInvariant()">

    <p class="studio-eyebrow">Rubric and grader calibration</p>
    <h1>Rubric studio@(string.IsNullOrEmpty(studio.SkillName) ? "" : " — " + studio.SkillName)</h1>
    <p class="studio-lede">
        Four criteria across seven bands. Every cell needs a descriptor — what the band looks like — and a set of
        binary gates — what must be true before the band is reached. The ladder then proves the bands actually
        separate before anyone grades against them.
    </p>

    @if (!string.IsNullOrEmpty(studio.ErrorMessage))
    {
        <div class="rubric-alert" role="alert">
            <span class="rubric-alert__icon"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M12 3l10 18H2z" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 10v5M12 18v1" fill="none" stroke="currentColor" stroke-width="2" /></svg></span>
            <span>@studio.ErrorMessage</span>
        </div>
    }
    else
    {
        <div class="rubric-status" id="rubric-status">
            <dl class="rubric-status__facts">
                <div>
                    <dt>Criterion</dt>
                    <dd class="font-mono" id="rubric-skill">@studio.SkillCode</dd>
                </div>
                <div>
                    <dt>Cells filled</dt>
                    <dd class="font-mono" id="rubric-filled">@(studio.FilledCellCount)/@studio.CellCount</dd>
                </div>
                <div>
                    <dt>Lock</dt>
                    <dd id="rubric-lock-state">@(studio.IsLocked ? "Locked " + studio.LockedAt : "Not locked")</dd>
                </div>
            </dl>
            @if (studio.IsLocked)
            {
                <p class="rubric-status__note">
                    This rubric is locked: its grid, its anchors and its criterion list are frozen, because
                    stored scores were measured against them. A change here is a new rubric, not an edit.
                </p>
            }
        </div>

        <form id="rubric-form" method="post" action="/admin/studio/rubric/save">
            @Html.AntiForgeryToken()

            <div class="rubric-grid__scroll">
                <table class="rubric-grid" id="rubric-grid">
                    <caption class="visually-hidden">
                        Twenty-eight editable cells: four criteria by seven CEFR bands, each with a descriptor
                        and its binary gates.
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col" class="rubric-grid__corner">Criterion</th>
                            @foreach (var bandLabel in studio.BandLabels)
                            {
                                <th scope="col" class="rubric-grid__band">
                                    <span class="font-mono">@bandLabel</span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in studio.Rows)
                        {
                            <tr class="rubric-grid__row" data-criterion="@row.CriterionId" data-code="@row.Code">
                                <th scope="row" class="rubric-grid__criterion">
                                    <span class="rubric-grid__code font-mono">@row.Code</span>
                                    <span class="rubric-grid__name">@row.Name</span>
                                </th>
                                @foreach (var cell in row.Cells)
                                {
                                    @* The coordinate is the contract: data-criterion + data-band is what a
                                       test asserts, so a grid of seven criteria by four bands cannot pass. *@
                                    <td class="rubric-grid__cell"
                                        data-criterion="@row.CriterionId"
                                        data-code="@row.Code"
                                        data-band="@cell.Band"
                                        data-anchor-band="@(Contracts.RubricBands.AnchorBands.Contains(cell.Band) ? "true" : "false")">
                                        <label class="visually-hidden" for="desc-@row.CriterionId-@cell.Band">
                                            @row.Code @cell.BandLabel descriptor
                                        </label>
                                        <textarea id="desc-@row.CriterionId-@cell.Band"
                                                  class="rubric-grid__input rubric-grid__input--descriptor"
                                                  data-field="descriptor"
                                                  data-criterion="@row.CriterionId"
                                                  data-band="@cell.Band"
                                                  rows="4"
                                                  placeholder="What @cell.BandLabel looks like, in observable terms"
                                                  @(studio.IsLocked ? "readonly" : "")>@cell.Descriptor</textarea>
                                        <label class="visually-hidden" for="gate-@row.CriterionId-@cell.Band">
                                            @row.Code @cell.BandLabel binary gates
                                        </label>
                                        <textarea id="gate-@row.CriterionId-@cell.Band"
                                                  class="rubric-grid__input rubric-grid__input--gates"
                                                  data-field="gates"
                                                  data-criterion="@row.CriterionId"
                                                  data-band="@cell.Band"
                                                  rows="3"
                                                  placeholder="What must be true before @cell.BandLabel"
                                                  @(studio.IsLocked ? "readonly" : "")>@cell.BinaryGates</textarea>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* The three anchors, at bands 2, 3 and 4: the floor, the middle and the ceiling a grader
               interpolates between. Authored here, before the lock, because the schema freezes them after. *@
            <section class="rubric-anchors" id="rubric-anchors">
                <h2 class="rubric-anchors__title">Calibrated anchors</h2>
                <p class="rubric-anchors__lede">
                    One whole written answer at band 2, 3 and 4, for every criterion. A locked rubric is graded
                    against all three, so a missing anchor is a standard the model would have to invent.
                </p>
                @foreach (var row in studio.Rows)
                {
                    <article class="rubric-anchor__criterion" data-criterion="@row.CriterionId" data-code="@row.Code">
                        <h3 class="rubric-anchor__code">@row.Code <span class="rubric-anchor__name">@row.Name</span></h3>
                        <div class="rubric-anchor__slots">
                            @foreach (var anchor in row.Anchors)
                            {
                                <label class="rubric-anchor__slot" data-criterion="@row.CriterionId" data-band="@anchor.Band">
                                    <span class="rubric-anchor__band font-mono">@anchor.BandLabel</span>
                                    <span class="visually-hidden">@row.Code @anchor.BandLabel anchor response</span>
                                    <textarea class="rubric-grid__input rubric-grid__input--anchor"
                                              data-field="anchor"
                                              data-criterion="@row.CriterionId"
                                              data-band="@anchor.Band"
                                              rows="3"
                                              placeholder="A whole @anchor.BandLabel answer"
                                              @(studio.IsLocked ? "readonly" : "")>@anchor.ResponseText</textarea>
                                </label>
                            }
                        </div>
                    </article>
                }
            </section>

            <div class="rubric-actions">
                <button type="submit" class="btn" id="rubric-save" @(studio.IsLocked ? "disabled" : "")>Save grid</button>
                <button type="button" class="btn btn--ghost" id="rubric-run-ladder" @(studio.IsLocked ? "disabled" : "")>Run ladder</button>
                <button type="button" class="btn btn--ghost" id="rubric-lock" disabled>Lock rubric</button>
                <p class="rubric-actions__status" id="rubric-save-status" role="status" aria-live="polite"></p>
            </div>
        </form>

        @* The ladder's seven responses: six band benchmarks and the verbose trap. They are the ladder's
           input, not the rubric's content - the ladder grades them to find out whether the rubric can
           tell the bands apart, so they live here rather than in the grid. *@
        <section class="rubric-responses" id="rubric-responses">
            <h2 class="rubric-ladder__title">Ladder responses</h2>
            <p class="rubric-anchors__lede">
                Seven responses: one written to show each band from A1 to C2, and one deliberately verbose
                trap of repetitive simple clauses. The ladder grades all seven and checks that the composites rise,
                that each step rises by at least 0.65, and that the trap stays at or below 3.25.
            </p>
            <div class="rubric-responses__grid">
                @foreach (var band in Contracts.RubricBands.All.Where(b => b > 0))
                {
                    <label class="rubric-response__slot">
                        <span class="rubric-anchor__band font-mono">Band @band — @Contracts.RubricBands.Label(band)</span>
                        <textarea id="ladder-response-@band" class="rubric-grid__input"
                                  data-ladder-band="@band" rows="3"
                                  placeholder="A response written to demonstrate @Contracts.RubricBands.Label(band)"
                                  @(studio.IsLocked ? "readonly" : "")></textarea>
                    </label>
                }
                <label class="rubric-response__slot rubric-response__slot--trap">
                    <span class="rubric-anchor__band font-mono">Verbose trap — 280 words</span>
                    <textarea id="ladder-response-trap" class="rubric-grid__input"
                              data-ladder-band="trap" rows="3"
                              placeholder="A long response of repetitive simple clauses: length without the ability the band asks for"
                              @(studio.IsLocked ? "readonly" : "")></textarea>
                </label>
            </div>
        </section>

        @* The ladder panel. An unrun ladder says so and refuses to pretend: "not plotted" is a state,
           not a zero, and the lock is refused until it is plotted and accepted. *@
        <section class="rubric-ladder" id="rubric-ladder" data-has-run="@studio.Ladder.HasRun.ToString().ToLowerInvariant()">
            <h2 class="rubric-ladder__title">Separation ladder</h2>
            <p class="rubric-ladder__verdict" id="rubric-ladder-verdict" data-outcome="@studio.Ladder.Outcome">
                @Contracts.RubricLadderOutcomes.Label(studio.Ladder.Outcome)
            </p>

            @if (!studio.Ladder.HasRun)
            {
                <p class="rubric-ladder__note" id="rubric-ladder-not-plotted">
                    The ladder has not run against this rubric. Run it before locking: a complete grid is the
                    rubric's shape, and the ladder is the evidence that its bands separate.
                </p>
            }
            else
            {
                @if (!string.IsNullOrEmpty(studio.Ladder.Reason))
                {
                    <p class="rubric-ladder__reason" id="rubric-ladder-reason">@studio.Ladder.Reason</p>
                }
                @if (studio.Ladder.ResponsibleCriteria.Count > 0)
                {
                    <p class="rubric-ladder__responsible" id="rubric-ladder-responsible">
                        Rewrite: <span class="font-mono">@string.Join(", ", studio.Ladder.ResponsibleCriteria)</span>
                    </p>
                }
                <ol class="rubric-ladder__bars" id="rubric-ladder-bars">
                    @foreach (var bar in studio.Ladder.Bars)
                    {
                        <li class="rubric-ladder__bar @(bar.IsVerboseTrap ? "rubric-ladder__bar--trap" : "")"
                            data-band="@bar.Band"
                            data-composite="@bar.Composite.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            <span class="rubric-ladder__bar-label font-mono">@bar.BandLabel</span>
                            <span class="rubric-ladder__bar-track">
                                <span class="rubric-ladder__bar-fill" style="width: @bar.Percent%"></span>
                            </span>
                            <span class="rubric-ladder__bar-value font-mono">@bar.Composite.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                        </li>
                    }
                </ol>
            }
        </section>

        <script type="application/json" id="rubric-config">
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
            {
                certId = studio.CertId,
                skillId = studio.SkillId,
                locked = studio.IsLocked,
                anchorBands = Contracts.RubricBands.AnchorBands,
                allBands = Contracts.RubricBands.All,
                separation = 0.65m,
                trapCeiling = 3.25m,
            }))
        </script>
    }
</div>
