@using Contracts
@model WebMVC.Models.AdminUserDetailViewModel
@{
    Layout = "_AdminLayout";
    var user = Model.Detail.User;
    var placements = Model.Detail.Placements;
    ViewData["Title"] = user.FullName ?? user.Email;
    ViewData["Description"] = "Learner account overview and placement billing history.";
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/admin" class="breadcrumbs__item">Admin</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/admin/users" class="breadcrumbs__item">Students</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">@(user.FullName ?? user.Email)</span>
</nav>

<div class="row row--between">
  <div>
    <h1>@(user.FullName ?? user.Email)</h1>
    <p class="text-muted"><code>@user.Email</code> · Credits left: <strong>@user.CreditsLeft</strong></p>
  </div>
  <a href="/admin/users" class="btn btn--ghost">Back to students</a>
</div>

<div class="card">
  <div class="card__header"><strong>Placement history</strong></div>
  <div class="card__body">
    @if (placements.Count == 0)
    {
      <p class="text-muted no-margin">This learner has not started any placement tests yet.</p>
    }
    else
    {
      <table class="table table--striped">
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Certificate</th>
            <th scope="col">Exam</th>
            <th scope="col">Scope</th>
            <th scope="col">Billing</th>
            <th scope="col">Status</th>
            <th scope="col">Result</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var p in placements)
          {
            <tr>
              <td>@Model.Dates[p.TakenAt].Full</td>
              <td><strong>@p.CertCode</strong></td>
              <td>@p.ExamName</td>
              <td>@DisplayLabels.LabelFor(p.Scope, Microsoft.Extensions.Logging.Abstractions.NullLogger.Instance)</td>
              <td>
                @if (p.Paid)
                {
                  <span class="badge badge--info">Paid (@p.CreditsCharged @(p.CreditsCharged == 1 ? "credit" : "credits"))</span>
                }
                else
                {
                  <span class="badge badge--success">Free</span>
                }
              </td>
              <td>@DisplayLabels.LabelFor(p.Status, Microsoft.Extensions.Logging.Abstractions.NullLogger.Instance)</td>
              <td>@(p.ResultBandCode is not null ? $"{p.ResultBandCode} ({p.TotalScore})" : "—")</td>
            </tr>
          }
        </tbody>
      </table>
    }
  </div>
</div>
