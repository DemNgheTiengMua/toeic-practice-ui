@model Contracts.AuthUserDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
    ViewData["Description"] = "Administration dashboard.";
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <span class="breadcrumbs__item" aria-current="page">Admin</span>
</nav>

<div class="row row--between">
  <h1>Dashboard</h1>
</div>

<div class="grid-3">
  <div class="stat">
    <div class="stat__label">Administrator</div>
    <div class="stat__value text-base">@Model.Email</div>
    <div class="stat__hint">Role: @Model.Role</div>
  </div>
  <div class="stat">
    <div class="stat__label">Quick actions</div>
    <div class="stat__value text-base"><a href="/admin/packages">Manage credit packages</a></div>
    <div class="stat__hint">Prices, featured status &amp; sales</div>
  </div>
  <div class="stat">
    <div class="stat__label">Public catalogue</div>
    <div class="stat__value text-base"><a href="/pricing">View live pricing</a></div>
    <div class="stat__hint">Public-facing VND pricing</div>
  </div>
</div>
