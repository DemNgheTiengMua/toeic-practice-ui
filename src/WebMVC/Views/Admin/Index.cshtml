@using Contracts
@model WebMVC.Models.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
    ViewData["Description"] = "Administration dashboard.";
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <span class="breadcrumbs__item" aria-current="page">Admin</span>
</nav>

<div class="row row--between">
  <h1>Dashboard</h1>
</div>

<div class="grid-3">
  <div class="stat">
    <div class="stat__label">Active learners</div>
    <div class="stat__value">@Model.ActiveLearners</div>
    <div class="stat__hint">+@Model.NewLearners in 7 days</div>
  </div>
  <div class="stat">
    <div class="stat__label">Credits used (this month)</div>
    <div class="stat__value">@Model.CreditsUsed</div>
    <div class="stat__hint">Average @Model.CreditsPerDay credits/day</div>
  </div>
  <div class="stat">
    <div class="stat__label">Revenue this month</div>
    <div class="stat__value">@Model.Revenue</div>
    <div class="stat__hint">@Model.PaidOrders @(Model.Dashboard.PaidOrdersThisMonthCount == 1 ? "paid order" : "paid orders")</div>
  </div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card__header"><strong>Most attempted exams</strong></div>
    <div class="card__body">
      @if (Model.Dashboard.MostAttemptedExams.Count == 0)
      {
        <p class="text-muted">No exam attempts yet</p>
      }
      else
      {
        <table class="table table--striped">
          <thead>
            <tr>
              <th scope="col">Exam</th>
              <th scope="col">Attempts</th>
              <th scope="col">Avg. score</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var exam in Model.Dashboard.MostAttemptedExams)
            {
              <tr>
                <td>@exam.ExamName</td>
                <td>@Model.Attempts[exam.ExamId]</td>
                <td>@Model.Scores[exam.ExamId]</td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>

  <div class="card">
    <div class="card__header"><strong>Needs attention</strong></div>
    <div class="card__body stack">
@if (!Model.HasAlerts)
      {
        <div class="alert alert--success">All systems operational — no issues needing attention</div>
      }
      else
      {
        @if (Model.Dashboard.NeedsAttention.DraftExamsCount > 0)
        {
          <div class="alert alert--warning">
            @Model.Dashboard.NeedsAttention.DraftExamsCount @(Model.Dashboard.NeedsAttention.DraftExamsCount == 1 ? "exam is" : "exams are") in draft status.
          </div>
        }
        @if (Model.Dashboard.NeedsAttention.StalePendingOrdersCount > 0)
        {
          <div class="alert alert--info">
            @Model.Dashboard.NeedsAttention.StalePendingOrdersCount @(Model.Dashboard.NeedsAttention.StalePendingOrdersCount == 1 ? "order has" : "orders have") been waiting for reconciliation for over 30 minutes.
          </div>
        }
        @if (Model.Dashboard.NeedsAttention.OpenComplaintsCount > 0)
        {
          <div class="alert alert--info">
            @Model.Dashboard.NeedsAttention.OpenComplaintsCount @(Model.Dashboard.NeedsAttention.OpenComplaintsCount == 1 ? "complaint requires" : "complaints require") review.
          </div>
        }
      }
    </div>
    <div class="card__footer row">
      <a class="btn" href="/admin/exams">Open exam list</a>
      <a class="btn btn--ghost" href="/admin/orders">Open orders</a>
      <a class="btn btn--ghost" href="/admin/complaints">Open complaints</a>
    </div>
  </div>
</div>
