@using Contracts
@model WebMVC.Models.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
    ViewData["Description"] = "Administration dashboard.";
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <span class="breadcrumbs__item" aria-current="page">Admin</span>
</nav>

<div class="row row--between">
  <h1>Dashboard</h1>
  @* #286: the connection indicator. It lives outside the region the live update replaces - a status line
     that was itself replaced by a fetch could never be trusted to report the fetch's failure. *@
  <p class="text-sm no-margin" data-dashboard-live aria-live="polite">
    <span class="badge badge--muted" data-dashboard-live-state>Connecting…</span>
  </p>
</div>

@* #286: this element is the replacement target. Its children are the metric region and its own boundary,
   so a fetch swaps the figures and nothing else - no page reload, no replayed reveal animation, no lost
   scroll position, and no focused field disturbed. *@
<div id="dashboard-metrics"
     data-dashboard-metrics
     data-stream-url="/admin/dashboard/stream"
     data-fragment-url="/admin/dashboard/fragment">
  <partial name="_DashboardMetrics" model="Model" />
</div>

@section Scripts {
<script src="~/js/admin/dashboard/live.js" asp-append-version="true"></script>
}
