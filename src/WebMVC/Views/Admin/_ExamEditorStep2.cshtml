@model WebMVC.Models.ExamEditorViewModel
@{ var isEdit = Model.IsEdit; var detail = Model.Form.Detail; var presentation = Model.Presentation; }
<!-- ===== Step 2: Upload Listening audio ===== -->
@if (Model.Form.Step == 2 && isEdit && detail != null)
{
  var listeningSections = presentation.ListeningSections;
  var uploadedCount = presentation.UploadedCount;
  var totalListening = presentation.TotalListening;
  var percent = presentation.Percent;

  <div class="card">
    <div class="card__header"><strong>Listening audio (@totalListening parts)</strong></div>
    <div class="card__body stack">
      <div class="alert alert--warning">
        Learners may listen only <strong>once</strong>, no rewinding. The file must be in question order, with silent gaps inserted between questions.
      </div>

      @if (listeningSections.Count == 0)
      {
        <div class="alert alert--info">This exam's certificate does not contain listening sections requiring full section audio.</div>
      }
      else
      {
        @foreach (var s in listeningSections)
        {
          var audio = presentation.AudioBySection.GetValueOrDefault(s.SectionId);
          <div class="card p-3 mb-3">
            <span class="field__label"><strong>@s.SectionName</strong> (@s.SectionCode)</span>

            @if (audio != null)
            {
              <div class="upload__file row row--between mt-2 p-2" style="background: var(--surface-soft); border: 1px solid var(--rule-soft);">
                <span>@presentation.AudioDescriptions[s.SectionId]</span>
                <span class="badge badge--success">Uploaded</span>
              </div>
            }
            else
            {
              <div class="upload__file upload__file--missing row row--between mt-2 p-2" style="background: var(--surface-soft); border: 1px solid var(--rule-soft);">
                <span>No file uploaded yet</span>
                <span class="badge badge--warning">Missing</span>
              </div>
            }

            <details class="mt-2">
              <summary class="btn btn--sm btn--ghost" style="cursor:pointer; display:inline-block;">@(audio != null ? "Replace audio file" : "Upload audio file")</summary>
              <form method="post" action="/admin/exams/@Model.Form.ExamId/audio" enctype="multipart/form-data" class="card card__body stack mt-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SectionId" value="@s.SectionId" />
                <input type="hidden" id="dur-@s.SectionId" name="DurationSec" value="@(audio?.DurationSec ?? 300)" />
                <input type="hidden" id="size-@s.SectionId" name="SizeBytes" value="@(audio?.SizeBytes ?? 0)" />
                <div class="field">
                  <label class="field__label" for="file-@s.SectionId">Select Audio File</label>
                  <input class="field__input" type="file" id="file-@s.SectionId" name="AudioFile" accept="audio/mpeg,audio/mp3,audio/wav,audio/*" required />
                  <span class="field__hint">MP3, WAV, or MPEG audio (max 60 MB). Duration and size are computed automatically upon upload.</span>
                </div>
                <div class="upload-meta-preview mt-1 text-xs text-muted" id="preview-@s.SectionId" style="display:none;"></div>
                <button type="submit" class="btn btn--sm btn--primary mt-2">Upload audio</button>
              </form>
            </details>
          </div>
        }

        <div>
          <div class="row row--between text-sm">
            <span>Uploaded @uploadedCount / @totalListening files</span>
            <span>@percent%</span>
          </div>
          <div class="progress mt-2">
            <div class="progress__bar" style="width: @percent%;"></div>
          </div>
        </div>
      }
    </div>
    <div class="card__footer row row--between">
      <a class="btn btn--ghost" href="/admin/exams/@Model.Form.ExamId/edit?step=1">‹ Back to information</a>
      <a class="btn btn--primary" href="/admin/exams/@Model.Form.ExamId/edit?step=3">Continue: enter questions ›</a>
    </div>
  </div>
}
