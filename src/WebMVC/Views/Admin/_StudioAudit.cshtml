@model WebMVC.Models.ExamStudioViewModel
  <!-- ================= PUBLISH READINESS DOCK ================= -->
  @*
    #159: the audit used to be the studio's third column, which cost the author a third of the
    screen on every question. It is still on the page — the publish gate (#157) stays visible and
    keeps its message — but it docks above the cards instead of beside them.
  *@
  <section class="studio-audit-dock" id="studio-right-audit" aria-label="Publish Readiness Audit">
    <div class="studio-audit-dock__summary">
      <h2>Publish Readiness</h2>
      <span class="badge" id="audit-status-badge" style="font-family: var(--font-mono, monospace); border-radius: 0; @Model.AuditBadgeStyle">
        @Model.AuditStatusText
      </span>
      <span class="text-sm">Questions:
        <strong style="font-family: var(--font-mono, monospace);" id="audit-q-count">@Model.Detail.Audit.TotalQuestions / @Model.Detail.Audit.ExpectedQuestions</strong>
      </span>
      <span class="text-sm">Blocks:
        <strong style="font-family: var(--font-mono, monospace); color: @(Model.Detail.Audit.BlockingErrorCount > 0 ? "#b31217" : "#0a6b3c");" id="audit-error-count">@Model.Detail.Audit.BlockingErrorCount</strong>
      </span>
      <span class="text-sm">Warnings:
        <strong style="font-family: var(--font-mono, monospace);" id="audit-warn-count">@Model.Detail.Audit.WarningCount</strong>
      </span>
      <button type="button" class="btn btn--primary btn--sm" id="btn-publish-exam" @(Model.Detail.Audit.CanPublish ? "" : "disabled") style="border-radius: 0; text-transform: uppercase; font-family: var(--font-condensed, sans-serif); font-weight: bold;">
        Publish Exam
      </button>
      <a href="/admin/exams/@Model.Detail.ExamId/export?format=zip" class="btn btn--secondary btn--sm" id="btn-export-exam" style="border-radius: 0;">
        Export ZIP
      </a>
      <a href="/admin/exams/@Model.Detail.ExamId/export?format=json" class="btn btn--secondary btn--sm" id="btn-export-json" style="border-radius: 0;">
        Export JSON
      </a>
    </div>

    <ul class="studio-audit-dock__issues" id="audit-issues-list">
      @if (Model.AuditIssues.Count == 0 && Model.Detail.Audit.CanPublish)
      {
        <li class="audit-item audit-item--success">
          <span class="audit-item__mark">PASSED</span>
          <div>All certificate invariants satisfied. Ready to publish!</div>
        </li>
      }
      @foreach (var iss in Model.AuditIssues)
      {
        var itemClass = iss.ItemClass;
        <li class="audit-item @itemClass" id="audit-issue-@iss.Issue.Code">
          <span class="audit-item__mark">@(iss.Issue.Severity == "error" ? "BLOCK" : "WARN")</span>
          <div>
            <div>@iss.Issue.Message</div>
            @if (!string.IsNullOrEmpty(iss.Issue.ElementTarget))
            {
              <span class="audit-jump-link" onclick="jumpToAuditElement('@iss.Issue.ElementTarget')">Jump to issue &rarr;</span>
            }
          </div>
        </li>
      }
    </ul>
  </section>
