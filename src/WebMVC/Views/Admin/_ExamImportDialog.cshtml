@model WebMVC.Models.AdminExamListViewModel
<div id="import-exam-dialog" class="modal-overlay" style="display: @(string.Equals(Context.Request.Query["import"], "true", StringComparison.OrdinalIgnoreCase) ? "grid" : "none");" role="dialog" aria-modal="true" aria-labelledby="import-dialog-title">
  <div class="modal" style="max-width: 580px;">
    <div class="modal__header">
      <h2 id="import-dialog-title">Import Exam Manifest or Package</h2>
      <button type="button" class="modal__close" onclick="closeImportExamDialog()">Close</button>
    </div>
    <div class="modal__body">
      <p class="text-muted" style="margin-top: 0;">
        Upload a <code>.json</code> manifest for text-only exams or a <code>.zip</code> package with <code>manifest.json</code> and a <code>media/</code> folder for exams with listening audio or images. The file is validated first; upon success, a new draft exam is created.
      </p>
      <form method="post" action="/admin/exams/import" enctype="multipart/form-data" class="stack">
        @Html.AntiForgeryToken()
        <div class="field">
          <label class="field__label" for="import-certId">Target Certificate</label>
          <select class="field__input" id="import-certId" name="certId" required>
            <option value="">Select Certificate</option>
            @foreach (var cert in Model.Summary.Certificates)
            {
              <option value="@cert.CertId" selected="@(cert.CertId == Model.CertId)">@cert.Code — @cert.Name</option>
            }
          </select>
          <div class="field__hint">The imported exam and its questions will be strictly associated with this certificate (Certificate Isolation).</div>
        </div>

        <div class="field">
          <label class="field__label" for="import-file">Manifest (.json) or Package (.zip)</label>
          <input class="field__input" id="import-file" name="file" type="file" accept=".json,.zip,application/json,application/zip" required />
          <div class="field__hint">.json or .zip, up to 100 MB. Audio: .mp3, .wav. Images: .jpg, .png.</div>
        </div>

        <div class="row row--between" style="margin-top: var(--space-md); padding-top: var(--space-sm); border-top: 1px solid var(--color-rule, #ccd2d6);">
          <button type="button" class="btn btn--ghost" onclick="closeImportExamDialog()">Cancel</button>
          <div style="display: flex; gap: 8px;">
            <a href="#" class="btn btn--secondary" id="btn-download-manifest-template" onclick="downloadManifestTemplate(event)">Download Template (.json)</a>
            <button type="submit" class="btn btn--primary">Validate and import</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
