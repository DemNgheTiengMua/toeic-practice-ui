@model WebMVC.Models.AdminLessonEditViewModel
@{
    Layout = "_AdminLayout";
    var isNew = Model.LessonId == 0;
    ViewData["Title"] = isNew ? "Create Lesson" : $"Edit Lesson #{Model.LessonId}";
    ViewData["Description"] = "Consolidated single-page editor for guided learning walkthroughs and interactive card decks.";
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/admin" class="breadcrumbs__item">Admin</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/admin/lessons" class="breadcrumbs__item">Lessons</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">@(isNew ? "Create" : $"Edit #{Model.LessonId}")</span>
</nav>

<div class="row row--between" style="margin-bottom: var(--space-md);">
  <div>
    <h1 style="margin-bottom: var(--space-xxs);">@(isNew ? "Create New Lesson" : $"Edit Lesson: {Model.Title}")</h1>
    <p class="text-muted" style="margin: 0;">Configure lesson curriculum metadata and author instructional cards.</p>
  </div>
  <div class="row" style="gap: var(--space-xs);">
    <a href="/admin/lessons" class="btn btn--ghost">Cancel</a>
    <button type="submit" form="lesson-form" class="btn btn--primary">Save Lesson</button>
  </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
  <div class="alert alert--danger" role="alert" style="margin-bottom: var(--space-md);">
    <strong>Error:</strong> @Model.ErrorMessage
  </div>
}

<form id="lesson-form" method="post" action="/admin/lessons/save" class="stack">
  @Html.AntiForgeryToken()
  <input type="hidden" name="LessonId" value="@Model.LessonId" />

  <!-- Section 1: Lesson Metadata -->
  <div class="card" style="border: 2px solid var(--color-ink, #14181d);">
    <div class="card__header" style="background: var(--color-surface, #f8f9fa); border-bottom: 2px solid var(--color-ink, #14181d);">
      <h2 style="margin: 0; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">1. Lesson Metadata</h2>
    </div>
    <div class="card__body stack">
      <div class="grid-2">
        <div class="field">
          <label class="field__label" for="CertId">Certificate <span class="text-danger">*</span></label>
          @if (isNew)
          {
            <select class="field__input" id="CertId" name="CertId" required>
              @foreach (var cert in Model.Certificates)
              {
                <option value="@cert.CertId" selected="@(cert.CertId == Model.CertId)">@cert.Code — @cert.Name</option>
              }
            </select>
          }
          else
          {
            <input type="hidden" name="CertId" value="@Model.CertId" />
            <input class="field__input" type="text" value="@Model.CertCode" readonly disabled />
            <div class="field__hint">Certificate cannot be modified after creation (Certificate Isolation).</div>
          }
        </div>

        <div class="field">
          <label class="field__label" for="SkillId">Skill ID <span class="text-danger">*</span></label>
          <input class="field__input font-mono" id="SkillId" name="SkillId" type="number" value="@Model.SkillId" required placeholder="e.g. 1" />
          <div class="field__hint">Target skill identifier belonging to this certificate.</div>
        </div>
      </div>

      <div class="grid-2">
        <div class="field">
          <label class="field__label" for="CategoryId">Category ID (Optional)</label>
          <input class="field__input font-mono" id="CategoryId" name="CategoryId" type="number" value="@Model.CategoryId" placeholder="e.g. 5" />
          <div class="field__hint">Links this lesson to a specific question category for remediation.</div>
        </div>

        <div class="field">
          <label class="field__label" for="EstimatedMinutes">Estimated Minutes <span class="text-danger">*</span></label>
          <input class="field__input font-mono" id="EstimatedMinutes" name="EstimatedMinutes" type="number" min="1" max="180" value="@Model.EstimatedMinutes" required />
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="Title">Lesson Title <span class="text-danger">*</span></label>
        <input class="field__input" id="Title" name="Title" type="text" maxlength="160" value="@Model.Title" required placeholder="e.g. Present Simple vs Present Continuous" />
      </div>

      <div class="field">
        <label class="field__label" for="Summary">Curriculum Summary</label>
        <textarea class="field__input" id="Summary" name="Summary" rows="2" maxlength="500" placeholder="Brief pedagogical summary of concepts covered in this deck...">@Model.Summary</textarea>
      </div>

      <div class="field">
        <label class="field__label" for="DisplayOrder">Display Order</label>
        <input class="field__input font-mono" id="DisplayOrder" name="DisplayOrder" type="number" value="@Model.DisplayOrder" style="max-width: 140px;" />
      </div>
    </div>
  </div>

  <!-- Section 2: Walkthrough Cards -->
  <div class="row row--between" style="align-items: center; margin-top: var(--space-md);">
    <div>
      <h2 style="margin: 0; text-transform: uppercase; font-size: 1.2rem;">2. Walkthrough Cards</h2>
      <p class="text-muted text-sm" style="margin: 0;">Cards are presented sequentially to the learner. Rearrange or configure each card type below.</p>
    </div>
    <div class="row" style="gap: var(--space-xxs);">
      <button type="button" class="btn btn--sm" onclick="addCard('rule')">+ Rule</button>
      <button type="button" class="btn btn--sm" onclick="addCard('pitfall')">+ Pitfall</button>
      <button type="button" class="btn btn--sm" onclick="addCard('example')">+ Example</button>
      <button type="button" class="btn btn--sm btn--secondary" onclick="addCard('micro_check')">+ Micro-Check</button>
    </div>
  </div>

  <div id="cards-container" class="stack" style="gap: var(--space-md);">
    @for (int i = 0; i < Model.Cards.Count; i++)
    {
      var card = Model.Cards[i];
      var isMicroCheck = string.Equals(card.CardType, "micro_check", StringComparison.OrdinalIgnoreCase);

      <div class="card card-item" data-index="@i" style="border: 2px solid var(--color-ink, #14181d);">
        <input type="hidden" class="card-id" name="Cards[@i].CardId" value="@card.CardId" />
        <input type="hidden" class="card-order" name="Cards[@i].DisplayOrder" value="@i" />

        <div class="card__header row row--between" style="background: var(--color-surface, #f8f9fa); border-bottom: 1px solid var(--color-rule, #ccd2d6); padding: var(--space-xs) var(--space-sm);">
          <div class="row" style="align-items: center; gap: var(--space-xs);">
            <span class="card-badge font-mono badge badge--primary">Card #<span class="card-num">@(i + 1)</span></span>
            <span class="card-type-label badge">@card.CardType.ToUpper()</span>
          </div>
          <div class="row" style="gap: var(--space-xxs);">
            <button type="button" class="btn btn--sm btn--ghost" onclick="moveCardUp(this)" title="Move Up">↑</button>
            <button type="button" class="btn btn--sm btn--ghost" onclick="moveCardDown(this)" title="Move Down">↓</button>
            <button type="button" class="btn btn--sm btn--danger" onclick="removeCard(this)" title="Delete Card">✕ Remove</button>
          </div>
        </div>

        <div class="card__body stack" style="gap: var(--space-sm);">
          <div class="grid-2">
            <div class="field">
              <label class="field__label">Card Type <span class="text-danger">*</span></label>
              <select class="field__input card-type-select" name="Cards[@i].CardType" onchange="onCardTypeChanged(this)" required>
                <option value="rule" selected="@(card.CardType == "rule")">Rule</option>
                <option value="pitfall" selected="@(card.CardType == "pitfall")">Pitfall</option>
                <option value="example" selected="@(card.CardType == "example")">Example</option>
                <option value="micro_check" selected="@(card.CardType == "micro_check")">Micro-Check (Quiz)</option>
              </select>
            </div>

            <div class="field">
              <label class="field__label">Card Title <span class="text-danger">*</span></label>
              <input class="field__input" name="Cards[@i].Title" type="text" maxlength="160" value="@card.Title" required placeholder="e.g. Core Principle or Common Pitfall" />
            </div>
          </div>

          <div class="field">
            <label class="field__label">Content (GitHub-Flavored Markdown) <span class="text-danger">*</span></label>
            <textarea class="field__input font-mono" name="Cards[@i].ContentMarkdown" rows="4" required placeholder="Write card body with **bold terms**, bullet lists, and code blocks...">@card.ContentMarkdown</textarea>
          </div>

          <!-- Micro-Check Specific Container -->
          <div class="micro-check-fields stack" style="display: @(isMicroCheck ? "block" : "none"); background: #fdfdfd; padding: var(--space-sm); border: 1px dashed var(--color-ink, #14181d); margin-top: var(--space-xs);">
            <h3 style="margin-top: 0; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-ink, #14181d);">Micro-Check Question Configuration</h3>

            <div class="field">
              <label class="field__label">Question Prompt <span class="text-danger">*</span></label>
              <textarea class="field__input" name="Cards[@i].QuestionPrompt" rows="2" placeholder="e.g. Which of the following sentences correctly applies the rule?">@card.QuestionPrompt</textarea>
            </div>

            <div class="grid-2">
              <div class="field">
                <label class="field__label">Option A <span class="text-danger">*</span></label>
                <input class="field__input" name="Cards[@i].OptionA" type="text" maxlength="250" value="@card.OptionA" placeholder="Option A text" />
              </div>
              <div class="field">
                <label class="field__label">Option B <span class="text-danger">*</span></label>
                <input class="field__input" name="Cards[@i].OptionB" type="text" maxlength="250" value="@card.OptionB" placeholder="Option B text" />
              </div>
            </div>

            <div class="grid-2">
              <div class="field">
                <label class="field__label">Option C <span class="text-danger">*</span></label>
                <input class="field__input" name="Cards[@i].OptionC" type="text" maxlength="250" value="@card.OptionC" placeholder="Option C text" />
              </div>
              <div class="field">
                <label class="field__label">Option D <span class="text-danger">*</span></label>
                <input class="field__input" name="Cards[@i].OptionD" type="text" maxlength="250" value="@card.OptionD" placeholder="Option D text" />
              </div>
            </div>

            <div class="grid-2">
              <div class="field">
                <label class="field__label">Correct Option <span class="text-danger">*</span></label>
                <select class="field__input font-mono" name="Cards[@i].CorrectOption">
                  <option value="">Select Correct Option</option>
                  <option value="A" selected="@(string.Equals(card.CorrectOption, "A", StringComparison.OrdinalIgnoreCase))">Option A</option>
                  <option value="B" selected="@(string.Equals(card.CorrectOption, "B", StringComparison.OrdinalIgnoreCase))">Option B</option>
                  <option value="C" selected="@(string.Equals(card.CorrectOption, "C", StringComparison.OrdinalIgnoreCase))">Option C</option>
                  <option value="D" selected="@(string.Equals(card.CorrectOption, "D", StringComparison.OrdinalIgnoreCase))">Option D</option>
                </select>
              </div>

              <div class="field">
                <label class="field__label">Distractor Rationale</label>
                <input class="field__input" name="Cards[@i].Rationale" type="text" value="@card.Rationale" placeholder="Why incorrect options are wrong..." />
              </div>
            </div>

            <div class="field">
              <label class="field__label">Explanation <span class="text-danger">*</span></label>
              <textarea class="field__input" name="Cards[@i].Explanation" rows="2" placeholder="Full explanation displayed when learner confirms their answer...">@card.Explanation</textarea>
            </div>
          </div>
        </div>
      </div>
    }
  </div>

  <div class="row row--between" style="margin-top: var(--space-lg); padding-top: var(--space-md); border-top: 2px solid var(--color-ink, #14181d);">
    <a href="/admin/lessons" class="btn btn--ghost">Cancel</a>
    <button type="submit" class="btn btn--primary" style="font-size: 1rem; padding: var(--space-xs) var(--space-lg);">Save Lesson Deck</button>
  </div>
</form>

<template id="card-template">
  <div class="card card-item" data-index="__INDEX__" style="border: 2px solid var(--color-ink, #14181d);">
    <input type="hidden" class="card-id" name="Cards[__INDEX__].CardId" value="" />
    <input type="hidden" class="card-order" name="Cards[__INDEX__].DisplayOrder" value="__INDEX__" />

    <div class="card__header row row--between" style="background: var(--color-surface, #f8f9fa); border-bottom: 1px solid var(--color-rule, #ccd2d6); padding: var(--space-xs) var(--space-sm);">
      <div class="row" style="align-items: center; gap: var(--space-xs);">
        <span class="card-badge font-mono badge badge--primary">Card #<span class="card-num">__NUM__</span></span>
        <span class="card-type-label badge">__TYPE_UPPER__</span>
      </div>
      <div class="row" style="gap: var(--space-xxs);">
        <button type="button" class="btn btn--sm btn--ghost" onclick="moveCardUp(this)" title="Move Up">↑</button>
        <button type="button" class="btn btn--sm btn--ghost" onclick="moveCardDown(this)" title="Move Down">↓</button>
        <button type="button" class="btn btn--sm btn--danger" onclick="removeCard(this)" title="Delete Card">✕ Remove</button>
      </div>
    </div>

    <div class="card__body stack" style="gap: var(--space-sm);">
      <div class="grid-2">
        <div class="field">
          <label class="field__label">Card Type <span class="text-danger">*</span></label>
          <select class="field__input card-type-select" name="Cards[__INDEX__].CardType" onchange="onCardTypeChanged(this)" required>
            <option value="rule">Rule</option>
            <option value="pitfall">Pitfall</option>
            <option value="example">Example</option>
            <option value="micro_check">Micro-Check (Quiz)</option>
          </select>
        </div>

        <div class="field">
          <label class="field__label">Card Title <span class="text-danger">*</span></label>
          <input class="field__input" name="Cards[__INDEX__].Title" type="text" maxlength="160" value="__TITLE__" required placeholder="e.g. Core Principle" />
        </div>
      </div>

      <div class="field">
        <label class="field__label">Content (GitHub-Flavored Markdown) <span class="text-danger">*</span></label>
        <textarea class="field__input font-mono" name="Cards[__INDEX__].ContentMarkdown" rows="4" required placeholder="Write card body with **bold terms**, bullet lists, and code blocks...">__CONTENT__</textarea>
      </div>

      <div class="micro-check-fields stack" style="display: none; background: #fdfdfd; padding: var(--space-sm); border: 1px dashed var(--color-ink, #14181d); margin-top: var(--space-xs);">
        <h3 style="margin-top: 0; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-ink, #14181d);">Micro-Check Question Configuration</h3>

        <div class="field">
          <label class="field__label">Question Prompt <span class="text-danger">*</span></label>
          <textarea class="field__input" name="Cards[__INDEX__].QuestionPrompt" rows="2" placeholder="e.g. Which of the following sentences correctly applies the rule?"></textarea>
        </div>

        <div class="grid-2">
          <div class="field">
            <label class="field__label">Option A <span class="text-danger">*</span></label>
            <input class="field__input" name="Cards[__INDEX__].OptionA" type="text" maxlength="250" placeholder="Option A text" />
          </div>
          <div class="field">
            <label class="field__label">Option B <span class="text-danger">*</span></label>
            <input class="field__input" name="Cards[__INDEX__].OptionB" type="text" maxlength="250" placeholder="Option B text" />
          </div>
        </div>

        <div class="grid-2">
          <div class="field">
            <label class="field__label">Option C <span class="text-danger">*</span></label>
            <input class="field__input" name="Cards[__INDEX__].OptionC" type="text" maxlength="250" placeholder="Option C text" />
          </div>
          <div class="field">
            <label class="field__label">Option D <span class="text-danger">*</span></label>
            <input class="field__input" name="Cards[__INDEX__].OptionD" type="text" maxlength="250" placeholder="Option D text" />
          </div>
        </div>

        <div class="grid-2">
          <div class="field">
            <label class="field__label">Correct Option <span class="text-danger">*</span></label>
            <select class="field__input font-mono" name="Cards[__INDEX__].CorrectOption">
              <option value="">Select Correct Option</option>
              <option value="A">Option A</option>
              <option value="B">Option B</option>
              <option value="C">Option C</option>
              <option value="D">Option D</option>
            </select>
          </div>

          <div class="field">
            <label class="field__label">Distractor Rationale</label>
            <input class="field__input" name="Cards[__INDEX__].Rationale" type="text" placeholder="Why incorrect options are wrong..." />
          </div>
        </div>

        <div class="field">
          <label class="field__label">Explanation <span class="text-danger">*</span></label>
          <textarea class="field__input" name="Cards[__INDEX__].Explanation" rows="2" placeholder="Full explanation displayed when learner confirms their answer..."></textarea>
        </div>
      </div>
    </div>
  </div>
</template>

@section Scripts {
<script>
  function reindexCards() {
    const container = document.getElementById('cards-container');
    const cards = container.querySelectorAll('.card-item');

    cards.forEach((card, idx) => {
      card.setAttribute('data-index', idx);
      card.querySelector('.card-num').textContent = (idx + 1);
      card.querySelector('.card-order').value = idx;

      // Update all input names: Cards[old].Prop -> Cards[idx].Prop
      const inputs = card.querySelectorAll('input, select, textarea');
      inputs.forEach(input => {
        const name = input.getAttribute('name');
        if (name && name.startsWith('Cards[')) {
          const newName = name.replace(/Cards\[\d+\]/, 'Cards[' + idx + ']');
          input.setAttribute('name', newName);
        }
      });
    });
  }

  function addCard(type) {
    const container = document.getElementById('cards-container');
    const idx = container.querySelectorAll('.card-item').length;
    const template = document.getElementById('card-template').innerHTML;

    let defaultTitle = 'New ' + type.charAt(0).toUpperCase() + type.slice(1);
    let defaultContent = 'Write ' + type + ' content here.';

    if (type === 'micro_check') {
      defaultTitle = 'Check Your Understanding';
      defaultContent = 'Answer the quick check question below.';
    }

    let html = template
      .replaceAll('__INDEX__', idx)
      .replaceAll('__NUM__', idx + 1)
      .replaceAll('__TYPE_UPPER__', type.toUpperCase())
      .replaceAll('__TITLE__', defaultTitle)
      .replaceAll('__CONTENT__', defaultContent);

    const tempDiv = document.createElement('div');
    tempDiv.innerHTML = html;
    const newCard = tempDiv.firstElementChild;

    const select = newCard.querySelector('.card-type-select');
    select.value = type;

    if (type === 'micro_check') {
      newCard.querySelector('.micro-check-fields').style.display = 'block';
    }

    container.appendChild(newCard);
    reindexCards();
    newCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function removeCard(btn) {
    const container = document.getElementById('cards-container');
    if (container.querySelectorAll('.card-item').length <= 1) {
      alert('A lesson deck must contain at least one card.');
      return;
    }
    const card = btn.closest('.card-item');
    card.remove();
    reindexCards();
  }

  function moveCardUp(btn) {
    const card = btn.closest('.card-item');
    const prev = card.previousElementSibling;
    if (prev) {
      card.parentNode.insertBefore(card, prev);
      reindexCards();
    }
  }

  function moveCardDown(btn) {
    const card = btn.closest('.card-item');
    const next = card.nextElementSibling;
    if (next) {
      card.parentNode.insertBefore(next, card);
      reindexCards();
    }
  }

  function onCardTypeChanged(select) {
    const card = select.closest('.card-item');
    const type = select.value;
    card.querySelector('.card-type-label').textContent = type.toUpperCase();

    const microCheckFields = card.querySelector('.micro-check-fields');
    if (type === 'micro_check') {
      microCheckFields.style.display = 'block';
    } else {
      microCheckFields.style.display = 'none';
    }
  }
</script>
}
