@model WebMVC.Models.LessonViewModel
@using WebMVC.Models
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Preview: " + Model.Lesson.Title;
    ViewData["Description"] = "Admin preview for guided lesson walkthrough deck.";
    var cards = Model.Cards;
    var totalCards = cards.Count;
    var initialIndex = 1;
    var finishUrl = Model.FinishUrl;
    var returnUrl = Model.ReturnUrl;
}

<link rel="stylesheet" href="~/css/admin/lessons/preview.css" asp-append-version="true" />

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/admin" class="breadcrumbs__item">Admin</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/admin/lessons" class="breadcrumbs__item">Lessons</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="@returnUrl" class="breadcrumbs__item">Edit #@Model.Lesson.LessonId</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Preview</span>
</nav>

<div class="row row--between" style="border: 2px solid var(--color-ink, #14181d); background: var(--color-surface, #f8f9fa); padding: var(--space-sm) var(--space-md); margin-bottom: var(--space-md); align-items: center;">
  <div>
    <span class="badge badge--warning">ADMIN PREVIEW MODE</span>
    <h1 style="margin: var(--space-xxs) 0 0 0; font-size: 1.15rem; text-transform: uppercase;">Preview: @Model.Lesson.Title</h1>
    <div class="text-xs text-muted">Viewing deck as learners see it. Interactive answers and cards function for test validation without writing learner progress.</div>
  </div>
  <div class="row" style="gap: var(--space-xs); align-items: center;">
    <a href="@returnUrl" class="btn btn--secondary">← Back to Editor</a>
    <a href="/admin/lessons" class="btn btn--ghost">Lessons List</a>
  </div>
</div>

<div class="lesson-deck" data-lesson-id="@Model.Lesson.LessonId" data-initial-index="@initialIndex" data-total-cards="@totalCards" data-completed="@(Model.Progress.IsCompleted ? "true" : "false")">
  <div class="row row--between" style="align-items: center;">
    <span class="badge badge--primary" id="cardTypeBadge">CARD @initialIndex OF @totalCards</span>
    <span class="text-sm text-muted font-mono" id="cardCounter">@initialIndex / @totalCards cards</span>
  </div>

  @await Html.PartialAsync("~/Views/Admin/Lessons/_PreviewCards.cshtml", Model)

  <!-- NAVIGATION -->
  <div class="deck-navigation">
    <button type="button" class="btn" id="btnPrev" @(initialIndex == 1 ? "disabled" : "")>Previous card</button>
    <div class="row" style="gap: var(--space-xs);">
      <button type="button" class="btn btn--primary" id="btnNext" style="@(initialIndex == totalCards ? "display: none;" : "")">Next card</button>
      <a href="@returnUrl" class="btn btn--success" id="btnFinish" style="@(initialIndex == totalCards ? "" : "display: none;")">Finish Preview &amp; Return to Editor</a>
    </div>
  </div>
</div>

@section Scripts {
<script src="~/js/admin/lessons/preview.js" asp-append-version="true"></script>
}
