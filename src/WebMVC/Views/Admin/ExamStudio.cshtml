@model Contracts.ExamStudioDetailDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Exam Studio — {Model.Name}";
    var certCodeUpper = Model.CertCode.ToUpperInvariant();

    // Group sections by Skill
    var skills = Model.Sections
        .GroupBy(s => s.SkillId > 0 ? s.SkillId.ToString() : s.Modality.ToString())
        .Select(g => new {
            Key = g.Key,
            Name = g.First().SkillName ?? g.First().Modality.ToString(),
            Code = g.First().SkillCode ?? g.First().Modality.ToString().ToUpperInvariant(),
            Modality = g.First().Modality,
            Sections = g.ToList(),
            TotalQuestions = g.Sum(s => s.CurrentQuestionCount),
            ExpectedQuestions = g.Sum(s => s.ExpectedQuestionCount ?? 0)
        })
        .ToList();

    var firstSection = Model.Sections.FirstOrDefault();
    var firstSkillKey = skills.FirstOrDefault()?.Key ?? "";
}

<div id="studio-csrf-holder" style="display:none;">
  @Html.AntiForgeryToken()
</div>

<style>
  /* Exam Studio "Bảng hiệu phòng thi" Layout */
  .studio-container {
    display: grid;
    grid-template-columns: 290px 1fr 310px;
    gap: 1rem;
    align-items: start;
    margin-top: 0.75rem;
  }
  @@media (max-width: 1200px) {
    .studio-container {
      grid-template-columns: 250px 1fr 270px;
    }
  }
  @@media (max-width: 992px) {
    .studio-container {
      grid-template-columns: 1fr;
    }
  }

  .studio-panel {
    background: #ffffff;
    border: 2px solid var(--color-ink, #14181d);
    border-radius: 0;
    box-shadow: none;
    padding: 0;
  }

  .studio-panel__header {
    background: var(--color-surface, #f8f9fa);
    border-bottom: 2px solid var(--color-ink, #14181d);
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .studio-panel__header h2,
  .studio-panel__header h3 {
    margin: 0;
    font-family: var(--font-condensed, sans-serif);
    text-transform: uppercase;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }

  .studio-panel__body {
    padding: 1rem;
    overflow-y: auto;
  }

  /* Skill & Section Navigation Tabs */
  .studio-nav-bar {
    border: 2px solid var(--color-ink, #14181d);
    background: #ffffff;
    margin-bottom: 0.75rem;
  }

  .studio-skill-tabs {
    display: flex;
    flex-wrap: wrap;
    background: #eceff1;
    border-bottom: 2px solid var(--color-ink, #14181d);
  }

  .studio-skill-tab {
    padding: 0.5rem 1.1rem;
    background: transparent;
    border: none;
    border-right: 2px solid var(--color-ink, #14181d);
    border-radius: 0;
    font-family: var(--font-condensed, sans-serif);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink, #14181d);
    transition: background 0.15s ease, color 0.15s ease;
  }

  .studio-skill-tab:hover {
    background: #dde2e6;
  }

  .studio-skill-tab.is-active {
    background: var(--color-ink, #14181d);
    color: #ffffff;
  }

  .studio-section-tabs {
    display: flex;
    flex-wrap: wrap;
    background: #ffffff;
    gap: 0.25rem;
    padding: 0.4rem 0.5rem;
  }

  .studio-section-tab {
    padding: 0.35rem 0.75rem;
    background: #f0f4f8;
    border: 1px solid var(--color-ink, #14181d);
    border-radius: 0;
    font-family: var(--font-condensed, sans-serif);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-ink, #14181d);
  }

  .studio-section-tab:hover {
    background: #e2e8f0;
  }

  .studio-section-tab.is-active {
    background: var(--color-ink, #14181d);
    color: #ffffff;
  }

  /* Left Rail */
  .rail-skill-group {
    margin-bottom: 1rem;
  }

  .rail-skill-heading {
    padding: 0.4rem 0.6rem;
    background: #eceff1;
    border: 1px solid var(--color-border, #ccd2d6);
    font-family: var(--font-condensed, sans-serif);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
  }

  .rail-section {
    border: 1px solid var(--color-border, #ccd2d6);
    margin-bottom: 0.5rem;
    background: #ffffff;
  }

  .rail-section__header {
    padding: 0.45rem 0.65rem;
    background: #f8f9fa;
    border-bottom: 1px solid var(--color-border, #ccd2d6);
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.8rem;
  }

  .rail-section__header.is-active {
    background: var(--color-ink, #14181d);
    color: #ffffff;
  }

  .rail-section__items {
    list-style: none;
    margin: 0;
    padding: 0.2rem 0;
  }

  .rail-item {
    padding: 0.35rem 0.65rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    border-bottom: 1px dashed #e5e5e5;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .rail-item:last-child {
    border-bottom: none;
  }

  .rail-item:hover {
    background: #f4f6f8;
  }

  .rail-item.is-selected {
    background: var(--color-ink, #14181d);
    color: #ffffff;
  }

  .rail-item__btns {
    display: flex;
    gap: 0.15rem;
  }

  .rail-btn-move {
    background: transparent;
    border: 1px solid #ccd2d6;
    border-radius: 0;
    padding: 0.05rem 0.25rem;
    font-size: 0.65rem;
    cursor: pointer;
    color: inherit;
  }

  .rail-btn-move:hover {
    background: #e0e0e0;
  }

  /* Center Workstation */
  .workstation-toolbar {
    background: #f8f9fa;
    border-bottom: 2px solid var(--color-ink, #14181d);
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .blueprint-placard {
    background: #f0f4f8;
    border: 1px solid var(--color-border, #ccd2d6);
    padding: 0.5rem 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .blueprint-pill {
    font-family: var(--font-mono, monospace);
    background: #ffffff;
    border: 1px solid #ccd2d6;
    padding: 0.15rem 0.4rem;
  }

  .card-editor {
    border: 2px solid var(--color-ink, #14181d);
    border-radius: 0;
    margin-bottom: 1.25rem;
    background: #ffffff;
  }

  .card-editor__header {
    background: #f8f9fa;
    border-bottom: 1px solid var(--color-ink, #14181d);
    padding: 0.5rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-editor.is-highlighted {
    outline: 3px solid var(--color-warning, #f2b705);
  }

  /* Split Pane Layout for Passage/Stimulus */
  .split-workspace {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: start;
  }
  @@media (max-width: 900px) {
    .split-workspace {
      grid-template-columns: 1fr;
    }
  }

  .split-workspace__pane {
    background: #ffffff;
  }

  /* Visual Audio Slicer Widget */
  .audio-slicer {
    background: #f8f9fa;
    border: 2px solid var(--color-ink, #14181d);
    padding: 0.85rem;
    margin-bottom: 1rem;
  }

  .audio-slicer__scrubber {
    position: relative;
    height: 36px;
    background: #14181d;
    cursor: pointer;
    margin: 0.5rem 0;
    overflow: hidden;
  }

  .audio-slicer__progress {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    background: var(--color-brand, #0b4ea2);
    width: 0%;
    pointer-events: none;
  }

  .audio-slicer__slice-region {
    position: absolute;
    top: 0;
    bottom: 0;
    background: rgba(242, 183, 5, 0.45);
    border-left: 2px solid #f2b705;
    border-right: 2px solid #f2b705;
    pointer-events: none;
  }

  .audio-slicer__start-marker {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #f2b705;
    pointer-events: none;
    z-index: 1;
  }

  .audio-slicer__cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #ffffff;
    pointer-events: none;
  }

  .audio-slicer__status {
    margin-top: 0.5rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid #ccd2d6;
    background: #ffffff;
    font-size: 0.75rem;
  }
  .audio-slicer__status[data-state="success"] {
    border-color: #0a6b3c;
    color: #0a6b3c;
  }
  .audio-slicer__status[data-state="error"] {
    border-color: #b31217;
    color: #b31217;
  }

  /* Dropzone */
  .studio-dropzone {
    border: 2px dashed #ccd2d6;
    padding: 1.25rem;
    text-align: center;
    background: #fafafa;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .studio-dropzone.is-dragover {
    border-color: var(--color-brand, #0b4ea2);
    background: #eef4fc;
  }

  /* Right Audit Placard */
  .audit-item {
    padding: 0.5rem;
    border-left: 4px solid #ccd2d6;
    margin-bottom: 0.5rem;
    font-size: 0.8rem;
    background: #fdfdfd;
    display: flex;
    gap: 0.4rem;
  }
  .audit-item--error {
    border-left-color: var(--color-danger, #b31217);
    background: #fff5f5;
  }
  .audit-item--warning {
    border-left-color: var(--color-warning, #f2b705);
    background: #fffdf0;
  }
  .audit-item--success {
    border-left-color: var(--color-success, #0a6b3c);
    background: #f4fbf7;
  }
  .audit-jump-link {
    cursor: pointer;
    text-decoration: underline;
    font-weight: 600;
    color: var(--color-brand, #0b4ea2);
  }

  /* Blank Badge */
  .blank-badge {
    display: inline-block;
    padding: 0.1rem 0.4rem;
    background: var(--color-ink, #14181d);
    color: #ffffff;
    font-family: var(--font-mono, monospace);
    font-weight: bold;
    font-size: 0.8rem;
    cursor: pointer;
    margin: 0 0.2rem;
  }

  /* Document Tabs */
  .doc-tabs {
    display: flex;
    border-bottom: 2px solid var(--color-ink, #14181d);
    margin-bottom: 0.5rem;
    gap: 0.25rem;
  }
  .doc-tab {
    padding: 0.35rem 0.75rem;
    border: 2px solid var(--color-ink, #14181d);
    border-bottom: none;
    background: #f0f4f8;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.75rem;
    font-family: var(--font-condensed, sans-serif);
    text-transform: uppercase;
  }
  .doc-tab.is-active {
    background: var(--color-ink, #14181d);
    color: #ffffff;
  }

  /* Stage / Unit Badge */
  .unit-badge {
    display: inline-block;
    padding: 0.15rem 0.4rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    font-weight: bold;
    background: #e2e8f0;
    border: 1px solid #14181d;
    margin-right: 0.4rem;
  }
</style>

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/admin" class="breadcrumbs__item">Admin</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/admin/exams" class="breadcrumbs__item">Exams</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Exam Studio</span>
</nav>

<!-- Studio Top Header Placard -->
<div class="row row--between row--wrap" style="align-items: center; margin-bottom: 0.75rem; gap: 0.75rem;">
  <div>
    <h1 style="margin: 0; font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-size: 1.5rem;">
      @Model.Name
    </h1>
    <div class="row" style="gap: 0.75rem; align-items: center; margin-top: 0.25rem;">
      <span class="badge" style="background: var(--color-ink, #14181d); color: #fff; border-radius: 0; font-family: var(--font-mono, monospace);">@certCodeUpper</span>
      <span class="text-sm text-muted">@Model.CertName &bull; Duration: @Model.DurationMinutes min &bull; Purpose: @Model.Purpose</span>
    </div>
  </div>

  <div class="row" style="gap: 0.5rem; align-items: center;">
    <div id="autosave-status" style="font-family: var(--font-mono, monospace); font-size: 0.85rem; padding: 0.35rem 0.65rem; border: 1px solid #ccd2d6; background: #fff;">
      Ready
    </div>
    <button type="button" class="btn btn--secondary btn--sm" id="btn-studio-quick-ingest" style="border-radius: 0;">
      Quick Ingest
    </button>
    <a href="/admin/exams/@Model.ExamId/edit?step=1" class="btn btn--ghost btn--sm" style="border-radius: 0;">
      Settings
    </a>
  </div>
</div>

<!-- ================= TOP NAVIGATION: SKILL TABS & SECTION TABS ================= -->
<div class="studio-nav-bar" id="studio-nav-bar">
  <!-- 1. Top-Level Skill Tabs -->
  <div class="studio-skill-tabs" id="skill-tabs-container">
    @foreach (var sk in skills)
    {
      var isFirstSkill = sk.Key == firstSkillKey;
      <button type="button" class="studio-skill-tab @(isFirstSkill ? "is-active" : "")" data-skill-key="@sk.Key" onclick="selectSkill('@sk.Key')">
        <span>@sk.Name</span>
        <span class="badge text-xs" style="font-family: var(--font-mono, monospace); background: rgba(0,0,0,0.1); border-radius: 0;">
          @sk.TotalQuestions / @sk.ExpectedQuestions Qs
        </span>
      </button>
    }
  </div>

  <!-- 2. Nested Section/Part Tabs with Live Completion Indicators -->
  <div class="studio-section-tabs" id="section-tabs-container">
    @foreach (var sec in Model.Sections)
    {
      var skillKey = sec.SkillId > 0 ? sec.SkillId.ToString() : sec.Modality.ToString();
      var isFirstSec = sec == firstSection;
      var isComplete = sec.ExpectedQuestionCount.HasValue && sec.CurrentQuestionCount == sec.ExpectedQuestionCount.Value;
      var hasOver = sec.ExpectedQuestionCount.HasValue && sec.CurrentQuestionCount > sec.ExpectedQuestionCount.Value;
      var indicator = isComplete ? "[ĐỦ]" : (hasOver ? "!" : "");

      <button type="button" class="studio-section-tab @(isFirstSec ? "is-active" : "")" id="tab-sec-@sec.SectionId" data-section-id="@sec.SectionId" data-skill-key="@skillKey" onclick="selectSection(@sec.SectionId)" style="@(skillKey == firstSkillKey ? "" : "display: none;")">
        <span>[@sec.Code] @sec.Name</span>
        <span class="badge text-xs" id="tab-badge-@sec.SectionId" style="font-family: var(--font-mono, monospace); border-radius: 0; @(isComplete ? "background: #e6f1ea; color: #0a6b3c;" : "background: #fef3d6; color: #b58900;")">
          @sec.CurrentQuestionCount/@(sec.ExpectedQuestionCount?.ToString() ?? "—") @indicator
        </span>
      </button>
    }
  </div>
</div>

<div class="studio-container">
  <!-- ================= 1. LEFT NAVIGATION RAIL ================= -->
  <aside class="studio-panel" id="studio-left-rail" aria-label="Sections and Questions Navigation">
    <div class="studio-panel__header">
      <h2>Curriculum Rail</h2>
      <span class="text-xs" style="font-family: var(--font-mono, monospace);" id="rail-total-count">
        @Model.ActualQuestionCount / @(Model.QuestionCount ?? Model.Sections.Sum(s => s.ExpectedQuestionCount ?? 0)) Qs
      </span>
    </div>
    <div class="studio-panel__body" style="max-height: 75vh;">
      @foreach (var sk in skills)
      {
        <div class="rail-skill-group" id="rail-skill-group-@sk.Key">
          <div class="rail-skill-heading">
            <span>@sk.Name</span>
            <span style="font-family: var(--font-mono, monospace);">@sk.TotalQuestions / @sk.ExpectedQuestions</span>
          </div>

          @foreach (var sec in sk.Sections)
          {
            var isComplete = sec.ExpectedQuestionCount.HasValue && sec.CurrentQuestionCount == sec.ExpectedQuestionCount.Value;
            var badgeColor = isComplete ? "background: #e6f1ea; color: #0a6b3c;" : "background: #fef3d6; color: #b58900;";

            <div class="rail-section" id="rail-sec-@sec.SectionId" data-section-id="@sec.SectionId" data-section-code="@sec.Code">
              <div class="rail-section__header @(sec == firstSection ? "is-active" : "")" onclick="selectSection(@sec.SectionId)">
                <span>[@sec.Code] @sec.Name</span>
                <span class="badge text-xs" style="@badgeColor border-radius: 0; font-family: var(--font-mono, monospace);" id="sec-badge-@sec.SectionId">
                  @sec.CurrentQuestionCount / @(sec.ExpectedQuestionCount?.ToString() ?? "—")
                </span>
              </div>
              <ul class="rail-section__items" id="rail-items-@sec.SectionId">
                @foreach (var g in sec.Groups)
                {
                  foreach (var q in g.Questions)
                  {
                    <li class="rail-item" id="rail-item-@q.QuestionId" data-question-id="@q.QuestionId" data-group-id="@g.GroupId" data-display-order="@q.DisplayOrder" onclick="focusQuestionCard(@q.QuestionId)">
                      <div class="row" style="gap: 0.35rem; align-items: center; overflow: hidden;">
                        @if (sec.UnitCount > 1)
                        {
                          <span class="unit-badge">U@g.UnitNumber</span>
                        }
                        <strong style="font-family: var(--font-mono, monospace);">#@q.DisplayOrder</strong>
                        <span class="truncate" style="max-width: 120px;">@(string.IsNullOrWhiteSpace(q.Stem) ? "(empty stem)" : q.Stem)</span>
                      </div>
                      <div class="rail-item__btns" onclick="event.stopPropagation()">
                        <button type="button" class="rail-btn-move" onclick="moveItemUp(@sec.SectionId, @q.QuestionId)" title="Move Up">&uarr;</button>
                        <button type="button" class="rail-btn-move" onclick="moveItemDown(@sec.SectionId, @q.QuestionId)" title="Move Down">&darr;</button>
                      </div>
                    </li>
                  }
                }
              </ul>
            </div>
          }
        </div>
      }
    </div>
  </aside>

  <!-- ================= 2. CENTER WORKSTATION ================= -->
  <main class="studio-panel" id="studio-workstation" aria-label="Question Workstation">
    <div class="workstation-toolbar">
      <div class="row" style="gap: 0.5rem; align-items: center;">
        <span style="font-weight: bold; font-family: var(--font-condensed, sans-serif); text-transform: uppercase;" id="ws-section-name">
          @firstSection?.Name
        </span>
        <span class="badge" style="background: #eef; border-radius: 0;" id="ws-section-modality">
          @firstSection?.Modality
        </span>
      </div>

      <div class="row" style="gap: 0.5rem; align-items: center;">
        <div id="ws-unit-selector-container" style="display: none;">
          <label class="text-xs font-bold mr-1">Filter Unit:</label>
          <select id="ws-unit-filter" class="field__input text-xs" style="padding: 0.2rem 0.4rem; border-radius: 0;" onchange="filterWorkstationUnit(this.value)">
            <option value="0">All Units</option>
            <option value="1">Unit 1</option>
            <option value="2">Unit 2</option>
          </select>
        </div>
        <button type="button" class="btn btn--secondary btn--sm" id="btn-add-question" style="border-radius: 0;">
          + Add Question
        </button>
        <button type="button" class="btn btn--secondary btn--sm" id="btn-add-cluster" style="border-radius: 0;">
          + Add Cluster
        </button>
      </div>
    </div>

    <div class="studio-panel__body" style="max-height: 75vh;" id="ws-cards-container">
      @foreach (var sec in Model.Sections)
      {
        var isSplit = sec.RequirePassage || sec.LayoutType == "SPLIT_HORIZONTAL";
        var hasAudioStimulus = sec.RequireAudio || sec.Modality == Contracts.ModalityDto.Listening || sec.ClusterSize > 1 || !string.IsNullOrWhiteSpace(sec.MasterAudioPath);

        <div class="section-workstation-content" id="ws-sec-@sec.SectionId" data-unit-count="@sec.UnitCount" data-cluster-size="@sec.ClusterSize" style="@(sec == firstSection ? "" : "display:none;")">

          <!-- Section Blueprint Spec Placard -->
          <div class="blueprint-placard">
            <div><strong>Code:</strong> <span class="blueprint-pill">@sec.Code</span></div>
            <div><strong>Expected:</strong> <span class="blueprint-pill">@(sec.ExpectedQuestionCount?.ToString() ?? "Flexible") Qs</span></div>
            <div><strong>Cluster:</strong> <span class="blueprint-pill">@sec.ClusterSize Qs/group</span></div>
            @if (sec.OptionCount > 0)
            {
              <div><strong>Options:</strong> <span class="blueprint-pill">@sec.OptionCount choices</span></div>
            }
            @if (sec.UnitCount > 1)
            {
              <div><strong>Units / Stages:</strong> <span class="blueprint-pill">@sec.UnitCount units</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(sec.NavigationMode))
            {
              <div><strong>Navigation:</strong> <span class="blueprint-pill">@sec.NavigationMode</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(sec.LayoutType))
            {
              <div><strong>Layout:</strong> <span class="blueprint-pill">@sec.LayoutType</span></div>
            }
          </div>

          <!-- VISUAL AUDIO SLICER FOR AUDIO SECTIONS -->
          @if (hasAudioStimulus)
          {
            <div class="audio-slicer" id="audio-slicer-sec-@sec.SectionId">
              <div class="row row--between mb-1" style="align-items: center;">
                <div class="row" style="gap: 0.5rem; align-items: center;">
                  <strong style="font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-size: 0.85rem;">Visual Audio Slicer</strong>
                  <span class="text-xs text-muted" id="slicer-track-label-@sec.SectionId">
                    @(string.IsNullOrWhiteSpace(sec.MasterAudioPath) ? "No master audio loaded" : Contracts.MediaUrlHelper.NormalizeMediaUrl(sec.MasterAudioPath))
                  </span>
                </div>
                <div style="font-family: var(--font-mono, monospace); font-size: 0.8rem;" id="slicer-timer-@sec.SectionId">
                  00:00.000 / 00:00.000
                </div>
              </div>

              <audio id="slicer-audio-@sec.SectionId" src="@Contracts.MediaUrlHelper.NormalizeMediaUrl(sec.MasterAudioPath)" preload="metadata"></audio>

              <!-- Waveform / scrubber representation with tick marks -->
              <div class="audio-slicer__scrubber" id="slicer-scrubber-@sec.SectionId" onclick="onScrubberClick(event, @sec.SectionId)">
                <div class="audio-slicer__progress" id="slicer-progress-@sec.SectionId"></div>
                <div class="audio-slicer__slice-region" id="slicer-region-@sec.SectionId" style="display: none;"></div>
                <div class="audio-slicer__start-marker" id="slicer-start-marker-@sec.SectionId" style="display: none;"></div>
                <div class="audio-slicer__cursor" id="slicer-cursor-@sec.SectionId"></div>
              </div>

              <!-- Slicer Action Buttons -->
              <div class="row row--between row--wrap" style="align-items: center; gap: 0.5rem;">
                <div class="row" style="gap: 0.35rem; align-items: center;">
                  <button type="button" class="btn btn--secondary btn--sm" onclick="toggleSlicerPlay(@sec.SectionId)" id="btn-slicer-play-@sec.SectionId" style="border-radius: 0; font-size: 0.75rem;">
                    Play
                  </button>
                  <button type="button" class="btn btn--secondary btn--sm" onclick="markCurrentStart(@sec.SectionId)" style="border-radius: 0; font-size: 0.75rem; background: #eef4fc;">
                    Mark Start
                  </button>
                  <button type="button" class="btn btn--secondary btn--sm" onclick="markCurrentEnd(@sec.SectionId)" style="border-radius: 0; font-size: 0.75rem; background: #eef4fc;">
                    Mark End
                  </button>
                  <button type="button" class="btn btn--ghost btn--sm" onclick="previewCurrentSlice(@sec.SectionId)" style="border-radius: 0; font-size: 0.75rem;">
                    Preview Slice
                  </button>
                  <button type="button" class="btn btn--ghost btn--sm" onclick="clearCurrentSlice(@sec.SectionId)" style="border-radius: 0; font-size: 0.75rem; color: #777;">
                    Clear
                  </button>
                </div>

                <div class="row" style="gap: 0.35rem; align-items: center;">
                  <label class="btn btn--ghost btn--sm" style="border-radius: 0; font-size: 0.75rem; cursor: pointer; margin: 0;">
                    Upload Audio
                    <input type="file" accept="audio/*" style="display: none;" onchange="uploadAudioFile(this, @sec.SectionId)" />
                  </label>
                </div>
              </div>
              <div class="audio-slicer__status" id="slicer-status-@sec.SectionId" role="status" aria-live="polite" hidden></div>
            </div>
          }

          @if (sec.Groups.Count == 0)
          {
            <div class="text-center text-muted p-4" style="border: 2px dashed #ccd2d6;" id="empty-sec-@sec.SectionId">
              <p>No questions yet in [@sec.Code] @sec.Name.</p>
              <div class="row" style="gap: 0.5rem; justify-content: center;">
                <button type="button" class="btn btn--primary btn--sm" onclick="createInitialCluster(@sec.SectionId, 'cluster', @sec.ClusterSize)">
                  + Add First Cluster (@sec.ClusterSize Qs)
                </button>
                <button type="button" class="btn btn--secondary btn--sm" onclick="triggerQuickIngestForSection(@sec.SectionId)">
                  Use Quick Ingest
                </button>
                <button type="button" class="btn btn--primary btn--sm" onclick="aiFillSection(@sec.SectionId)" id="btn-ai-fill-empty-@sec.SectionId" style="border-radius: 0; font-family: var(--font-condensed, sans-serif); text-transform: uppercase; font-weight: bold;">
                  AI Fill Missing Slots
                </button>
              </div>
            </div>
          }

          @foreach (var g in sec.Groups)
          {
            <div class="card-editor" id="group-card-@g.GroupId" data-group-id="@g.GroupId" data-section-id="@sec.SectionId" data-unit-number="@g.UnitNumber" data-display-order="@g.DisplayOrder">
              <div class="card-editor__header">
                <div class="row" style="gap: 0.5rem; align-items: center;">
                  @if (sec.UnitCount > 1)
                  {
                    <span class="unit-badge">Unit @g.UnitNumber</span>
                  }
                  <span style="font-weight: 600; font-size: 0.85rem; font-family: var(--font-condensed, sans-serif); text-transform: uppercase;">
                    Cluster #@g.DisplayOrder (@g.Questions.Count Questions)
                  </span>
                </div>
                <div class="row" style="gap: 0.5rem; align-items: center;">
                  @if (sec.UnitCount > 1)
                  {
                    <label class="text-xs">Stage/Unit:</label>
                    <select class="field__input studio-autosave" data-type="group" data-id="@g.GroupId" data-field="UnitNumber" style="font-size: 0.75rem; padding: 0.15rem 0.35rem; border-radius: 0;">
                      @for (int u = 1; u <= sec.UnitCount; u++)
                      {
                        <option value="@u" selected="@(g.UnitNumber == u)">Unit @u</option>
                      }
                    </select>
                  }
                  <button type="button" class="btn btn--ghost btn--sm" onclick="deleteStudioGroup(@g.GroupId, @sec.SectionId)" style="color: var(--color-danger, #b31217); padding: 0.1rem 0.3rem;" title="Remove Group">&times; Remove Group</button>
                </div>
              </div>

              <div class="p-3 stack" style="gap: 0.75rem;">
                <!-- DUAL PANE WORKSPACE IF PASSAGE STIMULUS REQUIRED -->
                <div class="@(isSplit ? "split-workspace" : "")">

                  @if (isSplit || !string.IsNullOrWhiteSpace(g.Passage))
                  {
                    <!-- LEFT PANE: STIMULUS & PASSAGE EDITOR -->
                    <div class="split-workspace__pane" style="background: #fafafa; border: 1px solid #ccd2d6; padding: 0.75rem;">
                      <div class="row row--between mb-1" style="align-items: center;">
                        <label class="text-xs" style="font-weight: bold; text-transform: uppercase; font-family: var(--font-condensed, sans-serif);">
                          Passage / Stimulus Editor
                        </label>
                        <div class="row" style="gap: 0.25rem;">
                          <button type="button" class="btn btn--ghost btn--sm" onclick="insertP6Blank(@g.GroupId, 1)" style="border-radius: 0; font-size: 0.7rem; padding: 0.1rem 0.3rem;">+ [1]</button>
                          <button type="button" class="btn btn--ghost btn--sm" onclick="insertP6Blank(@g.GroupId, 2)" style="border-radius: 0; font-size: 0.7rem; padding: 0.1rem 0.3rem;">+ [2]</button>
                          <button type="button" class="btn btn--ghost btn--sm" onclick="insertP6Blank(@g.GroupId, 3)" style="border-radius: 0; font-size: 0.7rem; padding: 0.1rem 0.3rem;">+ [3]</button>
                          <button type="button" class="btn btn--ghost btn--sm" onclick="insertP6Blank(@g.GroupId, 4)" style="border-radius: 0; font-size: 0.7rem; padding: 0.1rem 0.3rem;">+ [4]</button>
                        </div>
                      </div>

                      <div class="doc-tabs" id="doc-tabs-@g.GroupId">
                        <button type="button" class="doc-tab is-active" id="tab-btn-@g.GroupId-1" onclick="switchDocTab(@g.GroupId, 1)">Document 1</button>
                        <button type="button" class="doc-tab" id="tab-btn-@g.GroupId-2" onclick="switchDocTab(@g.GroupId, 2)">Document 2</button>
                        <button type="button" class="doc-tab" id="tab-btn-@g.GroupId-3" onclick="switchDocTab(@g.GroupId, 3)">Document 3</button>
                      </div>

                      <textarea rows="9" class="field__input studio-autosave p6-passage-input" id="p6-passage-@g.GroupId" data-type="group" data-id="@g.GroupId" data-field="Passage" oninput="renderP6Preview(@g.GroupId)" placeholder="Passage content here... (Use '---' on a new line to separate multi-documents, or [1], [2], [3] for inline blanks)" style="width: 100%; font-size: 0.82rem; border-radius: 0; font-family: var(--font-mono, monospace);">@g.Passage</textarea>

                      <!-- Live Inline Blank Preview -->
                      <div class="mt-2">
                        <span class="text-xs text-muted uppercase font-bold" style="letter-spacing: 0.05em;">Stimulus Live Preview:</span>
                        <div class="p-2 mt-1" id="p6-preview-@g.GroupId" style="background: #ffffff; border: 1px solid #ccd2d6; font-size: 0.8rem; min-height: 48px; line-height: 1.6;">
                          <!-- Rendered by renderP6Preview -->
                        </div>
                      </div>
                    </div>
                  }

                  <!-- IMAGE OR AUDIO ATTACHMENT SLOTS IF CONFIGURED -->
                  <div class="@(isSplit ? "split-workspace__pane" : "") stack" style="gap: 0.75rem;">
                    @if (sec.RequireImage || !string.IsNullOrWhiteSpace(g.ImagePath))
                    {
                      <div style="background: #fafafa; border: 1px solid #ccd2d6; padding: 0.75rem;">
                        <div class="row row--wrap" style="gap: 1rem; align-items: start;">
                          <div style="width: 160px;">
                            <div class="studio-dropzone" id="dropzone-@g.GroupId" ondragover="onDragOver(event)" ondragleave="onDragLeave(event)" ondrop="onDropFile(event, @g.GroupId, 'image')" onclick="triggerFileInput('img-input-@g.GroupId')">
                              @if (!string.IsNullOrWhiteSpace(g.ImagePath))
                              {
                                <img src="@Contracts.MediaUrlHelper.NormalizeMediaUrl(g.ImagePath)" alt="@g.ImageAlt" id="preview-img-@g.GroupId" style="width: 100%; max-height: 110px; object-fit: contain; border: 2px solid #14181d;" />
                                <div class="text-xs text-muted mt-1">Replace photo</div>
                              }
                              else
                              {
                                <div id="dropzone-placeholder-@g.GroupId">
                                  <span style="font-size: 1.4rem; display: block;">&#128247;</span>
                                  <span class="text-xs font-bold">Photo Stimulus</span>
                                  <span class="text-xs text-muted block">browse or drop</span>
                                </div>
                                <img id="preview-img-@g.GroupId" style="width: 100%; max-height: 110px; object-fit: contain; border: 2px solid #14181d; display: none;" />
                              }
                              <input type="file" id="img-input-@g.GroupId" accept="image/*" style="display: none;" onchange="uploadImageInput(this, @g.GroupId)" />
                            </div>
                          </div>

                          <div style="flex: 1;" class="stack" style="gap: 0.4rem;">
                            <div>
                              <label class="text-xs" style="font-weight: bold;">Photo File Path:</label>
                              <input type="text" class="field__input studio-autosave" data-type="group" data-id="@g.GroupId" data-field="ImagePath" id="img-path-@g.GroupId" value="@g.ImagePath" placeholder="/media/photo.jpg" style="width: 100%; font-size: 0.78rem; border-radius: 0;" />
                            </div>

                            <div>
                              <label class="text-xs" style="font-weight: bold;">
                                Accessibility Alt Text
                                <span class="badge text-xs" style="background: #fbe9e9; color: #b31217; border-radius: 0;">* REQUIRED (CK_QGroups_ImageAlt)</span>:
                              </label>
                              <input type="text" class="field__input studio-autosave @(string.IsNullOrWhiteSpace(g.ImageAlt) && !string.IsNullOrWhiteSpace(g.ImagePath) ? "border-danger" : "")" data-type="group" data-id="@g.GroupId" data-field="ImageAlt" id="img-alt-@g.GroupId" value="@g.ImageAlt" placeholder="Description of image for accessibility..." style="width: 100%; font-size: 0.78rem; border-radius: 0;" />
                            </div>
                          </div>
                        </div>
                      </div>
                    }

                    @if (hasAudioStimulus)
                    {
                      <div style="background: #fafafa; border: 1px solid #ccd2d6; padding: 0.75rem;">
                        <div class="row row--wrap" style="gap: 0.5rem; align-items: center;">
                          <div style="flex: 2;">
                            <label class="text-xs font-bold">Audio Clip Track:</label>
                            <input type="text" class="field__input studio-autosave" data-type="group" data-id="@g.GroupId" data-field="AudioPath" value="@g.AudioPath" placeholder="/audio/cluster.mp3" style="width: 100%; font-size: 0.78rem; border-radius: 0;" />
                          </div>
                          <div style="width: 85px;">
                            <label class="text-xs">Start (ms):</label>
                            <input type="number" class="field__input" data-type="group" data-id="@g.GroupId" data-field="AudioStartMs" data-saved-value="@g.AudioStartMs" id="start-ms-@g.GroupId" value="@g.AudioStartMs" min="0" style="width: 100%; font-size: 0.75rem; border-radius: 0;" />
                          </div>
                          <div style="width: 85px;">
                            <label class="text-xs">End (ms):</label>
                            <input type="number" class="field__input" data-type="group" data-id="@g.GroupId" data-field="AudioEndMs" data-saved-value="@g.AudioEndMs" id="end-ms-@g.GroupId" value="@g.AudioEndMs" min="0" style="width: 100%; font-size: 0.75rem; border-radius: 0;" />
                          </div>
                          <button type="button" class="btn btn--secondary btn--sm" onclick="setActiveSlicerGroup(@g.GroupId, @sec.SectionId)" style="border-radius: 0; font-size: 0.75rem; margin-top: 1.1rem;">
                            Sync Slicer
                          </button>
                        </div>

                        <div class="mt-2">
                          <label class="text-xs font-bold">Audio Dialogue / Spoken Transcript:</label>
                          <textarea rows="2" class="field__input studio-autosave" data-type="group" data-id="@g.GroupId" data-field="Transcript" placeholder="Spoken dialogue or audio script..." style="width: 100%; font-size: 0.78rem; border-radius: 0;">@g.Transcript</textarea>
                        </div>
                      </div>
                    }

                    <!-- QUESTIONS INSIDE THIS GROUP -->
                    <div class="stack" style="gap: 0.75rem; margin-top: 0.5rem;">
                      @foreach (var q in g.Questions)
                      {
                        var allowedTypesRaw = sec.AllowedComponentTypesJson;
                        var allowedList = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                        if (!string.IsNullOrWhiteSpace(allowedTypesRaw))
                        {
                            try
                            {
                                var parsed = System.Text.Json.JsonSerializer.Deserialize<List<string>>(allowedTypesRaw);
                                if (parsed != null) foreach (var t in parsed) allowedList.Add(t.Trim());
                            } catch {}
                        }
                        if (allowedList.Count == 0)
                        {
                            allowedList.Add("mcq");
                            allowedList.Add("free_response");
                        }
                        var currentTypeCode = q.QuestionType switch
                        {
                            Contracts.QuestionTypeDto.Mcq => "mcq",
                            Contracts.QuestionTypeDto.Mcq_3 => "mcq_3",
                            Contracts.QuestionTypeDto.MultiSelect => "multi_select",
                            Contracts.QuestionTypeDto.InlineCompletion => "inline_completion",
                            Contracts.QuestionTypeDto.Dropdown => "dropdown",
                            Contracts.QuestionTypeDto.DragDrop => "drag_drop",
                            Contracts.QuestionTypeDto.FreeResponse => "free_response",
                            _ => "mcq"
                        };
                        allowedList.Add(currentTypeCode);

                        <div class="question-card p-3" id="question-card-@q.QuestionId" data-question-id="@q.QuestionId" data-section-id="@sec.SectionId" data-question-type="@currentTypeCode" data-difficulty="@q.DifficultyLevel" data-display-order="@q.DisplayOrder" style="border: 2px solid var(--color-ink, #14181d); background: #ffffff; border-radius: 0; box-shadow: none;">
                          <div class="row row--between mb-2" style="align-items: center;">
                            <div class="row" style="gap: 0.5rem; align-items: center;">
                              <strong class="text-sm" style="font-family: var(--font-mono, monospace);">Question #@q.DisplayOrder</strong>
                              @if (sec.RequirePassage)
                              {
                                <span class="badge" style="background: var(--color-ink, #14181d); color: #fff; border-radius: 0; font-family: var(--font-mono, monospace); font-size: 0.7rem;">BLANK [@q.DisplayOrder]</span>
                              }
                            </div>

                            <div class="row" style="gap: 0.5rem; align-items: center;">
                              <label class="text-xs" for="question-type-@q.QuestionId">Type:</label>
                              <select class="field__input studio-question-type" id="question-type-@q.QuestionId" data-qid="@q.QuestionId" data-saved-type="@currentTypeCode" style="font-size: 0.75rem; padding: 0.2rem 0.4rem; border-radius: 0; border: 1px solid var(--color-ink, #14181d);">
                                @if (allowedList.Contains("mcq"))
                                {
                                  <option value="mcq" selected="@(currentTypeCode == "mcq")">MCQ (4 options)</option>
                                }
                                @if (allowedList.Contains("mcq_3"))
                                {
                                  <option value="mcq_3" selected="@(currentTypeCode == "mcq_3")">MCQ (3 options)</option>
                                }
                                @if (allowedList.Contains("multi_select"))
                                {
                                  <option value="multi_select" selected="@(currentTypeCode == "multi_select")">Multi-Select</option>
                                }
                                @if (allowedList.Contains("inline_completion"))
                                {
                                  <option value="inline_completion" selected="@(currentTypeCode == "inline_completion")">Inline Blank / Fill</option>
                                }
                                @if (allowedList.Contains("dropdown"))
                                {
                                  <option value="dropdown" selected="@(currentTypeCode == "dropdown")">Dropdown Choice</option>
                                }
                                @if (allowedList.Contains("drag_drop"))
                                {
                                  <option value="drag_drop" selected="@(currentTypeCode == "drag_drop")">Drag & Drop Matching</option>
                                }
                                @if (allowedList.Contains("free_response"))
                                {
                                  <option value="free_response" selected="@(currentTypeCode == "free_response")">Free Response (AI Rubric)</option>
                                }
                              </select>

                              <label class="text-xs">Category:</label>
                              <select class="field__input studio-autosave" data-type="question" data-id="@q.QuestionId" data-field="CategoryId" style="font-size: 0.75rem; padding: 0.2rem 0.4rem; border-radius: 0;">
                                <option value="">-- No Category --</option>
                                @foreach (var cat in Model.AvailableCategories)
                                {
                                  <option value="@cat.CategoryId" selected="@(q.CategoryId == cat.CategoryId)">@cat.Name (@cat.Code)</option>
                                }
                              </select>
                              <button type="button" class="btn btn--ghost btn--sm" onclick="deleteStudioQuestion(@q.QuestionId, @sec.SectionId)" style="color: var(--color-danger, #b31217); padding: 0.1rem 0.3rem;" title="Remove Question">&times;</button>
                            </div>
                          </div>

                          <!-- Question Stem -->
                          <div class="mb-2">
                            <div class="row row--between mb-1">
                              <label class="text-xs font-bold">Stem / Prompt Text:</label>
                              <button type="button" class="btn btn--ghost btn--sm" onclick="insertBlankInStem(@q.QuestionId)" style="border-radius: 0; font-size: 0.7rem; padding: 0.1rem 0.3rem;">
                                + Insert Blank (_____)
                              </button>
                            </div>
                            <input type="text" class="field__input studio-autosave" data-type="question" data-id="@q.QuestionId" data-field="Stem" id="stem-@q.QuestionId" value="@q.Stem" placeholder="Question stem text..." style="width: 100%; font-weight: 500; border-radius: 0;" />
                          </div>

                          <!-- 1. COMPONENT PANEL: MCQ & MCQ 3 & DROPDOWN -->
                          @{
                            var isRadioType = currentTypeCode == "mcq" || currentTypeCode == "mcq_3" || currentTypeCode == "dropdown";
                            var optCount = currentTypeCode == "mcq_3" ? 3 : sec.OptionCount;
                            var optLabels = currentTypeCode == "mcq_3" ? new[] { "A", "B", "C" } : new[] { "A", "B", "C", "D" };
                          }
                          <div class="component-panel component-mcq" style="display: @(isRadioType ? "block" : "none");">
                            @if (sec.HideOptionText)
                            {
                              <div class="text-xs text-muted mb-1" style="font-style: italic;">Note: Option text is hidden for learner view (spoken prompt).</div>
                            }
                            <div class="stack" style="gap: 0.35rem; margin-left: 0.25rem;">
                              @for (var oi = 0; oi < optCount; oi++)
                              {
                                var lbl = oi < optLabels.Length ? optLabels[oi] : ((char)('A' + oi)).ToString();
                                var existingOpt = q.Options.FirstOrDefault(o => o.Label == lbl);
                                var isCorr = existingOpt?.IsCorrect ?? (oi == 0);
                                var optTxt = existingOpt?.Text ?? "";
                                var optRat = existingOpt?.Rationale ?? "";

                                <div class="row studio-opt-row-single" data-label="@lbl" style="gap: 0.5rem; align-items: center;">
                                  <label style="display: flex; align-items: center; gap: 0.25rem; font-weight: bold; width: 45px; cursor: pointer;">
                                    <input type="radio" name="opt-correct-@q.QuestionId" value="@lbl" checked="@isCorr" class="studio-opt-radio" data-qid="@q.QuestionId" data-label="@lbl" style="accent-color: var(--color-ink, #14181d);" />
                                    @lbl.
                                  </label>
                                  <input type="text" class="field__input studio-opt-text" data-qid="@q.QuestionId" data-label="@lbl" value="@optTxt" placeholder="Option text..." style="flex: 2; font-size: 0.82rem; border-radius: 0;" />
                                  <input type="text" class="field__input studio-opt-rationale" data-qid="@q.QuestionId" data-label="@lbl" value="@optRat" placeholder="Distractor rationale..." style="flex: 2; font-size: 0.78rem; color: #555; border-radius: 0;" />
                                </div>
                              }
                            </div>
                          </div>

                          <!-- 2. COMPONENT PANEL: MULTI-SELECT -->
                          <div class="component-panel component-multi-select" style="display: @(currentTypeCode == "multi_select" ? "block" : "none"); background: #fdfdfd; border: 1px solid #ccd2d6; padding: 0.5rem;">
                            <div class="row mb-2" style="gap: 1rem; align-items: center;">
                              <label class="text-xs font-bold">Max Selections Allowed:</label>
                              <input type="number" class="field__input studio-autosave" data-type="question" data-id="@q.QuestionId" data-field="MaxSelections" value="@(q.MaxSelections ?? 2)" min="1" max="10" style="width: 80px; font-size: 0.8rem; border-radius: 0;" />
                              <span class="text-xs text-muted">Check all correct options:</span>
                            </div>
                            <div class="stack" style="gap: 0.35rem;">
                              @for (var oi = 0; oi < sec.OptionCount; oi++)
                              {
                                var lbl = ((char)('A' + oi)).ToString();
                                var existingOpt = q.Options.FirstOrDefault(o => o.Label == lbl);
                                var isCorr = existingOpt?.IsCorrect ?? false;
                                var optTxt = existingOpt?.Text ?? "";
                                var optRat = existingOpt?.Rationale ?? "";

                                <div class="row studio-opt-row-multi" data-label="@lbl" style="gap: 0.5rem; align-items: center;">
                                  <label style="display: flex; align-items: center; gap: 0.25rem; font-weight: bold; width: 45px; cursor: pointer;">
                                    <input type="checkbox" value="@lbl" checked="@isCorr" class="studio-opt-checkbox" data-qid="@q.QuestionId" data-label="@lbl" style="accent-color: var(--color-ink, #14181d);" />
                                    @lbl.
                                  </label>
                                  <input type="text" class="field__input studio-opt-text" data-qid="@q.QuestionId" data-label="@lbl" value="@optTxt" placeholder="Option text..." style="flex: 2; font-size: 0.82rem; border-radius: 0;" />
                                  <input type="text" class="field__input studio-opt-rationale" data-qid="@q.QuestionId" data-label="@lbl" value="@optRat" placeholder="Distractor rationale..." style="flex: 2; font-size: 0.78rem; color: #555; border-radius: 0;" />
                                </div>
                              }
                            </div>
                          </div>

                          <!-- 3. COMPONENT PANEL: INLINE COMPLETION -->
                          <div class="component-panel component-inline-completion" style="display: @(currentTypeCode == "inline_completion" ? "block" : "none"); background: #fdfdfd; border: 1px solid #ccd2d6; padding: 0.5rem;">
                            <div class="stack" style="gap: 0.5rem;">
                              <div>
                                <label class="text-xs font-bold">Accepted Answers (comma-separated variants or JSON list):</label>
                                <input type="text" class="field__input studio-autosave" data-type="question" data-id="@q.QuestionId" data-field="AcceptedAnswersJson" value="@q.AcceptedAnswersJson" placeholder="e.g. center, centre, middle" style="width: 100%; font-size: 0.82rem; border-radius: 0;" />
                              </div>
                              <div class="row row--wrap" style="gap: 1rem; align-items: center;">
                                <label style="display: flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; cursor: pointer;">
                                  <input type="checkbox" class="studio-autosave" data-type="question" data-id="@q.QuestionId" data-field="AllowNumber" checked="@q.AllowNumber" style="accent-color: var(--color-ink, #14181d);" />
                                  <span>Allow numeric digits and words (e.g., '5' and 'five')</span>
                                </label>
                                <div class="row" style="gap: 0.35rem; align-items: center;">
                                  <label class="text-xs font-bold">Max Words:</label>
                                  <input type="number" class="field__input studio-autosave" data-type="question" data-id="@q.QuestionId" data-field="MaxWords" value="@(q.MaxWords ?? 1)" min="1" max="10" style="width: 70px; font-size: 0.8rem; border-radius: 0;" />
                                </div>
                              </div>
                            </div>
                          </div>

                          <!-- 4. COMPONENT PANEL: DRAG & DROP -->
                          <div class="component-panel component-drag-drop" style="display: @(currentTypeCode == "drag_drop" ? "block" : "none"); background: #fdfdfd; border: 1px solid #ccd2d6; padding: 0.5rem;">
                            <div class="text-xs font-bold mb-1">Target / Choice Associations:</div>
                            <div class="stack" style="gap: 0.35rem;">
                              @for (var oi = 0; oi < sec.OptionCount; oi++)
                              {
                                var lbl = ((char)('A' + oi)).ToString();
                                var existingOpt = q.Options.FirstOrDefault(o => o.Label == lbl);
                                var isCorr = existingOpt?.IsCorrect ?? (oi == 0);
                                var optTxt = existingOpt?.Text ?? "";
                                var optRat = existingOpt?.Rationale ?? "";

                                <div class="row studio-opt-row-drag" data-label="@lbl" style="gap: 0.5rem; align-items: center;">
                                  <span style="font-weight: bold; width: 45px; font-family: var(--font-mono, monospace);">Slot @lbl</span>
                                  <input type="text" class="field__input studio-opt-text" data-qid="@q.QuestionId" data-label="@lbl" value="@optTxt" placeholder="Match value / target item..." style="flex: 2; font-size: 0.82rem; border-radius: 0;" />
                                  <input type="text" class="field__input studio-opt-rationale" data-qid="@q.QuestionId" data-label="@lbl" value="@optRat" placeholder="Matching rationale..." style="flex: 2; font-size: 0.78rem; color: #555; border-radius: 0;" />
                                </div>
                              }
                            </div>
                          </div>

                          <!-- 5. COMPONENT PANEL: FREE RESPONSE (SPEAKING / WRITING) -->
                          <div class="component-panel component-free-response" style="display: @(currentTypeCode == "free_response" ? "block" : "none"); background: #fafafa; border: 1px solid #ccd2d6; padding: 0.75rem; margin-top: 0.5rem;">
                            <div class="row row--wrap" style="gap: 0.75rem;">
                              <div>
                                <label class="text-xs" for="prep-@q.QuestionId" style="font-weight: bold;">Prep Seconds:</label>
                                <input type="number" id="prep-@q.QuestionId" class="field__input studio-autosave" data-type="question" data-id="@q.QuestionId" data-field="PrepSeconds" value="@(q.PrepSeconds ?? (sec.Modality == Contracts.ModalityDto.Speaking ? 15 : 60))" min="1" style="width: 90px; font-size: 0.8rem; border-radius: 0;" />
                              </div>
                              <div>
                                <label class="text-xs" for="response-@q.QuestionId" style="font-weight: bold;">Response Seconds:</label>
                                <input type="number" id="response-@q.QuestionId" class="field__input studio-autosave" data-type="question" data-id="@q.QuestionId" data-field="ResponseSeconds" value="@(q.ResponseSeconds ?? (sec.Modality == Contracts.ModalityDto.Speaking ? 45 : 1800))" min="1" style="width: 90px; font-size: 0.8rem; border-radius: 0;" />
                              </div>
                              @if (sec.Modality == Contracts.ModalityDto.Writing || currentTypeCode == "free_response")
                              {
                                <div>
                                  <label class="text-xs" for="min-words-@q.QuestionId" style="font-weight: bold;">Min Words:</label>
                                  <input type="number" id="min-words-@q.QuestionId" class="field__input studio-autosave" data-type="question" data-id="@q.QuestionId" data-field="MinWords" value="@q.MinWords" min="1" style="width: 90px; font-size: 0.8rem; border-radius: 0;" />
                                </div>
                                <div>
                                  <label class="text-xs" for="max-words-@q.QuestionId" style="font-weight: bold;">Max Words:</label>
                                  <input type="number" id="max-words-@q.QuestionId" class="field__input studio-autosave" data-type="question" data-id="@q.QuestionId" data-field="MaxWords" value="@q.MaxWords" min="1" style="width: 90px; font-size: 0.8rem; border-radius: 0;" />
                                </div>
                              }
                            </div>

                            @if (sec.RequiredKeywordCount > 0 || !string.IsNullOrWhiteSpace(q.RequiredKeywords))
                            {
                              <div class="mt-2">
                                <label class="text-xs" style="font-weight: bold;">
                                  Required Keywords (comma-separated)
                                  <span class="badge text-xs" style="background: #eef; border-radius: 0;">Min @sec.RequiredKeywordCount required</span>:
                                </label>
                                <input type="text" class="field__input studio-autosave" data-type="question" data-id="@q.QuestionId" data-field="RequiredKeywords" value="@q.RequiredKeywords" placeholder="e.g. environment, sustainability, future" style="width: 100%; font-size: 0.8rem; border-radius: 0;" />
                              </div>
                            }

                            <div class="mt-2">
                              <label class="text-xs" for="hint-@q.QuestionId" style="display: block; font-weight: bold;">Learner guidance / Hint:</label>
                              <textarea id="hint-@q.QuestionId" rows="2" class="field__input studio-autosave" data-type="question" data-id="@q.QuestionId" data-field="Hint" placeholder="Instructions or guidance for the learner..." style="width: 100%; border-radius: 0; font-size: 0.8rem;">@q.Hint</textarea>
                            </div>

                            <!-- Rubric Criteria Checklist -->
                            <div class="mt-2">
                              <label class="text-xs" style="font-weight: bold; text-transform: uppercase; font-family: var(--font-condensed, sans-serif);">
                                Rubric Criteria (evaluated by AI Mentor):
                              </label>
                              <div class="stack mt-1" style="gap: 0.35rem; background: #ffffff; border: 1px solid #ccd2d6; padding: 0.5rem; border-radius: 0;">
                                @foreach (var crit in Model.AvailableCriteria.Where(c => c.SkillId == q.SkillId || c.SkillId == sec.SkillId))
                                {
                                  var isAssigned = q.Criteria.Any(assigned => assigned.CriterionId == crit.CriterionId);
                                  <label class="row row--between" style="align-items: center; font-size: 0.8rem; gap: 0.5rem;">
                                    <span style="display: flex; align-items: center; gap: 0.35rem;">
                                      <input type="checkbox" class="studio-criterion-checkbox" data-qid="@q.QuestionId" data-criterion-id="@crit.CriterionId" checked="@isAssigned" style="accent-color: var(--color-ink, #14181d);" />
                                      <span><strong>[@crit.Code]</strong> @crit.Name</span>
                                    </span>
                                    <span class="badge text-xs" style="background: #eef; font-family: var(--font-mono, monospace); border-radius: 0;">Max Score: @crit.MaxScore</span>
                                  </label>
                                }
                              </div>
                            </div>
                          </div>

                          <!-- Pedagogical Explanation / Rationale -->
                          <div style="margin-top: 0.5rem;">
                            <label class="text-xs" for="explanation-@q.QuestionId" data-role="explanation-label">
                              @(currentTypeCode == "free_response" ? "Sample response / answer guidance" : "Explanation / pedagogical rationale")
                            </label>
                            <textarea rows="2" class="field__input studio-autosave" data-type="question" data-id="@q.QuestionId" data-field="Explanation" id="explanation-@q.QuestionId" placeholder="Explanation, sample response, or answer guidance..." style="width: 100%; font-size: 0.8rem; color: #444; border-radius: 0;">@q.Explanation</textarea>
                          </div>
                        </div>
                      }
                    </div>
                  </div>
                </div>
              </div>
            </div>
          }
        </div>
      }
    </div>
  </main>

  <!-- ================= 3. RIGHT READINESS AUDIT PLACARD ================= -->
  <aside class="studio-panel" id="studio-right-audit" aria-label="Publish Readiness Audit">
    <div class="studio-panel__header">
      <h2>Publish Readiness</h2>
      <span class="badge" id="audit-status-badge" style="font-family: var(--font-mono, monospace); border-radius: 0; @(Model.Audit.CanPublish ? "background: #e6f1ea; color: #0a6b3c;" : "background: #fbe9e9; color: #b31217;")">
        @(Model.Audit.CanPublish ? "PASSED" : $"{Model.Audit.BlockingErrorCount} BLOCKS")
      </span>
    </div>

    <div class="studio-panel__body" style="max-height: 75vh; display: flex; flex-direction: column; justify-content: space-between;">
      <div>
        <div class="stack" style="gap: 0.5rem; border-bottom: 2px solid var(--color-ink, #14181d); padding-bottom: 0.75rem; margin-bottom: 0.75rem;">
          <div class="row row--between text-sm">
            <span>Questions:</span>
            <strong style="font-family: var(--font-mono, monospace);" id="audit-q-count">
              @Model.Audit.TotalQuestions / @Model.Audit.ExpectedQuestions
            </strong>
          </div>
          <div class="row row--between text-sm">
            <span>Blocking Errors:</span>
            <strong style="font-family: var(--font-mono, monospace); color: @(Model.Audit.BlockingErrorCount > 0 ? "#b31217" : "#0a6b3c");" id="audit-error-count">
              @Model.Audit.BlockingErrorCount
            </strong>
          </div>
          <div class="row row--between text-sm">
            <span>Warnings:</span>
            <strong style="font-family: var(--font-mono, monospace);" id="audit-warn-count">
              @Model.Audit.WarningCount
            </strong>
          </div>
        </div>

        <ul class="stack" style="gap: 0.4rem; list-style: none; margin: 0; padding: 0;" id="audit-issues-list">
          @if (Model.Audit.Issues.Count == 0 && Model.Audit.CanPublish)
          {
            <li class="audit-item audit-item--success">
              <span>&#10004;</span>
              <div>All certificate invariants satisfied. Ready to publish!</div>
            </li>
          }
          @foreach (var iss in Model.Audit.Issues)
          {
            var itemClass = iss.Severity == "error" ? "audit-item--error" : "audit-item--warning";
            var icon = iss.Severity == "error" ? "&#10008;" : "&#9888;";
            <li class="audit-item @itemClass" id="audit-issue-@iss.Code">
              <span>@Html.Raw(icon)</span>
              <div>
                <div>@iss.Message</div>
                @if (!string.IsNullOrEmpty(iss.ElementTarget))
                {
                  <span class="audit-jump-link" onclick="jumpToAuditElement('@iss.ElementTarget')">Jump to issue &rarr;</span>
                }
              </div>
            </li>
          }
        </ul>
      </div>

      <div style="border-top: 1px solid var(--color-border, #ccd2d6); padding-top: 0.75rem;">
        <button type="button" class="btn btn--primary" id="btn-publish-exam" @(Model.Audit.CanPublish ? "" : "disabled") style="width: 100%; border-radius: 0; text-transform: uppercase; font-family: var(--font-condensed, sans-serif); font-weight: bold; margin-bottom: 0.5rem;">
          Publish Exam
        </button>
        <div style="display: flex; gap: 0.5rem; margin-top: 0.25rem;">
          <a href="/admin/exams/@Model.ExamId/export?format=zip" class="btn btn--secondary" id="btn-export-exam" style="flex: 1; border-radius: 0; font-size: 0.8rem; text-align: center; text-decoration: none; padding: 0.45rem 0.25rem;">
            Export ZIP
          </a>
          <a href="/admin/exams/@Model.ExamId/export?format=json" class="btn btn--secondary" id="btn-export-json" style="flex: 1; border-radius: 0; font-size: 0.8rem; text-align: center; text-decoration: none; padding: 0.45rem 0.25rem;">
            Export JSON
          </a>
        </div>
      </div>
    </div>
  </aside>
</div>

@await Html.PartialAsync("~/Views/Admin/_QuickIngestModal.cshtml")

<script>
(function() {
  var examId = @Model.ExamId;
  var currentSectionId = @(firstSection?.SectionId ?? 0);
  var activeSlicerGroupId = null;
  var activeSlicerSectionId = null;
  var stagedSlicerStarts = Object.create(null);
  var isSaving = false;
  var saveDebounceTimer = null;
  var statusIndicator = document.getElementById('autosave-status');

  function setSlicerStatus(sectionId, message, state) {
    var status = document.getElementById('slicer-status-' + sectionId);
    if (!status) return;

    status.textContent = message;
    status.hidden = !message;
    status.setAttribute('data-state', state || 'info');
    status.setAttribute('aria-live', state === 'error' ? 'assertive' : 'polite');
  }

  function pauseStudioAudio(exceptAudio) {
    document.querySelectorAll('audio').forEach(function(audio) {
      if (audio !== exceptAudio && !audio.paused) audio.pause();
    });
  }

  window.studioAudioManager = {
    pauseAll: function() {
      pauseStudioAudio(null);
    }
  };

  document.addEventListener('play', function(event) {
    if (event.target && event.target.tagName === 'AUDIO') {
      pauseStudioAudio(event.target);
    }
  }, true);

  document.getElementById('studio-workstation')?.addEventListener('click', function(event) {
    if (event.target.closest('.question-card, .card-editor')) {
      pauseStudioAudio(null);
    }
  });

  document.getElementById('studio-workstation')?.addEventListener('focusin', function(event) {
    if (event.target.closest('.question-card, .card-editor')) {
      pauseStudioAudio(null);
    }
  });

  function getCsrfToken() {
    var input = document.querySelector('#studio-csrf-holder input[name="__RequestVerificationToken"]')
      || document.querySelector('input[name="__RequestVerificationToken"]');
    return input ? input.value : '';
  }

  function normalizeMediaUrl(url) {
    if (!url) return '';
    var trimmed = ('' + url).trim();
    if (trimmed.startsWith('/media/') || trimmed.startsWith('http://') || trimmed.startsWith('https://') || trimmed.startsWith('/audio/') || trimmed.startsWith('/images/')) {
      return trimmed;
    }
    var clean = trimmed.replace(/^\/+/, '');
    if (clean.startsWith('exams/') || clean.startsWith('imports/')) {
      return '/media/' + clean;
    }
    return trimmed.startsWith('/') ? trimmed : '/' + trimmed;
  }

  // --- Autosave Engine ---
  function markSaving() {
    isSaving = true;
    if (statusIndicator) {
      statusIndicator.textContent = 'Saving...';
      statusIndicator.style.color = '#0b4ea2';
    }
  }

  function markSaved() {
    isSaving = false;
    if (statusIndicator) {
      var now = new Date();
      var timeStr = now.toTimeString().split(' ')[0];
      statusIndicator.textContent = 'Saved at ' + timeStr;
      statusIndicator.style.color = '#0a6b3c';
    }
  }

  function markSaveFailed(msg) {
    isSaving = false;
    if (statusIndicator) {
      statusIndicator.textContent = 'Save failed: ' + (msg || 'Error');
      statusIndicator.style.color = '#b31217';
    }
  }

  window.addEventListener('beforeunload', function(e) {
    if (isSaving) {
      e.preventDefault();
      e.returnValue = 'You have unsaved changes in progress. Are you sure you want to leave?';
      return e.returnValue;
    }
  });

  // Attach autosave listeners to inputs
  function bindAutosaveInputs() {
    document.querySelectorAll('.studio-autosave').forEach(function(input) {
      if (input._hasAutosave) return;
      input._hasAutosave = true;

      input.addEventListener('input', function() {
        clearTimeout(saveDebounceTimer);
        markSaving();
        saveDebounceTimer = setTimeout(function() {
          performAutosave(input);
        }, 1500);
      });

      input.addEventListener('blur', function() {
        clearTimeout(saveDebounceTimer);
        performAutosave(input);
      });

      input.addEventListener('change', function() {
        clearTimeout(saveDebounceTimer);
        performAutosave(input);
      });
    });

    document.querySelectorAll('.studio-opt-radio, .studio-opt-checkbox').forEach(function(optChoice) {
      if (optChoice._hasAutosave) return;
      optChoice._hasAutosave = true;
      optChoice.addEventListener('change', function() {
        saveSingleQuestion(parseInt(optChoice.getAttribute('data-qid'), 10));
      });
    });

    document.querySelectorAll('.studio-opt-text, .studio-opt-rationale').forEach(function(optInput) {
      if (optInput._hasAutosave) return;
      optInput._hasAutosave = true;
      optInput.addEventListener('input', function() {
        clearTimeout(saveDebounceTimer);
        markSaving();
        saveDebounceTimer = setTimeout(function() {
          saveSingleQuestion(parseInt(optInput.getAttribute('data-qid'), 10));
        }, 1500);
      });
    });

    document.querySelectorAll('.studio-question-type').forEach(function(typeInput) {
      if (typeInput._hasTypeChange) return;
      typeInput._hasTypeChange = true;
      typeInput.addEventListener('change', function() {
        setQuestionTypeDisplay(typeInput);
        saveSingleQuestion(parseInt(typeInput.getAttribute('data-qid'), 10));
      });
    });

    document.querySelectorAll('.studio-criterion-checkbox').forEach(function(checkbox) {
      if (checkbox._hasCriterionChange) return;
      checkbox._hasCriterionChange = true;
      checkbox.addEventListener('change', function() {
        saveSingleQuestion(parseInt(checkbox.getAttribute('data-qid'), 10));
      });
    });
  }

  bindAutosaveInputs();

  function performAutosave(input) {
    var type = input.getAttribute('data-type');
    var id = parseInt(input.getAttribute('data-id'), 10);
    if (type === 'question') {
      saveSingleQuestion(id);
    } else if (type === 'group') {
      saveSingleGroup(id);
    }
  }

  window.saveSingleQuestion = function(questionId) {
    var card = document.getElementById('question-card-' + questionId);
    if (!card) return;

    markSaving();

    var stem = card.querySelector('[data-field="Stem"]')?.value || '';
    var catId = card.querySelector('[data-field="CategoryId"]')?.value;
    var expl = card.querySelector('[data-field="Explanation"]')?.value;
    var prep = card.querySelector('[data-field="PrepSeconds"]')?.value;
    var resp = card.querySelector('[data-field="ResponseSeconds"]')?.value;
    var minW = card.querySelector('[data-field="MinWords"]')?.value;
    var maxW = card.querySelector('[data-field="MaxWords"]')?.value;
    var hint = card.querySelector('[data-field="Hint"]')?.value;
    var maxSel = card.querySelector('[data-field="MaxSelections"]')?.value;
    var allowNumCheck = card.querySelector('[data-field="AllowNumber"]');
    var allowNumber = allowNumCheck ? allowNumCheck.checked : true;
    var acceptedAns = card.querySelector('[data-field="AcceptedAnswersJson"]')?.value;
    var reqKeywords = card.querySelector('[data-field="RequiredKeywords"]')?.value;
    var typeInput = card.querySelector('.studio-question-type');
    var questionTypeStr = typeInput ? typeInput.value : (card.dataset.questionType || 'mcq');

    var options = [];
    if (questionTypeStr === 'multi_select') {
      var multiPanel = card.querySelector('.component-multi-select');
      if (multiPanel) {
        multiPanel.querySelectorAll('.studio-opt-row-multi').forEach(function(row) {
          var label = row.getAttribute('data-label');
          var txtInput = row.querySelector('.studio-opt-text');
          var isCorrCheck = row.querySelector('.studio-opt-checkbox');
          var ratInput = row.querySelector('.studio-opt-rationale');
          options.push({
            label: label,
            text: txtInput ? txtInput.value : '',
            isCorrect: isCorrCheck ? isCorrCheck.checked : false,
            rationale: ratInput ? ratInput.value : null
          });
        });
      }
    } else if (questionTypeStr === 'mcq' || questionTypeStr === 'mcq_3' || questionTypeStr === 'dropdown') {
      var mcqPanel = card.querySelector('.component-mcq');
      if (mcqPanel) {
        mcqPanel.querySelectorAll('.studio-opt-row-single').forEach(function(row) {
          var label = row.getAttribute('data-label');
          var txtInput = row.querySelector('.studio-opt-text');
          var isCorrRadio = row.querySelector('.studio-opt-radio');
          var ratInput = row.querySelector('.studio-opt-rationale');
          options.push({
            label: label,
            text: txtInput ? txtInput.value : '',
            isCorrect: isCorrRadio ? isCorrRadio.checked : false,
            rationale: ratInput ? ratInput.value : null
          });
        });
      }
    } else if (questionTypeStr === 'drag_drop') {
      var dragPanel = card.querySelector('.component-drag-drop');
      if (dragPanel) {
        dragPanel.querySelectorAll('.studio-opt-row-drag, .studio-opt-row-single').forEach(function(row) {
          var label = row.getAttribute('data-label');
          var txtInput = row.querySelector('.studio-opt-text');
          var isCorrRadio = row.querySelector('.studio-opt-radio');
          var ratInput = row.querySelector('.studio-opt-rationale');
          var textVal = txtInput ? txtInput.value.trim() : '';
          if (textVal) {
            options.push({
              label: label,
              text: textVal,
              isCorrect: isCorrRadio ? isCorrRadio.checked : false,
              rationale: ratInput ? ratInput.value : null
            });
          }
        });
      }
    }

    var criterionIds = [];
    card.querySelectorAll('.studio-criterion-checkbox:checked').forEach(function(checkbox) {
      criterionIds.push(parseInt(checkbox.getAttribute('data-criterion-id'), 10));
    });

    var isFreeResponse = questionTypeStr === 'free_response';
    var isInline = questionTypeStr === 'inline_completion';

    var diffLevel = parseInt(card.getAttribute('data-difficulty'), 10);
    if (!diffLevel || isNaN(diffLevel) || diffLevel < 1 || diffLevel > 5) diffLevel = 3;

    var dispOrder = parseInt(card.getAttribute('data-display-order'), 10) || 1;
    var grpId = parseInt(card.closest('.card-editor')?.dataset.groupId, 10) || null;

    var payload = {
      groupId: grpId,
      displayOrder: dispOrder,
      stem: stem,
      difficultyLevel: diffLevel,
      questionType: questionTypeStr,
      explanation: expl,
      categoryId: catId ? parseInt(catId, 10) : null,
      prepSeconds: isFreeResponse && prep ? parseInt(prep, 10) : null,
      responseSeconds: isFreeResponse && resp ? parseInt(resp, 10) : null,
      minWords: isFreeResponse && minW ? parseInt(minW, 10) : null,
      maxWords: isFreeResponse && maxW ? parseInt(maxW, 10) : (isInline && maxW ? parseInt(maxW, 10) : null),
      hint: isFreeResponse ? hint : null,
      maxSelections: questionTypeStr === 'multi_select' && maxSel ? parseInt(maxSel, 10) : null,
      allowNumber: allowNumber,
      acceptedAnswersJson: isInline ? acceptedAns : null,
      requiredKeywords: reqKeywords,
      options: options.length > 0 ? options : null,
      criterionIds: isFreeResponse && criterionIds.length > 0 ? criterionIds : null
    };

    fetch('/admin/exams/' + examId + '/studio/question/' + questionId, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
        'RequestVerificationToken': getCsrfToken()
      },
      body: JSON.stringify(payload)
    })
    .then(async function(res) {
      if (!res.ok) {
        var errDetail = 'HTTP ' + res.status;
        try {
          var data = await res.json();
          if (data && (data.message || data.title || data.detail)) {
            errDetail = data.message || data.title || data.detail;
          }
        } catch (_) {}
        throw new Error(errDetail);
      }
      return res.json();
    })
    .then(function() {
      if (typeInput) {
        typeInput.dataset.savedType = questionTypeStr;
        card.dataset.questionType = questionTypeStr;
      }
      markSaved();
      if (isFreeResponse) {
        syncSectionCriteria(card, criterionIds);
      }
      refreshAudit();
    })
    .catch(function(err) {
      if (typeInput) {
        typeInput.value = typeInput.dataset.savedType || card.dataset.questionType || 'mcq';
        setQuestionTypeDisplay(typeInput);
      }
      markSaveFailed(err.message);
    });
  };

  function setQuestionTypeDisplay(typeInput) {
    var card = document.getElementById('question-card-' + typeInput.getAttribute('data-qid'));
    if (!card) return;

    var selectedType = typeInput.value;
    card.dataset.questionType = selectedType;

    // Toggle panels
    var mcqPanel = card.querySelector('.component-mcq');
    var multiPanel = card.querySelector('.component-multi-select');
    var inlinePanel = card.querySelector('.component-inline-completion');
    var dragPanel = card.querySelector('.component-drag-drop');
    var freeResponsePanel = card.querySelector('.component-free-response');
    var explanationLabel = card.querySelector('[data-role="explanation-label"]');

    if (mcqPanel) mcqPanel.style.display = (selectedType === 'mcq' || selectedType === 'mcq_3' || selectedType === 'dropdown') ? 'block' : 'none';
    if (multiPanel) multiPanel.style.display = (selectedType === 'multi_select') ? 'block' : 'none';
    if (inlinePanel) inlinePanel.style.display = (selectedType === 'inline_completion') ? 'block' : 'none';
    if (dragPanel) dragPanel.style.display = (selectedType === 'drag_drop') ? 'block' : 'none';
    if (freeResponsePanel) freeResponsePanel.style.display = (selectedType === 'free_response') ? 'block' : 'none';

    if (explanationLabel) {
      explanationLabel.textContent = selectedType === 'free_response'
        ? 'Sample response / answer guidance'
        : 'Explanation / pedagogical rationale';
    }
  }

  function syncSectionCriteria(sourceCard, criterionIds) {
    var sectionId = sourceCard.dataset.sectionId;
    var selected = new Set(criterionIds.map(function(id) { return '' + id; }));
    document.querySelectorAll('.question-card[data-section-id="' + sectionId + '"] .studio-criterion-checkbox')
      .forEach(function(checkbox) {
        checkbox.checked = selected.has(checkbox.getAttribute('data-criterion-id'));
      });
  }

  window.saveSingleGroup = function(groupId, slicerSectionId) {
    var card = document.getElementById('group-card-' + groupId);
    if (!card) return;

    markSaving();

    var secId = parseInt(card.getAttribute('data-section-id'), 10);
    var audioPath = card.querySelector('[data-field="AudioPath"]')?.value;
    var startInput = card.querySelector('[data-field="AudioStartMs"]');
    var endInput = card.querySelector('[data-field="AudioEndMs"]');
    var startMs = startInput?.value;
    var endMs = endInput?.value;
    var sliceWasStaged = Object.prototype.hasOwnProperty.call(stagedSlicerStarts, groupId);
    if (slicerSectionId === undefined && sliceWasStaged) {
      startMs = startInput?.getAttribute('data-saved-value');
      endMs = endInput?.getAttribute('data-saved-value');
    }
    var imgPath = card.querySelector('[data-field="ImagePath"]')?.value;
    var imgAlt = card.querySelector('[data-field="ImageAlt"]')?.value;
    var passage = card.querySelector('[data-field="Passage"]')?.value;
    var transcript = card.querySelector('[data-field="Transcript"]')?.value;
    var unitSelect = card.querySelector('[data-field="UnitNumber"]');
    var unitNumber = unitSelect ? parseInt(unitSelect.value, 10) : parseInt(card.getAttribute('data-unit-number') || '1', 10);
    var dispOrder = parseInt(card.getAttribute('data-display-order'), 10) || 1;

    var payload = {
      sectionId: secId,
      displayOrder: dispOrder,
      audioPath: audioPath,
      audioStartMs: startMs ? parseInt(startMs, 10) : null,
      audioEndMs: endMs ? parseInt(endMs, 10) : null,
      imagePath: imgPath,
      imageAlt: imgAlt,
      passage: passage,
      transcript: transcript,
      unitNumber: unitNumber
    };

    fetch('/admin/exams/' + examId + '/studio/group/' + groupId, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
        'RequestVerificationToken': getCsrfToken()
      },
      body: JSON.stringify(payload)
    })
    .then(async function(res) {
      if (!res.ok) {
        var errDetail = 'HTTP ' + res.status;
        try {
          var data = await res.json();
          if (data && (data.message || data.title || data.detail)) {
            errDetail = data.message || data.title || data.detail;
          }
        } catch (_) {}
        throw new Error(errDetail);
      }
      return res.json();
    })
    .then(function() {
      markSaved();
      card.setAttribute('data-unit-number', unitNumber);
      if (slicerSectionId !== undefined) {
        delete stagedSlicerStarts[groupId];
        if (startInput) startInput.setAttribute('data-saved-value', startInput.value);
        if (endInput) endInput.setAttribute('data-saved-value', endInput.value);
        setSlicerStatus(slicerSectionId, 'Saved', 'success');
      }
      refreshAudit();
    })
    .catch(function(err) {
      markSaveFailed(err.message);
      if (slicerSectionId !== undefined) {
        setSlicerStatus(slicerSectionId, 'Save failed: ' + err.message, 'error');
      }
    });
  };

  // --- Visual Audio Slicer Widget Mechanics ---
  function formatTime(sec) {
    if (isNaN(sec) || sec < 0) sec = 0;
    var m = Math.floor(sec / 60);
    var s = Math.floor(sec % 60);
    var ms = Math.floor((sec % 1) * 1000);
    return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s + '.' + (ms < 100 ? (ms < 10 ? '00' : '0') : '') + ms;
  }

  function formatClock(milliseconds) {
    return formatTime(milliseconds / 1000).split('.')[0];
  }

  function readMilliseconds(input) {
    if (!input || input.value.trim() === '') return null;
    var milliseconds = Number(input.value);
    return Number.isInteger(milliseconds) && milliseconds >= 0 ? milliseconds : null;
  }

  function getTargetGroupId(sectionId) {
    if (activeSlicerGroupId && String(activeSlicerSectionId) === String(sectionId)) {
      return activeSlicerGroupId;
    }

    return document.querySelector('#ws-sec-' + sectionId + ' .card-editor')?.getAttribute('data-group-id');
  }

  window.setActiveSlicerGroup = function(groupId, sectionId) {
    activeSlicerGroupId = groupId;
    activeSlicerSectionId = sectionId;
    var grpCard = document.getElementById('group-card-' + groupId);
    if (!grpCard) return;

    var audio = document.getElementById('slicer-audio-' + sectionId);
    var grpAudioPath = grpCard.querySelector('[data-field="AudioPath"]')?.value;
    if (audio && grpAudioPath) {
      var normPath = normalizeMediaUrl(grpAudioPath);
      if (audio.getAttribute('src') !== normPath) {
        audio.src = normPath;
        var label = document.getElementById('slicer-track-label-' + sectionId);
        if (label) label.textContent = normPath;
      }
    }

    var startVal = grpCard.querySelector('[data-field="AudioStartMs"]')?.value;
    var endVal = grpCard.querySelector('[data-field="AudioEndMs"]')?.value;
    updateSlicerRegion(sectionId, readMilliseconds({ value: startVal || '' }), readMilliseconds({ value: endVal || '' }));
    setSlicerStatus(sectionId, '', 'info');
  };

  function updateSlicerRegion(secId, startMs, endMs) {
    var region = document.getElementById('slicer-region-' + secId);
    var marker = document.getElementById('slicer-start-marker-' + secId);
    var audio = document.getElementById('slicer-audio-' + secId);
    if (!region || !marker || !audio || !audio.duration || !isFinite(audio.duration)) {
      if (region) region.style.display = 'none';
      if (marker) marker.style.display = 'none';
      return;
    }

    if (startMs !== null && startMs >= 0) {
      marker.style.left = Math.min(100, (startMs / 1000 / audio.duration) * 100) + '%';
      marker.style.display = 'block';
    } else {
      marker.style.display = 'none';
    }

    if (startMs !== null && endMs !== null && endMs > startMs) {
      var leftPct = Math.min(100, (startMs / 1000 / audio.duration) * 100);
      var widthPct = ((endMs - startMs) / 1000 / audio.duration) * 100;
      region.style.left = leftPct + '%';
      region.style.width = widthPct + '%';
      region.style.display = 'block';
    } else {
      region.style.display = 'none';
    }
  }

  window.toggleSlicerPlay = function(secId) {
    var audio = document.getElementById('slicer-audio-' + secId);
    if (!audio) return;

    if (audio.paused) {
      audio.play().catch(function() {
        setSlicerStatus(secId, 'Audio playback could not be started.', 'error');
      });
    } else {
      audio.pause();
    }
  };

  window.onScrubberClick = function(e, secId) {
    var scrubber = document.getElementById('slicer-scrubber-' + secId);
    var audio = document.getElementById('slicer-audio-' + secId);
    if (!scrubber || !audio || !audio.duration) return;

    var rect = scrubber.getBoundingClientRect();
    var x = e.clientX - rect.left;
    var pct = Math.max(0, Math.min(1, x / rect.width));
    audio.currentTime = pct * audio.duration;
  };

  // Attach timeupdate to slicer audio
  document.querySelectorAll('[id^="slicer-audio-"]').forEach(function(audio) {
    var secId = audio.id.replace('slicer-audio-', '');
    var syncPlayButton = function() {
      var btn = document.getElementById('btn-slicer-play-' + secId);
      if (btn) btn.textContent = audio.paused ? 'Play' : 'Pause';
    };

    audio.addEventListener('play', syncPlayButton);
    audio.addEventListener('pause', syncPlayButton);
    audio.addEventListener('loadedmetadata', function() {
      var groupId = getTargetGroupId(secId);
      var group = groupId ? document.getElementById('group-card-' + groupId) : null;
      updateSlicerRegion(
        secId,
        readMilliseconds(group?.querySelector('[data-field="AudioStartMs"]')),
        readMilliseconds(group?.querySelector('[data-field="AudioEndMs"]'))
      );
    });

    audio.addEventListener('timeupdate', function() {
      var timer = document.getElementById('slicer-timer-' + secId);
      var progress = document.getElementById('slicer-progress-' + secId);
      var cursor = document.getElementById('slicer-cursor-' + secId);

      if (timer && audio.duration) {
        timer.textContent = formatTime(audio.currentTime) + ' / ' + formatTime(audio.duration);
      }
      if (progress && audio.duration) {
        var pct = (audio.currentTime / audio.duration) * 100;
        progress.style.width = pct + '%';
        if (cursor) cursor.style.left = pct + '%';
      }
    });

    audio.addEventListener('ended', function() {
      syncPlayButton();
    });
  });

  window.markCurrentStart = function(secId) {
    var audio = document.getElementById('slicer-audio-' + secId);
    if (!audio) return;
    var ms = Math.floor(audio.currentTime * 1000);
    if (!isFinite(ms) || ms < 0) return;
    var targetGroupId = getTargetGroupId(secId);
    if (!targetGroupId) return;

    var input = document.getElementById('start-ms-' + targetGroupId);
    if (!input) return;

    input.value = ms;
    stagedSlicerStarts[targetGroupId] = ms;
    var endMs = readMilliseconds(document.getElementById('end-ms-' + targetGroupId));
    updateSlicerRegion(secId, ms, endMs);
    setSlicerStatus(secId, 'Start marked: ' + formatClock(ms) + ' — click Mark End to save', 'info');
  };

  window.markCurrentEnd = function(secId) {
    var audio = document.getElementById('slicer-audio-' + secId);
    if (!audio) return;
    var endMs = Math.floor(audio.currentTime * 1000);
    var targetGroupId = getTargetGroupId(secId);
    if (!targetGroupId) {
      setSlicerStatus(secId, 'End time must be after Start time (00:00)', 'error');
      return;
    }

    var startInput = document.getElementById('start-ms-' + targetGroupId);
    var endInput = document.getElementById('end-ms-' + targetGroupId);
    var startMs = readMilliseconds(startInput);
    if (!startInput || !endInput || startMs === null || !isFinite(endMs) || endMs <= startMs) {
      setSlicerStatus(secId, 'End time must be after Start time (' + formatClock(startMs === null ? 0 : startMs) + ')', 'error');
      return;
    }

    endInput.value = endMs;
    updateSlicerRegion(secId, startMs, endMs);
    setSlicerStatus(secId, 'Saving...', 'info');
    saveSingleGroup(parseInt(targetGroupId, 10), secId);
  };

  window.previewCurrentSlice = function(secId) {
    var targetGroupId = getTargetGroupId(secId);
    if (!targetGroupId) return;

    var startMs = readMilliseconds(document.getElementById('start-ms-' + targetGroupId));
    var endMs = readMilliseconds(document.getElementById('end-ms-' + targetGroupId));
    var audio = document.getElementById('slicer-audio-' + secId);
    if (!audio || startMs === null || endMs === null || endMs <= startMs) {
      setSlicerStatus(secId, 'Set valid Start and End times before previewing the slice.', 'error');
      return;
    }

    audio.currentTime = startMs / 1000;
    audio.play().catch(function() {
      setSlicerStatus(secId, 'Audio playback could not be started.', 'error');
    });

    var checkSliceEnd = function() {
      if (audio.currentTime >= endMs / 1000) {
        audio.pause();
        audio.removeEventListener('timeupdate', checkSliceEnd);
      }
    };
    audio.addEventListener('timeupdate', checkSliceEnd);
  };

  window.clearCurrentSlice = function(secId) {
    var targetGroupId = getTargetGroupId(secId);
    if (!targetGroupId) return;

    var sInput = document.getElementById('start-ms-' + targetGroupId);
    var eInput = document.getElementById('end-ms-' + targetGroupId);
    if (sInput) sInput.value = '';
    if (eInput) eInput.value = '';
    updateSlicerRegion(secId, null, null);
    setSlicerStatus(secId, 'Saving...', 'info');
    saveSingleGroup(parseInt(targetGroupId, 10), secId);
  };

  // --- Upload Audio / Media Handling ---
  function probeAudioDurationSec(file, timeoutMs) {
    return new Promise(function(resolve) {
      var url;
      var timer;
      var probe = new Audio();
      function done(seconds) {
        clearTimeout(timer);
        probe.removeAttribute('src');
        if (url) URL.revokeObjectURL(url);
        resolve(seconds);
      }
      try {
        url = URL.createObjectURL(file);
      } catch (e) {
        resolve(null);
        return;
      }
      timer = setTimeout(function() { done(null); }, timeoutMs);
      probe.preload = 'metadata';
      probe.addEventListener('loadedmetadata', function() {
        var d = probe.duration;
        done(isFinite(d) && d > 0 ? Math.max(1, Math.round(d)) : null);
      }, { once: true });
      probe.addEventListener('error', function() { done(null); }, { once: true });
      probe.src = url;
    });
  }

  var FALLBACK_AUDIO_DURATION_SEC = 300;

  window.uploadAudioFile = function(inputEl, secId) {
    if (!inputEl.files || inputEl.files.length === 0) return;
    var file = inputEl.files[0];

    var durationProbe = probeAudioDurationSec(file, 3000);
    var formData = new FormData();
    formData.append('file', file);

    markSaving();
    fetch('/admin/exams/' + examId + '/media', {
      method: 'POST',
      headers: {
        'RequestVerificationToken': getCsrfToken()
      },
      body: formData
    })
    .then(function(res) {
      if (!res.ok) throw new Error('Upload failed');
      return Promise.all([res.json(), durationProbe]);
    })
    .then(function(uploaded) {
      var result = uploaded[0];
      var durationSec = uploaded[1] || FALLBACK_AUDIO_DURATION_SEC;
      var mediaUrl = normalizeMediaUrl(result.url || result.path);
      var audio = document.getElementById('slicer-audio-' + secId);
      if (audio) {
        audio.src = mediaUrl;
        var label = document.getElementById('slicer-track-label-' + secId);
        if (label) label.textContent = mediaUrl;
      }

      var audioFormData = new FormData();
      audioFormData.append('SectionId', secId);
      audioFormData.append('AudioPath', mediaUrl);
      audioFormData.append('DurationSec', durationSec);
      audioFormData.append('SizeBytes', file.size || 0);

      return fetch('/admin/exams/' + examId + '/audio', {
        method: 'POST',
        headers: {
          'RequestVerificationToken': getCsrfToken(),
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: audioFormData
      });
    })
    .then(function() {
      markSaved();
    })
    .catch(function(err) {
      markSaveFailed('Audio upload failed: ' + err.message);
    });
  };

  window.triggerFileInput = function(id) {
    document.getElementById(id)?.click();
  };

  window.uploadImageInput = function(inputEl, groupId) {
    if (!inputEl.files || inputEl.files.length === 0) return;
    uploadImageFile(inputEl.files[0], groupId);
  };

  function uploadImageFile(file, groupId) {
    var formData = new FormData();
    formData.append('file', file);

    markSaving();
    fetch('/admin/exams/' + examId + '/media', {
      method: 'POST',
      headers: {
        'RequestVerificationToken': getCsrfToken()
      },
      body: formData
    })
    .then(function(res) {
      if (!res.ok) throw new Error('Upload failed');
      return res.json();
    })
    .then(function(result) {
      markSaved();
      var mediaUrl = normalizeMediaUrl(result.url || result.path);
      var pathInput = document.getElementById('img-path-' + groupId);
      if (pathInput) pathInput.value = mediaUrl;

      var preview = document.getElementById('preview-img-' + groupId);
      var placeholder = document.getElementById('dropzone-placeholder-' + groupId);
      if (preview) {
        preview.src = mediaUrl;
        preview.style.display = 'block';
      }
      if (placeholder) placeholder.style.display = 'none';

      saveSingleGroup(groupId);
    })
    .catch(function(err) {
      markSaveFailed('Image upload failed: ' + err.message);
    });
  }

  window.onDragOver = function(e) {
    e.preventDefault();
    e.currentTarget.classList.add('is-dragover');
  };

  window.onDragLeave = function(e) {
    e.currentTarget.classList.remove('is-dragover');
  };

  window.onDropFile = function(e, groupId, type) {
    e.preventDefault();
    e.currentTarget.classList.remove('is-dragover');
    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      uploadImageFile(e.dataTransfer.files[0], groupId);
    }
  };

  // --- Helpers for Templates ---
  window.insertBlankInStem = function(qid) {
    var stemInput = document.getElementById('stem-' + qid);
    if (!stemInput) return;
    var start = stemInput.selectionStart || stemInput.value.length;
    var val = stemInput.value;
    stemInput.value = val.substring(0, start) + ' _____ ' + val.substring(start);
    stemInput.focus();
    saveSingleQuestion(qid);
  };

  window.insertP6Blank = function(groupId, blankNum) {
    var ta = document.getElementById('p6-passage-' + groupId);
    if (!ta) return;
    var token = '[' + blankNum + ']';
    var start = ta.selectionStart || ta.value.length;
    var val = ta.value;
    ta.value = val.substring(0, start) + ' ' + token + ' ' + val.substring(start);
    ta.focus();
    renderP6Preview(groupId);
    saveSingleGroup(groupId);
  };

  window.renderP6Preview = function(groupId) {
    var ta = document.getElementById('p6-passage-' + groupId);
    var preview = document.getElementById('p6-preview-' + groupId);
    if (!ta || !preview) return;

    var text = ta.value || '';
    var escaped = text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\n/g, '<br/>');

    var rendered = escaped.replace(/\[([1-9])\]/g, function(match, p1) {
      return '<span class="blank-badge" onclick="focusP6Question(' + groupId + ', ' + p1 + ')">[' + p1 + ']</span>';
    });

    preview.innerHTML = rendered || '<span class="text-muted italic">Type passage text above to preview blanks...</span>';
  };

  window.focusP6Question = function(groupId, blankNum) {
    var grpCard = document.getElementById('group-card-' + groupId);
    if (!grpCard) return;
    var qCards = grpCard.querySelectorAll('.question-card');
    if (qCards && qCards[blankNum - 1]) {
      qCards[blankNum - 1].scrollIntoView({ behavior: 'smooth', block: 'center' });
      qCards[blankNum - 1].classList.add('is-highlighted');
      setTimeout(function() { qCards[blankNum - 1].classList.remove('is-highlighted'); }, 2000);
    }
  };

