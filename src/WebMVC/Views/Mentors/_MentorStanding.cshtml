@model WebMVC.Models.MentorStandingViewModel
@*
   #223 / D21: what the mentor receives about this learner, replacing one band string.

   Three states, three different sentences and three different marks. "Not measured yet" is the
   learner's - the certificate tests this skill and a placement fills it. "Not examined by this
   certificate" is the paper's - no sitting will ever fill it. Nothing measured at all is a third: the
   learner owes a placement, and the block says so instead of printing a table of absences.
*@
<link rel="stylesheet" href="~/css/components/mentor-standing.css" />

<section class="mentor-standing" aria-labelledby="mentor-standing-title">
  <header class="mentor-standing__header">
    <h2 class="mentor-standing__title" id="mentor-standing-title">Learner standing &mdash; @Model.Standing.CertCode</h2>
    @if (!Model.OwesPlacement)
    {
      <span class="mentor-standing__overall font-mono">
        <span class="mentor-standing__overall-label">Overall</span>
        <span class="mentor-standing__overall-value">@Model.OverallText</span>
      </span>
    }
  </header>

  @if (Model.OwesPlacement)
  {
    <p class="mentor-standing__notice">
      Nothing on @Model.Standing.CertCode has been measured yet, so there is no level and no weakest
      skill to name. The learner owes a free placement test; until it is done this booking can only be
      planned from what the learner says in the focus area.
    </p>
  }
  else
  {
    @if (Model.LimitingSkillText is { } limiting)
    {
      <p class="mentor-standing__limiting">@limiting</p>
    }

    <table class="mentor-standing__table">
      <caption class="mentor-standing__caption">
        One row per skill this certificate examines, then one per skill it does not. Position is a
        position inside the level, never a percentage.
      </caption>
      <thead>
        <tr>
          <th scope="col">Skill</th>
          <th scope="col">State</th>
          <th scope="col">Level</th>
          <th scope="col">Position</th>
          <th scope="col">Measured</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var row in Model.Rows)
        {
          <tr class="@row.CssClass">
            <th scope="row">@row.SkillName</th>
            <td>@row.State</td>
            <td class="font-mono">@(row.Level ?? "")</td>
            <td class="font-mono">@(row.Position ?? "")</td>
            <td>@(row.IsStale ? "Stale - re-measure this skill" : "")</td>
          </tr>
        }
      </tbody>
    </table>
  }
</section>
