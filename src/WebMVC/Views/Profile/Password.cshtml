@inject CurrentUser CurrentUser
@model ChangePasswordViewModel
@{
    var isLearner = !CurrentUser.IsAdmin;
    Layout = isLearner ? "_LearnerLayout" : "_AdminLayout";
    ViewData["Title"] = "Change password";
    ViewData["Description"] = "Change your password.";
}

@if (isLearner)
{
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/dashboard" class="breadcrumbs__item">Home</a>
    <span class="breadcrumbs__separator" aria-hidden="true">›</span>
    <a href="/profile" class="breadcrumbs__item">My profile</a>
    <span class="breadcrumbs__separator" aria-hidden="true">›</span>
    <span class="breadcrumbs__item" aria-current="page">Change password</span>
  </nav>
}

<div class="stack">
  <div>
    <h1 class="m-0 mb-1">Change password</h1>
    <p class="text-muted no-margin">Your current password is required to set a new one.</p>
  </div>

  @if (!string.IsNullOrEmpty(Model.SuccessMessage))
  {
    <div class="alert alert--success" role="status">@Model.SuccessMessage</div>
  }
  @if (!string.IsNullOrEmpty(Model.FormError))
  {
    <div class="alert alert--danger" role="alert">@Model.FormError</div>
  }

  <div class="grid-2">
    <form method="post" asp-action="Password" class="card">
      <div class="card__header"><strong>Password update</strong></div>
      <div class="card__body stack">
        @Html.AntiForgeryToken()

        <div class="field">
          <label class="field__label" asp-for="CurrentPassword">Current password</label>
          <input class="field__input" asp-for="CurrentPassword" type="password" autocomplete="current-password" required>
          <span asp-validation-for="CurrentPassword" class="field__error"></span>
        </div>

        <div class="field">
          <label class="field__label" asp-for="NewPassword">New password</label>
          <input class="field__input" asp-for="NewPassword" type="password" autocomplete="new-password" required>
          <span asp-validation-for="NewPassword" class="field__error"></span>
          <p class="field__hint">At least 8 characters, with letters and numbers.</p>
        </div>

        <div class="field">
          <label class="field__label" asp-for="ConfirmPassword">Confirm new password</label>
          <input class="field__input" asp-for="ConfirmPassword" type="password" autocomplete="new-password" required>
          <span asp-validation-for="ConfirmPassword" class="field__error"></span>
        </div>
      </div>

      <div class="card__footer row row--between" style="align-items: center">
        <button type="submit" class="btn btn--primary">Change password</button>
        <a class="btn btn--ghost btn--sm" href="/profile">Back to profile</a>
      </div>
    </form>

    <aside class="card">
      <div class="card__header"><strong>Important notice</strong></div>
      <div class="card__body stack">
        <ol class="stack--tight m-0" style="padding-left: var(--space-5)">
          <li>Changing your password will <strong>sign you out on all active devices</strong>.</li>
          <li>You will be redirected to sign in immediately with your new credentials.</li>
          <li>Make sure to save any ongoing work before submitting.</li>
        </ol>
      </div>
    </aside>
  </div>
</div>
