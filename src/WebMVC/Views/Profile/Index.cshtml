@model ProfilePageViewModel
@{
    var isLearner = !Model.IsAdmin;
    Layout = isLearner ? "_LearnerLayout" : "_AdminLayout";
    ViewData["Title"] = "My profile";
    ViewData["Description"] = "Your profile and time zone.";
}

@if (isLearner)
{
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/dashboard" class="breadcrumbs__item">Home</a>
    <span class="breadcrumbs__separator" aria-hidden="true">›</span>
    <span class="breadcrumbs__item" aria-current="page">My profile</span>
  </nav>
}

<div class="stack">
  <div>
    <h1 class="m-0 mb-1">My profile</h1>
    <p class="text-muted no-margin">How we address you, and the zone every date and time renders in.</p>
  </div>

  @if (!string.IsNullOrEmpty(Model.Form.SuccessMessage))
  {
    <div class="alert alert--success" role="status">@Model.Form.SuccessMessage</div>
  }
  @if (!string.IsNullOrEmpty(Model.Form.FormError))
  {
    <div class="alert alert--danger" role="alert">@Model.Form.FormError</div>
  }

  @if (!string.IsNullOrEmpty(Model.LoadError))
  {
    <div class="card"><div class="card__body">
      <div class="state-block" role="alert">
        <div class="state-block__icon state-block__icon--danger" aria-hidden="true">FAILED</div>
        <h2 class="state-block__title">We couldn't load your profile</h2>
        <p class="state-block__desc">@Model.LoadError</p>
        <a class="btn btn--primary" href="/profile">Try again</a>
      </div>
    </div></div>
  }
  else
  {
  <div class="grid-2">
    @await Html.PartialAsync("_IndexForm", Model.Form)

    <div class="stack">
      @if (isLearner)
      {
        <partial name="_AudioEquipmentCheck" model="Model.Equipment" />
      }

      <div class="card">
        <div class="card__header"><strong>Credit wallet</strong></div>
        <div class="card__body stack">
          <p class="m-0 text-muted text-sm">
            Credits pay for a mock exam start, AI grading, or a mentor booking. Practice, weakness analysis, and placement exams are completely free. Credits never expire.
          </p>
          <div>
            <a class="btn btn--sm" href="/pricing">Buy credits</a>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card__header"><strong>Password &amp; Security</strong></div>
        <div class="card__body stack">
          <p class="m-0 text-muted text-sm">
            Keep your account secure with a strong password. Changing your password signs out all existing sessions.
          </p>
          <div>
            <a class="btn btn--sm" href="/profile/password">Change password</a>
          </div>
        </div>
      </div>
    </div>
  </div>
  }
</div>
