<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="@ViewData["Description"]">
  <title>@ViewData["Title"] — extra efficient</title>
  <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="~/css/tokens.css">
  <link rel="stylesheet" href="~/css/base.css">
  <link rel="stylesheet" href="~/css/components.css">
  @await RenderSectionAsync("Styles", required: false)
</head>
<body>
  <div class="app-shell">
    <header class="app-topbar">
      <a href="/" style="text-decoration: none"><strong>extra efficient</strong></a>
      <nav class="row" style="gap: var(--space-4); align-items: center">
        <a href="/certificates">Certificates</a>
        <a href="/pricing">Pricing</a>
        @if (User.IsSignedIn())
        {
          <a href="@(User.IsAdmin() ? "/admin" : "/dashboard")">Dashboard</a>
          <a href="/profile">Profile</a>
          <form method="post" action="/auth/sign-out" class="no-margin">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn--ghost btn--sm">Sign out (@(User.GetDisplayName()))</button>
          </form>
        }
        else
        {
          <a href="/auth/sign-in">Sign in</a>
          <a class="btn btn--sm" href="/auth/register">Register</a>
        }
      </nav>
    </header>
    <main class="app-main">
      @RenderBody()
    </main>
  </div>
  <script src="~/js/icons.js"></script>
  <script src="~/js/exam-audio.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
