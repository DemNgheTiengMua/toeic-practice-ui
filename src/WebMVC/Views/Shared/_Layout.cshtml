@inject CurrentUser CurrentUser
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="@ViewData["Description"]">
  <title>@ViewData["Title"] — extra efficient</title>
  <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="~/css/tokens.css">
  <link rel="stylesheet" href="~/css/base.css">
  <link rel="stylesheet" href="~/css/components.css">
</head>
<body>
  <header class="container row row--between" style="padding-top: var(--space-4); padding-bottom: var(--space-4)">
    <a href="/" class="no-margin"><strong>extra efficient</strong></a>
    <nav class="row" style="gap: var(--space-4); align-items: center">
      <a href="/certificates">Certificates</a>
      <a href="/pricing">Pricing</a>
      @if (CurrentUser.IsSignedIn)
      {
        <a href="@(CurrentUser.IsAdmin ? "/admin" : "/dashboard")">Dashboard</a>
        <a href="/profile">Profile</a>
        <form method="post" action="/auth/sign-out" class="no-margin">
          @Html.AntiForgeryToken()
          <button type="submit" class="btn">Sign out (@(CurrentUser.FullName ?? CurrentUser.Email))</button>
        </form>
      }
      else
      {
        <a href="/auth/sign-in">Sign in</a>
        <a class="btn btn--primary" href="/auth/register">Register</a>
      }
    </nav>
  </header>
  @RenderBody()
  <script src="~/js/icons.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
