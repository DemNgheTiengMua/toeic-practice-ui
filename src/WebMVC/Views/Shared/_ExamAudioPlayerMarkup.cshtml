@model WebMVC.Models.ExamAudioPlayerModel
@{
    var mode = Model.Mode ?? (Model.AllowReplay ? "study" : "exam");
    var allowReplay = mode == "study";
}

<div class="exam-audio" @(string.IsNullOrEmpty(Model.PlayerId) ? "" : $"id=\"{Model.PlayerId}\"") data-exam-audio data-mode="@mode" data-allow-replay="@(allowReplay ? "true" : "false")" data-autoplay="@(Model.AutoPlay ? "true" : "false")" data-start-ms="@Model.StartMs" data-end-ms="@Model.EndMs">
  <audio preload="metadata" src="@Model.AudioPath" class="exam-audio__native"></audio>

  <button type="button" class="btn exam-audio__btn-play" aria-label="@(allowReplay ? "Play audio" : "Play audio")">
    <svg class="icon exam-audio__icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M8 5v14l11-7z"/>
    </svg>
    <svg class="icon exam-audio__icon-pause hidden" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
    </svg>
    <span class="exam-audio__btn-text">@(allowReplay ? "PLAY" : "PLAY AUDIO")</span>
  </button>

  <span class="badge badge--info exam-audio__badge font-sign">@(Model.BadgeText ?? "READY")</span>

  @if (allowReplay)
  {
    <button type="button" class="btn btn--secondary btn--sm exam-audio__btn-rewind" aria-label="Rewind 5 seconds" title="Rewind 5 seconds">
      <svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M3 7v6h6"/>
        <path d="M4.5 13a8 8 0 1 0 2.3-5.7L3 10"/>
      </svg>
      <span>5s</span>
    </button>
  }

  <div class="exam-audio__center">
    <div class="exam-audio__progress" role="progressbar" aria-label="Audio progress" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" tabindex="@(allowReplay ? "0" : "-1")">
      <div class="exam-audio__bar" style="width: 0%"></div>
    </div>
    <div class="exam-audio__meta">
      <span class="exam-audio__status visually-hidden" aria-live="polite"></span>
      <span class="exam-audio__timer font-mono">00:00 / 00:00</span>
    </div>
  </div>

  @if (allowReplay)
  {
    <button type="button" class="btn btn--secondary btn--sm exam-audio__btn-forward" aria-label="Forward 5 seconds" title="Forward 5 seconds">
      <span>5s</span>
      <svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 7v6h-6"/>
        <path d="M19.5 13a8 8 0 1 1-2.3-5.7L21 10"/>
      </svg>
    </button>
  }

  @if (allowReplay)
  {
    <div class="exam-audio__speed" role="group" aria-label="Playback speed">
      <button type="button" class="btn btn--xs exam-audio__speed-btn" data-speed="0.8">0.8x</button>
      <button type="button" class="btn btn--xs exam-audio__speed-btn is-active" data-speed="1.0">1.0x</button>
      <button type="button" class="btn btn--xs exam-audio__speed-btn" data-speed="1.2">1.2x</button>
    </div>
  }

  <div class="exam-audio__volume">
    <button type="button" class="btn btn--ghost btn--sm exam-audio__btn-mute" aria-label="Mute audio" title="Mute audio">
      <svg class="icon exam-audio__icon-vol" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
      </svg>
      <svg class="icon exam-audio__icon-mute hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <line x1="23" y1="9" x2="17" y2="15"></line>
        <line x1="17" y1="9" x2="23" y2="15"></line>
      </svg>
    </button>
    <input type="range" min="0" max="100" value="85" class="exam-audio__slider" aria-label="Audio volume" title="Audio volume">
  </div>
</div>
