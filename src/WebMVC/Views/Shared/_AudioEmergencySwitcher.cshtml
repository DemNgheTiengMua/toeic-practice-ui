@model WebMVC.Models.AudioEquipmentCheckModel
@{
    var dialogId = "audio-emergency-" + Guid.NewGuid().ToString("N");
}

<button type="button" class="btn btn--ghost btn--sm" data-audio-emergency-open aria-haspopup="dialog" aria-controls="@dialogId">Audio</button>
<div class="modal-overlay" id="@dialogId" data-audio-emergency aria-hidden="true">
  <div class="modal audio-equipment-dialog" role="dialog" aria-modal="true" aria-labelledby="@(dialogId)-title" tabindex="-1">
    <div class="modal__header">
      <h2 id="@(dialogId)-title">Audio equipment</h2>
      <button type="button" class="modal__close" data-audio-emergency-close>Close</button>
    </div>
    <div class="modal__body">
      @await Html.PartialAsync("_AudioEquipmentCheck", Model with { Compact = true, Title = "Emergency audio settings" })
    </div>
  </div>
</div>
