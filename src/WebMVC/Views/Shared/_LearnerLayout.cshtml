@{
    var shell = ViewData["LearnerShell"] as LearnerContextDto ?? Context.Items["learner-shell"] as LearnerContextDto;
    var path = Context.Request.Path.Value ?? "/";
    var returnUrl = path + Context.Request.QueryString;
    string NavClass(string href)
    {
        if (href == "/exams")
        {
            return (path.Equals("/exams", StringComparison.OrdinalIgnoreCase) || 
                    path.StartsWith("/exams/index", StringComparison.OrdinalIgnoreCase) || 
                    (path.StartsWith("/exams/", StringComparison.OrdinalIgnoreCase) && !path.StartsWith("/exams/history", StringComparison.OrdinalIgnoreCase) && !path.StartsWith("/exams/review", StringComparison.OrdinalIgnoreCase)))
                ? "nav-list__item is-active" : "nav-list__item";
        }
        return path.StartsWith(href, StringComparison.OrdinalIgnoreCase)
            ? "nav-list__item is-active" : "nav-list__item";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="@ViewData["Description"]">
  <title>@ViewData["Title"] — extra efficient</title>
  <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="~/css/tokens.css">
  <link rel="stylesheet" href="~/css/base.css">
  <link rel="stylesheet" href="~/css/components.css">
  <link rel="stylesheet" href="~/css/calm.css">
  @await RenderSectionAsync("Styles", required: false)
  <script src="~/js/sidebar.js"></script>
</head>
<body>
  <a class="visually-hidden" href="#main">Skip to content</a>
  <div class="app-shell app-shell--with-sidebar">
    <header class="app-topbar">
      <a href="/dashboard"><strong>extra efficient</strong></a>
      <div class="row">
        @if (shell is not null)
        {
          <span class="badge badge--info">@shell.CreditBalance @(shell.CreditBalance == 1 ? "credit" : "credits") left</span>
        }
        <form method="post" action="/auth/sign-out" class="no-margin">
          @Html.AntiForgeryToken()
          <button type="submit" class="btn btn--ghost btn--sm">Sign out (@(User.GetDisplayName()))</button>
        </form>
      </div>
    </header>
    <div class="app-body">
      <aside class="app-sidebar">
        <nav class="nav-list" aria-label="Main navigation">
          <a class="@NavClass("/dashboard")" href="/dashboard" aria-current="@(path.StartsWith("/dashboard", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Home</a>
          <div class="nav-list__group">Mock exams</div>
          <a class="@NavClass("/exams")" href="/exams" aria-current="@(path.Equals("/exams", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Exams</a>
          <a class="@NavClass("/exams/history")" href="/exams/history" aria-current="@(path.StartsWith("/exams/history", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Exam history</a>
          <div class="nav-list__group">Practice sessions</div>
          <a class="@NavClass("/practice")" href="/practice" aria-current="@(path.StartsWith("/practice", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Practice by section</a>
          <a class="@NavClass("/weakness-analysis")" href="/weakness-analysis" aria-current="@(path.StartsWith("/weakness-analysis", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Weakness analysis</a>
          <a class="@NavClass("/saved-questions")" href="/saved-questions" aria-current="@(path.StartsWith("/saved-questions", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Saved questions</a>
          <div class="nav-list__group">Learning</div>
          <a class="@NavClass("/placement")" href="/placement" aria-current="@(path.StartsWith("/placement", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Placement test</a>
          <a class="@NavClass("/learning-path")" href="/learning-path" aria-current="@(path.StartsWith("/learning-path", StringComparison.OrdinalIgnoreCase) ? "page" : null)">My learning path</a>
          <a class="@NavClass("/mentors")" href="/mentors" aria-current="@(path.Equals("/mentors", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/mentors/", StringComparison.OrdinalIgnoreCase) && !path.StartsWith("/mentors/bookings", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Find a mentor</a>
          <a class="@NavClass("/mentors/bookings")" href="/mentors/bookings" aria-current="@(path.StartsWith("/mentors/bookings", StringComparison.OrdinalIgnoreCase) ? "page" : null)">My bookings</a>
          <div class="nav-list__group">Catalogue</div>

          <a class="@NavClass("/certificates")" href="/certificates" aria-current="@(path.StartsWith("/certificates", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Certificates</a>
          <div class="nav-list__group">Account</div>
          <a class="@NavClass("/pricing")" href="/pricing" aria-current="@(path.StartsWith("/pricing", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Buy credits</a>
          <a class="@NavClass("/wallet")" href="/wallet" aria-current="@(path.StartsWith("/wallet", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Credit wallet</a>
          <a class="@NavClass("/support")" href="/support/history" aria-current="@(path.StartsWith("/support", StringComparison.OrdinalIgnoreCase) ? "page" : null)">Support reports</a>
          <a class="@NavClass("/profile")" href="/profile">Profile</a>
        </nav>
      </aside>
      <main class="app-main" id="main">
        @if (shell is not null)
        {
          <div class="context-bar">
            <div class="context-bar__item">
              <span class="context-bar__label" id="cert-switcher-label">Certificate:</span>
              <details class="cert-menu">
                <summary class="cert-switcher" aria-labelledby="cert-switcher-label cert-switcher-current">
                  <span class="cert-switcher__current" id="cert-switcher-current">@shell.Active.Code</span>
                  <span class="cert-switcher__arrow" aria-hidden="true">▼</span>
                </summary>
                <form class="cert-dropdown" method="post" action="/learner/active-certificate">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="returnUrl" value="@returnUrl">
                  @foreach (var cert in shell.Certificates)
                  {
                    var isCurrent = cert.Code == shell.Active.Code;
                    <button type="submit" name="code" value="@cert.Code"
                            class="cert-dropdown__item@(isCurrent ? " is-current" : "")"
                            aria-current="@(isCurrent ? "true" : null)">
                      @cert.Code <span class="text-xs">@cert.Name</span>
                    </button>
                  }
                </form>
              </details>
            </div>
          </div>
        }
        <div class="container stack">
          @if (TempData["ShellError"] is string shellError)
          {
            <div class="alert alert--warning" role="alert">@shellError</div>
          }
          @RenderBody()
        </div>
      </main>
    </div>
  </div>
  <script src="~/js/icons.js"></script>
  <script src="~/js/ee-audio.js"></script>
  <script src="~/js/exam-audio.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
