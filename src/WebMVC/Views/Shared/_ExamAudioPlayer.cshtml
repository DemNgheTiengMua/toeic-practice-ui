@model WebMVC.Models.ExamAudioPlayerModel
@{
    var mode = Model.Mode ?? (Model.AllowReplay ? "study" : "exam");
    if (mode is not ("exam" or "study"))
    {
        throw new ArgumentOutOfRangeException(nameof(Model.Mode), "Audio player mode must be 'exam' or 'study'.");
    }
}

@if (Model.TemplateOnly)
{
  <template id="exam-audio-template">
    @await Html.PartialAsync("_ExamAudioPlayerMarkup", Model with { Mode = mode, TemplateOnly = false })
  </template>
}
else
{
  @if (!string.IsNullOrEmpty(Model.SectionTitle))
  {
    <div class="exam-audio__title font-sign">@Model.SectionTitle</div>
  }
  @await Html.PartialAsync("_ExamAudioPlayerMarkup", Model with { Mode = mode, TemplateOnly = false })
}
