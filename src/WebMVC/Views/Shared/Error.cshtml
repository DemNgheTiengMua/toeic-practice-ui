@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    ViewData["Description"] = "An error occurred while processing your request.";
}

<div class="container" style="padding-top: var(--space-6); padding-bottom: var(--space-8); max-width: 640px">
  <div class="card">
    <div class="card__body">
      <div class="state-block" role="alert">
        <div class="state-block__icon state-block__icon--danger" aria-hidden="true">!</div>
        <div class="state-block__title">Something went wrong</div>
        <p class="state-block__desc">
          An error occurred while processing your request. Please try again or return to the homepage.
        </p>
        @if (Model.ShowRequestId)
        {
          <p class="text-xs text-muted font-mono no-margin">Request ID: @Model.RequestId</p>
        }
        <div class="mt-4">
          <a class="btn btn--primary" href="/">Return to home</a>
        </div>
      </div>
    </div>
  </div>
</div>
