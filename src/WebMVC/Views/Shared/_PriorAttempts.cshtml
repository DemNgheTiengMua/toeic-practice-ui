@model IReadOnlyList<Contracts.PriorAttemptDto>?
@using Contracts
@{
    // #239: the prior submissions of one exam, listed so any of them can be re-opened. The route comes
    // from the service - a page that re-derives it can point a graded attempt at a sitting.
    // The status is a code, so it is read through the label registry, never printed.
    var log = Microsoft.Extensions.Logging.Abstractions.NullLogger.Instance;
    var attempts = Model ?? [];
}
@if (attempts.Count > 0)
{
  <div class="card">
    <div class="card__header">
      <div class="row row--between">
        <strong>Your previous attempts</strong>
        <span class="text-xs text-muted font-mono">@attempts.Count total</span>
      </div>
    </div>
    <div class="card__body">
      <table class="table">
        <caption class="visually-hidden">Every attempt you have already made on this exam, newest first</caption>
        <thead>
          <tr>
            <th scope="col">Attempt</th>
            <th scope="col">Started</th>
            <th scope="col">Status</th>
            <th scope="col"><span class="visually-hidden">Open</span></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var attempt in attempts)
          {
            var statusLabel = DisplayLabels.LabelForCode<AttemptStatusDto>(attempt.Status, log);
            <tr>
              <th scope="row" class="font-mono">#@attempt.AttemptId</th>
              <td class="font-mono">@attempt.StartedAt.ToString("d MMM yyyy · HH:mm")</td>
              <td>@statusLabel</td>
              <td>
                @if (!string.IsNullOrEmpty(attempt.ReopenPath))
                {
                  <a class="btn btn--sm btn--ghost" href="@attempt.ReopenPath">
                    @(attempt.CanReview ? "Read the feedback" : "Open") <span aria-hidden="true">&rarr;</span>
                  </a>
                }
                else
                {
                  <span class="text-xs text-muted">Nothing to open</span>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}
