@model WebMVC.Models.AiInsightPanelViewModel
@using Contracts
@using WebMVC.Models
@{
    var insight = Model.Insight;
    var status = insight?.Status.ToWireCode() ?? "pending";
    var isDone = status == "done";
    var isFailed = status == "failed";
    var isPending = !isDone && !isFailed;
    var formattedInitial = Model.FormattedNarrative;
}

<link rel="stylesheet" href="~/css/components/ai-insight-panel.css" />

<div class="card mt-4 ai-insight-panel" id="ai-insight-panel" data-scope="@Model.Scope" data-activity-id="@Model.ActivityId" data-status="@status">
  <div id="ai-insight-csrf" style="display: none;">
    @Html.AntiForgeryToken()
  </div>

  <div class="card__header">
    <div class="row row--between row--middle row--wrap">
      <div>
        <div class="row row--middle" style="gap: var(--space-2, 8px);">
          <span class="badge badge--info font-mono uppercase font-bold" style="letter-spacing: 0.04em;">@(Model.Scope == "dashboard" ? "AI Study Mentor" : "AI Insight")</span>
          <strong>@(Model.Scope == "dashboard" ? "Personal Diagnostic Guidance" : "AI Diagnostic Insights & Recommendations")</strong>
        </div>
        @if (Model.Scope == "dashboard")
        {
          <div class="ai-insight-panel__companion-tagline">
            Continuous diagnostic review &amp; targeted coaching — you are never studying alone.
          </div>
        }
      </div>
      <div id="ai-insight-header-badges" class="row row--middle">
        @if (Model.Scope == "dashboard" && Model.OverallAccuracyPercent.HasValue)
        {
          <span class="badge badge--muted text-xs font-mono">ACCURACY: @(Model.OverallAccuracyPercent.Value)%</span>
        }
        @if (isDone && insight?.Trend != null)
        {
          var trendBadge = insight.Trend switch
          {
              AiInsightTrendDto.Improving => "badge--success",
              AiInsightTrendDto.Declining => "badge--danger",
              _ => "badge--warning"
          };
          var trendLabel = insight.Trend switch
          {
              AiInsightTrendDto.Improving => "Trend: Improving",
              AiInsightTrendDto.Declining => "Trend: Declining",
              _ => "Trend: Flat"
          };
          <span class="badge @trendBadge text-xs font-mono" id="ai-insight-trend-badge">@trendLabel</span>
        }
      </div>
    </div>
  </div>

  <div class="card__body" id="ai-insight-body">
    @if (isPending)
    {
      <div class="state-block p-4" id="ai-insight-loading">
        <div class="row row--between row--middle row--wrap mb-2" style="width: 100%;">
          <span class="badge badge--warning font-mono uppercase font-bold" id="ai-insight-phase">AI MENTOR // ANALYZING PROGRESS…</span>
          <span class="font-mono text-xs font-bold" id="ai-insight-elapsed" aria-live="polite">ELAPSED: 00.0s</span>
        </div>
        <div class="state-block__title">Analyzing your diagnostic progress…</div>
        <p class="state-block__desc">
          Reviewing your latest question logs, accuracy trends, and target band alignment so you have clear next steps.
        </p>
        <div class="ai-kinetic-bar mt-3" role="progressbar" aria-label="AI insight generation in progress">
          <div class="ai-kinetic-bar__fill"></div>
        </div>
      </div>
    }
    else if (isFailed)
    {
      <div class="state-block p-4" id="ai-insight-failed">
        <div class="state-block__icon state-block__icon--danger" aria-hidden="true">FAILED</div>
        <div class="state-block__title">AI Insight Generation Did Not Complete</div>
        <p class="state-block__desc" id="ai-insight-failure-reason">
          @(insight?.FailureReason ?? "Could not generate AI diagnostic insight at this time.")
        </p>
        <button type="button" class="btn btn--primary mt-2" id="ai-insight-retry-btn" onclick="retryAiInsight()">Retry Analysis</button>
      </div>
    }
    else if (isDone && insight != null)
    {
      <div id="ai-insight-content">
        @if (string.IsNullOrWhiteSpace(formattedInitial))
        {
          <div class="ai-mentor-welcome">
            <h3 class="ai-mentor-welcome__heading">Ready to guide your preparation</h3>
            <p class="ai-mentor-welcome__text">
              I am your dedicated AI study mentor. As you complete practice questions and mock exams, I will analyze your answer patterns, spot question traps, and give you step-by-step guidance to achieve your target band.
            </p>
            <div class="row">
              <a class="btn btn--primary btn--sm" href="/placement">Begin Diagnostic Placement ›</a>
            </div>
          </div>
        }
        else
        {
          <div class="ai-insight-narrative" style="line-height: 1.6; font-size: 15px; margin-bottom: var(--space-4); color: var(--ink);">
            @Html.Raw(formattedInitial)
          </div>
        }

        @if (insight.Recommendations is { Count: > 0 })
        {
          <div class="mt-4 pt-3" style="border-top: 1px solid var(--rule-soft);">
            <div class="text-xs uppercase text-muted mb-2 font-bold font-sign" style="letter-spacing: 0.05em;">Action Directives from Your AI Mentor:</div>
            <div class="stack" style="gap: var(--space-2);">
              @foreach (var rec in insight.Recommendations)
              {
                var sevBadge = rec.Severity switch
                {
                    RecommendationSeverityDto.Major => "badge--danger",
                    RecommendationSeverityDto.Minor => "badge--warning",
                    _ => "badge--info"
                };
                var sevLabel = rec.Severity switch
                {
                    RecommendationSeverityDto.Major => "Priority",
                    RecommendationSeverityDto.Minor => "Focus",
                    _ => "Tip"
                };
                <div class="row row--between row--baseline p-2" style="background: var(--surface-soft); border: 1px solid var(--rule-soft);">
                  <div class="row row--baseline">
                    <span class="badge @sevBadge text-xs">@sevLabel</span>
                    <span class="text-sm">@rec.Text</span>
                  </div>
                  @if (!string.IsNullOrEmpty(rec.TargetBandCode))
                  {
                    <span class="badge badge--muted text-xs">Band @rec.TargetBandCode</span>
                  }
                </div>
              }
            </div>
          </div>
        }

        <div class="text-xs text-muted mt-3 font-mono">
          Model: @(insight.Model ?? "fake-ai-insight-v1")
        </div>
      </div>
    }
  </div>

  @if (Model.Scope == "dashboard" && Model.RubricHighlight is { } rubric)
  {
    var reviewUrl = rubric.Purpose == ExamPurposeDto.SpeakingPractice
        ? $"/speaking/review/{rubric.AttemptId}"
        : $"/writing/review/{rubric.AttemptId}";
    <div class="card__body" id="ai-insight-rubric-highlight" style="border-top: 2px solid var(--ink, #14181d); background: var(--surface-soft, #f3f5f7);">
      <div class="row row--between row--middle row--wrap">
        <div class="row row--middle">
          <span class="badge badge--warning font-mono uppercase font-bold">Rubric Focus · @rubric.SkillName</span>
          <strong class="font-sign uppercase" style="letter-spacing: 0.03em;">@rubric.CriterionName</strong>
          <span class="badge badge--muted font-mono">@rubric.Score.ToString("0.##") / @rubric.MaxScore.ToString("0.##")</span>
        </div>
        <a class="btn btn--sm btn--ghost" href="@reviewUrl">Review @rubric.SkillName attempt</a>
      </div>
      @if (!string.IsNullOrWhiteSpace(rubric.Comment))
      {
        <p class="text-sm no-margin mt-2" style="color: var(--ink, #14181d);">@rubric.Comment</p>
      }
    </div>
  }
</div>

<script src="~/js/components/ai-insight-panel.js"></script>
