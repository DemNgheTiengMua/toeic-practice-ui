@model PlacementResultViewModel
@{
    Layout = "_LearnerLayout";
    ViewData["Title"] = "Placement Result";
    var result = Model.Result;
}

@section Styles {
  <link rel="stylesheet" href="~/css/placement/result.css" asp-append-version="true">
}

@* #250 audit: the certificate bar is the LAYOUT's and renders once, above the breadcrumb. This page
   drew a second one, so /placement/result stacked two bars before the heading. The facts it carried
   are on the page already: "Free" is the badge beside the heading and the sitting date is in the
   subtitle beneath it. *@

<div class="container stack">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/dashboard" class="breadcrumbs__item">Home</a>
    <span class="breadcrumbs__separator" aria-hidden="true">›</span>
    <a href="/placement" class="breadcrumbs__item">Placement test</a>
    <span class="breadcrumbs__separator" aria-hidden="true">›</span>
    <span class="breadcrumbs__item" aria-current="page">Result</span>
  </nav>

  @if (!string.IsNullOrEmpty(Model.ErrorMessage))
  {
    <div class="alert alert--danger" role="alert">@Model.ErrorMessage</div>
  }

  <div class="row row--between">
    <div>
      <h1 class="m-0 mb-1">Your placement result</h1>
      <p class="text-muted no-margin">
        Taken @Model.TakenAtDisplay · @result.TotalQuestions questions · <span class="font-mono">@result.DurationMinutes</span> minutes
      </p>
    </div>
    @if (Model.IsTwoSkillScope)
    {
      <span class="badge badge--info">2 skills covered</span>
    }
  </div>

  @if (result.IsAutoSubmitted)
  {
    <div class="alert alert--warning" role="status">
      <strong>Time is up.</strong> The placement test was submitted automatically when your deadline expired and graded on the questions you answered.
    </div>
  }

  @if (Model.IsAwaitingGrading)
  {
    <section id="grading-status-card"
             class="card"
             role="status"
             aria-live="polite"
             data-status-url="/placement/result/@result.PlacementId/status">
      <div class="card__body">
        <strong id="grading-status-title">AI grading in progress</strong>
        <p id="grading-status-message" class="text-sm no-margin mt-1">
          Evaluating grammar structure and task achievement... Objective skill scores are available below.
        </p>
      </div>
    </section>
  }

  @* #218 / LRN-16: one signboard, not four cards. The floor placard, the shared-axis horizon, the
     provenance strip and the single primary action all live inside this partial. *@
  @if (!string.IsNullOrEmpty(Model.ScopeNotice))
  {
    <div class="alert alert--info" role="status">@Model.ScopeNotice</div>
  }

  <partial name="_Signboard" model="Model" />

  @* #217 / PLC-19: a partial result names what is missing rather than presenting a whole one. The
     overall is the weakest MEASURED skill; an unmeasured skill contributes nothing to it, which is
     why this says "excluded", not "scored zero". *@
  @if (Model.Result.SkillResults is { Count: > 0 } && Model.Result.SkillResults.Any(s => s.Status == "not_measured"))
  {
    <div class="alert alert--warning" role="status">
      <strong>This is a partial result.</strong>
      The skills marked <em>Not measured</em> are left out of your overall level — they did not score zero.
    </div>
  }

  @if (result.IsGraded && Model.Insight != null)
  {
    <partial name="_AiInsightPanel" model="Model.InsightPanel" />
  }

  <div class="card">
    <div class="card__header"><strong>Certificate score behind the horizon</strong></div>
    <div class="card__body stack">
      @* #222 / PRN-03: the certificate score is its own quantity with its own label. It is never
         labelled a level, because TOEIC 785-940 is not CEFR B2. *@
      <div class="row row--between row--middle">
        <div>
          <div class="stat__label">Certificate score · @result.CertCode</div>
          <div class="stat__value font-mono">@Model.TotalScoreDisplay</div>
          <div class="stat__hint font-mono text-muted">
            @(string.IsNullOrEmpty(Model.MaximumScore) ? "no scale configured" : $"out of {Model.MaximumScore}")
          </div>
        </div>
        <div>
          <div class="stat__label">Certificate band</div>
          <div class="stat__value">@(string.IsNullOrWhiteSpace(result.ResultBandName) ? result.ResultBandCode : result.ResultBandName)</div>
          <div class="stat__hint text-muted">Read from this certificate's own band table.</div>
        </div>
      </div>
      @if (result.IsGraded && !string.IsNullOrEmpty(result.BandNote))
      {
        <p class="text-sm text-muted no-margin">@result.BandNote</p>
      }
      @if (!result.IsGraded)
      {
        <p class="text-sm text-muted no-margin">The composite figure fills in when grading finishes.</p>
      }
    </div>
    <div class="card__body">
      <table class="table">
        <caption class="visually-hidden">Raw evidence behind each skill's position</caption>
        <thead>
          <tr>
            <th scope="col">Skill</th>
            <th scope="col">Correct</th>
            <th scope="col">Certificate score</th>
            <th scope="col">Measured</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var s in result.SkillScores)
          {
            <tr>
              <th scope="row">@s.SkillName</th>
              <td class="font-mono">@s.RawScore / @s.TotalQuestions</td>
              <td class="font-mono">@Model.SkillScoreDisplay(s)</td>
              <td class="font-mono text-sm">@Model.MeasuredOnFor(s.SkillId)</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

@if (Model.IsAwaitingGrading)
{
  <script src="~/js/placement/result.js" asp-append-version="true"></script>
}
