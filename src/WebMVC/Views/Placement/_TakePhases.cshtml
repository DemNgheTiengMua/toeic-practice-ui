@model PlacementTakeViewModel
@if (Model.ShowPhases)
{
  <section id="phase-progress" class="phase-progress" aria-label="Exam phases">
    @foreach (var phase in Model.Phases)
    {
      <div class="phase-progress__item" data-phase-skill="@phase.SkillCode" aria-current="@phase.AriaCurrent">
        <strong>@phase.SkillName</strong>
        @* #214 / PLC-12: placement has no clock, so a phase says where it stands, never how long is
           left. Colour is the second layer; the word is the first. *@
        <span class="phase-progress__state" data-phase-state="@phase.SkillCode">@phase.StateText</span>
      </div>
    }
  </section>
}
