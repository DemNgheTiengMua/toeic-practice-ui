@model PlacementPreflightPageViewModel
@{
    Layout = "_LearnerLayout";
    ViewData["Title"] = Model.IsRetake ? "Confirm placement retake" : "Placement preflight";
    var gate = Model.Gate;
    var reusable = Model.ReusableOfferCount;
}

@section Styles {
  <link rel="stylesheet" href="~/css/placement/preflight.css" asp-append-version="true">
}

<div class="container stack">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/dashboard" class="breadcrumbs__item">Home</a>
    <span class="breadcrumbs__separator" aria-hidden="true">›</span>
    <a href="/placement" class="breadcrumbs__item">Placement</a>
    <span class="breadcrumbs__separator" aria-hidden="true">›</span>
    <span class="breadcrumbs__item" aria-current="page">@(Model.IsRetake ? "Confirm retake" : "Preflight")</span>
  </nav>

  @if (!string.IsNullOrEmpty(Model.ErrorMessage))
  {
    <div class="alert alert--danger" role="alert">@Model.ErrorMessage</div>
  }

  <div class="row row--between">
    <div>
      <h1 class="m-0 mb-1">@(Model.IsRetake ? "Confirm your placement retake" : "Before you start")</h1>
      @if (Model.IsRetake)
      {
        <p class="text-muted no-margin">
          Choose which skills to measure for <strong>@gate.CertCode</strong>. Your current balance is
          <strong class="font-mono">@Model.CreditBalance @(Model.CreditBalance == 1 ? "credit" : "credits")</strong>.
        </p>
      }
      else
      {
        <p class="text-muted no-margin">
          This is what the placement will measure for <strong>@gate.CertCode</strong>.
          <strong>Free — no credit is deducted.</strong>
        </p>
      }
    </div>
    @if (Model.IsRetake)
    {
      <span class="badge @(Model.IsShortForAllScopes ? "badge--danger" : "badge--info") font-mono">
        @Model.CreditBalance @(Model.CreditBalance == 1 ? "credit" : "credits") left
      </span>
    }
    else
    {
      <span class="badge badge--success">Free</span>
    }
  </div>

  @if (!gate.IsStartable)
  {
    <div class="alert alert--danger" role="alert">
      <strong>A placement can be retaken every 24 hours.</strong>
      @Model.CooldownMessage
    </div>
  }
  else if (gate.CooldownWaived)
  {
    <div class="alert alert--info" role="status">
      <strong>Your last sitting could not be graded.</strong>
      The system failed to produce a result, so the 24-hour wait has been waived — that was not your fault.
    </div>
  }

  <section class="card">
    <div class="card__header"><strong>What is on file for @gate.CertCode</strong></div>
    <div class="card__body">
      <table class="table">
        <caption class="visually-hidden">Each skill this certificate examines, and whether it can be carried over</caption>
        <thead>
          <tr>
            <th scope="col">Skill</th>
            <th scope="col">Previous measurement</th>
            <th scope="col">Needs</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var offer in gate.Offers)
          {
            <tr>
              <th scope="row">@offer.SkillName</th>
              <td>
                @if (offer.CanReuse)
                {
                  <span class="badge badge--info">Valid</span>
                  <span class="font-mono">@Model.LevelAndPosition(offer)</span>
                  <span class="text-sm text-muted">
                    measured @Model.MeasuredOn(offer)
                    @if (offer.IsAged)
                    {
                      <span class="badge badge--warning">Older than 60 days</span>
                    }
                  </span>
                }
                else if (offer.LevelCode is not null)
                {
                  <span class="font-mono">@Model.LevelAndPosition(offer)</span>
                  <span class="text-sm text-muted">measured @Model.MeasuredOn(offer) (older than 90 days)</span>
                }
                else
                {
                  <span class="text-sm text-muted">Not measured yet</span>
                }
              </td>
              <td>
                @if (offer.RequiresMicrophone)
                {
                  <span class="text-sm">Microphone</span>
                }
                else if (offer.RequiresAudio)
                {
                  <span class="text-sm">Headphones</span>
                }
                else
                {
                  <span class="text-sm text-muted">Nothing extra</span>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>

  @if (gate.IsStartable)
  {
    @if (Model.IsShortForAllScopes)
    {
      <section class="card" aria-labelledby="short-balance-heading">
        <div class="card__header"><strong>Insufficient credits</strong></div>
        <div class="card__body stack">
          <div class="alert alert--danger" role="alert">
            <strong id="short-balance-heading">Not enough credits to start a retake.</strong>
            You have <span class="font-mono">@Model.CreditBalance</span> @(Model.CreditBalance == 1 ? "credit" : "credits"),
            and the smallest retake scope costs <span class="font-mono">@PlacementPreflightPageViewModel.FormatCredits(Model.MinimumRequiredCredits)</span>.
            No sitting was created and nothing was charged.
          </div>

          <div class="scope-grid">
            @foreach (var choice in Model.ScopeChoices)
            {
              <div class="scope-choice scope-choice--disabled">
                <div class="scope-choice__header">
                  <span class="scope-choice__title">@choice.Title</span>
                  <span class="scope-choice__price">@choice.PriceLabel</span>
                </div>
                <dl class="scope-choice__facts">
                  <div>
                    <dt>Skills measured</dt>
                    <dd>@choice.IncludedSummary</dd>
                  </div>
                  <div>
                    <dt>Skills left out</dt>
                    <dd>@choice.ExcludedSummary</dd>
                  </div>
                </dl>
                <p class="scope-choice__short no-margin">
                  Short by <span class="font-mono">@choice.ShortBy</span> @(choice.ShortBy == 1 ? "credit" : "credits").
                </p>
              </div>
            }
          </div>

          <div class="preflight-actions">
            <a href="/pricing" class="btn btn--primary btn--lg">Buy credits</a>
            <a href="/placement" class="btn btn--lg">Back to placement</a>
          </div>
        </div>
      </section>
    }
    else
    {
      <section class="card" aria-labelledby="scope-choice-heading">
        <div class="card__header"><strong id="scope-choice-heading">Choose your placement scope</strong></div>
        <div class="card__body stack">
          <p class="no-margin">
            Pick one of the two scopes below. Neither option is selected until you choose it.
          </p>

          @if (Model.IsShortForSomeScope)
          {
            <div class="alert alert--warning" role="status">
              <strong>Your credit balance covers Listening and Reading only.</strong>
              To retake all four skills, <a href="/pricing">buy more credits</a>.
            </div>
          }

          <form method="post"
                action="/placement/start"
                id="placement-confirm-form"
                class="stack"
                data-all-requires-mic="@(Model.AllSkillsRequiresMicrophone ? "true" : "false")"
                data-all-requires-audio="@(Model.AllSkillsRequiresAudio ? "true" : "false")"
                data-lr-requires-mic="@(Model.ListeningAndReadingRequiresMicrophone ? "true" : "false")"
                data-lr-requires-audio="@(Model.ListeningAndReadingRequiresAudio ? "true" : "false")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="examId" value="@Model.EffectiveExamId" />
            <input type="hidden" name="fromPreflight" value="true" />
            <input type="hidden" name="idempotencyKey" value="@Model.IdempotencyKey" />

            <div class="scope-grid" role="radiogroup" aria-labelledby="scope-choice-heading">
              @foreach (var choice in Model.ScopeChoices)
              {
                var cardClass = choice.CanAfford ? "scope-choice" : "scope-choice scope-choice--disabled";
                <label class="@cardClass" for="@choice.RadioId">
                  <input class="scope-choice__input"
                         type="radio"
                         id="@choice.RadioId"
                         name="scope"
                         value="@choice.Value"
                         disabled="@(!choice.CanAfford ? "disabled" : null)" />
                  <div class="scope-choice__header">
                    <span class="scope-choice__title-wrap">
                      <span class="scope-choice__marker" aria-hidden="true"></span>
                      <span class="scope-choice__title">@choice.Title</span>
                    </span>
                    <span class="scope-choice__price">@choice.PriceLabel</span>
                  </div>
                  <dl class="scope-choice__facts">
                    <div>
                      <dt>Skills measured</dt>
                      <dd>@choice.IncludedSummary</dd>
                    </div>
                    <div>
                      <dt>Skills left out</dt>
                      <dd>@choice.ExcludedSummary</dd>
                    </div>
                  </dl>
                  @if (!choice.CanAfford)
                  {
                    <div class="scope-choice__short">
                      Not enough credits (short by <span class="font-mono">@choice.ShortBy</span>).
                      <a href="/pricing">Buy credits</a>
                    </div>
                  }
                </label>
              }
            </div>

            @if (reusable > 0)
            {
              <label class="row row--middle preflight-reuse-toggle">
                <input type="checkbox" name="reuseValidSkills" value="true" />
                <span class="text-sm">
                  Keep my <strong>@reusable</strong> valid result@(reusable == 1 ? "" : "s") from the last 90 days when available in the chosen scope
                </span>
              </label>
            }
            else
            {
              <input type="hidden" name="reuseValidSkills" value="false" />
            }

            <div class="alert alert--info">
              <ul class="preflight-terms">
                <li><strong>Left-out skills are not measured this time.</strong> They are not served, not graded, and never reported as zero.</li>
                <li><strong>Any previous measurement of a left-out skill survives.</strong> Choosing Listening and Reading only leaves any existing Speaking or Writing level intact.</li>
                @if (Model.IsRetake)
                {
                  <li><strong>The charge is made when the sitting starts, not when it is submitted.</strong> Abandoning or letting a sitting expire does not refund credits.</li>
                }
              </ul>
            </div>

            <div class="preflight-actions">
              <button type="submit" id="confirm-start-btn" class="btn btn--primary btn--lg">
                @(Model.IsRetake ? "Confirm and start retake" : "Start placement")
              </button>
              <a href="/placement" class="btn btn--lg">Cancel</a>
              <span id="scope-selection-hint" class="text-sm text-muted">Select a scope above to continue.</span>
            </div>
          </form>
        </div>
      </section>

      @* #221 / D18: the permission is obtained HERE, before the sitting exists, because a system
         dialog over a running clock is an interruption the learner cannot control. Null on a
         paper that needs neither audio nor microphone, so a reading-only certificate never asks. *@
      @if (Model.AudioEquipment is not null)
      {
        <partial name="_AudioEquipmentCheck" model="Model.AudioEquipment" />
      }
    }
  }
</div>

@section Scripts {
  <script src="~/js/placement/preflight.js" asp-append-version="true"></script>
}
