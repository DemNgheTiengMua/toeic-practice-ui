@model PlacementResumePageViewModel
@{
    Layout = "_LearnerLayout";
    ViewData["Title"] = "Resume your placement test";
    var resume = Model.Resume;
}

@* #250 audit: the certificate bar is the layout's; this page drew a second one above it. The start
   time and "free" are stated in the page body. *@

<div class="container stack">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/dashboard" class="breadcrumbs__item">Home</a>
    <span class="breadcrumbs__separator" aria-hidden="true">›</span>
    <a href="/placement" class="breadcrumbs__item">Placement test</a>
    <span class="breadcrumbs__separator" aria-hidden="true">›</span>
    <span class="breadcrumbs__item" aria-current="page">Resume</span>
  </nav>

  @if (Model.HasError)
  {
    <div class="alert alert--danger" role="alert">@Model.ErrorMessage</div>
  }

  <div class="row row--between">
    <div>
      <h1 class="m-0 mb-1">Your placement test is still open</h1>
      <p class="text-muted no-margin">@resume.ExamName — started @Model.StartedAtDisplay.</p>
    </div>
    <span class="badge badge--info">In progress</span>
  </div>

  <section class="card" aria-labelledby="resume-state-heading">
    <div class="card__header"><strong id="resume-state-heading">Where you left off</strong></div>
    <div class="card__body stack">
      <dl class="resume-facts">
        <div class="resume-facts__row">
          <dt>Stage</dt>
          <dd class="font-mono">@Model.StageSummary</dd>
        </div>
        <div class="resume-facts__row">
          <dt>Answers synced</dt>
          <dd class="font-mono">@Model.SyncedSummary</dd>
        </div>
      </dl>

      <table class="table">
        <caption class="visually-hidden">Each skill in this placement test and whether it is done</caption>
        <thead>
          <tr>
            <th scope="col">Skill</th>
            <th scope="col">State</th>
            <th scope="col">Answers</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var skill in Model.SkillRows)
          {
            <tr class="@skill.CssClass">
              <th scope="row">@skill.Name</th>
              <td>@skill.StateText</td>
              <td class="font-mono">@skill.AnsweredSummary</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>

  <div class="row row--between row--middle">
    <form method="post" action="@Model.AbandonUrl" class="no-margin"
          onsubmit="return confirm('Abandon this placement test? Your saved answers are kept for the record, but the sitting closes and this result is not produced. You can start a new one when the retake window opens.');">
      @Html.AntiForgeryToken()
      <button type="submit" class="btn btn--danger">Abandon this test</button>
    </form>
    <a href="@Model.ResumeUrl" class="btn btn--primary">Resume at question</a>
  </div>
</div>
