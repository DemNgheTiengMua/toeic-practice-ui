@model PlacementTakeViewModel
<header class="app-topbar">
  <div class="exam-topbar-group">
    <strong>Placement Test</strong>
    <span class="badge badge--info">Question @Model.Question.DisplayOrder of @Model.Take.TotalQuestions</span>
  </div>
  <div class="exam-topbar-group">
    <span id="save-status" class="save-status save-status--saved" role="status" aria-live="polite">Saved</span>
    @* #214 / PLC-12: a placement measures ability, not speed. There is no overall countdown, so there
       is no clock on this bar - the sitting is in progress while the server says so. *@
    <a href="/placement" class="btn btn--ghost btn--sm" id="btn-exit">Exit</a>
  </div>
</header>
