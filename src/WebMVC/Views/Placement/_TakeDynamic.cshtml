@model PlacementTakeViewModel
<partial name="_TakeTopbar" model="Model" />
<main class="app-main">
  <div class="container take-container">
    @if (Model.HasError)
    {
      <div class="alert alert--danger mb-4" role="alert">@Model.ErrorMessage</div>
    }
    @* #216 / PLC-17: a persistent, non-modal banner. It is hidden until a save actually fails, so a
       healthy sitting never wears a warning it does not need. *@
    <div id="placement-offline-banner" class="placement-offline-banner" role="status" aria-live="polite" hidden>
      <strong>Connection lost</strong>
      <p>Your answers are being saved on this device. You can keep answering; they will be sent when
        the connection is back. Moving to the next part and submitting wait for the server.</p>
    </div>
    <partial name="_TakePhases" model="Model" />
    <div class="exam-layout">
      <div class="stack">
        <partial name="_TakeQuestion" model="Model" />
        <partial name="_TakeNavigation" model="Model" />
      </div>
      <partial name="_TakeNavigator" model="Model" />
    </div>
  </div>
</main>
<script type="application/json" id="placement-take-data">@Html.Raw(Model.PageDataJson)</script>