@{
    Layout = "_Layout";
    ViewData["Title"] = "Placement test not found";
    ViewData["Description"] = "The requested placement test could not be found.";
}

<div class="container stack" style="padding-top: var(--space-8); padding-bottom: var(--space-8); max-width: 520px">
  <div class="card" style="border: 2px solid var(--ink); border-radius: 0;">
    <div class="card__body">
      <div class="state-block">
        <div class="state-block__icon state-block__icon--danger" aria-hidden="true">ERROR</div>
        <h1 class="state-block__title">Placement test not found</h1>
        <p class="state-block__desc">
          This placement test does not exist, belongs to another learner, or has been abandoned.
        </p>
        <div class="row" style="justify-content: center; gap: var(--space-3); margin-top: var(--space-4)">
          <a class="btn btn--primary" href="/placement">Back to placement tests</a>
          <a class="btn btn--ghost" href="/dashboard">Back to home</a>
        </div>
      </div>
    </div>
  </div>
</div>
