@model PlacementTakeViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@Model.PageTitle</title>
  <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="~/css/tokens.css">
  <link rel="stylesheet" href="~/css/base.css">
  <link rel="stylesheet" href="~/css/components.css">
  <link rel="stylesheet" href="~/css/placement/take.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/calm.css">
</head>
<body>
  <div class="app-shell">
    <form id="anti-forgery-holder" class="take-token-holder">@Html.AntiForgeryToken()</form>
    <div id="placement-take-dynamic">
      <partial name="_TakeDynamic" model="Model" />
    </div>
    <partial name="_TakeSubmitModal" model="Model" />
  </div>
  <script src="~/js/icons.js"></script>
  <script src="~/js/exam-audio.js"></script>
  <script src="~/js/keyboard-nav.js"></script>
  <script src="~/js/placement/take.js" asp-append-version="true"></script>
</body>
</html>
