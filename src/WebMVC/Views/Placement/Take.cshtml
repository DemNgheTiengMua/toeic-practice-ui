@model PlacementTakeViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@Model.PageTitle</title>
  <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="~/css/tokens.css">
  <link rel="stylesheet" href="~/css/base.css">
  <link rel="stylesheet" href="~/css/components.css">
  <link rel="stylesheet" href="~/css/placement/take.css" asp-append-version="true">
</head>
<body>
  <div class="app-shell">
    <partial name="_TakeTopbar" model="Model" />
    <main class="app-main">
      <div class="container take-container">
        <form id="anti-forgery-holder" class="take-token-holder">@Html.AntiForgeryToken()</form>
        @if (Model.HasError)
        {
          <div class="alert alert--danger mb-4" role="alert">@Model.ErrorMessage</div>
        }
        <partial name="_TakePhases" model="Model" />
        <div class="exam-layout">
          <div class="stack">
            <partial name="_TakeQuestion" model="Model" />
            <partial name="_TakeNavigation" model="Model" />
          </div>
          <partial name="_TakeNavigator" model="Model" />
        </div>
      </div>
    </main>
    <partial name="_TakeSubmitModal" model="Model" />
  </div>
  <script type="application/json" id="placement-take-data">@Html.Raw(Model.PageDataJson)</script>
  <script src="~/js/icons.js"></script>
  <script src="~/js/exam-audio.js"></script>
  <script src="~/js/keyboard-nav.js"></script>
  <script src="~/js/placement/take.js" asp-append-version="true"></script>
</body>
</html>
