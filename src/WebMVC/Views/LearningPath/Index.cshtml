@model LearningPathIndexViewModel
@{
    Layout = "_LearnerLayout";
    ViewData["Title"] = "My learning path";
    ViewData["Description"] = "Your four-week learning path, planned from your own per-skill levels.";
    var summary = Model.Summary;
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/dashboard" class="breadcrumbs__item">Home</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">My learning path</span>
</nav>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
  <div class="alert alert--danger" role="alert">@Model.ErrorMessage</div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
  <div class="alert alert--success mb-4" role="status">@Model.SuccessMessage</div>
}

@if (!summary.HasActivePath)
{
  <div class="card"><div class="card__body">
    <div class="state-block">
      <div class="state-block__icon" aria-hidden="true">EMPTY</div>
      <h1 class="state-block__title">No learning path yet</h1>
      <p class="state-block__desc">Take a placement test to generate your personalized learning path, or generate one from your current level.</p>
      <div class="row row--center" style="gap: var(--space-3); margin-top: var(--space-3);">
        <a href="/placement" class="btn btn--primary">Start placement test</a>
        <form method="post" action="/learning-path/generate" class="no-margin">
          @Html.AntiForgeryToken()
          <button type="submit" class="btn">Generate path</button>
        </form>
      </div>
    </div>
  </div></div>
}
else
{
  <div class="stack">
    <div class="row row--between" style="align-items: center;">
      <div>
        <h1 class="m-0 mb-1">@summary.FromBandCode → @summary.ToBandCode learning path</h1>
        <p class="text-muted no-margin">From <strong>@summary.FromBandName</strong> to <strong>@summary.ToBandName</strong>. Steps unlock in order.</p>
      </div>
    </div>

    @* #232 / D10: each skill is pitched at its own level. Showing one overall level here would be the
       defect the ticket exists to prevent, so every skill's level is printed. *@
    @if (summary.SkillLevels is { Count: > 0 })
    {
      <div class="card"><div class="card__body">
        <strong class="text-sm">Level by skill</strong>
        <div class="row" style="gap: var(--space-4); flex-wrap: wrap; margin-top: var(--space-2);">
          @foreach (var skillLevel in summary.SkillLevels)
          {
            <div class="font-mono text-sm">
              <span class="text-muted">@skillLevel.Key</span>
              <strong>@skillLevel.Value</strong>
            </div>
          }
        </div>
      </div></div>
    }

    <div class="card"><div class="card__body stack">
      <div class="row row--between">
        <strong class="text-sm">Path progress</strong>
        <span class="text-sm text-muted">@summary.CompletedSteps of @summary.TotalSteps steps done · @Model.TimeLeft</span>
      </div>

      <div class="progress" role="progressbar" aria-valuenow="@summary.CompletedSteps" aria-valuemin="0" aria-valuemax="@summary.TotalSteps" aria-label="Learning path progress">
        <div class="progress__bar" style="width: @Model.ProgressPercent%"></div>
      </div>
      <div class="cefr">
        <div class="cefr__head">
          <span class="cefr__current">@summary.FromBandCode → @summary.ToBandCode</span>
          <span>@(summary.CurrentScore.HasValue ? $"{summary.CurrentScore} at placement" : "")@(summary.CurrentScore.HasValue && summary.TargetScore.HasValue ? " · " : "")@(summary.TargetScore.HasValue ? $"{summary.TargetScore} target" : "")</span>
        </div>
        <div class="cefr__track" role="img" aria-label="Current band @summary.CurrentBandCode, target band @summary.TargetBandCode">
          @foreach (var band in summary.CefrBands)
          {
            var isCurrent = band.Code == summary.CurrentBandCode;
            var isReached = band.IsReached;
            <span class="cefr__band@(isCurrent ? " is-current" : isReached ? " is-reached" : "")">@band.Code</span>
          }
        </div>
        <div class="cefr__scale" aria-hidden="true">
          @foreach (var band in summary.CefrBands)
          {
            <span class="cefr__tick">@band.MinTotal</span>
          }
        </div>
      </div>
    </div></div>

    @if (Model.CalibrationStatus is { } calibrationStatus)
    {
      <p class="text-sm text-muted no-margin" data-calibration-status>@calibrationStatus</p>
    }

    @if (Model.Calibration is { } calibration)
    {
      @await Html.PartialAsync("_Calibration", calibration)
    }

    @if (Model.InsightPanel != null)
    {
      @await Html.PartialAsync("_AiInsightPanel", Model.InsightPanel)
    }

    @if (summary.Weeks is { Count: > 0 })
    {
      <section>
        <h2 class="section-group__title">Four-week plan</h2>
        <div class="stack">
          @foreach (var week in summary.Weeks)
          {
            <article class="path-module">
              <div class="path-module__status">
                @if (week.IsOnTrack)
                {
                  <span class="badge badge--success">On track</span>
                }
                else
                {
                  <span class="badge badge--warning">Off track</span>
                }
              </div>
              <div class="path-module__content">
                <strong>Week @week.WeekNumber</strong>
                <p class="font-mono text-sm no-margin">
                  @week.CompletedSteps/@week.PlannedSteps steps done · @week.CompletedMinutes of @week.PlannedMinutes min planned@(week.ActualAccuracyPct.HasValue ? $" · accuracy {week.ActualAccuracyPct:0.#}% (target {week.TargetAccuracyPct}%)" : "")
                </p>
                <ul class="no-margin" style="margin-top: var(--space-2); padding-left: 1.2rem;">
                  @foreach (var step in week.Steps)
                  {
                    <li class="text-sm">
                      <span class="font-mono text-xs">@step.WeekSequence. @step.TargetCefr</span>
                      <span class="font-mono text-xs">@step.TopicCode</span>
                      @step.Title
                      <span class="text-muted text-xs">· @LearningPathIndexViewModel.StepTypeLabel(step.StepType) · @LearningPathIndexViewModel.SizeLabel(step)</span>
                      @if (step.Status == LearnerPathStepStatusDto.Done)
                      {
                        <span class="badge badge--success text-xs">Done</span>
                      }
                      else if (step.Status == LearnerPathStepStatusDto.InProgress)
                      {
                        <span class="badge badge--warning text-xs">In progress</span>
                      }
                      else if (step.Status == LearnerPathStepStatusDto.Locked)
                      {
                        <span class="badge text-xs">Locked</span>
                      }
                      else
                      {
                        <form method="post" action="/learning-path/steps/@step.StepId/start" class="no-margin" style="display:inline">
                          @Html.AntiForgeryToken()
                          <button type="submit" class="btn btn--sm btn--primary">Start</button>
                        </form>
                      }
                    </li>
                  }
                </ul>
              </div>
            </article>
          }
        </div>
      </section>
    }

    <div class="card mt-4"><div class="card__footer">
      <form method="post" action="/learning-path/reset">
        @Html.AntiForgeryToken()
        <div class="row row--between" style="align-items: center;">
          <span class="text-sm text-muted">Resetting clears your step progress. Your placement result and target level are kept.</span>
          <button type="submit" class="btn btn--danger" onclick="return confirm('Resetting clears your step progress. Are you sure you want to reset your learning path?');">Reset progress</button>
        </div>
      </form>
    </div></div>
  </div>
}
