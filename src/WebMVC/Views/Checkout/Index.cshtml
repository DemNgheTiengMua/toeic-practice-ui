@using Contracts
@model WebMVC.Models.CheckoutViewModel
@{
    Layout = "_LearnerLayout";
    ViewData["Title"] = "Confirm order";
    ViewData["Description"] = "Confirm your credit package order before payment.";
    var preview = Model.Preview;
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/dashboard" class="breadcrumbs__item">Home</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/wallet" class="breadcrumbs__item">Credit wallet</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/pricing" class="breadcrumbs__item">Buy credits</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Confirm order</span>
</nav>

@if (Model.IsBlockedUnverified)
{
    <div class="card">
      <div class="card__body">
        <div class="state-block">
          <div class="state-block__icon" aria-hidden="true">UNVERIFIED</div>
          <h1 class="state-block__title">Email verification required</h1>
          <p class="state-block__desc">
            You must verify your email address before you can purchase credits. Please check your inbox or request a new verification email from your profile.
          </p>
        </div>
        <div class="alert alert--warning">
          Unverified learners cannot proceed to checkout. Diagnostic practice and section drilling remain completely free.
        </div>
      </div>
      <div class="card__footer row">
        <a class="btn btn--primary" href="/profile">Go to profile</a>
        <a class="btn btn--ghost" href="/practice">Practice by section</a>
      </div>
    </div>
}
else if (preview?.OpenOrder is not null)
{
    var open = preview.OpenOrder;
    <div class="card">
      <div class="card__body">
        <div class="state-block">
          <div class="state-block__icon" aria-hidden="true">PENDING</div>
          <h1 class="state-block__title">You have an unfinished order</h1>
          <p class="state-block__desc">
            Order <strong>@open.OrderCode</strong> · @open.PackageName package · @CurrencyFormatter.FormatVnd(open.Amount) · created at @open.CreatedAt.ToString("HH:mm"). This order is still valid, so a new one cannot be created yet.
          </p>
        </div>
        <div class="alert alert--warning">
          If you already paid for the previous order, do not pay again — your credits will be added once reconciliation is complete.
        </div>
      </div>
      <div class="card__footer row">
        @if (open.Status is OrderStatusDto.Pending or OrderStatusDto.Reconciling && !string.IsNullOrEmpty(open.CheckoutUrl))
        {
          <button type="button" class="btn btn--primary" id="btn-resume-qr"
                  data-ordercode="@open.OrderCode"
                  data-packagename="@open.PackageName"
                  data-amount="@CurrencyFormatter.FormatVnd(open.Amount)"
                  data-credits="@open.Credits"
                  data-checkouturl="@open.CheckoutUrl">
            Scan VietQR to Pay
          </button>
        }
        <a class="btn btn--secondary" href="/payment/result?orderCode=@open.OrderCode">Check payment status</a>
        <form method="post" action="/checkout/cancel" style="display: inline-block;">
          @Html.AntiForgeryToken()
          <input type="hidden" name="orderCode" value="@open.OrderCode" />
          <input type="hidden" name="returnUrl" value="/checkout?packageId=@open.PackageId" />
          <button type="submit" class="btn btn--danger" onclick="return confirm('Cancel this order and start a new one?');">Cancel this order</button>
        </form>
        <a class="btn btn--ghost" href="/wallet">View credit wallet</a>
      </div>
    </div>
}
else if (preview is not null)
{
    <div class="stack">
      <div class="row row--between">
        <h1 class="m-0">Confirm order</h1>
      </div>

      <div class="stepper" aria-label="Checkout progress">
        <div class="stepper__item is-done">1. Choose a package</div>
        <div class="stepper__item is-current">2. Confirm</div>
        <div class="stepper__item">3. Payment</div>
        <div class="stepper__item">4. Done</div>
      </div>

      @if (!string.IsNullOrEmpty(Model.ErrorMessage))
      {
          <div class="alert alert--danger" role="alert">
            @Model.ErrorMessage
          </div>
      }

      <div class="grid-2">
        <div class="card">
          <div class="card__header"><strong>Payment method</strong></div>
          <div class="card__body">
            <div class="option-list" role="radiogroup" aria-label="Payment method">
              <label class="option">
                <input class="option__input" type="radio" name="method" value="vietqr" checked>
                <span class="option__marker">1</span>
                <span class="option__text">payOS — VietQR Bank Transfer / Online Checkout</span>
              </label>
            </div>
            <p class="text-muted text-sm mt-2 mb-0">
              You will be redirected to complete payment securely.
            </p>
          </div>
        </div>

        <div class="card">
          <div class="card__header"><strong>Order summary</strong></div>
          <div class="card__body stack">
            <div class="row row--between">
              <span>@preview.PackageName</span>
              <strong>@CurrencyFormatter.FormatVnd(preview.Price)</strong>
            </div>
            <div class="row row--between">
              <span class="text-muted">Credits added</span>
              <span>@preview.Credits @(preview.Credits == 1 ? "credit" : "credits")</span>
            </div>
            <div class="row row--between">
              <span class="text-muted">Current balance</span>
              <span>@preview.CurrentBalance @(preview.CurrentBalance == 1 ? "credit" : "credits")</span>
            </div>
            <div class="row row--between">
              <span class="text-muted">Balance after payment</span>
              <span><strong>@preview.BalanceAfter credits</strong></span>
            </div>
            <hr>
            <div class="row row--between">
              <strong>Total</strong>
              <strong class="text-lg">@CurrencyFormatter.FormatVnd(preview.Price)</strong>
            </div>
          </div>
          <div class="card__footer stack--tight">
            <form id="checkout-form" method="post" action="/checkout">
              @Html.AntiForgeryToken()
              <input type="hidden" name="packageId" value="@preview.PackageId">
              <button type="submit" class="btn btn--primary btn--lg" style="width: 100%;">
                Pay @CurrencyFormatter.FormatVnd(preview.Price)
              </button>
            </form>
            <a class="btn btn--ghost" href="/pricing" style="width: 100%; text-align: center;">Choose another package</a>
          </div>
        </div>
      </div>
    </div>
}

@if (preview is not null)
{
    <!-- QR Payment Modal Dialog with Order Details Panel -->
    <div id="embedded-payment-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="qr-modal-title">
      <div class="modal qr-modal">
        
        <div class="modal__header row row--between">
          <div class="row row--tight">
            <strong id="qr-modal-title">
              VietQR Payment — payOS
            </strong>
          </div>
          <button type="button" class="btn btn--sm btn--ghost" id="btn-close-embedded">
            Close
          </button>
        </div>

        <div class="qr-modal__grid">
          
          <!-- Left Column: Order Summary & Instructions -->
          <div class="qr-modal__summary">
            <div class="stack">
              <div class="row row--between">
                <span class="font-sign uppercase text-xs font-bold text-muted">
                  Order Details
                </span>
                <span class="badge badge--warning">WAITING PAYMENT</span>
              </div>

              <div class="card p-3 mt-2 stack--tight">
                <div class="row row--between text-sm">
                  <span class="text-muted">Order code:</span>
                  <strong class="font-mono" id="modal-order-code">DH-0000</strong>
                </div>
                <div class="row row--between text-sm">
                  <span class="text-muted">Package:</span>
                  <strong id="modal-package-name">Credit Package</strong>
                </div>
                <div class="row row--between text-sm">
                  <span class="text-muted">Credits added:</span>
                  <strong class="text-success" id="modal-credits">+0 credits</strong>
                </div>
                <hr style="margin: 0.5rem 0; border: none; border-top: 1px solid var(--line-soft);">
                <div class="row row--between">
                  <strong>Total amount:</strong>
                  <strong class="font-mono text-primary text-lg" id="modal-amount">0 đ</strong>
                </div>
              </div>

              <div class="mt-2">
                <div class="font-sign uppercase text-xs font-bold text-muted mb-2">
                  Payment Instructions
                </div>
                <ol class="text-sm pl-5" style="margin: 0; line-height: 1.6;">
                  <li>Open your mobile banking app (Vietcombank, MB Bank, Techcombank, etc.) or e-wallet.</li>
                  <li>Select <strong>Scan QR (Quét mã QR)</strong>.</li>
                  <li>Scan the <strong>VietQR</strong> code on the right.</li>
                  <li>Confirm the transfer. Your credits are credited immediately!</li>
                </ol>
              </div>

              <div class="alert alert--success mt-2">
                <strong>Auto-sync:</strong> Do not close this window while paying. Once transferred, this screen automatically updates.
              </div>
            </div>

            <div class="mt-3 text-xs text-muted">
              Having trouble scanning? You can also open the official hosted checkout page directly.
            </div>
          </div>

          <!-- Right Column: payOS VietQR iframe container -->
          <div class="qr-modal__frame">
            <div id="embedded-payment-container" class="w-100" style="height: 540px; min-height: 540px;"></div>
          </div>

        </div>

        <div class="modal__footer row row--between">
          <form id="modal-cancel-form" method="post" action="/checkout/cancel" class="no-margin">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderCode" id="modal-cancel-orderCode" value="" />
            <input type="hidden" name="returnUrl" value="/checkout@(preview != null ? $"?packageId={preview.PackageId}" : "")" />
            <button type="submit" class="btn btn--danger btn--sm" onclick="return confirm('Cancel this payment order?');">
              Cancel order
            </button>
          </form>
          <a id="btn-direct-checkout" href="#" target="_blank" rel="noopener noreferrer" class="btn btn--sm">
            Open payOS hosted page
          </a>
        </div>

      </div>
    </div>
}

@section Scripts {
  <style>
    @("@media") (max-width: 768px) {
      .qr-modal-grid { grid-template-columns: 1fr !important; }
    }
  </style>
  <script src="https://cdn.payos.vn/payos-checkout/v1/stable/payos-initialize.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var form = document.getElementById("checkout-form");
      var embeddedModal = document.getElementById("embedded-payment-modal");
      var btnClose = document.getElementById("btn-close-embedded");
      var directLink = document.getElementById("btn-direct-checkout");
      var modalCancelOrderCode = document.getElementById("modal-cancel-orderCode");
      var btnResume = document.getElementById("btn-resume-qr");
      var payosInstance = null;

      function closeModal() {
        if (payosInstance) {
          try { payosInstance.exit(); } catch (e) {}
        }
        var container = document.getElementById("embedded-payment-container");
        if (container) container.innerHTML = "";
        if (embeddedModal) embeddedModal.style.display = "none";
        var submitBtn = form ? form.querySelector("button[type='submit']") : null;
        if (submitBtn) submitBtn.disabled = false;
      }

      function openQrModal(order) {
        var codeEl = document.getElementById("modal-order-code");
        var pkgEl = document.getElementById("modal-package-name");
        var amtEl = document.getElementById("modal-amount");
        var credEl = document.getElementById("modal-credits");

        if (codeEl) codeEl.textContent = order.orderCode || "";
        if (pkgEl) pkgEl.textContent = order.packageName || "Credit Package";
        if (amtEl) amtEl.textContent = order.amount || "";
        if (credEl) credEl.textContent = "+" + (order.credits || "0") + " credits";
        if (modalCancelOrderCode) modalCancelOrderCode.value = order.orderCode || "";
        if (directLink) directLink.href = order.checkoutUrl || "#";

        if (window.PayOSCheckout && typeof window.PayOSCheckout.usePayOS === "function" && order.checkoutUrl) {
          var container = document.getElementById("embedded-payment-container");
          if (container) container.innerHTML = "";
          if (embeddedModal) embeddedModal.style.display = "flex";

          var config = {
            RETURN_URL: window.location.origin + "/payment/result?orderCode=" + encodeURIComponent(order.orderCode),
            ELEMENT_ID: "embedded-payment-container",
            CHECKOUT_URL: order.checkoutUrl,
            embedded: true,
            onSuccess: function (event) {
              window.location.href = "/payment/result?orderCode=" + encodeURIComponent(order.orderCode);
            },
            onCancel: function (event) {
              console.log("payOS onCancel:", event);
            },
            onExit: function (event) {
              console.log("payOS onExit:", event);
              closeModal();
            }
          };

          try {
            payosInstance = PayOSCheckout.usePayOS(config);
            payosInstance.open();
          } catch (popupErr) {
            console.warn("PayOS embedded open failed, redirecting to hosted checkout:", popupErr);
            window.location.href = order.checkoutUrl;
          }
        } else if (order.checkoutUrl) {
          window.location.href = order.checkoutUrl;
        }
      }

      if (btnClose) {
        btnClose.addEventListener("click", closeModal);
      }

      if (btnResume) {
        btnResume.addEventListener("click", function () {
          openQrModal({
            orderCode: btnResume.getAttribute("data-ordercode"),
            packageName: btnResume.getAttribute("data-packagename"),
            amount: btnResume.getAttribute("data-amount"),
            credits: btnResume.getAttribute("data-credits"),
            checkoutUrl: btnResume.getAttribute("data-checkouturl")
          });
        });

        // If URL has ?openQr=1, auto-trigger the resume modal
        var urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get("openQr") === "1") {
          btnResume.click();
        }
      }

      if (form) {
        form.addEventListener("submit", async function (e) {
          e.preventDefault();
          var submitBtn = form.querySelector("button[type='submit']");
          if (submitBtn) submitBtn.disabled = true;

          try {
            var tokenInput = form.querySelector("input[name='__RequestVerificationToken']");
            var packageIdInput = form.querySelector("input[name='packageId']");
            var formData = new FormData();
            formData.append("packageId", packageIdInput ? packageIdInput.value : "");
            if (tokenInput) formData.append("__RequestVerificationToken", tokenInput.value);

            var res = await fetch("/checkout", {
              method: "POST",
              headers: {
                "Accept": "application/json",
                "X-Requested-With": "XMLHttpRequest"
              },
              body: formData
            });

            if (!res.ok) {
              var errData = null;
              try { errData = await res.json(); } catch (_) {}
              if (errData && errData.message) {
                alert(errData.message);
              } else {
                alert("Could not create payment order. Please refresh and try again.");
              }
              if (submitBtn) submitBtn.disabled = false;
              return;
            }

            var data = await res.json();
            if (data.gateway === "payos" && data.checkoutUrl) {
              openQrModal({
                orderCode: data.orderCode,
                packageName: "@(preview?.PackageName ?? "Credit Package")",
                amount: "@(preview != null ? CurrencyFormatter.FormatVnd(preview.Price) : "")",
                credits: "@(preview?.Credits ?? 0)",
                checkoutUrl: data.checkoutUrl
              });
            } else if (data.checkoutUrl) {
              window.location.href = data.checkoutUrl;
            } else {
              if (submitBtn) submitBtn.disabled = false;
            }
          } catch (err) {
            console.error("Checkout submission failed", err);
            alert("An unexpected error occurred. Please try again.");
            if (submitBtn) submitBtn.disabled = false;
          }
        });
      }
    });
  </script>
}
