@using Contracts
@model WebMVC.Models.MockGatewayViewModel
@{
    Layout = "_LearnerLayout";
    ViewData["Title"] = "Payment Gateway (simulated)";
    ViewData["Description"] = "Simulated payment gateway to test credit purchasing.";
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/dashboard" class="breadcrumbs__item">Home</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/checkout" class="breadcrumbs__item">Confirm order</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Gateway simulation</span>
</nav>

<div class="stack" style="max-width: 680px; margin: 0 auto;">
  <div class="stepper" aria-label="Checkout progress">
    <div class="stepper__item is-done">1. Choose a package</div>
    <div class="stepper__item is-done">2. Confirm</div>
    <div class="stepper__item is-current">3. Payment</div>
    <div class="stepper__item">4. Done</div>
  </div>

  <div class="row row--between">
    <h1 class="m-0">Pay via Simulated Gateway</h1>
    <span class="badge badge--warning">Mock Gateway</span>
  </div>

  <div class="alert alert--warning">
    This is an offline simulator for development and automated grading. No real monetary transactions are made.
  </div>

  <div class="card">
    <div class="card__header"><strong>Order summary</strong></div>
    <div class="card__body stack">
      <div class="row row--between"><span class="text-muted">Order code:</span><strong>@Model.OrderCode</strong></div>
      <div class="row row--between"><span class="text-muted">Package:</span><span>@Model.PackageName (@Model.Credits credits)</span></div>
      <div class="row row--between"><span class="text-muted">Amount:</span><strong>@Model.AmountDisplay</strong></div>
      <div class="field mt-2">
        <label class="field__label" for="card-number">Simulated Card / Account</label>
        <input class="field__input" id="card-number" value="9704 xxxx xxxx 1234" disabled>
        <span class="field__hint">Test simulation mode active. Choose an outcome below.</span>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card__header"><strong>Choose simulated result</strong></div>
    <div class="card__body stack">
      <p class="text-sm text-muted no-margin">Select how the simulated gateway should report this transaction:</p>
      <div class="row row--wrap" style="gap: var(--space-3);">
        <form method="post" action="/checkout/mock-gateway/action" class="no-margin">
          @Html.AntiForgeryToken()
          <input type="hidden" name="orderCode" value="@Model.OrderCode">
          <input type="hidden" name="action" value="success">
          <button type="submit" class="btn btn--primary">Payment successful</button>
        </form>

        <form method="post" action="/checkout/mock-gateway/action" class="no-margin">
          @Html.AntiForgeryToken()
          <input type="hidden" name="orderCode" value="@Model.OrderCode">
          <input type="hidden" name="action" value="failed">
          <input type="hidden" name="errorCode" value="24">
          <button type="submit" class="btn btn--danger">Payment failed</button>
        </form>

        <form method="post" action="/checkout/mock-gateway/action" class="no-margin">
          @Html.AntiForgeryToken()
          <input type="hidden" name="orderCode" value="@Model.OrderCode">
          <input type="hidden" name="action" value="pending">
          <button type="submit" class="btn">Slow gateway (reconcile)</button>
        </form>

        <form method="post" action="/checkout/mock-gateway/action" class="no-margin">
          @Html.AntiForgeryToken()
          <input type="hidden" name="orderCode" value="@Model.OrderCode">
          <input type="hidden" name="action" value="expired">
          <button type="submit" class="btn">Order expired</button>
        </form>
      </div>
      <p class="text-sm text-muted no-margin mt-2">
        Returning without choosing an action keeps the order open as pending or reconciling.
      </p>
    </div>
  </div>
</div>
