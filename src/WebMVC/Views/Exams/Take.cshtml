@model ExamTakeViewModel
@{
    Layout = null;
    var take = Model.Take;
    var q = take.CurrentQuestion;
    var questions = take.Questions ?? new List<AttemptQuestionDto> { q };
    var phases = take.Phases ?? new List<AttemptPhaseDto>();
    var prevOrder = q.DisplayOrder > 1 ? q.DisplayOrder - 1 : (int?)null;
    var nextOrder = q.DisplayOrder < take.TotalQuestions ? q.DisplayOrder + 1 : (int?)null;
    var isLastQuestion = q.DisplayOrder >= take.TotalQuestions;
    var progressPercent = (int)Math.Round((double)take.AnsweredCount / Math.Max(1, take.TotalQuestions) * 100);
    var hasListening = questions.Any(item => item.Modality == ModalityDto.Listening);
    var hasSpeaking = questions.Any(item => item.Modality == ModalityDto.Speaking);
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@take.ExamName — Question @q.DisplayOrder — extra efficient</title>
  <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="~/css/tokens.css">
  <link rel="stylesheet" href="~/css/base.css">
  <link rel="stylesheet" href="~/css/components.css">
  <style>
    .phase-progress { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); border: 2px solid #14181d; margin-bottom: var(--space-4); }
    .phase-progress__item { display: flex; justify-content: space-between; gap: var(--space-3); padding: var(--space-3); border-right: 1px solid #ccd2d6; }
    .phase-progress__item:last-child { border-right: 0; }
    .phase-progress__item[aria-current="step"] { background: #14181d; color: #fff; }
    .phase-progress__timer { font-family: "IBM Plex Mono", monospace; font-variant-numeric: tabular-nums; }
    .writing-editor { width: 100%; min-height: 18rem; border: 2px solid #14181d; border-radius: 0; box-shadow: none; padding: var(--space-3); font: inherit; }

    /* Mandatory Keyword Badges */
    .keyword-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.2rem 0.55rem;
      font-family: "IBM Plex Mono", monospace;
      font-size: 0.825rem;
      font-weight: 600;
      border: 2px solid #14181d;
      border-radius: 0;
      background: #ffffff;
      color: #14181d;
      transition: all 0.15s ease-in-out;
    }
    .keyword-badge.badge--used {
      background: #0a6b3c !important;
      color: #ffffff !important;
      border-color: #14181d !important;
    }
    .keyword-badge.badge--pending {
      background: #f8fafc;
      border: 2px dashed #14181d;
      color: #4b5563;
    }

    /* Automated Speaking Pacer & Verification Screen (DESIGN.md Bảng hiệu phòng thi) */
    .speaking-pacer-container {
      margin-top: 1rem;
      border: 2px solid #14181d;
      border-radius: 0;
      box-shadow: none;
      background: #fafbfc;
      padding: 1.25rem;
    }
    .speaking-pacer-placard {
      padding: 0.75rem 1rem;
      border: 2px solid #14181d;
      border-radius: 0;
      box-shadow: none;
      font-family: "IBM Plex Sans Condensed", sans-serif;
      font-weight: 700;
      font-size: 1.1rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .speaking-pacer-placard--prep {
      background: #0b4ea2;
      color: #ffffff;
      border-color: #14181d;
    }
    .speaking-pacer-placard--recording {
      background: #b31217;
      color: #ffffff;
      border-color: #14181d;
      animation: rec-banner-pulse 1.2s infinite ease-in-out;
    }
    @@keyframes rec-banner-pulse {
      0%, 100% { background-color: #b31217; color: #ffffff; }
      50% { background-color: #7a0c10; color: #ffffff; }
    }
    .speaking-pacer-placard .rec-dot {
      display: inline-block;
      width: 14px;
      height: 14px;
      background-color: #ffffff;
      border: 2px solid #14181d;
      border-radius: 0;
      margin-right: 0.5rem;
      vertical-align: middle;
      animation: rec-pulse 0.8s infinite alternate;
    }
    @@keyframes rec-pulse {
      0% { opacity: 1; transform: scale(1); }
      100% { opacity: 0.2; transform: scale(0.85); }
    }
    .speaking-timer-val {
      font-family: "IBM Plex Mono", monospace;
      font-size: 1.25rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }
    .speaking-pacer-bar {
      height: 8px;
      border: 2px solid #14181d;
      border-radius: 0;
      background: #e2e8f0;
      overflow: hidden;
      margin-top: 0.5rem;
    }
    .speaking-pacer-bar__fill {
      height: 100%;
      background: #0b4ea2;
      transition: width 0.2s linear;
    }
    .speaking-pacer-bar__fill--rec {
      background: #b31217;
    }
    .audio-level-meter-box {
      margin-top: 0.75rem;
      border: 2px solid #14181d;
      border-radius: 0;
      background: #ffffff;
      padding: 0.5rem 0.75rem;
    }
    .audio-level-meter {
      height: 10px;
      background: #e2e8f0;
      border: 1px solid #14181d;
      border-radius: 0;
      overflow: hidden;
      margin-top: 0.35rem;
    }
    .audio-level-bar {
      height: 100%;
      width: 0%;
      background: #0a6b3c;
      transition: width 0.05s ease-out;
    }

    /* Verification Screen */
    .speaking-verification-screen {
      border: 2px solid #14181d;
      border-radius: 0;
      box-shadow: none;
      background: #ffffff;
      padding: 1.5rem;
    }
    .speaking-verification-card {
      border: 2px solid #14181d;
      border-radius: 0;
      padding: 1rem;
      background: #fafbfc;
      margin-bottom: 1rem;
    }
    .status-badge--recorded {
      background: #0a6b3c !important;
      color: #ffffff !important;
      border: 2px solid #14181d !important;
      border-radius: 0 !important;
      font-family: "IBM Plex Mono", monospace !important;
      font-weight: 700;
      padding: 0.25rem 0.6rem;
      font-size: 0.85rem;
    }
    .status-badge--missing {
      background: #b31217 !important;
      color: #ffffff !important;
      border: 2px solid #14181d !important;
      border-radius: 0 !important;
      font-family: "IBM Plex Mono", monospace !important;
      font-weight: 700;
      padding: 0.25rem 0.6rem;
      font-size: 0.85rem;
    }

    /* On-Screen Cut/Paste/Undo/Redo Toolbar */
    .writing-onscreen-toolbar .btn--sm {
      padding: 0.25rem 0.65rem;
      font-size: 0.825rem;
      font-family: "IBM Plex Sans Condensed", sans-serif;
      font-weight: 700;
      text-transform: uppercase;
      border-radius: 0;
      border: 2px solid #14181d;
      box-shadow: none;
    }

    /* Split-Screen 100vh Viewport */
    .exam-layout--split {
      display: grid !important;
      grid-template-columns: 1fr 1fr !important;
      gap: 1.5rem !important;
      height: calc(100vh - 165px) !important;
      min-height: 480px;
      overflow: hidden !important;
    }
    .exam-layout--split #split-stimulus-pane {
      display: block !important;
      height: 100% !important;
      overflow: hidden !important;
    }
    .exam-layout--split #question-pane {
      height: 100% !important;
      overflow-y: auto !important;
      padding-right: 0.5rem !important;
    }
    .exam-layout--split .exam-sidebar {
      display: none !important;
    }

    /* Timer Warnings & Red Flashing */
    @@keyframes timer-pulse-red {
      0%, 100% { background-color: #b31217; color: #ffffff; }
      50% { background-color: #ffffff; color: #b31217; }
    }
    .timer--warn-flash {
      border: 2px solid #b31217 !important;
      animation: timer-pulse-red 1.5s infinite ease-in-out;
    }
    .timer-alert-placard {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: #b31217;
      color: #ffffff;
      padding: 0.25rem 0.65rem;
      border: 2px solid #14181d;
      font-family: "IBM Plex Sans Condensed", sans-serif;
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      animation: timer-pulse-red 2s infinite ease-in-out;
    }

    /* Accessibility Font Scaling */
    body.font-size-standard { font-size: 16px; }
    body.font-size-large { font-size: 18.4px; }
    body.font-size-xlarge { font-size: 20.8px; }

    /* Accessibility High Contrast Themes */
    body[data-theme="inverted"] {
      background-color: #14181d !important;
      color: #f0f2f5 !important;
    }
    body[data-theme="inverted"] .app-topbar,
    body[data-theme="inverted"] .card,
    body[data-theme="inverted"] .modal,
    body[data-theme="inverted"] .question,
    body[data-theme="inverted"] .bottom-question-palette {
      background-color: #1c2127 !important;
      color: #f0f2f5 !important;
      border-color: #4b5563 !important;
    }
    body[data-theme="inverted"] .option {
      background-color: #242a32 !important;
      color: #f0f2f5 !important;
      border-color: #4b5563 !important;
    }
    body[data-theme="inverted"] .option.is-selected {
      background-color: #ffffff !important;
      color: #14181d !important;
    }
    body[data-theme="inverted"] .palette-chip--unanswered {
      background-color: #1c2127 !important;
      color: #f0f2f5 !important;
      border-color: #4b5563 !important;
    }
    body[data-theme="inverted"] .palette-chip--answered {
      background-color: #374151 !important;
      color: #ffffff !important;
      border-color: #9ca3af !important;
    }
    body[data-theme="inverted"] .palette-chip--current {
      background-color: #ffffff !important;
      color: #14181d !important;
      border-color: #ffffff !important;
    }

    body[data-theme="high-contrast"] {
      background-color: #000000 !important;
      color: #ffff00 !important;
    }
    body[data-theme="high-contrast"] .app-topbar,
    body[data-theme="high-contrast"] .card,
    body[data-theme="high-contrast"] .modal,
    body[data-theme="high-contrast"] .question,
    body[data-theme="high-contrast"] .bottom-question-palette,
    body[data-theme="high-contrast"] input,
    body[data-theme="high-contrast"] select,
    body[data-theme="high-contrast"] textarea {
      background-color: #000000 !important;
      color: #ffff00 !important;
      border-color: #ffff00 !important;
    }
    body[data-theme="high-contrast"] .option {
      background-color: #000000 !important;
      color: #ffff00 !important;
      border-color: #ffff00 !important;
    }
    body[data-theme="high-contrast"] .option.is-selected {
      background-color: #ffff00 !important;
      color: #000000 !important;
    }
    body[data-theme="high-contrast"] .btn--primary {
      background-color: #ffff00 !important;
      color: #000000 !important;
      border-color: #ffff00 !important;
    }
    body[data-theme="high-contrast"] .btn--ghost {
      color: #ffff00 !important;
      border-color: #ffff00 !important;
    }
    body[data-theme="high-contrast"] .palette-chip--unanswered {
      background-color: #000000 !important;
      color: #ffff00 !important;
      border-color: #ffff00 !important;
    }
    body[data-theme="high-contrast"] .palette-chip--answered {
      background-color: #222200 !important;
      color: #ffff00 !important;
      border-color: #ffff00 !important;
    }
    body[data-theme="high-contrast"] .palette-chip--current {
      background-color: #ffff00 !important;
      color: #000000 !important;
      border-color: #ffff00 !important;
    }

    /* Bottom Question Palette */
    .bottom-question-palette {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: #ffffff;
      border-top: 2px solid #14181d;
      z-index: 100;
      padding: 0.4rem 1.5rem;
      box-shadow: none;
    }
    .palette-container {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .palette-legend {
      display: flex;
      gap: 0.75rem;
      font-size: 0.75rem;
      white-space: nowrap;
    }
    .palette-legend-item {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .chip-swatch {
      width: 12px;
      height: 12px;
      display: inline-block;
      border: 1px solid #14181d;
    }
    .chip-swatch--unanswered { background: #ffffff; border-color: #ccd2d6; }
    .chip-swatch--answered { background: #e9ecef; border-color: #14181d; font-weight: 700; }
    .chip-swatch--current { background: #14181d; border-color: #14181d; }
    .chip-swatch--flagged { background: #f2b705; border-color: #14181d; }

    .palette-chips-track {
      display: flex;
      gap: 0.35rem;
      overflow-x: auto;
      padding: 0.2rem 0;
      width: 100%;
    }
    .palette-chip {
      min-width: 36px;
      height: 36px;
      border: 1px solid #ccd2d6;
      background: #ffffff;
      color: #14181d;
      font-family: "IBM Plex Mono", monospace;
      font-weight: 600;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      position: relative;
      border-radius: 0;
      box-shadow: none;
      padding: 0 0.35rem;
      flex-shrink: 0;
    }
    .palette-chip:hover {
      border-color: #14181d;
    }
    .palette-chip--unanswered {
      border: 1px solid #ccd2d6;
      background: #ffffff;
      color: #14181d;
    }
    .palette-chip--answered {
      border: 2px solid #14181d;
      background: #e9ecef;
      color: #14181d;
      font-weight: 700;
    }
    .palette-chip--current {
      border: 2px solid #14181d !important;
      background: #14181d !important;
      color: #ffffff !important;
      font-weight: 700;
    }
    .palette-chip--flagged::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 0;
      height: 0;
      border-style: solid;
      border-width: 0 8px 8px 0;
      border-color: transparent #f2b705 transparent transparent;
    }

    /* Highlighter & Notes Engine */
    .ee-token {
      display: inline;
      position: relative;
    }
    .ee-token--highlighted {
      background-color: #f2b705 !important;
      color: #14181d !important;
    }
    .ee-note-pin {
      display: inline-block;
      cursor: pointer;
      background: #14181d;
      color: #ffffff;
      font-size: 0.7rem;
      padding: 0.1rem 0.25rem;
      margin-left: 0.2rem;
      font-family: "IBM Plex Mono", monospace;
      font-weight: 700;
      border: 1px solid #14181d;
      vertical-align: middle;
    }
    .highlighter-popover {
      position: absolute;
      z-index: 1000;
      display: flex;
      gap: 0.25rem;
      background: #ffffff;
      border: 2px solid #14181d;
      padding: 0.25rem;
      box-shadow: none;
    }

    /* Question Component Widgets */
    .option--checkbox input[type="checkbox"] {
      width: 1.15rem;
      height: 1.15rem;
      accent-color: #14181d;
    }
    .completion-input {
      font-family: "IBM Plex Sans", sans-serif;
      font-size: 1rem;
      border: 2px solid #14181d;
      border-radius: 0;
      box-shadow: none;
      padding: 0.5rem 0.75rem;
      width: 100%;
      max-width: 480px;
    }
    .chip-item {
      display: inline-block;
      border: 2px solid #14181d;
      background: #ffffff;
      color: #14181d;
      padding: 0.35rem 0.75rem;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      user-select: none;
    }
    .chip-item:hover {
      background: #e9ecef;
    }
    .chip-item.is-placed {
      opacity: 0.35;
      pointer-events: none;
    }
    .drop-zone {
      min-height: 54px;
      border: 2px dashed #14181d;
      background: #fafbfc;
      padding: 0.5rem 0.75rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .drop-zone.is-hovered {
      background: #e3ebf6;
      border-color: #0b4ea2;
    }
    body.exam-body-protected {
      padding-bottom: 85px;
    }

    /* Masked Options Placards (HideOptionText, OptionCount) */
    .option-list--masked {
      display: flex !important;
      flex-direction: row !important;
      gap: 0.75rem !important;
      margin-top: 1rem !important;
      flex-wrap: wrap !important;
    }
    .option--masked {
      flex: 1 1 0 !important;
      min-width: 60px !important;
      max-width: 120px !important;
      justify-content: center !important;
      align-items: center !important;
      text-align: center !important;
      padding: 0.85rem 1rem !important;
      border: 2px solid #14181d !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      cursor: pointer !important;
      background: #ffffff !important;
    }
    .option--masked .option__marker {
      font-family: "IBM Plex Mono", monospace !important;
      font-weight: 700 !important;
      font-size: 1.125rem !important;
      pointer-events: none !important;
    }
    .option--masked.is-selected {
      background: #14181d !important;
      color: #ffffff !important;
    }
    .option--masked.is-selected .option__marker {
      color: #ffffff !important;
    }

    /* Clustered Audio Cards (ClusterSize = 3) */
    .cluster-card-container {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .cluster-item {
      border: 2px solid #14181d;
      background: #fafbfc;
      padding: 1.25rem;
      border-radius: 0;
    }
    .cluster-item .question__number {
      font-family: "IBM Plex Mono", monospace;
      font-weight: 700;
      font-size: 1rem;
    }
    .cluster-item .question__stem {
      margin: 0.5rem 0 1rem 0;
      font-size: 1rem;
      line-height: 1.45;
    }

    /* Bottom palette disabled states */
    .palette-chip--disabled {
      opacity: 0.35 !important;
      cursor: not-allowed !important;
      pointer-events: none !important;
    }
    .palette-chip--locked {
      display: none !important;
    }

    /* Review Screen Modal Items */
    .review-item-card {
      background: #ffffff;
      border: 1px solid #ccd2d6;
      padding: 0.75rem;
      text-align: left;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      border-radius: 0;
      box-shadow: none;
      transition: none;
    }
    .review-item-card:hover {
      border-color: #14181d;
      background: #f0f4f8;
    }
  </style>
</head>
<body class="exam-body-protected">
  <div class="app-shell">
    <header class="app-topbar">
      <div class="exam-topbar-group">
        <strong>@take.ExamName</strong>
        <span class="badge badge--info" id="topbar-section-badge">@q.SkillName · @q.SectionName</span>
        @if (!string.IsNullOrEmpty(take.AuthorizationCode))
        {
          <span class="badge badge--neutral" id="auth-code-placard" style="font-family: 'IBM Plex Mono', monospace; font-weight: 700; letter-spacing: 0.05em; border: 2px solid #14181d; background: #fff; color: #14181d; border-radius: 0; box-shadow: none;" title="Mã dự thi dùng để khôi phục bài thi khi gặp sự cố">
            MÃ DỰ THI: @take.AuthorizationCode
          </span>
        }
      </div>
      <div class="exam-topbar-group">
        <div id="timer-alert-placard" class="timer-alert-placard" style="display:none;" role="alert">
          <span id="timer-alert-message"></span>
        </div>
        <span id="save-status" class="save-status save-status--saved" role="status" aria-live="polite">Saved</span>
        <span id="timer-box" class="timer" role="timer" aria-label="Time remaining">
          <span class="text-sm text-muted">Time remaining</span>
          <span id="timer-display" class="timer__value">--:--:--</span>
        </span>
        @if (hasListening || hasSpeaking)
        {
          @await Html.PartialAsync("_AudioEmergencySwitcher", new AudioEquipmentCheckModel(
              ShowInput: hasSpeaking,
              ShowOutput: hasListening))
        }
        <div class="volume-slider-group" style="display: inline-flex; align-items: center; gap: 0.35rem; border: 1px solid #ccd2d6; padding: 0.2rem 0.5rem; background: #fff;" title="Ã‚m lÆ°á»£ng bÃ i thi (Volume)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
          <input type="range" id="exam-volume-slider" min="0" max="1" step="0.05" value="1" aria-label="Audio Volume" style="width: 65px; accent-color: #0b4ea2; cursor: pointer;">
          <span id="exam-volume-pct" style="font-family: 'IBM Plex Mono', monospace; font-size: 0.75rem; min-width: 32px;">100%</span>
        </div>
        <button type="button" class="btn btn--ghost btn--sm" id="btn-open-accessibility-modal" title="Trá»£ nÄƒng & Giao diá»‡n">
          <span style="font-family: 'IBM Plex Mono', monospace; font-weight: 700;">Aa</span> Cá»¡ chá»¯ & TÆ°Æ¡ng pháº£n
        </button>
        <button type="button" class="btn btn--ghost btn--sm" id="btn-open-exit-modal">Exit</button>
      </div>
    </header>

    <main class="app-main">
      <div class="container" style="max-width: 1200px">
        <form id="anti-forgery-holder" style="display:none;">@Html.AntiForgeryToken()</form>

        <script id="exam-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(questions, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))</script>
        <script id="phase-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(phases, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))</script>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
          <div class="alert alert--danger mb-4" role="alert">@Model.ErrorMessage</div>
        }

        <!-- Exam Integrity & Disciplinary Warning Banner -->
        <div id="integrity-warning" class="alert alert--warning mb-4" style="display:none;" role="alert">
          <strong>Warning:</strong> Tab switching or leaving the exam screen detected (<span id="integrity-count">0</span> time(s)). This activity is recorded in the exam audit trail.
        </div>

        <!-- Offline Network Warning Banner -->
        <div id="network-warning" class="alert alert--danger mb-4" style="display:none; border: 2px solid #b31217; border-radius: 0; box-shadow: none; font-family: 'IBM Plex Sans', sans-serif;" role="alert">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <strong style="font-family: 'IBM Plex Sans Condensed', sans-serif; text-transform: uppercase; color: #b31217; font-size: 1rem;">
              MẤT KẾT NỐI MẠNG (CONNECTION OFFLINE):
            </strong>
            <span>Câu trả lời của bạn đã được lưu tạm an toàn trong máy. Hệ thống sẽ tự động đồng bộ ngay khi có mạng trở lại.</span>
          </div>
        </div>

        <section id="phase-progress" class="phase-progress" aria-label="Exam phases">
          @foreach (var phase in phases)
          {
            <div class="phase-progress__item" data-phase-skill="@phase.SkillCode" aria-current="@(q.SkillCode == phase.SkillCode ? "step" : "false")">
              <strong>@phase.SkillName</strong>
              <span class="phase-progress__timer" data-phase-timer="@phase.SkillCode">--:--</span>
            </div>
          }
        </section>

        <div class="exam-layout" id="exam-main-layout">
          <!-- Left Stimulus / Passage Pane (active in 100vh Split Screen mode) -->
          <div id="split-stimulus-pane" class="exam-split-left" style="display:none;">
            <div class="card" style="height: 100%; border: 2px solid #14181d; border-radius: 0; box-shadow: none; display: flex; flex-direction: column;">
              <div class="card__header" style="border-bottom: 2px solid #14181d; background: #fafbfc; padding: 0.75rem 1rem;">
                <strong style="font-family: 'IBM Plex Sans Condensed', sans-serif; text-transform: uppercase;">ÄOáº N VÄ‚N / TÃ€I LIá»†U (READING PASSAGE & STIMULUS)</strong>
              </div>
              <div class="card__body" id="split-passage-scroll" style="flex: 1; overflow-y: auto; padding: 1.25rem;">
                <div id="split-passage-text" class="passage ee-tokenized-text"></div>
              </div>
            </div>
          </div>
          <!-- Question Content Pane (Exam Shell Swap Target) -->
          <div class="stack" id="question-pane">
            <!-- Audio Player Container -->
            <div id="exam-audio-wrapper" class="mb-3" style="@(!string.IsNullOrEmpty(q.AudioPath) ? "" : "display:none;")">
              @if (!string.IsNullOrEmpty(q.AudioPath))
              {
                @await Html.PartialAsync("_ExamAudioPlayer", new ExamAudioPlayerModel(
                    AudioPath: q.AudioPath,
                    AllowReplay: false,
                    SectionTitle: "Listening Audio",
                    BadgeText: "READY",
                    StartMs: q.AudioStartMs,
                    EndMs: q.AudioEndMs,
                    PlayerId: "main-exam-audio",
                    Mode: "exam"
                ))
              }
            </div>
            @await Html.PartialAsync("_ExamAudioPlayer", new ExamAudioPlayerModel(
                AudioPath: string.Empty,
                Mode: "exam",
                TemplateOnly: true
            ))

            <!-- Passage Card Container -->
            <div id="passage-card" class="card mb-3" style="@(!string.IsNullOrEmpty(q.Passage) ? "" : "display:none;")">
              <div class="card__body">
                <p id="passage-text" class="no-margin passage">@q.Passage</p>
              </div>
            </div>

            <!-- Image Container -->
            <div id="image-container" class="mb-3" style="@(!string.IsNullOrEmpty(q.ImagePath) ? "" : "display:none;") @(q.RequireImage ? "border: 2px solid #14181d; background: #fff; padding: 0.5rem; text-align: center;" : "")">
              <img id="question-image" src="@q.ImagePath" alt="@(q.ImageAlt ?? "Question illustration")" class="question__image" />
            </div>

            <div class="question" id="question-card">
              <div class="question__meta row row--between" id="question-meta-bar" style="@(q.ClusterSize == 3 ? "display:none;" : "")">
                <div class="row row--tight">
                  <span class="question__number" id="question-number-display">Question @q.DisplayOrder</span>
                  <span class="badge badge--muted" id="question-section-display">@q.SectionName</span>
                </div>
                <div>
                  <button type="button" class="btn btn--ghost btn--sm @(q.IsFlagged ? "btn--primary" : "")" id="flag-btn"
                          aria-pressed="@(q.IsFlagged ? "true" : "false")"
                          data-flagged="@(q.IsFlagged ? "true" : "false")">
                    @(q.IsFlagged ? "Flagged for review" : "Flag for review")
                  </button>
                </div>
              </div>

              <p class="question__stem ee-tokenized-text" id="question-stem-display" style="@(q.ClusterSize == 3 || (q.HideOptionText && q.OptionCount == 3) ? "display:none;" : "")">
                @q.Stem
              </p>

              <!-- Mandatory Prompt Keyword Badges -->
              <div id="required-keywords-area" class="required-keywords-area mt-2 mb-2" style="@(!string.IsNullOrWhiteSpace(q.RequiredKeywords) ? "" : "display:none;")">
                <div class="row" style="align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                  <span class="text-sm font-bold" style="font-family: 'IBM Plex Sans Condensed', sans-serif; text-transform: uppercase; letter-spacing: 0.04em;">Từ khóa bắt buộc:</span>
                  <div id="required-keywords-list" class="row row--wrap" style="gap: 0.35rem; display: inline-flex;"></div>
                </div>
              </div>

              <div class="option-list @(q.HideOptionText ? "option-list--masked" : "")" id="option-list" role="radiogroup" aria-label="Answer for question @q.DisplayOrder" style="@(q.QuestionType == "free_response" || q.ClusterSize == 3 ? "display:none;" : "")">
                @{
                  var initialOpts = q.HideOptionText && q.OptionCount > 0 ? q.Options.Take(q.OptionCount) : q.Options;
                }
                @foreach (var opt in initialOpts)
                {
                  var isSelected = opt.OptionId == q.SelectedOptionId;
                  <label class="option @(isSelected ? "is-selected" : "") @(q.HideOptionText ? "option--masked" : "")">
                    <input class="option__input js-option-radio" type="radio" name="selectedOptionId"
                           value="@opt.OptionId" @(isSelected ? "checked" : "")>
                    <span class="option__marker">@opt.Label</span>
                    @if (!q.HideOptionText)
                    {
                      <span class="option__text">@opt.Text</span>
                    }
                  </label>
                }
              </div>

              <!-- Clustered Audio Cards Container (ClusterSize == 3) -->
              <div id="cluster-card-container" class="cluster-card-container" style="@(q.ClusterSize == 3 ? "" : "display:none;")">
                @if (q.ClusterSize == 3)
                {
                  var clusterQs = questions.Where(item => (q.GroupId.HasValue && item.GroupId == q.GroupId) || (item.SectionId == q.SectionId && ((item.DisplayOrder - 1) / 3) == ((q.DisplayOrder - 1) / 3))).ToList();
                  if (!clusterQs.Any()) { clusterQs = new List<AttemptQuestionDto> { q }; }
                  @foreach (var cq in clusterQs)
                  {
                    <div class="cluster-item" data-question-id="@cq.QuestionId">
                      <div class="row row--between mb-1" style="align-items: center;">
                        <span class="question__number">Question @cq.DisplayOrder</span>
                        <button type="button" class="btn btn--ghost btn--sm js-cluster-flag-btn @(cq.IsFlagged ? "btn--primary" : "")" data-question-id="@cq.QuestionId" data-flagged="@(cq.IsFlagged ? "true" : "false")">
                          @(cq.IsFlagged ? "Flagged for review" : "Flag for review")
                        </button>
                      </div>
                      <p class="question__stem ee-tokenized-text">@cq.Stem</p>
                      <div class="option-list" role="radiogroup" aria-label="Answer for question @cq.DisplayOrder">
                        @foreach (var opt in cq.Options)
                        {
                          var isSelected = opt.OptionId == cq.SelectedOptionId;
                          <label class="option @(isSelected ? "is-selected" : "")">
                            <input class="option__input js-cluster-radio" type="radio" name="cluster_opt_@cq.QuestionId" value="@opt.OptionId" data-question-id="@cq.QuestionId" @(isSelected ? "checked" : "")>
                            <span class="option__marker">@opt.Label</span>
                            <span class="option__text">@opt.Text</span>
                          </label>
                        }
                      </div>
                    </div>
                  }
                }
              </div>
              <!-- Dynamic 11-Component Widgets (multi_select, inline_completion, dropdown, drag_drop) -->
              <div id="component-widget-container" class="stack mt-3" style="display:none;"></div>

              <!-- Automated Speaking Pacer Workspace Container (SYSTEM_PACED_AUTO) -->
              <div id="speaking-pacer-container" class="speaking-pacer-container stack" style="@(q.NavigationMode == "SYSTEM_PACED_AUTO" ? "" : "display:none;")">
                <!-- Step 1: Prep Countdown Placard -->
                <div id="speaking-prep-placard" class="speaking-pacer-placard speaking-pacer-placard--prep">
                  <span>CHUẨN BỊ TRẢ LỜI: <span id="speaking-prep-timer" class="speaking-timer-val">@(q.PrepSeconds ?? 15)s</span></span>
                  <span class="badge" style="background:#ffffff; color:#0b4ea2; border:1px solid #14181d; font-family:'IBM Plex Sans Condensed',sans-serif; text-transform:uppercase;">Chuẩn bị</span>
                </div>
                <div id="speaking-prep-bar-box" class="speaking-pacer-bar">
                  <div id="speaking-prep-bar" class="speaking-pacer-bar__fill" style="width: 100%;"></div>
                </div>

                <!-- Step 3: Recording Countdown Placard (hidden during prep) -->
                <div id="speaking-record-placard" class="speaking-pacer-placard speaking-pacer-placard--recording" style="display:none;">
                  <span><span class="rec-dot"></span>ĐANG THU ÂM: <span id="speaking-record-timer" class="speaking-timer-val">@(q.ResponseSeconds ?? 30)s</span></span>
                  <span class="badge" style="background:#ffffff; color:#b31217; border:1px solid #14181d; font-family:'IBM Plex Sans Condensed',sans-serif; text-transform:uppercase;">Ghi âm</span>
                </div>
                <div id="speaking-record-bar-box" class="speaking-pacer-bar" style="display:none;">
                  <div id="speaking-record-bar" class="speaking-pacer-bar__fill speaking-pacer-bar__fill--rec" style="width: 100%;"></div>
                </div>

                <!-- Live Audio Level Meter -->
                <div id="audio-level-container" class="audio-level-meter-box" style="display:none;">
                  <div class="row row--between text-xs font-bold" style="font-family:'IBM Plex Sans Condensed',sans-serif; text-transform:uppercase;">
                    <span>Mức âm lượng micro</span>
                    <span id="audio-level-text" style="font-family:'IBM Plex Mono',monospace;">0%</span>
                  </div>
                  <div class="audio-level-meter" id="audio-level-meter">
                    <div id="audio-level-bar" class="audio-level-bar" style="width: 0%;"></div>
                  </div>
                </div>

                <!-- Step 4: Auto-Upload Status Placard -->
                <div id="speaking-upload-placard" class="alert alert--info mt-2" style="display:none; border:2px solid #14181d; border-radius:0; font-family:'IBM Plex Sans Condensed',sans-serif; font-weight:700;">
                  Đang lưu bản thu âm và tự động chuyển câu hỏi tiếp theo...
                </div>
              </div>

              <!-- Post-Section Recorded Audio Verification Screen (#speaking-verification-screen) -->
              <div id="speaking-verification-screen" class="speaking-verification-screen stack" style="display:none;">
                <div class="row row--between" style="border-bottom: 2px solid #14181d; padding-bottom: 0.75rem; align-items: center;">
                  <h2 class="no-margin" style="font-family:'IBM Plex Sans Condensed',sans-serif; text-transform:uppercase; font-size:1.25rem;">
                    BẢNG XÁC NHẬN BẢN GHI ÂM PHẦN THI NÓI (SPEAKING AUDIO VERIFICATION)
                  </h2>
                  <span class="badge badge--muted" id="speaking-verification-count-badge" style="border:1px solid #14181d; font-family:'IBM Plex Mono',monospace;">0 items</span>
                </div>
                <p class="text-sm text-muted mt-2 mb-3">
                  Tất cả các câu hỏi trong phần thi Nói đã hoàn thành. Hãy kiểm tra lại các đoạn ghi âm của bạn dưới đây trước khi nộp bài để chấm điểm AI.
                </p>

                <div id="speaking-verification-items" class="stack" style="gap: 1rem;">
                  <!-- Dynamic items populated via JS -->
                </div>

                <div class="row row--between mt-4" style="align-items: center; border-top: 2px solid #14181d; padding-top: 1rem;">
                  <span class="text-xs text-muted" style="font-style:italic;">
                    Sau khi bấm nộp, phần thi sẽ được khóa và chuyển thẳng vào hàng đợi chấm điểm AI.
                  </span>
                  <button type="button" class="btn btn--danger" id="btn-submit-speaking-verification" style="font-family:'IBM Plex Sans Condensed',sans-serif; text-transform:uppercase; font-weight:700; border-radius:0; border:2px solid #14181d; padding:0.6rem 1.25rem;">
                    Nộp phần thi Nói để chấm AI
                  </button>
                </div>
              </div>

              <div id="writing-response-pane" class="stack mt-3" style="@(q.QuestionType == "free_response" ? "" : "display:none;")">
                <!-- On-Screen Cut/Paste/Undo/Redo Toolbar -->
                <div id="writing-onscreen-toolbar" class="writing-onscreen-toolbar row mb-2" style="gap: 0.5rem; display: none;">
                  <button type="button" class="btn btn--secondary btn--sm" id="btn-writing-cut" title="Cắt">Cắt (Cut)</button>
                  <button type="button" class="btn btn--secondary btn--sm" id="btn-writing-paste" title="Dán">Dán (Paste)</button>
                  <button type="button" class="btn btn--secondary btn--sm" id="btn-writing-undo" title="Hoàn tác">Hoàn tác (Undo)</button>
                  <button type="button" class="btn btn--secondary btn--sm" id="btn-writing-redo" title="Làm lại">Làm lại (Redo)</button>
                </div>

                <label for="writing-editor"><strong>Your response</strong></label>
                <textarea id="writing-editor" class="writing-editor" aria-describedby="writing-counts" data-question-id="@q.QuestionId" spellcheck="false" autocorrect="off" autocomplete="off" autocapitalize="off">@q.ResponseText</textarea>
                <div id="writing-counts" class="row row--between text-sm" style="align-items: center; margin-top: 0.5rem;">
                  <div class="row" style="gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                    <span>Số từ: <strong id="live-word-count">0</strong> <span id="word-count" style="display:none;">0</span> <span id="word-range"></span></span>
                    <span id="min-words-badge" class="badge" style="display:none; font-family:'IBM Plex Mono',monospace; font-size:0.8rem; border:1px solid #14181d;">Tối thiểu: 0 từ</span>
                    <span id="under-length-warning" class="text-xs font-bold" style="display:none; color:#b31217; font-family:'IBM Plex Sans Condensed',sans-serif; text-transform:uppercase;">(Chưa đạt số từ tối thiểu)</span>
                  </div>
                  <span><strong id="character-count">0</strong> ký tự</span>
                </div>
                <button type="button" class="btn btn--secondary" id="btn-save-writing-draft">Save draft</button>
              </div>
              <div id="free-response-container" class="stack" style="display:none; margin-top: 1rem;"></div>
            </div>

            <!-- Bottom Question Navigation Row -->
            <div class="row row--between mt-4" style="align-items: center;">
              <div>
                <button type="button" class="btn" id="btn-prev" @(prevOrder.HasValue ? "" : "disabled") style="@(q.NavigationMode == "AUDIO_DRIVEN" || q.NavigationMode == "SYSTEM_PACED_AUTO" ? "display:none;" : "")">Previous</button>
              </div>

              <div class="row" style="gap: var(--space-3); align-items: center;">
                <button type="button" class="btn btn--secondary" id="btn-open-review-screen" style="display:none;">Bảng xem lại (Review Screen)</button>
                <button type="button" class="btn btn--primary" id="btn-next" style="@(q.NavigationMode == "SYSTEM_PACED_AUTO" ? "display:none;" : "")">@(isLastQuestion ? "Review & Submit exam" : "Next question")</button>
              </div>
            </div>
          </div>

          <!-- Sidebar Navigator (Exam Shell Persistent) -->
          <aside class="exam-sidebar stack">
            <div class="card">
              <div class="card__header">
                <div class="row row--between">
                  <strong class="text-sm">Exam Progress</strong>
                  <span class="text-xs text-muted" id="progress-text">@take.AnsweredCount/@take.TotalQuestions answered</span>
                </div>
              </div>
              <div class="card__body stack">
                <div class="progress" role="progressbar" aria-valuenow="@take.AnsweredCount" aria-valuemin="0" aria-valuemax="@take.TotalQuestions">
                  <div class="progress__bar" id="progress-bar" style="width: @progressPercent%"></div>
                </div>
                <div class="row row--between text-xs text-muted">
                  <span>Flagged: <strong id="sidebar-flagged-count">@take.FlaggedCount</strong></span>
                  <span>Unanswered: <strong id="sidebar-unanswered-count">@(take.TotalQuestions - take.AnsweredCount)</strong></span>
                </div>
              </div>
            </div>

            <div class="card">
              <div class="card__header">
                <strong class="text-sm">Questions (1–@take.TotalQuestions)</strong>
                <button type="button" class="btn btn--ghost btn--sm" id="flagged-filter-btn" disabled>Show flagged</button>
              </div>
              <div class="card__body stack">
                <div class="navigator__grid" role="group" aria-label="Question Navigator" id="navigator-grid">
                  @foreach (var item in take.Navigator)
                  {
                    var statusClass = item.IsAnswered ? "is-answered" : "is-unanswered";
                    var markClass = item.IsFlagged ? "is-marked" : "";
                    var currentClass = item.IsCurrent ? "is-current" : "";
                    <button type="button"
                       class="navigator__cell @statusClass @markClass @currentClass @(item.IsLocked ? "is-locked" : "")"
                       id="nav-cell-@item.QuestionId"
                       data-question-id="@item.QuestionId"
                       data-display-order="@item.DisplayOrder"
                       @(item.IsLocked ? "disabled" : "")
                       title="Question @item.DisplayOrder@(item.IsAnswered ? " · Answered" : " · Unanswered")@(item.IsFlagged ? " · Flagged" : "")@(item.IsLocked ? " · Locked" : "")">
                      @item.DisplayOrder
                    </button>
                  }
                </div>

                <div class="text-xs stack mt-2" style="gap: var(--space-1)">
                  <div class="row" style="align-items: center; gap: var(--space-2);">
                    <span class="navigator__cell navigator__cell--swatch is-answered" aria-hidden="true">1</span> Answered
                  </div>
                  <div class="row" style="align-items: center; gap: var(--space-2);">
                    <span class="navigator__cell navigator__cell--swatch is-marked" aria-hidden="true">2</span> Flagged for review
                  </div>
                  <div class="row" style="align-items: center; gap: var(--space-2);">
                    <span class="navigator__cell navigator__cell--swatch is-unanswered" aria-hidden="true">3</span> Unanswered
                  </div>
                </div>
              </div>
            </div>

            <button type="button" class="btn btn--danger js-open-submit-modal" id="btn-sidebar-submit" style="width: 100%;">
              Submit exam
            </button>
          </aside>
        </div>
      </div>
    </main>
  </div>

  <!-- Submit Confirmation Modal -->
  <div id="submit-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="submit-modal-title">
    <div class="modal">
      <div class="modal__header">
        <h2 id="submit-modal-title" class="no-margin">Submit exam?</h2>
      </div>
      <div class="modal__body stack">
        <div id="modal-sync-pending" class="alert alert--info" style="display:none;">
          <strong>Synchronizing latest answers…</strong> Please wait a moment while your answers are being recorded on the server.
        </div>

        <div id="modal-unanswered-warning" class="alert alert--warning" style="@(take.AnsweredCount < take.TotalQuestions ? "" : "display:none;")">
          <strong>You have <span id="modal-unanswered-count">@(take.TotalQuestions - take.AnsweredCount)</span> unanswered questions.</strong>
          Unanswered questions count as incorrect, and answers cannot be changed after you submit.
        </div>
        <div id="modal-all-answered" class="alert alert--success" style="@(take.AnsweredCount >= take.TotalQuestions ? "" : "display:none;")">
          <strong>All @take.TotalQuestions questions have been answered.</strong>
          Answers cannot be changed after you submit.
        </div>

        <div class="grid-3">
          <div class="stat">
            <div class="stat__label">Answered</div>
            <div class="stat__value" id="modal-stat-answered">@take.AnsweredCount</div>
          </div>
          <div class="stat">
            <div class="stat__label">Flagged</div>
            <div class="stat__value" id="modal-stat-flagged">@take.FlaggedCount</div>
          </div>
          <div class="stat">
            <div class="stat__label">Unanswered</div>
            <div class="stat__value" id="modal-stat-unanswered">@(take.TotalQuestions - take.AnsweredCount)</div>
          </div>
        </div>

        <p class="text-sm text-muted no-margin">
          Once submitted, your responses will be scored and your scaled band computed immediately.
        </p>
      </div>
      <div class="modal__footer">
        <button type="button" class="btn js-close-submit-modal">Go back and continue</button>
        <form method="post" action="/exams/take/@take.AttemptId/submit" id="submit-exam-form" style="display:inline;">
          @Html.AntiForgeryToken()
          <div class="exam-draft-submit-fields"></div>
          <button type="submit" class="btn btn--danger" id="btn-modal-submit-now">Submit now</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Exit / Cancel Modal -->
  <div id="exit-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="exit-modal-title">
    <div class="modal">
      <div class="modal__header">
        <h2 id="exit-modal-title" class="no-margin">Exit or Cancel Exam?</h2>
      </div>
      <div class="modal__body stack">
        <div class="alert alert--danger">
          <strong>Cancelling abandons the exam and forfeits your 1 credit.</strong>
          An abandoned attempt will not be scored and will not appear in your completed tests.
        </div>
        <p class="text-sm text-muted no-margin">
          You can exit back to the test list to resume later before the countdown expires.
        </p>
      </div>
      <div class="modal__footer">
        <button type="button" class="btn js-close-exit-modal">Stay on test</button>
        <a class="btn" href="/exams">Exit (resume later)</a>
        <form method="post" action="/exams/take/@take.AttemptId/cancel" id="cancel-exam-form" style="display:inline;">
          @Html.AntiForgeryToken()
          <button type="submit" class="btn btn--danger">Cancel & abandon (lose credit)</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Time's Up Auto-Submit Modal -->
  <div id="times-up-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="times-up-title">
    <div class="modal">
      <div class="modal__header">
        <h2 id="times-up-title" class="no-margin">Time is up</h2>
      </div>
      <div class="modal__body stack">
        <div class="alert alert--warning">
          <strong>Your exam deadline has expired.</strong>
          The exam is being submitted automatically and scored on the questions you answered.
        </div>
        <div class="progress mx-auto" style="max-width: 280px">
          <div class="progress__bar" style="width: 100%"></div>
        </div>
      </div>
    </div>
  </div>

  <form id="auto-submit-form" method="post" action="/exams/take/@take.AttemptId/submit" style="display:none;">
    @Html.AntiForgeryToken()
    <div class="exam-draft-submit-fields"></div>
  </form>

  <!-- Bottom Question Palette (FULL_SANDBOX) -->
  <nav class="bottom-question-palette" id="bottom-question-palette" aria-label="Question Palette">
    <div class="palette-container">
      <div style="display: flex; align-items: center; justify-content: space-between; width: 100%; margin-bottom: 0.2rem;">
        <strong style="font-family: 'IBM Plex Sans Condensed', sans-serif; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">Báº¢NG CÃ‚U Há»ŽI (QUESTIONS 1â€“@take.TotalQuestions)</strong>
        <div class="palette-legend">
