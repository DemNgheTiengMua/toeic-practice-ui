  <script src="~/js/icons.js"></script>
  <script src="~/js/ee-audio.js"></script>
  <script src="~/js/exam-audio.js"></script>
  <script src="~/js/keyboard-nav.js"></script>
  <script>
    (function () {
      "use strict";

      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      // 1. Data Model & Initialization
      var examDataEl = document.getElementById('exam-data');
      var questions = [];
      var phaseData = [];
      try {
        questions = JSON.parse(examDataEl ? examDataEl.textContent : '[]');
        phaseData = JSON.parse(document.getElementById('phase-data')?.textContent || '[]');
      } catch (e) {
        console.error('Failed to parse exam payload:', e);
      }

      var attemptId = @take.AttemptId;
      var totalQuestions = questions.length || @take.TotalQuestions;
      var currentDisplayOrder = @q.DisplayOrder;
      var activeUnitNumber = @take.ActiveUnitNumber;
      var expiresAt = @take.ExpiresAt.ToUnixTimeMilliseconds();
      var attemptStartedAt = @take.StartedAt.ToUnixTimeMilliseconds();
      var csrfToken = document.querySelector('#anti-forgery-holder input[name="__RequestVerificationToken"]').value;
      var currentAudioOffsetMs = @take.LastAudioOffsetMs;
      var candidateNotesJson = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(take.CandidateNotesJson ?? ""));

      var questionMap = {};
      questions.forEach(function (q) {
        questionMap[q.displayOrder] = q;
      });

      // Local Answer & State Registry (optimistic in-memory cache)
      var localAnswers = {};
      questions.forEach(function (q) {
        localAnswers[q.questionId] = {
          selectedOptionId: q.selectedOptionId,
          selectedOptionIdsJson: q.selectedOptionIds != null ? JSON.stringify(q.selectedOptionIds) : null,
          isFlagged: q.isFlagged,
          responseText: q.responseText || '',
          responseAudioPath: q.responseAudioPath || null,
          responseDurationMs: q.responseDurationMs || null
        };
      });

      var responseDrafts = {};
      questions.forEach(function (q) {
        if (q.questionType === 'free_response') {
          responseDrafts[q.questionId] = {
            text: q.responseText || '',
            dirty: false
          };
        }
      });

      // Restore uncommitted answers from localStorage backup if present
      var storageKey = 'ee_exam_pending_' + attemptId;
      var pendingQueue = [];
      try {
        var rawStored = localStorage.getItem(storageKey);
        if (rawStored) {
          var parsed = JSON.parse(rawStored);
          if (Array.isArray(parsed) && parsed.length > 0) {
            pendingQueue = parsed;
            pendingQueue.forEach(function (item) {
              if (localAnswers[item.questionId]) {
                localAnswers[item.questionId].selectedOptionId = item.selectedOptionId;
                localAnswers[item.questionId].isFlagged = item.isFlagged;
                if (typeof item.responseText === 'string') {
                  localAnswers[item.questionId].responseText = item.responseText;
                }
              }
            });
          }
        }
      } catch (e) {
        console.warn('LocalStorage restore error:', e);
      }

      // UI Elements
      var saveStatus = document.getElementById('save-status');
      var timerDisplay = document.getElementById('timer-display');
      var timerBox = document.getElementById('timer-box');
      var topbarBadge = document.getElementById('topbar-section-badge');
      var flagBtn = document.getElementById('flag-btn');
      var btnPrev = document.getElementById('btn-prev');
      var btnNext = document.getElementById('btn-next');
      var optionList = document.getElementById('option-list');
      var freeResponseContainer = document.getElementById('free-response-container');
      var passageCard = document.getElementById('passage-card');
      var passageText = document.getElementById('passage-text');
      var imageContainer = document.getElementById('image-container');
      var questionImage = document.getElementById('question-image');
      var questionNumberDisplay = document.getElementById('question-number-display');
      var questionSectionDisplay = document.getElementById('question-section-display');
      var questionStemDisplay = document.getElementById('question-stem-display');
      var audioWrapper = document.getElementById('exam-audio-wrapper');
      var writingPane = document.getElementById('writing-response-pane');
      var writingEditor = document.getElementById('writing-editor');
      var wordCountDisplay = document.getElementById('word-count');
      var characterCountDisplay = document.getElementById('character-count');
      var wordRangeDisplay = document.getElementById('word-range');
      var saveDraftButton = document.getElementById('btn-save-writing-draft');
      var flaggedFilterButton = document.getElementById('flagged-filter-btn');

      var clusterContainer = document.getElementById('cluster-card-container');
      var questionMetaBar = document.getElementById('question-meta-bar');
      var reviewScreenModal = document.getElementById('review-screen-modal');
      var unitLockModal = document.getElementById('unit-lock-modal');
      var groupLockModal = document.getElementById('group-lock-modal');
      var btnConfirmGroupLock = document.getElementById('btn-confirm-group-lock');
      var writingOnscreenToolbar = document.getElementById('writing-onscreen-toolbar');
      var btnWritingCut = document.getElementById('btn-writing-cut');
      var btnWritingPaste = document.getElementById('btn-writing-paste');
      var btnWritingUndo = document.getElementById('btn-writing-undo');
      var btnWritingRedo = document.getElementById('btn-writing-redo');
      var liveWordCount = document.getElementById('live-word-count');
      var minWordsBadge = document.getElementById('min-words-badge');
      var underLengthWarning = document.getElementById('under-length-warning');
      var requiredKeywordsArea = document.getElementById('required-keywords-area');
      var requiredKeywordsList = document.getElementById('required-keywords-list');
      var btnOpenReviewScreen = document.getElementById('btn-open-review-screen');
      var btnReviewFirstUnanswered = document.getElementById('btn-review-first-unanswered');
      var btnReviewOnlyUnanswered = document.getElementById('btn-review-only-unanswered');
      var btnReviewOnlyFlagged = document.getElementById('btn-review-only-flagged');
      var btnReviewShowAll = document.getElementById('btn-review-show-all');
      var reviewQuestionsList = document.getElementById('review-questions-list');
      var reviewStatAnswered = document.getElementById('review-stat-answered');
      var reviewStatFlagged = document.getElementById('review-stat-flagged');
      var reviewStatUnanswered = document.getElementById('review-stat-unanswered');
      var reviewUnitTransitionContainer = document.getElementById('review-unit-transition-container');
      var btnReviewFinishUnit = document.getElementById('btn-review-finish-unit');
      var btnConfirmUnitLock = document.getElementById('btn-confirm-unit-lock');

      var submitModal = document.getElementById('submit-modal');
      var exitModal = document.getElementById('exit-modal');
      var timesUpModal = document.getElementById('times-up-modal');
      var autoSubmitForm = document.getElementById('auto-submit-form');
      var submitExamForm = document.getElementById('submit-exam-form');
      var cancelExamForm = document.getElementById('cancel-exam-form');

      var phases = phaseData.map(function (phase) {
        return {
          skillId: phase.skillId,
          skillCode: phase.skillCode,
          skillName: phase.skillName,
          skillDisplayOrder: phase.skillDisplayOrder,
          startOffsetSeconds: phase.startOffsetSeconds,
          durationSeconds: phase.durationSeconds,
          questions: questions.filter(function (question) { return question.skillCode === phase.skillCode; })
        };
      });
      var activePhaseIndex = -1;
      var flaggedOnly = false;
      var draftSaveTimeout = null;
      var draftSaveInFlight = {};

      function getPhaseIndexAt(now) {
        var elapsedSeconds = Math.max(0, Math.floor((now - attemptStartedAt) / 1000));
        for (var i = 0; i < phases.length; i++) {
          if (elapsedSeconds < phases[i].startOffsetSeconds + phases[i].durationSeconds) return i;
        }
        return phases.length;
      }

      function getQuestionPhaseIndex(question) {
        return phases.findIndex(function (phase) { return phase.skillCode === question.skillCode; });
      }

      function formatTimer(seconds) {
        var minutes = Math.floor(seconds / 60);
        var remainder = seconds % 60;
        return (minutes < 10 ? '0' : '') + minutes + ':' + (remainder < 10 ? '0' : '') + remainder;
      }

      function renderPhaseProgress(now) {
        var elapsedSeconds = Math.max(0, Math.floor((now - attemptStartedAt) / 1000));
        var currentIndex = getPhaseIndexAt(now);
        document.querySelectorAll('[data-phase-skill]').forEach(function (item, index) {
          var phase = phases[index];
          if (!phase) return;
          var timer = item.querySelector('[data-phase-timer]');
          var remaining = index < currentIndex
            ? 0
            : index === currentIndex
              ? Math.max(0, phase.startOffsetSeconds + phase.durationSeconds - elapsedSeconds)
              : phase.durationSeconds;
          item.setAttribute('aria-current', index === currentIndex ? 'step' : 'false');
          if (timer) timer.textContent = formatTimer(remaining);
        });

        if (currentIndex < phases.length && currentIndex !== activePhaseIndex) {
          activePhaseIndex = currentIndex;
          var phase = phases[currentIndex];
          var firstQuestion = phase.questions[0];
          var currentQuestion = questionMap[currentDisplayOrder];
          if (firstQuestion && (!currentQuestion || currentQuestion.skillCode !== phase.skillCode)) {
            renderQuestion(firstQuestion.displayOrder);
          }
          updateNavigationForPhase();
        }
      }

      function getQuestionAudioKey(item) {
        if (!item || !item.audioPath || !item.audioPath.trim()) return null;
        var key = item.audioPath.trim();
        if (item.audioStartMs != null || item.audioEndMs != null) {
          key += ':' + (item.audioStartMs || 0) + '-' + (item.audioEndMs || 0);
        }
        return key;
      }

      var currentAudioKey = getQuestionAudioKey(questionMap[currentDisplayOrder]);
      var audioStorageKey = 'ee_exam_audio_' + attemptId;
      var playedAudios = {};
      try {
        var rawStoredAudios = localStorage.getItem(audioStorageKey);
        if (rawStoredAudios) {
          playedAudios = JSON.parse(rawStoredAudios) || {};
        }
      } catch (e) {
        console.warn('Audio storage read error:', e);
      }

      function getAudioProgress(key) {
        if (!key || !playedAudios[key]) return { completed: false, currentTime: 0 };
        var entry = playedAudios[key];
        if (typeof entry === 'boolean') {
          return { completed: entry, currentTime: 0 };
        }
        return {
          completed: !!entry.completed,
          currentTime: Number(entry.currentTime) || 0
        };
      }

      function recordAudioProgress(key, progress) {
        if (!key || !progress) return;
        var existing = getAudioProgress(key);
        var completed = !!(progress.completed || existing.completed);
        var currentTime = Math.max(existing.currentTime, Number(progress.currentTime) || 0);
        playedAudios[key] = {
          completed: completed,
          currentTime: currentTime
        };
        try {
          localStorage.setItem(audioStorageKey, JSON.stringify(playedAudios));
        } catch (e) {}
      }

      // If initial question audio was already completed or listened in this attempt, re-render with saved progress
      var initialProgress = getAudioProgress(currentAudioKey);
      if (currentAudioKey && (initialProgress.completed || initialProgress.currentTime > 0) && audioWrapper && window.createExamAudioHtml) {
        var initialQ = questionMap[currentDisplayOrder] || {
          audioPath: '@Html.Raw(q.AudioPath ?? "")',
          audioStartMs: @(q.AudioStartMs.HasValue ? q.AudioStartMs.Value.ToString() : "null"),
          audioEndMs: @(q.AudioEndMs.HasValue ? q.AudioEndMs.Value.ToString() : "null")
        };
        audioWrapper.innerHTML = window.createExamAudioHtml({
          mode: 'exam',
          audioPath: initialQ.audioPath,
          startMs: initialQ.audioStartMs,
          endMs: initialQ.audioEndMs,
          playerId: 'main-exam-audio',
          completed: initialProgress.completed,
          currentTime: initialProgress.currentTime
        });
        if (window.initExamAudio) window.initExamAudio();
      }

      document.addEventListener('examaudiotimeupdate', function (e) {
        if (e.detail && typeof e.detail.currentTime === 'number') {
          currentAudioOffsetMs = Math.round(e.detail.currentTime * 1000);
        }
        if (currentAudioKey && e.detail) {
          recordAudioProgress(currentAudioKey, {
            currentTime: e.detail.currentTime,
            completed: e.detail.completed
          });
        }
      });

      document.addEventListener('examaudioended', function () {
        if (currentAudioKey) {
          recordAudioProgress(currentAudioKey, {
            completed: true
          });
        }
      });

      var isFlushing = false;
      var isSubmitting = false;
      var activeRecorder = null;
      var activeRecordingStream = null;
      var activeAudioChunks = [];
      var activeAudioTimer = null;
      var prepTimer = null;
      var activeRecordingStartedAt = 0;
      var isSpeakingPreparing = false;
      var isSpeakingRecording = false;
      var isAudioUploading = false;
      var speakingPacerTimer = null;
      var speakingPacerAudioCtx = null;
      var speakingPacerAnalyser = null;
      var speakingPacerAnimFrame = null;
      var recordedSpeakingClips = {};

      function isSystemPacedAuto(q) {
        return !!(q && (q.navigationMode === 'SYSTEM_PACED_AUTO' || q.navigationMode === 'SystemPacedAuto'));
      }

      function playBeepCue() {
        try {
          var AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (!AudioCtx) return;
          var ctx = new AudioCtx();
          var osc = ctx.createOscillator();
          var gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(1000, ctx.currentTime);
          gain.gain.setValueAtTime(0.3, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.3);
        } catch (e) {
          console.warn('AudioContext beep cue failed:', e);
        }
      }

      function cleanupSpeakingPacer() {
        if (speakingPacerTimer) {
          clearInterval(speakingPacerTimer);
          speakingPacerTimer = null;
        }
        if (speakingPacerAnimFrame) {
          cancelAnimationFrame(speakingPacerAnimFrame);
          speakingPacerAnimFrame = null;
        }
        if (speakingPacerAudioCtx && speakingPacerAudioCtx.state !== 'closed') {
          try { speakingPacerAudioCtx.close(); } catch (e) {}
          speakingPacerAudioCtx = null;
        }
        if (activeRecorder && activeRecorder.state !== 'inactive') {
          try { activeRecorder.stop(); } catch (e) {}
          activeRecorder = null;
        }
        if (activeRecordingStream) {
          try {
            activeRecordingStream.getTracks().forEach(function (t) { t.stop(); });
          } catch (e) {}
          activeRecordingStream = null;
        }
        isSpeakingPreparing = false;
        isSpeakingRecording = false;
        isAudioUploading = false;
      }

      function startSpeakingPacerStateMachine(q) {
        cleanupSpeakingPacer();

        var pacerContainer = document.getElementById('speaking-pacer-container');
        var prepPlacard = document.getElementById('speaking-prep-placard');
        var prepTimer = document.getElementById('speaking-prep-timer');
        var prepBar = document.getElementById('speaking-prep-bar');
        var prepBarBox = document.getElementById('speaking-prep-bar-box');
        var recordPlacard = document.getElementById('speaking-record-placard');
        var recordTimer = document.getElementById('speaking-record-timer');
        var recordBar = document.getElementById('speaking-record-bar');
        var recordBarBox = document.getElementById('speaking-record-bar-box');
        var levelContainer = document.getElementById('audio-level-container');
        var levelBar = document.getElementById('audio-level-bar');
        var levelText = document.getElementById('audio-level-text');
        var uploadPlacard = document.getElementById('speaking-upload-placard');

        if (!pacerContainer) return;
        pacerContainer.style.display = 'block';

        var totalPrep = (q.prepSeconds != null && q.prepSeconds > 0) ? q.prepSeconds : 15;
        var totalResponse = (q.responseSeconds != null && q.responseSeconds > 0) ? q.responseSeconds : 30;

        // Step 1: Prep Countdown
        isSpeakingPreparing = true;
        isSpeakingRecording = false;
        isAudioUploading = false;

        if (prepPlacard) prepPlacard.style.display = 'flex';
        if (prepBarBox) prepBarBox.style.display = 'block';
        if (prepTimer) prepTimer.textContent = totalPrep + 's';
        if (prepBar) prepBar.style.width = '100%';

        if (recordPlacard) recordPlacard.style.display = 'none';
        if (recordBarBox) recordBarBox.style.display = 'none';
        if (levelContainer) levelContainer.style.display = 'none';
        if (uploadPlacard) uploadPlacard.style.display = 'none';

        var remainingPrep = totalPrep;
        speakingPacerTimer = setInterval(function () {
          remainingPrep--;
          if (prepTimer) prepTimer.textContent = Math.max(0, remainingPrep) + 's';
          if (prepBar) prepBar.style.width = Math.max(0, (remainingPrep / totalPrep) * 100) + '%';

          if (remainingPrep <= 0) {
            clearInterval(speakingPacerTimer);
            speakingPacerTimer = null;
            isSpeakingPreparing = false;

            // Step 2: Audible Beep Cue
            playBeepCue();

            // Step 3: Recording Countdown
            startSpeakingPacerRecording(q, totalResponse);
          }
        }, 1000);
      }

      function startSpeakingPacerRecording(q, totalResponse) {
        var prepPlacard = document.getElementById('speaking-prep-placard');
        var prepBarBox = document.getElementById('speaking-prep-bar-box');
        var recordPlacard = document.getElementById('speaking-record-placard');
        var recordTimer = document.getElementById('speaking-record-timer');
        var recordBar = document.getElementById('speaking-record-bar');
        var recordBarBox = document.getElementById('speaking-record-bar-box');
        var levelContainer = document.getElementById('audio-level-container');
        var levelBar = document.getElementById('audio-level-bar');
        var levelText = document.getElementById('audio-level-text');

        isSpeakingRecording = true;
        if (prepPlacard) prepPlacard.style.display = 'none';
        if (prepBarBox) prepBarBox.style.display = 'none';

        if (recordPlacard) recordPlacard.style.display = 'flex';
        if (recordBarBox) recordBarBox.style.display = 'block';
        if (recordTimer) recordTimer.textContent = totalResponse + 's';
        if (recordBar) recordBar.style.width = '100%';
        if (levelContainer) levelContainer.style.display = 'block';

        activeRecordingStartedAt = Date.now();
        activeAudioChunks = [];

        var streamPromise = (navigator.mediaDevices && navigator.mediaDevices.getUserMedia)
          ? navigator.mediaDevices.getUserMedia({ audio: true })
          : Promise.reject(new Error('MediaDevices unavailable'));

        streamPromise.then(function (stream) {
          activeRecordingStream = stream;
          try {
            var AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (AudioCtx) {
              speakingPacerAudioCtx = new AudioCtx();
              var srcNode = speakingPacerAudioCtx.createMediaStreamSource(stream);
              speakingPacerAnalyser = speakingPacerAudioCtx.createAnalyser();
              speakingPacerAnalyser.fftSize = 256;
              srcNode.connect(speakingPacerAnalyser);
              var freqArr = new Uint8Array(speakingPacerAnalyser.frequencyBinCount);

              function pumpLevel() {
                if (!isSpeakingRecording || !speakingPacerAnalyser) return;
                speakingPacerAnalyser.getByteFrequencyData(freqArr);
                var total = 0;
                for (var i = 0; i < freqArr.length; i++) total += freqArr[i];
                var pct = Math.min(100, Math.round(((total / freqArr.length) / 128) * 100));
                if (levelBar) levelBar.style.width = pct + '%';
                if (levelText) levelText.textContent = pct + '%';
                speakingPacerAnimFrame = requestAnimationFrame(pumpLevel);
              }
              speakingPacerAnimFrame = requestAnimationFrame(pumpLevel);
            }
          } catch (e) {
            console.warn('Audio level meter init failed:', e);
          }

          if (typeof MediaRecorder !== 'undefined') {
            activeRecorder = new MediaRecorder(stream);
            activeRecorder.ondataavailable = function (evt) {
              if (evt.data && evt.data.size > 0) activeAudioChunks.push(evt.data);
            };
            activeRecorder.onstop = function () {
              finishSpeakingPacerRecording(q);
            };
            activeRecorder.start();
          }
        }).catch(function (err) {
          console.warn('Microphone error in speaking pacer:', err);
        });

        var remainingRec = totalResponse;
        speakingPacerTimer = setInterval(function () {
          remainingRec--;
          if (recordTimer) recordTimer.textContent = Math.max(0, remainingRec) + 's';
          if (recordBar) recordBar.style.width = Math.max(0, (remainingRec / totalResponse) * 100) + '%';

          if (remainingRec <= 0) {
            clearInterval(speakingPacerTimer);
            speakingPacerTimer = null;
            // Step 4: Stop Recording and Advance
            stopSpeakingPacerRecording(q);
          }
        }, 1000);
      }

      function stopSpeakingPacerRecording(q) {
        isSpeakingRecording = false;
        if (speakingPacerAnimFrame) {
          cancelAnimationFrame(speakingPacerAnimFrame);
          speakingPacerAnimFrame = null;
        }
        if (speakingPacerAudioCtx && speakingPacerAudioCtx.state !== 'closed') {
          try { speakingPacerAudioCtx.close(); } catch (e) {}
          speakingPacerAudioCtx = null;
        }
        if (activeRecorder && activeRecorder.state !== 'inactive') {
          activeRecorder.stop();
        } else {
          finishSpeakingPacerRecording(q);
        }
      }

      function finishSpeakingPacerRecording(q) {
        if (activeRecordingStream) {
          try { activeRecordingStream.getTracks().forEach(function (t) { t.stop(); }); } catch (e) {}
          activeRecordingStream = null;
        }

        var uploadPlacard = document.getElementById('speaking-upload-placard');
        if (uploadPlacard) uploadPlacard.style.display = 'block';
        isAudioUploading = true;

        var blob = activeAudioChunks.length > 0
          ? new Blob(activeAudioChunks, { type: activeAudioChunks[0].type || 'audio/webm' })
          : new Blob([new Uint8Array(50)], { type: 'audio/webm' });

        var blobUrl = URL.createObjectURL(blob);
        var durationMs = Math.max(1000, Date.now() - (activeRecordingStartedAt || (Date.now() - 1000)));

        recordedSpeakingClips[q.questionId] = {
          questionId: q.questionId,
          displayOrder: q.displayOrder,
          stem: q.stem,
          blobUrl: blobUrl,
          blob: blob,
          durationMs: durationMs,
          isRecorded: true
        };

        var formData = new FormData();
        formData.append('attemptId', attemptId);
        formData.append('questionId', q.questionId);
        formData.append('audioFile', blob, 'speaking-q' + q.questionId + '.webm');
        formData.append('durationMs', durationMs);
        formData.append('__RequestVerificationToken', csrfToken);

        fetch('/exams/take/' + attemptId + '/upload-audio', {
          method: 'POST',
          body: formData
        }).then(function (res) {
          if (!res.ok) {
            return fetch('/speaking/upload-audio', { method: 'POST', body: formData });
          }
          return res;
        }).then(function (res) {
          return res.json();
        }).then(function (data) {
          var state = localAnswers[q.questionId] || {};
          state.responseAudioPath = (data && data.audioPath) ? data.audioPath : blobUrl;
          state.responseDurationMs = durationMs;
          localAnswers[q.questionId] = state;
          saveAnswer(q.questionId, null, !!state.isFlagged, state.responseText || '');
          updateProgressStats();
        }).catch(function (err) {
          console.warn('Speaking upload error:', err);
          var state = localAnswers[q.questionId] || {};
          state.responseAudioPath = blobUrl;
          state.responseDurationMs = durationMs;
          localAnswers[q.questionId] = state;
          saveAnswer(q.questionId, null, !!state.isFlagged, state.responseText || '');
          updateProgressStats();
        }).finally(function () {
          isAudioUploading = false;
          activeRecorder = null;
          activeAudioChunks = [];
          transitionAfterSpeakingItem(q);
        });
      }

      function transitionAfterSpeakingItem(q) {
        var sectionSpeakingQuestions = questions.filter(function (item) {
          return item.sectionId === q.sectionId && (item.navigationMode === 'SYSTEM_PACED_AUTO' || (item.modality || '').toLowerCase() === 'speaking');
        });
        if (sectionSpeakingQuestions.length === 0) {
          sectionSpeakingQuestions = questions.filter(function (item) {
            return item.navigationMode === 'SYSTEM_PACED_AUTO';
          });
        }

        var currentIdx = sectionSpeakingQuestions.findIndex(function (item) {
          return item.questionId === q.questionId;
        });

        var isLast = (currentIdx === -1) || (currentIdx >= sectionSpeakingQuestions.length - 1);

        if (!isLast) {
          var nextQ = sectionSpeakingQuestions[currentIdx + 1];
          goToQuestion(nextQ.displayOrder);
        } else {
          renderSpeakingVerificationScreen(sectionSpeakingQuestions);
        }
      }

      function renderSpeakingVerificationScreen(speakingQuestions) {
        cleanupSpeakingPacer();

        var pacerContainer = document.getElementById('speaking-pacer-container');
        if (pacerContainer) pacerContainer.style.display = 'none';

        var verificationScreen = document.getElementById('speaking-verification-screen');
        var verificationItems = document.getElementById('speaking-verification-items');
        var countBadge = document.getElementById('speaking-verification-count-badge');
        if (!verificationScreen || !verificationItems) return;

        verificationScreen.style.display = 'block';

        if (btnPrev) btnPrev.style.display = 'none';
        if (btnNext) btnNext.style.display = 'none';

        var qs = speakingQuestions && speakingQuestions.length > 0
          ? speakingQuestions
          : questions.filter(function (it) { return it.navigationMode === 'SYSTEM_PACED_AUTO' || (it.modality || '').toLowerCase() === 'speaking'; });

        if (countBadge) countBadge.textContent = qs.length + ' câu hỏi (items)';

        var itemsHtml = '';
        qs.forEach(function (sq) {
          var clip = recordedSpeakingClips[sq.questionId];
          var ans = localAnswers[sq.questionId];
          var audioUrl = clip ? clip.blobUrl : (ans ? ans.responseAudioPath : null);
          var hasRecording = !!audioUrl;

          itemsHtml += '<div class="speaking-verification-card" data-question-id="' + sq.questionId + '">';
          itemsHtml += '<div class="row row--between mb-2" style="align-items: center;">';
          itemsHtml += '<strong style="font-family:\'IBM Plex Sans Condensed\',sans-serif; text-transform:uppercase; font-size:1rem;">Câu ' + sq.displayOrder + ' / ' + totalQuestions + '</strong>';
          if (hasRecording) {
            itemsHtml += '<span class="badge status-badge--recorded">Đã ghi âm [✓]</span>';
          } else {
            itemsHtml += '<span class="badge status-badge--missing">Chưa có ghi âm [!]</span>';
          }
          itemsHtml += '</div>';

          itemsHtml += '<p class="text-sm text-muted mb-2">' + escapeHtml(sq.stem || 'Phần trả lời nói') + '</p>';

          if (hasRecording) {
            itemsHtml += '<audio controls src="' + escapeHtml(audioUrl) + '" style="width: 100%; border: 1px solid #14181d; border-radius: 0; background: #fff;"></audio>';
          } else {
            itemsHtml += '<div class="text-xs text-muted" style="font-style: italic; padding: 0.5rem; background: #fff; border: 1px dashed #ccd2d6;">Chưa có bản ghi âm cho câu hỏi này.</div>';
          }

          itemsHtml += '</div>';
        });

        verificationItems.innerHTML = itemsHtml;

        var btnSubmitVerification = document.getElementById('btn-submit-speaking-verification');
        if (btnSubmitVerification) {
          btnSubmitVerification.onclick = function () {
            btnSubmitVerification.disabled = true;
            btnSubmitVerification.textContent = 'Đang nộp bài...';
            var submitForm = document.getElementById('submit-exam-form') || document.getElementById('auto-submit-form');
            if (submitForm) {
              submitForm.submit();
            } else {
              var form = document.createElement('form');
              form.method = 'POST';
              form.action = '/exams/take/' + attemptId + '/submit';
              var tokenInput = document.createElement('input');
              tokenInput.type = 'hidden';
              tokenInput.name = '__RequestVerificationToken';
              tokenInput.value = csrfToken;
              form.appendChild(tokenInput);
              document.body.appendChild(form);
              form.submit();
            }
          };
        }
      }

      function renderFreeResponse(q) {
        var answer = localAnswers[q.questionId] || {};
        var isSpeaking = (q.modality || '').toLowerCase() === 'speaking';
        optionList.style.display = 'none';
        freeResponseContainer.style.display = 'block';

        if (!isSpeaking) {
          var minWords = Number(q.minWords) || 0;
          var maxWords = Number(q.maxWords) || 0;
          freeResponseContainer.innerHTML =
            '<label class="field__label" for="free-response-text">Written response</label>' +
            '<p class="text-sm text-muted">Word limit: ' + minWords + '–' + maxWords + ' words.</p>' +
            '<textarea id="free-response-text" class="field__input" rows="12" maxlength="20000" aria-describedby="free-response-word-count"></textarea>' +
            '<p id="free-response-word-count" class="text-sm text-muted" aria-live="polite"></p>';
          var responseInput = document.getElementById('free-response-text');
          var wordCount = document.getElementById('free-response-word-count');
          responseInput.value = answer.responseText || '';

          function updateWordCount() {
            var trimmed = responseInput.value.trim();
            var count = trimmed ? trimmed.split(/\s+/).length : 0;
            wordCount.textContent = count + ' words' +
              (minWords || maxWords ? ' · required ' + minWords + '–' + maxWords : '');
          }

          responseInput.addEventListener('input', function () {
            updateWordCount();
            saveAnswer(q.questionId, null, !!(localAnswers[q.questionId] && localAnswers[q.questionId].isFlagged), responseInput.value);
          });
          updateWordCount();
          return;
        }

        var existingAudio = answer.responseAudioPath;
        freeResponseContainer.innerHTML =
          '<p class="text-sm">Preparation time: ' + (Number(q.prepSeconds) || 0) + ' seconds · ' +
            'Response time: ' + (Number(q.responseSeconds) || 0) + ' seconds.</p>' +
          '<p id="speaking-recording-status" class="text-sm" aria-live="polite">' +
            (existingAudio ? 'A saved recording is attached. Record again to replace it.' : 'No recording saved yet.') +
          '</p>' +
          '<div class="row" style="gap:.5rem; flex-wrap:wrap;">' +
            '<button type="button" id="speaking-record-start" class="btn btn--primary">Start recording</button>' +
            '<button type="button" id="speaking-record-stop" class="btn" style="display:none;">Stop recording</button>' +
          '</div>';
        var startButton = document.getElementById('speaking-record-start');
        var stopButton = document.getElementById('speaking-record-stop');
        var status = document.getElementById('speaking-recording-status');

        startButton.addEventListener('click', function () {
          startMockSpeakingCapture(q, status, startButton, stopButton);
        });
        stopButton.addEventListener('click', function () {
          stopMockSpeakingCapture();
        });
      }

      async function startMockSpeakingCapture(q, status, startButton, stopButton) {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia || typeof MediaRecorder === 'undefined') {
          status.textContent = 'This browser does not support audio recording.';
          return;
        }

        startButton.disabled = true;
        isSpeakingPreparing = true;
        status.textContent = 'Requesting microphone access…';
        try {
          activeRecordingStream = await navigator.mediaDevices.getUserMedia({ audio: true });
          var prepSeconds = Number(q.prepSeconds) || 0;
          if (prepSeconds > 0) {
            var remainingPrep = prepSeconds;
            status.textContent = 'Preparation time: ' + remainingPrep + ' seconds.';
            await new Promise(function (resolve) {
              prepTimer = window.setInterval(function () {
                remainingPrep--;
                if (remainingPrep <= 0) {
                  window.clearInterval(prepTimer);
                  prepTimer = null;
                  resolve();
                } else {
                  status.textContent = 'Preparation time: ' + remainingPrep + ' seconds.';
                }
              }, 1000);
            });
          }

          isSpeakingPreparing = false;
          activeAudioChunks = [];
          activeRecorder = new MediaRecorder(activeRecordingStream);
          activeRecorder.addEventListener('dataavailable', function (event) {
            if (event.data && event.data.size > 0) activeAudioChunks.push(event.data);
          });
          activeRecorder.addEventListener('stop', function () {
            uploadMockSpeakingRecording(q, status, startButton, stopButton);
          }, { once: true });
          activeRecorder.start();
          activeRecordingStartedAt = Date.now();
          isSpeakingRecording = true;
          startButton.style.display = 'none';
          stopButton.style.display = '';
          status.textContent = 'Recording…';
          var responseSeconds = Number(q.responseSeconds) || 0;
          if (responseSeconds > 0) {
            activeAudioTimer = window.setTimeout(stopMockSpeakingCapture, responseSeconds * 1000);
          }
        } catch (error) {
          isSpeakingPreparing = false;
          if (activeRecordingStream) {
            activeRecordingStream.getTracks().forEach(function (track) { track.stop(); });
            activeRecordingStream = null;
          }
          if (prepTimer) {
            window.clearInterval(prepTimer);
            prepTimer = null;
          }
          startButton.disabled = false;
          status.textContent = 'Microphone access failed. Check browser permissions and try again.';
        }
      }

      function stopMockSpeakingCapture() {
        if (activeAudioTimer) {
          window.clearTimeout(activeAudioTimer);
          activeAudioTimer = null;
        }
        if (prepTimer) {
          window.clearInterval(prepTimer);
          prepTimer = null;
        }
        if (activeRecorder && activeRecorder.state !== 'inactive') {
          activeRecorder.stop();
        }
      }

      async function uploadMockSpeakingRecording(q, status, startButton, stopButton) {
        isSpeakingRecording = false;
        isAudioUploading = true;
        if (activeRecordingStream) {
          activeRecordingStream.getTracks().forEach(function (track) { track.stop(); });
          activeRecordingStream = null;
        }
        stopButton.style.display = 'none';
        status.textContent = 'Uploading recording…';
        var blob = new Blob(activeAudioChunks, { type: activeAudioChunks[0] ? activeAudioChunks[0].type : 'audio/webm' });
        var durationMs = Math.max(1, Date.now() - activeRecordingStartedAt);

        try {
          var tokenInput = document.querySelector('#anti-forgery-holder input[name="__RequestVerificationToken"]');
          var formData = new FormData();
          formData.append('attemptId', attemptId);
          formData.append('questionId', q.questionId);
          formData.append('audioFile', blob, 'recording.webm');
          formData.append('durationMs', durationMs);
          formData.append('__RequestVerificationToken', tokenInput ? tokenInput.value : '');
          var response = await fetch('/speaking/upload-audio', { method: 'POST', body: formData });
          if (!response.ok) {
            throw new Error('Audio upload failed (' + response.status + ').');
          }

          var state = localAnswers[q.questionId] || {};
          state.responseAudioPath = 'saved';
          state.responseDurationMs = durationMs;
          localAnswers[q.questionId] = state;
          status.textContent = 'Recording saved. Record again to replace it.';
          saveAnswer(q.questionId, null, !!state.isFlagged, state.responseText || '');
          updateProgressStats();
        } catch (error) {
          status.textContent = 'Recording could not be saved. Check your connection and record again.';
          startButton.style.display = '';
        } finally {
          isAudioUploading = false;
          startButton.disabled = false;
          activeRecorder = null;
          activeAudioChunks = [];
        }
      }

      function countWords(text) {
        var trimmed = (text || '').trim();
        return trimmed ? trimmed.split(/\s+/).length : 0;
      }

      function stripSuffixes(word) {
        if (!word) return '';
        if (word.endsWith('ations') && word.length > 7) return word.slice(0, -6);
        if (word.endsWith('ation') && word.length > 6) return word.slice(0, -5);
        if (word.endsWith('tion') && word.length > 6) return word.slice(0, -4);
        if (word.endsWith('ment') && word.length > 6) return word.slice(0, -4);
        if (word.endsWith('ing') && word.length > 5) return word.slice(0, -3);
        if (word.endsWith('ed') && word.length > 4) return word.slice(0, -2);
        if (word.endsWith('es') && word.length > 4) return word.slice(0, -2);
        if (word.endsWith('s') && word.length > 3) return word.slice(0, -1);
        if (word.endsWith('e') && word.length > 4) return word.slice(0, -1);
        return word;
      }

      function containsKeywordStem(text, keyword) {
        if (!keyword) return true;
        var kw = keyword.trim().toLowerCase();
        var lower = (text || '').toLowerCase();
        if (lower.indexOf(kw) !== -1) return true;
        var stem = stripSuffixes(kw);
        if (stem.length >= 3 && lower.indexOf(stem) !== -1) return true;
        var words = lower.split(/[\s,.\!?;\:]+/).filter(Boolean);
        for (var i = 0; i < words.length; i++) {
          var w = words[i];
          if (w.indexOf(stem) !== -1 || stripSuffixes(w) === stem) return true;
        }
        return false;
      }

      function parseKeywordList(keywordsStr) {
        if (!keywordsStr) return [];
        var trimmed = keywordsStr.trim();
        if (trimmed.startsWith('[') && trimmed.endsWith(']')) {
          try {
            var arr = JSON.parse(trimmed);
            if (Array.isArray(arr)) return arr.filter(Boolean);
          } catch (e) {}
        }
        return trimmed.split(/[,;]+/).map(function (k) { return k.trim(); }).filter(Boolean);
      }

      function updateRequiredKeywordsMatch(q, text) {
        if (!requiredKeywordsList || !q || !q.requiredKeywords) return;
        var badges = requiredKeywordsList.querySelectorAll('.keyword-badge');
        badges.forEach(function (badge) {
          var kw = badge.getAttribute('data-keyword') || '';
          var matched = containsKeywordStem(text, kw);
          if (matched) {
            badge.className = 'keyword-badge badge--used';
            badge.setAttribute('title', 'Đã sử dụng');
          } else {
            badge.className = 'keyword-badge badge--pending';
            badge.setAttribute('title', 'Chưa sử dụng');
          }
        });
      }

      function renderRequiredKeywords(q) {
        if (!requiredKeywordsArea || !requiredKeywordsList) return;
        var kws = parseKeywordList(q ? q.requiredKeywords : null);
        if (kws.length === 0) {
          requiredKeywordsArea.style.display = 'none';
          requiredKeywordsList.innerHTML = '';
          return;
        }
        requiredKeywordsArea.style.display = '';
        var html = '';
        kws.forEach(function (kw) {
          html += '<span class="keyword-badge badge--pending" data-keyword="' + escapeHtml(kw) + '">' + escapeHtml(kw) + '</span>';
        });
        requiredKeywordsList.innerHTML = html;
        var text = (writingEditor ? writingEditor.value : '') || '';
        updateRequiredKeywordsMatch(q, text);
      }

      var internalClipboard = '';
      var undoStack = [];
      var redoStack = [];
      var isTrackingUndo = true;

      function pushUndoState() {
        if (!writingEditor || !isTrackingUndo) return;
        var currentText = writingEditor.value;
        if (undoStack.length === 0 || undoStack[undoStack.length - 1] !== currentText) {
          undoStack.push(currentText);
          if (undoStack.length > 50) undoStack.shift();
          redoStack = [];
        }
      }

      function isCutPasteRestricted(q) {
        if (!q) return false;
        var cfg = parseToolsConfig(q.toolsConfigJson);
        return cfg.allowKeyboardCutPaste === false || cfg.showOnScreenCutPaste === true || cfg.onScreenCutPasteOnly === true;
      }

      function updateWritingEditorTools(q) {
        if (!writingEditor) return;
        var cfg = parseToolsConfig(q ? q.toolsConfigJson : null);
        var disableSpellCheck = cfg.disableSpellCheck !== false;
        writingEditor.setAttribute('spellcheck', disableSpellCheck ? 'false' : 'true');
        writingEditor.setAttribute('autocorrect', disableSpellCheck ? 'off' : 'on');
        writingEditor.setAttribute('autocomplete', disableSpellCheck ? 'off' : 'on');
        writingEditor.setAttribute('autocapitalize', disableSpellCheck ? 'off' : 'on');

        var isRestricted = isCutPasteRestricted(q);
        if (writingOnscreenToolbar) {
          writingOnscreenToolbar.style.display = isRestricted ? 'flex' : 'none';
        }

        var showWordCount = cfg.showWordCount !== false;
        var writingCounts = document.getElementById('writing-counts');
        if (writingCounts) {
          writingCounts.style.display = showWordCount ? 'flex' : 'none';
        }
      }

      function updateWritingCounters(question) {
        if (!writingEditor || !question) return;
        var responseText = writingEditor.value || '';
        var words = countWords(responseText);
        if (liveWordCount) liveWordCount.textContent = words;
        if (wordCountDisplay) wordCountDisplay.textContent = words;
        if (characterCountDisplay) characterCountDisplay.textContent = responseText.length;

        var minWords = Number(question.minWords) || 0;
        var maxWords = Number(question.maxWords) || 0;

        if (wordRangeDisplay) {
          var minimum = minWords ? minWords + ' minimum' : '';
          var maximum = maxWords ? maxWords + ' maximum' : '';
          wordRangeDisplay.textContent = minimum && maximum
            ? ' (' + minimum + ', ' + maximum + ')'
            : minimum || maximum ? ' (' + (minimum || maximum) + ')' : '';
        }

        if (minWordsBadge) {
          if (minWords > 0) {
            minWordsBadge.style.display = 'inline-flex';
            minWordsBadge.textContent = 'Tối thiểu: ' + minWords + ' từ';
            if (words < minWords) {
              minWordsBadge.style.background = '#fef2f2';
              minWordsBadge.style.color = '#b31217';
              minWordsBadge.style.borderColor = '#b31217';
              if (underLengthWarning) underLengthWarning.style.display = 'inline-flex';
            } else {
              minWordsBadge.style.background = '#f0fdf4';
              minWordsBadge.style.color = '#0a6b3c';
              minWordsBadge.style.borderColor = '#0a6b3c';
              if (underLengthWarning) underLengthWarning.style.display = 'none';
            }
          } else {
            minWordsBadge.style.display = 'none';
            if (underLengthWarning) underLengthWarning.style.display = 'none';
          }
        }

        updateRequiredKeywordsMatch(question, responseText);
      }

      function markDraftDirty(questionId) {
        var draft = responseDrafts[questionId];
        if (!draft) return;
        draft.text = writingEditor.value;
        draft.dirty = true;
        pushUndoState();
        updateWritingCounters(questionMap[currentDisplayOrder]);
        updateProgressStats();
        saveStatus.textContent = 'Draft not saved';
        saveStatus.className = 'save-status save-status--saving';
        if (draftSaveTimeout) clearTimeout(draftSaveTimeout);
        draftSaveTimeout = setTimeout(function () {
          saveDraft(questionId);
        }, 3000);
      }

      function saveDraft(questionId) {
        var draft = responseDrafts[questionId];
        if (!draft || !draft.dirty) return Promise.resolve(true);
        if (draftSaveInFlight[questionId]) return draftSaveInFlight[questionId];

        var savedText = draft.text;
        saveStatus.textContent = 'Saving draft…';
        saveStatus.className = 'save-status save-status--saving';
        var request = fetch('/exams/take/' + attemptId + '/draft', {
          method: 'POST',
          keepalive: true,
          headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': csrfToken
          },
          body: JSON.stringify({
            questionId: questionId,
            responseText: savedText
          })
        })
        .then(function (response) {
          if (!response.ok) {
            return response.json().catch(function () { return {}; }).then(function (error) {
              throw new Error(error.message || error.detail || 'Draft save failed with status ' + response.status);
            });
          }
          return response.json();
        })
        .then(function (result) {
          draft.dirty = draft.text !== savedText;
          var savedAt = result.savedAt ? new Date(result.savedAt) : new Date();
          saveStatus.textContent = 'Draft saved at ' + savedAt.toLocaleTimeString([], { hour12: false });
          saveStatus.className = 'save-status save-status--saved';
          return true;
        })
        .catch(function (error) {
          saveStatus.textContent = 'Draft save failed';
          saveStatus.className = 'save-status save-status--error';
          console.error('Failed to save exam draft:', error);
          return false;
        })
        .then(function (saved) {
          delete draftSaveInFlight[questionId];
          if (draft.dirty && saved) {
            setTimeout(function () { saveDraft(questionId); }, 0);
          }
          return saved;
        });

        draftSaveInFlight[questionId] = request;
        return request;
      }

      function prepareFinalDraftFields(form) {
        var container = form.querySelector('.exam-draft-submit-fields');
        if (!container) return;
        container.innerHTML = '';

        var draftIndex = 0;
        questions.forEach(function (question) {
          if (question.questionType !== 'free_response') return;
          var draft = responseDrafts[question.questionId];
          if (!draft) return;

          var questionIdInput = document.createElement('input');
          questionIdInput.type = 'hidden';
          questionIdInput.name = 'Drafts[' + draftIndex + '].QuestionId';
          questionIdInput.value = question.questionId;

          var responseTextInput = document.createElement('input');
          responseTextInput.type = 'hidden';
          responseTextInput.name = 'Drafts[' + draftIndex + '].ResponseText';
          responseTextInput.value = draft.text;

          container.appendChild(questionIdInput);
          container.appendChild(responseTextInput);
          draftIndex++;
        });
      }

      function updateNavigationForPhase() {
        var phase = phases[activePhaseIndex];
        var isListening = phase && phase.skillCode === 'LIST';
        var isReading = phase && phase.skillCode === 'READ';
        var currentQuestion = questionMap[currentDisplayOrder];
        var currentPhaseQuestions = phase ? phase.questions : [];
        var currentPhaseQuestionIndex = currentPhaseQuestions.findIndex(function (question) {
          return question.displayOrder === currentDisplayOrder;
        });
        var isAudioDriven = currentQuestion && (currentQuestion.navigationMode === 'AUDIO_DRIVEN');
        var isUnitLockedSandbox = currentQuestion && (currentQuestion.navigationMode === 'UNIT_LOCKED_SANDBOX');

        document.querySelectorAll('#navigator-grid .navigator__cell[data-question-id]').forEach(function (cell) {
          var question = questions.find(function (item) {
            return item.questionId === Number(cell.getAttribute('data-question-id'));
          });
          var samePhase = question && phase && question.skillCode === phase.skillCode;
          var answer = question ? localAnswers[question.questionId] : null;
          var isUnitLocked = isUnitLockedSandbox && question && (question.unitNumber || 1) !== activeUnitNumber;
          var isBackInAudio = isAudioDriven && question && question.displayOrder < currentDisplayOrder;

          cell.hidden = !!(flaggedOnly && (!answer || !answer.isFlagged)) || isUnitLocked;
          cell.disabled = !samePhase || (isListening && question.displayOrder !== currentDisplayOrder) || isBackInAudio || isUnitLocked;
        });

        // Update bottom palette chips
        document.querySelectorAll('#bottom-palette-chips .palette-chip').forEach(function (chip) {
          var order = Number(chip.getAttribute('data-display-order'));
          var question = questionMap[order];
          var samePhase = question && phase && question.skillCode === phase.skillCode;
          var isUnitLocked = isUnitLockedSandbox && question && (question.unitNumber || 1) !== activeUnitNumber;
          var isBackInAudio = isAudioDriven && order < currentDisplayOrder;

          chip.hidden = isUnitLocked;
          chip.disabled = !samePhase || isBackInAudio || isUnitLocked;
          if (isBackInAudio || isUnitLocked) {
            chip.classList.add('palette-chip--disabled');
          } else {
            chip.classList.remove('palette-chip--disabled');
          }
        });

        if (flaggedFilterButton) {
          flaggedFilterButton.disabled = !isReading && !isUnitLockedSandbox;
          flaggedFilterButton.textContent = flaggedOnly ? 'Show all questions' : 'Show flagged';
          flaggedFilterButton.setAttribute('aria-pressed', flaggedOnly ? 'true' : 'false');
        }

        if (btnOpenReviewScreen) {
          btnOpenReviewScreen.style.display = (isReading || isUnitLockedSandbox) ? 'inline-block' : 'none';
        }

        if (btnPrev) {
          var isOneWay = isAudioDriven || isListening;
          var prevQ = currentPhaseQuestionIndex > 0 ? currentPhaseQuestions[currentPhaseQuestionIndex - 1] : null;
          var isGroupLockedPrev = currentQuestion && currentQuestion.navigationMode === 'HYBRID_GROUP_LOCKED' && prevQ && prevQ.groupId !== currentQuestion.groupId;
          btnPrev.disabled = !phase
            || isOneWay
            || isGroupLockedPrev
            || currentPhaseQuestionIndex <= 0
            || getQuestionPhaseIndex(currentQuestion) !== activePhaseIndex;
          if (isAudioDriven || isSystemPacedAuto(currentQuestion)) {
            btnPrev.style.display = 'none';
          } else {
            btnPrev.style.display = '';
          }
        }

        if (btnNext && currentQuestion && isSystemPacedAuto(currentQuestion)) {
          btnNext.style.display = 'none';
        } else if (btnNext && phase && currentQuestion) {
          var lastInPhase = currentPhaseQuestionIndex === currentPhaseQuestions.length - 1;
          var isFinalQuestion = currentDisplayOrder === totalQuestions;

          // Check if on final question of Unit 1 in UNIT_LOCKED_SANDBOX
          var unit1Questions = currentPhaseQuestions.filter(function (q) { return (q.unitNumber || 1) === 1; });
          var isLastInUnit1 = isUnitLockedSandbox && activeUnitNumber === 1 && unit1Questions.length > 0 &&
            currentQuestion.questionId === unit1Questions[unit1Questions.length - 1].questionId;

          if (isLastInUnit1) {
            btnNext.textContent = 'Hoàn thành Giai đoạn 1 (Finish Unit 1)';
            btnNext.className = 'btn btn--primary js-open-unit-lock-modal';
            btnNext.disabled = false;
          } else if (isFinalQuestion) {
            btnNext.textContent = 'Review & Submit exam';
            btnNext.className = 'btn btn--danger js-open-submit-modal';
            btnNext.disabled = false;
          } else if (lastInPhase) {
            btnNext.textContent = 'Next phase starts when time expires';
            btnNext.className = 'btn';
            btnNext.disabled = true;
          } else {
            btnNext.textContent = 'Next question';
            btnNext.className = 'btn btn--primary';
            btnNext.disabled = false;
          }
        }
      }

      // Accessibility & Volume Initialization
      function initAccessibility() {
        var savedSize = localStorage.getItem('ee_exam_font_size') || 'standard';
        var savedTheme = localStorage.getItem('ee_exam_theme') || 'standard';

        function applySize(size) {
          document.body.classList.remove('font-size-standard', 'font-size-large', 'font-size-xlarge');
          document.body.classList.add('font-size-' + size);
          localStorage.setItem('ee_exam_font_size', size);
          document.querySelectorAll('.js-font-size-btn').forEach(function (b) {
            b.classList.toggle('btn--primary', b.getAttribute('data-size') === size);
          });
        }

        function applyTheme(theme) {
          document.body.setAttribute('data-theme', theme);
          localStorage.setItem('ee_exam_theme', theme);
          document.querySelectorAll('.js-theme-btn').forEach(function (b) {
            b.classList.toggle('btn--primary', b.getAttribute('data-theme') === theme);
          });
        }

        applySize(savedSize);
        applyTheme(savedTheme);

        document.querySelectorAll('.js-font-size-btn').forEach(function (b) {
          b.addEventListener('click', function () {
            applySize(b.getAttribute('data-size'));
          });
        });

        document.querySelectorAll('.js-theme-btn').forEach(function (b) {
          b.addEventListener('click', function () {
            applyTheme(b.getAttribute('data-theme'));
          });
        });

        var btnOpen = document.getElementById('btn-open-accessibility-modal');
        var btnClose = document.getElementById('btn-close-accessibility-modal');
        var accModal = document.getElementById('accessibility-modal');
        if (btnOpen && accModal) {
          btnOpen.addEventListener('click', function () {
            accModal.style.display = 'flex';
          });
        }
        if (btnClose && accModal) {
          btnClose.addEventListener('click', function () {
            accModal.style.display = 'none';
          });
        }
      }

      function initVolume() {
        var slider = document.getElementById('exam-volume-slider');
        var pct = document.getElementById('exam-volume-pct');
        var savedVol = localStorage.getItem('ee_exam_volume');
        var vol = savedVol !== null ? parseFloat(savedVol) : 1.0;

        if (slider) {
          slider.value = vol;
          if (pct) pct.textContent = Math.round(vol * 100) + '%';
          slider.addEventListener('input', function () {
            var currentVol = parseFloat(slider.value);
            if (pct) pct.textContent = Math.round(currentVol * 100) + '%';
            document.querySelectorAll('audio').forEach(function (a) {
              a.volume = currentVol;
            });
            localStorage.setItem('ee_exam_volume', currentVol.toString());
          });
        }
      }

      // Tokenized Text Highlighter & Notes Engine
      var candidateNotes = [];
      try {
        candidateNotes = JSON.parse(candidateNotesJson || '[]');
        if (!Array.isArray(candidateNotes)) candidateNotes = [];
      } catch (e) {
        candidateNotes = [];
      }

      var currentSelectionMeta = null;
      var highlighterPopover = document.getElementById('highlighter-popover');
      var stickyNoteModal = document.getElementById('sticky-note-modal');
      var stickyNoteInput = document.getElementById('sticky-note-input');
      var stickyNoteQuote = document.getElementById('sticky-note-quote');
      var btnSaveNote = document.getElementById('btn-save-note');
      var btnCancelNote = document.getElementById('btn-cancel-note');
      var componentContainer = document.getElementById('component-widget-container');

      function parseToolsConfig(jsonStr) {
        if (!jsonStr) return {};
        try {
          return JSON.parse(jsonStr);
        } catch (e) {
          return {};
        }
      }

      function renderTokenizedText(container, rawText, sectionId, questionId, targetType) {
        if (!container) return;
        if (!rawText) {
          container.innerHTML = '';
          return;
        }
        var words = rawText.split(/\s+/).filter(Boolean);
        var html = '';
        words.forEach(function (word, idx) {
          html += '<span class="ee-token" data-token-idx="' + idx + '" data-section-id="' + sectionId + '" data-question-id="' + questionId + '" data-target="' + targetType + '">' + escapeHtml(word) + '</span> ';
        });
        container.innerHTML = html;
        applyHighlightsForTarget(container, sectionId, targetType);
      }

      function applyHighlightsForTarget(container, sectionId, targetType) {
        if (!container) return;
        var tokens = container.querySelectorAll('.ee-token');
        tokens.forEach(function (tok) {
          tok.classList.remove('ee-token--highlighted');
          var existingPin = tok.querySelector('.ee-note-pin');
          if (existingPin) existingPin.remove();
        });

        candidateNotes.forEach(function (note) {
          if (note.target === targetType && (String(note.sectionId) === String(sectionId) || !note.sectionId)) {
            for (var i = note.startToken; i <= note.endToken; i++) {
              var tokenEl = container.querySelector('.ee-token[data-token-idx="' + i + '"]');
              if (tokenEl) {
                tokenEl.classList.add('ee-token--highlighted');
                if (i === note.endToken && note.note && note.note.trim()) {
                  var pin = document.createElement('span');
                  pin.className = 'ee-note-pin';
                  pin.textContent = 'ðŸ“';
                  pin.title = note.note;
                  (function (savedNote) {
                    pin.addEventListener('click', function (e) {
                      e.stopPropagation();
                      alert('Ghi chÃº (Note): ' + savedNote);
                    });
                  })(note.note);
                  tokenEl.appendChild(pin);
                }
              }
            }
          }
        });
      }

      function applyAllHighlights() {
        var curQ = questionMap[currentDisplayOrder];
        if (!curQ) return;
        var splitPassage = document.getElementById('split-passage-text');
        var standardPassage = document.getElementById('passage-text');
        if (splitPassage && splitPassage.offsetParent !== null) {
          applyHighlightsForTarget(splitPassage, curQ.sectionId, 'passage');
        } else if (standardPassage) {
          applyHighlightsForTarget(standardPassage, curQ.sectionId, 'passage');
        }
        if (questionStemDisplay) {
          applyHighlightsForTarget(questionStemDisplay, curQ.sectionId, 'stem');
        }
      }

      function addHighlight(meta, noteText) {
        var hl = {
          id: 'hl_' + Date.now() + '_' + Math.random().toString(36).substr(2, 4),
          sectionId: meta.sectionId,
          questionId: meta.questionId,
          target: meta.target,
          startToken: meta.startToken,
          endToken: meta.endToken,
          text: meta.text,
          note: noteText || ''
        };
        candidateNotes.push(hl);
        candidateNotesJson = JSON.stringify(candidateNotes);
        applyAllHighlights();
        scheduleSync(false);
      }

      function removeHighlight(meta) {
        candidateNotes = candidateNotes.filter(function (h) {
          var sameTarget = h.target === meta.target && String(h.sectionId) === String(meta.sectionId);
          var overlaps = !(h.endToken < meta.startToken || h.startToken > meta.endToken);
          return !(sameTarget && overlaps);
        });
        candidateNotesJson = JSON.stringify(candidateNotes);
        applyAllHighlights();
        scheduleSync(false);
      }

      function handleHighlighterSelection(e) {
        var sel = window.getSelection();
        if (!sel || sel.isCollapsed || sel.rangeCount === 0) {
          if (highlighterPopover && !highlighterPopover.contains(e.target)) {
            highlighterPopover.style.display = 'none';
          }
          return;
        }

        var range = sel.getRangeAt(0);
        var container = range.commonAncestorContainer;
        if (container.nodeType === 3) container = container.parentElement;
        var tokenizedContainer = container.closest('.ee-tokenized-text');
        if (!tokenizedContainer) {
          if (highlighterPopover) highlighterPopover.style.display = 'none';
          return;
        }

        var tokensInContainer = Array.from(tokenizedContainer.querySelectorAll('.ee-token'));
        var selectedTokens = tokensInContainer.filter(function (tok) {
          return sel.containsNode(tok, true);
        });

        if (selectedTokens.length === 0) {
          if (highlighterPopover) highlighterPopover.style.display = 'none';
          return;
        }

        var startIdx = parseInt(selectedTokens[0].getAttribute('data-token-idx'), 10);
        var endIdx = parseInt(selectedTokens[selectedTokens.length - 1].getAttribute('data-token-idx'), 10);
        var secId = selectedTokens[0].getAttribute('data-section-id');
        var qId = selectedTokens[0].getAttribute('data-question-id');
        var target = selectedTokens[0].getAttribute('data-target');

        currentSelectionMeta = {
          sectionId: secId,
          questionId: qId,
          target: target,
          startToken: Math.min(startIdx, endIdx),
          endToken: Math.max(startIdx, endIdx),
          text: sel.toString().trim()
        };

        var rect = range.getBoundingClientRect();
        if (highlighterPopover) {
          highlighterPopover.style.left = (rect.left + window.scrollX) + 'px';
          highlighterPopover.style.top = (rect.top + window.scrollY - 40) + 'px';
          highlighterPopover.style.display = 'flex';
        }
      }

      document.addEventListener('mouseup', handleHighlighterSelection);

      document.querySelectorAll('.js-hl-action').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (!currentSelectionMeta) return;
          var action = btn.getAttribute('data-action');
          if (action === 'highlight') {
            addHighlight(currentSelectionMeta, '');
            if (highlighterPopover) highlighterPopover.style.display = 'none';
            window.getSelection()?.removeAllRanges();
          } else if (action === 'note') {
            if (stickyNoteModal && stickyNoteQuote && stickyNoteInput) {
              stickyNoteQuote.textContent = '"' + currentSelectionMeta.text + '"';
              stickyNoteInput.value = '';
              stickyNoteModal.style.display = 'flex';
              stickyNoteInput.focus();
            }
            if (highlighterPopover) highlighterPopover.style.display = 'none';
          } else if (action === 'clear') {
            removeHighlight(currentSelectionMeta);
            if (highlighterPopover) highlighterPopover.style.display = 'none';
            window.getSelection()?.removeAllRanges();
          }
        });
      });

      if (btnSaveNote) {
        btnSaveNote.addEventListener('click', function () {
          if (currentSelectionMeta && stickyNoteInput) {
            var noteText = stickyNoteInput.value.trim();
            addHighlight(currentSelectionMeta, noteText);
            stickyNoteModal.style.display = 'none';
            window.getSelection()?.removeAllRanges();
          }
        });
      }
      if (btnCancelNote) {
        btnCancelNote.addEventListener('click', function () {
          stickyNoteModal.style.display = 'none';
        });
      }

      // 11 Interactive Question Component Widgets
      function renderComponentWidget(q) {
        if (!componentContainer) return;
        var isPacedAuto = isSystemPacedAuto(q);
        var pacerContainer = document.getElementById('speaking-pacer-container');
        var verificationScreen = document.getElementById('speaking-verification-screen');
        if (verificationScreen) verificationScreen.style.display = 'none';

        if (isPacedAuto) {
          if (optionList) optionList.style.display = 'none';
          if (writingPane) writingPane.style.display = 'none';
          if (freeResponseContainer) freeResponseContainer.style.display = 'none';
          if (btnPrev) btnPrev.style.display = 'none';
          if (btnNext) btnNext.style.display = 'none';
          if (pacerContainer) pacerContainer.style.display = 'block';
          startSpeakingPacerStateMachine(q);
        } else {
          if (pacerContainer) pacerContainer.style.display = 'none';
          cleanupSpeakingPacer();
        }

