@model ExamTakeViewModel
@{
    Layout = null;
    var take = Model.Display;
    var q = take.Question;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@take.ExamName — Question @q.DisplayOrder — extra efficient</title>
  <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="~/css/tokens.css">
  <link rel="stylesheet" href="~/css/base.css">
  <link rel="stylesheet" href="~/css/components.css">
  <link rel="stylesheet" href="~/css/exams/take.css" asp-append-version="true">
</head>
<body class="exam-body-protected">
  <div class="app-shell">
    <partial name="_TakeTopbar" model="Model" />

    <main class="app-main">
      <div class="container exam-sitting-container" style="max-width: 1200px">
        <form id="anti-forgery-holder" style="display:none;">@Html.AntiForgeryToken()</form>

        <script id="exam-data" type="application/json">@Html.Raw(take.QuestionsJson)</script>
        <script id="phase-data" type="application/json">@Html.Raw(take.PhasesJson)</script>
        <script id="sitting-data" type="application/json">@Html.Raw(take.SittingJson)</script>

        @if (Model.HasErrorMessage)
        {
          <div class="alert alert--danger mb-4" role="alert">@Model.ErrorMessage</div>
        }

        <!-- Offline Network Warning Banner -->
        <div id="network-warning" class="alert alert--danger mb-4" style="display:none; border: 2px solid #b31217; border-radius: 0; box-shadow: none; font-family: 'IBM Plex Sans', sans-serif;" role="alert">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <strong style="font-family: 'IBM Plex Sans Condensed', sans-serif; text-transform: uppercase; color: #b31217; font-size: 1rem;">
              CONNECTION OFFLINE:
            </strong>
            <span>Your answers are safely saved locally. The system will automatically sync as soon as connection is restored.</span>
          </div>
        </div>

        <section id="phase-progress" class="phase-progress" aria-label="Exam phases">
          @foreach (var phase in take.Phases)
          {
            <div class="phase-progress__item" data-phase-skill="@phase.SkillCode" aria-current="@phase.CurrentStep">
              <strong>@phase.SkillName</strong>
              <span class="phase-progress__timer" data-phase-timer="@phase.SkillCode">--:--</span>
            </div>
          }
        </section>

        <div class="exam-layout" id="exam-main-layout">
          <partial name="_TakeStimulus" model="Model" />
          <partial name="_TakeQuestion" model="Model" />
          <partial name="_TakeSidebar" model="Model" />
        </div>
      </div>
    </main>
  </div>

  <partial name="_TakeModals" model="Model" />
  <partial name="_TakePalette" model="Model" />
  <script src="~/js/icons.js"></script>
  <script src="~/js/ee-audio.js"></script>
  <script src="~/js/exam-audio.js"></script>
  <script src="~/js/keyboard-nav.js"></script>
  <script src="~/js/exams/context.js" asp-append-version="true"></script>
  <script src="~/js/exams/phases.js" asp-append-version="true"></script>
  <script src="~/js/exams/audio.js" asp-append-version="true"></script>
  <script src="~/js/exams/speaking.js" asp-append-version="true"></script>
  <script src="~/js/exams/writing.js" asp-append-version="true"></script>
  <script src="~/js/exams/accessibility.js" asp-append-version="true"></script>
  <script src="~/js/exams/annotations.js" asp-append-version="true"></script>
  <script src="~/js/exams/widgets.js" asp-append-version="true"></script>
  <script src="~/js/exams/navigation.js" asp-append-version="true"></script>
  <script src="~/js/exams/sync.js" asp-append-version="true"></script>
  <script src="~/js/exams/review.js" asp-append-version="true"></script>
  <script src="~/js/exams/submission.js" asp-append-version="true"></script>
  <script src="~/js/exams/shell.js" asp-append-version="true"></script>
</body>
</html>
