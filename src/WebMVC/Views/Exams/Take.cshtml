        flaggedFilterButton.addEventListener('click', function () {
          if (flaggedFilterButton.disabled) return;
          flaggedOnly = !flaggedOnly;
          updateNavigationForPhase();
        });
      }

      // 4. Progress Stats Updater
      function updateProgressStats() {
        var answered = 0;
        var flagged = 0;
        questions.forEach(function (q) {
          var a = localAnswers[q.questionId];
          var draft = responseDrafts[q.questionId];
          var hasResponse = q.questionType === 'free_response'
            ? !!((draft && draft.text.trim()) ||
                (a && ((a.responseText || '').trim() || a.responseAudioPath)))
            : !!(a && a.selectedOptionId !== null && a.selectedOptionId !== undefined);
          if (hasResponse) answered++;
          if (a && a.isFlagged) flagged++;

          var cell = document.getElementById('nav-cell-' + q.questionId);
          if (cell) {
            cell.classList.toggle('is-answered', !!hasResponse);
            cell.classList.toggle('is-unanswered', !hasResponse);
          }
        });
        var unanswered = totalQuestions - answered;
        var pct = Math.round((answered / Math.max(1, totalQuestions)) * 100);

        var progressText = document.getElementById('progress-text');
        var progressBar = document.getElementById('progress-bar');
        var flaggedText = document.getElementById('sidebar-flagged-count');
        var unansweredText = document.getElementById('sidebar-unanswered-count');

        if (progressText) progressText.textContent = answered + '/' + totalQuestions + ' answered';
        if (progressBar) progressBar.style.width = pct + '%';
        if (flaggedText) flaggedText.textContent = flagged;
        if (unansweredText) unansweredText.textContent = unanswered;

        // Modal counters
        var mAns = document.getElementById('modal-stat-answered');
        var mFlag = document.getElementById('modal-stat-flagged');
        var mUnans = document.getElementById('modal-stat-unanswered');
        var mUnansCount = document.getElementById('modal-unanswered-count');
        var mUnansWarn = document.getElementById('modal-unanswered-warning');
        var mAllAns = document.getElementById('modal-all-answered');

        if (mAns) mAns.textContent = answered;
        if (mFlag) mFlag.textContent = flagged;
        if (mUnans) mUnans.textContent = unanswered;
        if (mUnansCount) mUnansCount.textContent = unanswered;
        if (mUnansWarn) mUnansWarn.style.display = (unanswered > 0) ? 'block' : 'none';
        if (mAllAns) mAllAns.style.display = (unanswered <= 0) ? 'block' : 'none';
      }

      // 5. Debounced Auto-Sync & LocalStorage Recovery Seam
      var syncDebounceTimer = null;

      function scheduleSync(immediate) {
        if (syncDebounceTimer) {
          clearTimeout(syncDebounceTimer);
          syncDebounceTimer = null;
        }
        if (immediate) {
          triggerSync();
        } else {
          syncDebounceTimer = setTimeout(triggerSync, 500);
        }
      }

      function triggerFlush() {
        scheduleSync(true);
      }

      function triggerSync() {
        if (isFlushing || pendingQueue.length === 0) {
          if (pendingQueue.length === 0) {
            saveStatus.textContent = 'Saved';
            saveStatus.className = 'save-status save-status--saved';
            var submitQueueMsg = document.getElementById('modal-sync-pending');
            var submitNowBtn = document.getElementById('btn-modal-submit-now');
            if (submitQueueMsg) submitQueueMsg.style.display = 'none';
            if (submitNowBtn) submitNowBtn.disabled = false;
          }
          return;
        }

        isFlushing = true;
        saveStatus.textContent = 'Saving…';
        saveStatus.className = 'save-status save-status--saving';

        var syncItems = pendingQueue.slice();
        var payload = {
          answers: syncItems.map(function (item) {
            return {
              questionId: item.questionId,
              selectedOptionId: (item.selectedOptionId !== null && item.selectedOptionId !== undefined) ? item.selectedOptionId : null,
              selectedOptionIdsJson: item.selectedOptionIdsJson || null,
              responseText: item.responseText || null,
              isFlagged: !!item.isFlagged
            };
          }),
          lastAudioOffsetMs: currentAudioOffsetMs,
          candidateNotesJson: candidateNotesJson || null,
          lastQuestionId: (questionMap[currentDisplayOrder] ? questionMap[currentDisplayOrder].questionId : null)
        };

        fetch('/exams/attempts/' + attemptId + '/sync', {
          method: 'POST',
          keepalive: true,
          headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': csrfToken,
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        })
        .then(function (res) {
          if (!res.ok) {
            return res.json().then(function (err) { throw err; });
          }
          return res.json();
        })
        .then(function (data) {
          isFlushing = false;
          if (data.isAutoSubmitted && data.redirectUrl) {
            isSubmitting = true;
            timesUpModal.style.display = 'flex';
            window.location.href = data.redirectUrl;
            return;
          }

          if (typeof data.remainingSeconds === 'number') {
            expiresAt = Date.now() + (data.remainingSeconds * 1000);
          }

          var syncedQIds = syncItems.map(function (x) { return x.questionId; });
          pendingQueue = pendingQueue.filter(function (x) { return syncedQIds.indexOf(x.questionId) === -1; });
          try {
            localStorage.setItem(storageKey, JSON.stringify(pendingQueue));
          } catch (e) {}

          var networkWarning = document.getElementById('network-warning');
          if (networkWarning) networkWarning.style.display = 'none';

          if (pendingQueue.length > 0) {
            scheduleSync(false);
          } else {
            saveStatus.textContent = 'Saved';
            saveStatus.className = 'save-status save-status--saved';
            var submitQueueMsg = document.getElementById('modal-sync-pending');
            var submitNowBtn = document.getElementById('btn-modal-submit-now');
            if (submitQueueMsg) submitQueueMsg.style.display = 'none';
            if (submitNowBtn) submitNowBtn.disabled = false;
          }
        })
        .catch(function (err) {
          isFlushing = false;
          if (err && err.code === 'attempt_expired') {
            isSubmitting = true;
            timesUpModal.style.display = 'flex';
            window.location.href = '/exams/result/' + attemptId;
            return;
          }

          var networkWarning = document.getElementById('network-warning');
          if (networkWarning) networkWarning.style.display = 'block';

          saveStatus.textContent = 'Sync offline · Đã lưu tạm';
          saveStatus.className = 'save-status save-status--error';

          setTimeout(function () {
            scheduleSync(true);
          }, 4000);
        });
      }

      function saveAnswer(questionId, selectedOptionId, flagged, responseText, selectedOptionIdsJson) {
        // Immediate in-memory registration
        var previousAnswer = localAnswers[questionId] || {};
        localAnswers[questionId] = {
          selectedOptionId: selectedOptionId,
          selectedOptionIdsJson: typeof selectedOptionIdsJson === 'string' ? selectedOptionIdsJson : (previousAnswer.selectedOptionIdsJson || null),
          isFlagged: flagged,
          responseText: typeof responseText === 'string' ? responseText : (previousAnswer.responseText || ''),
          responseAudioPath: previousAnswer.responseAudioPath || null,
          responseDurationMs: previousAnswer.responseDurationMs || null
        };

        // Immediate Navigator cell UI reflection
        var cell = document.getElementById('nav-cell-' + questionId);
        if (cell) {
          var isAnswered = (selectedOptionId !== null && selectedOptionId !== undefined)
            || (localAnswers[questionId].responseText.trim().length > 0)
            || (localAnswers[questionId].selectedOptionIdsJson != null && localAnswers[questionId].selectedOptionIdsJson.length > 2)
            || !!localAnswers[questionId].responseAudioPath;
          if (isAnswered) {
            cell.classList.add('is-answered');
            cell.classList.remove('is-unanswered');
          } else {
            cell.classList.remove('is-answered');
            cell.classList.add('is-unanswered');
          }
          if (flagged) {
            cell.classList.add('is-marked');
          } else {
            cell.classList.remove('is-marked');
          }
        }

        updateProgressStats();

        // Enqueue save job (debouncing redundant requests for same question)
        pendingQueue = pendingQueue.filter(function (job) { return job.questionId !== questionId; });
        pendingQueue.push({
          questionId: questionId,
          selectedOptionId: selectedOptionId,
          selectedOptionIdsJson: localAnswers[questionId].selectedOptionIdsJson,
          responseText: localAnswers[questionId].responseText,
          isFlagged: flagged,
          retryCount: 0
        });

        try {
          localStorage.setItem(storageKey, JSON.stringify(pendingQueue));
        } catch (e) {}

        scheduleSync(false); // 500ms debounce
      }

      // 6. Navigation Event Listeners
      if (btnPrev) {
        btnPrev.addEventListener('click', function () {
          var currentQ = questionMap[currentDisplayOrder];
          if (currentQ && currentQ.clusterSize === 3) {
            var clusterQs = questions.filter(function (item) {
              return (currentQ.groupId && item.groupId === currentQ.groupId) ||
                (item.sectionId === currentQ.sectionId && Math.floor((item.displayOrder - 1) / 3) === Math.floor((currentQ.displayOrder - 1) / 3));
            });
            if (clusterQs.length > 0) {
              goToQuestion(clusterQs[0].displayOrder - 1);
              return;
            }
          }
          goToQuestion(currentDisplayOrder - 1);
        });
      }

      if (btnNext) {
        btnNext.addEventListener('click', function () {
          if (btnNext.classList.contains('js-open-unit-lock-modal')) {
            openUnitLockModal();
            return;
          }
          if (currentDisplayOrder >= totalQuestions) {
            openSubmitModal();
            return;
          }
          var currentQ = questionMap[currentDisplayOrder];
          var nextQ = questionMap[currentDisplayOrder + 1];
          if (currentQ && nextQ && currentQ.navigationMode === 'HYBRID_GROUP_LOCKED' && currentQ.groupId !== nextQ.groupId) {
            var cfg = parseToolsConfig(currentQ.toolsConfigJson);
            if (cfg.confirmOnNext !== false) {
              openGroupLockModal(nextQ.groupId, currentDisplayOrder + 1);
              return;
            }
          }
          var currentQ = questionMap[currentDisplayOrder];
          if (currentQ && currentQ.clusterSize === 3) {
            var clusterQs = questions.filter(function (item) {
              return (currentQ.groupId && item.groupId === currentQ.groupId) ||
                (item.sectionId === currentQ.sectionId && Math.floor((item.displayOrder - 1) / 3) === Math.floor((currentQ.displayOrder - 1) / 3));
            });
            if (clusterQs.length > 0) {
              goToQuestion(clusterQs[clusterQs.length - 1].displayOrder + 1);
              return;
            }
          }
          goToQuestion(currentDisplayOrder + 1);
        });
      }

      // 7. Reading Review Screen Modal & Multi-Stage Adaptive CAT Routing
      function openReviewScreenModal() {
        if (!reviewScreenModal) return;
        updateReviewScreenStats();
        renderReviewQuestions('all');
        if (reviewUnitTransitionContainer) {
          var currentQ = questionMap[currentDisplayOrder];
          var isUnitLockedSandbox = currentQ && currentQ.navigationMode === 'UNIT_LOCKED_SANDBOX';
          reviewUnitTransitionContainer.style.display = (isUnitLockedSandbox && activeUnitNumber === 1) ? 'block' : 'none';
        }
        reviewScreenModal.style.display = 'flex';
      }

      function closeReviewScreenModal() {
        if (reviewScreenModal) reviewScreenModal.style.display = 'none';
      }

      function updateReviewScreenStats() {
        var phase = phases[activePhaseIndex];
        var phaseQs = phase ? phase.questions : questions;
        var currentQ = questionMap[currentDisplayOrder];
        if (currentQ && currentQ.navigationMode === 'UNIT_LOCKED_SANDBOX') {
          phaseQs = phaseQs.filter(function (q) { return (q.unitNumber || 1) === activeUnitNumber; });
        }
        var answered = 0;
        var flagged = 0;
        phaseQs.forEach(function (q) {
          var a = localAnswers[q.questionId];
          var hasResponse = (a && a.selectedOptionId !== null && a.selectedOptionId !== undefined)
            || (a && ((a.responseText || '').trim().length > 0 || a.responseAudioPath));
          if (hasResponse) answered++;
          if (a && a.isFlagged) flagged++;
        });
        var unanswered = phaseQs.length - answered;
        if (reviewStatAnswered) reviewStatAnswered.textContent = answered;
        if (reviewStatFlagged) reviewStatFlagged.textContent = flagged;
        if (reviewStatUnanswered) reviewStatUnanswered.textContent = unanswered;
      }

      function renderReviewQuestions(filterMode) {
        if (!reviewQuestionsList) return;
        var phase = phases[activePhaseIndex];
        var phaseQs = phase ? phase.questions : questions;
        var currentQ = questionMap[currentDisplayOrder];
        if (currentQ && currentQ.navigationMode === 'UNIT_LOCKED_SANDBOX') {
          phaseQs = phaseQs.filter(function (q) { return (q.unitNumber || 1) === activeUnitNumber; });
        }

        var filtered = phaseQs;
        if (filterMode === 'unanswered') {
          filtered = phaseQs.filter(function (q) {
            var a = localAnswers[q.questionId];
            return !a || (a.selectedOptionId === null && (!a.responseText || !a.responseText.trim()) && !a.responseAudioPath);
          });
        } else if (filterMode === 'flagged') {
          filtered = phaseQs.filter(function (q) {
            var a = localAnswers[q.questionId];
            return !!(a && a.isFlagged);
          });
        }

        var html = '';
        filtered.forEach(function (q) {
          var a = localAnswers[q.questionId];
          var isAns = (a && a.selectedOptionId !== null && a.selectedOptionId !== undefined)
            || (a && ((a.responseText || '').trim().length > 0 || a.responseAudioPath));
          var isFl = !!(a && a.isFlagged);
          html += '<button type="button" class="review-item-card" data-display-order="' + q.displayOrder + '">';
          html += '<div style="display:flex; justify-content:space-between; align-items:center;">';
          html += '<strong style="font-family:\'IBM Plex Mono\', monospace; font-size:0.9rem;">Q' + q.displayOrder + '</strong>';
          if (isFl) {
            html += '<span class="badge" style="background:#f2b705; color:#14181d; font-size:0.7rem; font-weight:700;">🚩 FLAGGED</span>';
          }
          html += '</div>';
          html += '<span style="font-size:0.75rem; font-family:\'IBM Plex Sans Condensed\', sans-serif; text-transform:uppercase; color:' + (isAns ? '#0a6b3c' : '#b31217') + '; font-weight:700;">' + (isAns ? 'ĐÃ TRẢ LỜI' : 'CHƯA TRẢ LỜI') + '</span>';
          html += '</button>';
        });
        if (filtered.length === 0) {
          html = '<div style="grid-column: 1 / -1; padding: 1.5rem; text-align:center; background:#fff; color:#555;">Không có câu hỏi nào phù hợp với bộ lọc.</div>';
        }
        reviewQuestionsList.innerHTML = html;
      }

      if (btnOpenReviewScreen) {
        btnOpenReviewScreen.addEventListener('click', openReviewScreenModal);
      }
      document.querySelectorAll('.js-close-review-modal').forEach(function (btn) {
        btn.addEventListener('click', closeReviewScreenModal);
      });

      if (reviewQuestionsList) {
        reviewQuestionsList.addEventListener('click', function (e) {
          var card = e.target.closest('.review-item-card');
          if (card) {
            var order = parseInt(card.getAttribute('data-display-order'), 10);
            if (!isNaN(order)) {
              closeReviewScreenModal();
              goToQuestion(order);
            }
          }
        });
      }

      if (btnReviewFirstUnanswered) {
        btnReviewFirstUnanswered.addEventListener('click', function () {
          var phase = phases[activePhaseIndex];
          var phaseQs = phase ? phase.questions : questions;
          var currentQ = questionMap[currentDisplayOrder];
          if (currentQ && currentQ.navigationMode === 'UNIT_LOCKED_SANDBOX') {
            phaseQs = phaseQs.filter(function (q) { return (q.unitNumber || 1) === activeUnitNumber; });
          }
          var firstUnanswered = phaseQs.find(function (q) {
            var a = localAnswers[q.questionId];
            return !a || (a.selectedOptionId === null && (!a.responseText || !a.responseText.trim()) && !a.responseAudioPath);
          });
          if (firstUnanswered) {
            closeReviewScreenModal();
            goToQuestion(firstUnanswered.displayOrder);
          } else {
            alert('Tất cả câu hỏi trong phần này đã được trả lời!');
          }
        });
      }

      if (btnReviewOnlyUnanswered) {
        btnReviewOnlyUnanswered.addEventListener('click', function () {
          renderReviewQuestions('unanswered');
        });
      }

      if (btnReviewOnlyFlagged) {
        btnReviewOnlyFlagged.addEventListener('click', function () {
          renderReviewQuestions('flagged');
        });
      }

      if (btnReviewShowAll) {
        btnReviewShowAll.addEventListener('click', function () {
          renderReviewQuestions('all');
        });
      }

      // Unit Lock Modal handlers
      function openUnitLockModal() {
        closeReviewScreenModal();
        if (unitLockModal) unitLockModal.style.display = 'flex';
      }

      function closeUnitLockModal() {
        if (unitLockModal) unitLockModal.style.display = 'none';
      }

      if (btnReviewFinishUnit) {
        btnReviewFinishUnit.addEventListener('click', openUnitLockModal);
      }

      document.querySelectorAll('.js-close-unit-lock-modal').forEach(function (btn) {
        btn.addEventListener('click', closeUnitLockModal);
      });

      var pendingTargetGroupId = null;
      var pendingTargetDisplayOrder = null;

      function openGroupLockModal(targetGroupId, targetDisplayOrder) {
        pendingTargetGroupId = targetGroupId;
        pendingTargetDisplayOrder = targetDisplayOrder;
        if (groupLockModal) groupLockModal.style.display = 'flex';
      }

      function closeGroupLockModal() {
        pendingTargetGroupId = null;
        pendingTargetDisplayOrder = null;
        if (groupLockModal) groupLockModal.style.display = 'none';
      }

      document.querySelectorAll('.js-close-group-lock-modal').forEach(function (btn) {
        btn.addEventListener('click', closeGroupLockModal);
      });

      if (btnConfirmGroupLock) {
        btnConfirmGroupLock.addEventListener('click', function () {
          if (!pendingTargetGroupId) return;
          btnConfirmGroupLock.disabled = true;
          btnConfirmGroupLock.textContent = 'Đang chuyển...';
          scheduleSync(true);

          fetch('/exams/attempts/' + attemptId + '/transition-group', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'RequestVerificationToken': antiForgeryToken
            },
            body: JSON.stringify({ targetGroupId: pendingTargetGroupId })
          })
          .then(function (res) {
            if (!res.ok) throw new Error('Transition failed');
            return res.json();
          })
          .then(function (data) {
            activeGroupId = data.activeGroupId;
            if (data.remainingSeconds !== undefined) {
              remainingSeconds = data.remainingSeconds;
              if (data.phaseDeadlineAt) {
                phaseDeadlineAt = new Date(data.phaseDeadlineAt).getTime();
              } else {
                phaseDeadlineAt = Date.now() + (remainingSeconds * 1000);
              }
            }
            btnConfirmGroupLock.disabled = false;
            btnConfirmGroupLock.textContent = 'Xác nhận chuyển và khóa (Confirm & Proceed)';
            var nextOrderToNav = pendingTargetDisplayOrder;
            closeGroupLockModal();
            goToQuestion(nextOrderToNav);
          })
          .catch(function (err) {
            btnConfirmGroupLock.disabled = false;
            btnConfirmGroupLock.textContent = 'Xác nhận chuyển và khóa (Confirm & Proceed)';
            alert('Không thể chuyển nhóm câu hỏi: ' + (err.message || 'Lỗi hệ thống'));
          });
        });
      }

      if (writingEditor) {
        writingEditor.addEventListener('keydown', function (e) {
          var currentQ = questionMap[currentDisplayOrder];
          if (isCutPasteRestricted(currentQ)) {
            if ((e.ctrlKey || e.metaKey) && (e.key === 'c' || e.key === 'C' || e.key === 'x' || e.key === 'X' || e.key === 'v' || e.key === 'V')) {
              e.preventDefault();
              e.stopPropagation();
              return false;
            }
          }
        });

        writingEditor.addEventListener('cut', function (e) {
          var currentQ = questionMap[currentDisplayOrder];
          if (isCutPasteRestricted(currentQ)) {
            e.preventDefault();
            e.stopPropagation();
            return false;
          }
        });

        writingEditor.addEventListener('copy', function (e) {
          var currentQ = questionMap[currentDisplayOrder];
          if (isCutPasteRestricted(currentQ)) {
            e.preventDefault();
            e.stopPropagation();
            return false;
          }
        });

        writingEditor.addEventListener('paste', function (e) {
          var currentQ = questionMap[currentDisplayOrder];
          if (isCutPasteRestricted(currentQ)) {
            e.preventDefault();
            e.stopPropagation();
            return false;
          }
        });
      }

      if (btnWritingCut) {
        btnWritingCut.addEventListener('click', function () {
          if (!writingEditor) return;
          var start = writingEditor.selectionStart;
          var end = writingEditor.selectionEnd;
          if (start === end) return;
          pushUndoState();
          internalClipboard = writingEditor.value.substring(start, end);
          writingEditor.value = writingEditor.value.substring(0, start) + writingEditor.value.substring(end);
          writingEditor.selectionStart = writingEditor.selectionEnd = start;
          markDraftDirty(writingEditor.getAttribute('data-question-id'));
          writingEditor.focus();
        });
      }

      if (btnWritingPaste) {
        btnWritingPaste.addEventListener('click', function () {
          if (!writingEditor || !internalClipboard) return;
          var start = writingEditor.selectionStart;
          var end = writingEditor.selectionEnd;
          pushUndoState();
          writingEditor.value = writingEditor.value.substring(0, start) + internalClipboard + writingEditor.value.substring(end);
          writingEditor.selectionStart = writingEditor.selectionEnd = start + internalClipboard.length;
          markDraftDirty(writingEditor.getAttribute('data-question-id'));
          writingEditor.focus();
        });
      }

      if (btnWritingUndo) {
        btnWritingUndo.addEventListener('click', function () {
          if (!writingEditor || undoStack.length === 0) return;
          isTrackingUndo = false;
          redoStack.push(writingEditor.value);
          var prev = undoStack.pop();
          writingEditor.value = prev;
          isTrackingUndo = true;
          markDraftDirty(writingEditor.getAttribute('data-question-id'));
          writingEditor.focus();
        });
      }

      if (btnWritingRedo) {
        btnWritingRedo.addEventListener('click', function () {
          if (!writingEditor || redoStack.length === 0) return;
          isTrackingUndo = false;
          undoStack.push(writingEditor.value);
          var next = redoStack.pop();
          writingEditor.value = next;
          isTrackingUndo = true;
          markDraftDirty(writingEditor.getAttribute('data-question-id'));
          writingEditor.focus();
        });
      }

      if (btnConfirmUnitLock) {
        btnConfirmUnitLock.addEventListener('click', function () {
          btnConfirmUnitLock.disabled = true;
          btnConfirmUnitLock.textContent = 'Đang khóa Giai đoạn 1...';
          scheduleSync(true);

          fetch('/exams/attempts/' + attemptId + '/transition-unit', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'RequestVerificationToken': csrfToken
            },
            body: JSON.stringify({ targetUnitNumber: 2 })
          })
          .then(function (res) {
            if (!res.ok) {
              return fetch('/exams/take/' + attemptId + '/transition/unit', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'RequestVerificationToken': csrfToken
                },
                body: JSON.stringify({ targetUnitNumber: 2 })
              });
            }
            return res;
          })
          .then(function (res) {
            if (!res.ok) throw new Error('Transition failed');
            return res.json();
          })
          .then(function (data) {
            window.location.href = '/exams/take/' + attemptId;
          })
          .catch(function (err) {
            console.error('Unit transition error:', err);
            alert('Không thể chuyển giai đoạn. Vui lòng thử lại.');
            btnConfirmUnitLock.disabled = false;
            btnConfirmUnitLock.textContent = 'Xác nhận khóa và tiếp tục (Confirm & Proceed)';
          });
        });
      }

      // Bottom question palette click handler
      var paletteChipsTrack = document.getElementById('bottom-palette-chips');
      if (paletteChipsTrack) {
        paletteChipsTrack.addEventListener('click', function (e) {
          var targetChip = e.target.closest('.palette-chip');
          if (targetChip && !targetChip.disabled && !targetChip.classList.contains('palette-chip--disabled')) {
            if (isSystemPacedAuto(questionMap[currentDisplayOrder])) return;
            var targetOrder = parseInt(targetChip.getAttribute('data-display-order'), 10);
            if (!isNaN(targetOrder)) {
              var currentQ = questionMap[currentDisplayOrder];
              var isOneWay = currentQ && currentQ.navigationMode === 'AUDIO_DRIVEN';
              if (isOneWay && targetOrder < currentDisplayOrder) return;
              goToQuestion(targetOrder);
            }
          }
        });
      }

      // Navigator grid cells click handler
      var navGrid = document.getElementById('navigator-grid');
      if (navGrid) {
        navGrid.addEventListener('click', function (e) {
          var targetCell = e.target.closest('.navigator__cell');
          if (targetCell) {
            if (isSystemPacedAuto(questionMap[currentDisplayOrder])) return;
            var targetOrder = parseInt(targetCell.getAttribute('data-display-order'), 10);
            if (!isNaN(targetOrder)) {
              goToQuestion(targetOrder);
            }
          }
        });
      }

      // Flag toggle button
      if (flagBtn) {
        flagBtn.addEventListener('click', function () {
          var currentQ = questionMap[currentDisplayOrder];
          if (!currentQ) return;
          var curFlagged = !!(localAnswers[currentQ.questionId] && localAnswers[currentQ.questionId].isFlagged);
          var newFlagged = !curFlagged;

          flagBtn.setAttribute('data-flagged', newFlagged ? 'true' : 'false');
          flagBtn.setAttribute('aria-pressed', newFlagged ? 'true' : 'false');
          flagBtn.textContent = newFlagged ? 'Flagged for review' : 'Flag for review';
          if (newFlagged) {
            flagBtn.classList.add('btn--primary');
          } else {
            flagBtn.classList.remove('btn--primary');
          }

          var curSelected = localAnswers[currentQ.questionId] ? localAnswers[currentQ.questionId].selectedOptionId : null;
          saveAnswer(currentQ.questionId, curSelected, newFlagged);
        });
      }

      // Initial option change listeners
      var initialRadios = optionList.querySelectorAll('.js-option-radio');
      initialRadios.forEach(function (radio) {
        radio.addEventListener('change', function () {
          var currentQ = questionMap[currentDisplayOrder];
          if (!currentQ) return;
          var val = parseInt(this.value, 10);
          optionList.querySelectorAll('.option').forEach(function (lbl) { lbl.classList.remove('is-selected'); });
          var parentLabel = radio.closest('.option');
          if (parentLabel) parentLabel.classList.add('is-selected');
          saveAnswer(currentQ.questionId, val, !!(localAnswers[currentQ.questionId] && localAnswers[currentQ.questionId].isFlagged));
        });
      });

      // 7. Exam Timer Loop
      function updateTimer() {
        var now = Date.now();
        renderPhaseProgress(now);
        var diff = Math.max(0, Math.floor((expiresAt - now) / 1000));

        var hours = Math.floor(diff / 3600);
        var minutes = Math.floor((diff % 3600) / 60);
        var seconds = diff % 60;

        var hStr = hours < 10 ? '0' + hours : '' + hours;
        var mStr = minutes < 10 ? '0' + minutes : '' + minutes;
        var sStr = seconds < 10 ? '0' + seconds : '' + seconds;

        timerDisplay.textContent = hStr + ':' + mStr + ':' + sStr;

        if (diff <= 300 && diff > 60) {
          timerBox.className = 'timer timer--warning';
        } else if (diff <= 60) {
          timerBox.className = 'timer timer--critical';
        }

        if (diff <= 0) {
          timerDisplay.textContent = '00:00:00';
          timerBox.className = 'timer timer--critical';
          if (!isSubmitting) {
            isSubmitting = true;
            timesUpModal.style.display = 'flex';
            setTimeout(function () {
              if (window.stopExamAudio) window.stopExamAudio();
              prepareFinalDraftFields(autoSubmitForm);
              try {
                localStorage.removeItem(storageKey);
                localStorage.removeItem(audioStorageKey);
              } catch (err) {}
              autoSubmitForm.submit();
            }, 1000);
          }
        }
      }

      updateTimer();
      setInterval(updateTimer, 1000);

      // 8. Exam Integrity Guards & Non-Happy Paths

      // History Trap: Intercept browser Back navigation and display Exit modal
      window.history.pushState({ page: 'exam-shell', q: currentDisplayOrder }, '', window.location.href);
      window.addEventListener('popstate', function () {
        window.history.pushState({ page: 'exam-shell', q: currentDisplayOrder }, '', window.location.href);
        exitModal.style.display = 'flex';
      });

      // Accidental tab close / refresh protection
      window.addEventListener('beforeunload', function (e) {
        if (!isSubmitting) {
          e.preventDefault();
          e.returnValue = 'Your exam attempt is currently in progress. Leaving may cause unsaved responses to be lost.';
          return e.returnValue;
        }
      });

      // Disable Context Menu (Right Click)
      document.addEventListener('contextmenu', function (e) {
        e.preventDefault();
      });

      // Disable Destructive Keyboard Shortcuts (F5, Ctrl+R, Ctrl+U, F12, Ctrl+Shift+I)
      document.addEventListener('keydown', function (e) {
        if (e.key === 'F5' || (e.ctrlKey && (e.key === 'r' || e.key === 'R'))) {
          e.preventDefault();
          return;
        }
        if ((e.ctrlKey && (e.key === 'u' || e.key === 'U')) ||
            e.key === 'F12' ||
            (e.ctrlKey && e.shiftKey && (e.key === 'i' || e.key === 'I'))) {
          e.preventDefault();
          return;
        }
      });

      // Tab Switching / Focus Loss Monitoring
      var tabSwitchCount = 0;
      var integrityWarning = document.getElementById('integrity-warning');
      var integrityCount = document.getElementById('integrity-count');

      document.addEventListener('visibilitychange', function () {
        if (document.hidden && !isSubmitting) {
          tabSwitchCount++;
          if (integrityWarning) {
            integrityWarning.style.display = 'block';
            if (integrityCount) integrityCount.textContent = tabSwitchCount;
          }
        }
      });

      // Online / Offline Detection
      var networkWarning = document.getElementById('network-warning');
      window.addEventListener('online', function () {
        if (networkWarning) networkWarning.style.display = 'none';
        scheduleSync(true);
      });

      window.addEventListener('offline', function () {
        if (networkWarning) networkWarning.style.display = 'block';
        saveStatus.textContent = 'Offline · Đã lưu tạm';
        saveStatus.className = 'save-status save-status--error';
      });

      // 9. Modals Management
      function openSubmitModal() {
        if (isSpeakingPreparing || isSpeakingRecording || isAudioUploading) {
          saveStatus.textContent = isAudioUploading
            ? 'Wait for the recording to finish uploading before submitting.'
            : (isSpeakingPreparing ? 'Wait for preparation to finish before submitting.' : 'Stop and save the recording before submitting.');
          saveStatus.className = 'save-status save-status--error';
          return;
        }
        updateProgressStats();
        var submitQueueMsg = document.getElementById('modal-sync-pending');
        var submitNowBtn = document.getElementById('btn-modal-submit-now');
        if (pendingQueue.length > 0) {
          if (submitQueueMsg) submitQueueMsg.style.display = 'block';
          if (submitNowBtn) submitNowBtn.disabled = true;
        } else {
          if (submitQueueMsg) submitQueueMsg.style.display = 'none';
          if (submitNowBtn) submitNowBtn.disabled = false;
        }
        submitModal.style.display = 'flex';
      }

      var openSubmitBtns = document.querySelectorAll('.js-open-submit-modal');
      var closeSubmitBtns = document.querySelectorAll('.js-close-submit-modal');
      openSubmitBtns.forEach(function (btn) {
        btn.addEventListener('click', openSubmitModal);
      });
      closeSubmitBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          submitModal.style.display = 'none';
        });
      });

      var openExitBtn = document.getElementById('btn-open-exit-modal');
      var closeExitBtns = document.querySelectorAll('.js-close-exit-modal');
      if (openExitBtn) {
        openExitBtn.addEventListener('click', function () {
          exitModal.style.display = 'flex';
        });
      }
      closeExitBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          exitModal.style.display = 'none';
        });
      });

      window.addEventListener('click', function (e) {
        if (e.target === submitModal) submitModal.style.display = 'none';
        if (e.target === exitModal) exitModal.style.display = 'none';
      });

      // Form submission cleans up storage buffer
      if (submitExamForm) {
        submitExamForm.addEventListener('submit', function (e) {
          if (isSubmitting) return;
          if (isSpeakingPreparing || isSpeakingRecording || isAudioUploading) {
            e.preventDefault();
            saveStatus.textContent = isAudioUploading
              ? 'Wait for the recording to finish uploading before submitting.'
              : (isSpeakingPreparing ? 'Wait for preparation to finish before submitting.' : 'Stop and save the recording before submitting.');
            saveStatus.className = 'save-status save-status--error';
            return;
          }
          e.preventDefault();
          prepareFinalDraftFields(submitExamForm);

          function submitWhenAnswersAreSynced() {
            if (pendingQueue.length === 0 && !isFlushing) {
              if (window.stopExamAudio) window.stopExamAudio();
              isSubmitting = true;
              try {
                localStorage.removeItem(storageKey);
                localStorage.removeItem(audioStorageKey);
              } catch (err) {}
              submitExamForm.submit();
              return;
            }
            if (Date.now() >= expiresAt) return;
            if (Date.now() >= expiresAt) return;
            var submitQueueMsg = document.getElementById('modal-sync-pending');
            if (submitQueueMsg) submitQueueMsg.style.display = 'block';
            triggerFlush();
            setTimeout(submitWhenAnswersAreSynced, 100);
          }

          if (pendingQueue.length > 0 || isFlushing) {
            var submitNowBtn = document.getElementById('btn-modal-submit-now');
            if (submitNowBtn) submitNowBtn.disabled = true;
          }
          submitWhenAnswersAreSynced();
        });
      }

      if (autoSubmitForm) {
        autoSubmitForm.addEventListener('submit', function () {
          if (window.stopExamAudio) window.stopExamAudio();
          isSubmitting = true;
          try {
            localStorage.removeItem(storageKey);
            localStorage.removeItem(audioStorageKey);
          } catch (err) {}
        });
      }

      if (cancelExamForm) {
        cancelExamForm.addEventListener('submit', function () {
          if (window.stopExamAudio) window.stopExamAudio();
          isSubmitting = true;
          try {
            localStorage.removeItem(storageKey);
            localStorage.removeItem(audioStorageKey);
          } catch (err) {}
        });
      }

      // Start initial queue flush if uncommitted items restored
      renderQuestion(currentDisplayOrder);
      if (pendingQueue.length > 0) {
        triggerFlush();
      }
      renderPhaseProgress(Date.now());
      var initialQuestion = questionMap[currentDisplayOrder];
      if (initialQuestion && initialQuestion.questionType === 'free_response') {
        updateWritingCounters(initialQuestion);
      }
    })();
  </script>
</body>
</html>
