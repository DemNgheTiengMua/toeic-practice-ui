      function goToQuestion(targetOrder) {
        if (targetOrder < 1 || targetOrder > totalQuestions) return;
        if (isSpeakingPreparing || isSpeakingRecording || isAudioUploading) {
          saveStatus.textContent = isAudioUploading
            ? 'Wait for the recording to finish uploading.'
            : (isSpeakingPreparing ? 'Wait for preparation to finish before changing questions.' : 'Stop the recording before changing questions.');
          saveStatus.className = 'save-status save-status--error';
          return;
        }

        if (isSystemPacedAuto(currentQuestion)) {
          // Manual navigation disabled during automated speaking flow
          return;
        }
                var targetQuestion = questionMap[targetOrder];
        var phase = phases[activePhaseIndex];
        var currentQuestion = questionMap[currentDisplayOrder];
        if (!targetQuestion || !phase || targetQuestion.skillCode !== phase.skillCode) return;
        var isOneWay = currentQuestion && (currentQuestion.navigationMode === 'AUDIO_DRIVEN');
        if (isOneWay && targetOrder < currentDisplayOrder) return;
        if (currentQuestion && currentQuestion.navigationMode === 'HYBRID_GROUP_LOCKED') {
          if (activeGroupId && targetQuestion.groupId !== activeGroupId) return;
        }
        if (isOneWay && phase.skillCode === 'LIST' && targetOrder < currentDisplayOrder) return;

        // Strict Unit Locked Sandbox routing
        if (targetQuestion.navigationMode === 'UNIT_LOCKED_SANDBOX') {
          var targetUnit = targetQuestion.unitNumber || 1;
          if (targetUnit !== activeUnitNumber) return;
        }
        var currentDraft = currentQuestion && responseDrafts[currentQuestion.questionId];
        if (currentQuestion && currentQuestion.questionType === 'free_response' && currentDraft && currentDraft.dirty) {
          saveDraft(currentQuestion.questionId);
        }
        renderQuestion(targetOrder);
      }

