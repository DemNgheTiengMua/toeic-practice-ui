@model ExamTakeViewModel
@{
    Layout = null;
    var take = Model.Take;
    var q = take.CurrentQuestion;
    var questions = take.Questions ?? new List<AttemptQuestionDto> { q };
    var prevOrder = q.DisplayOrder > 1 ? q.DisplayOrder - 1 : (int?)null;
    var nextOrder = q.DisplayOrder < take.TotalQuestions ? q.DisplayOrder + 1 : (int?)null;
    var isLastQuestion = q.DisplayOrder >= take.TotalQuestions;
    var progressPercent = (int)Math.Round((double)take.AnsweredCount / Math.Max(1, take.TotalQuestions) * 100);
    var hasListening = questions.Any(item => item.Modality == ModalityDto.Listening);
    var hasSpeaking = questions.Any(item => item.Modality == ModalityDto.Speaking);
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@take.ExamName — Question @q.DisplayOrder — extra efficient</title>
  <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="~/css/tokens.css">
  <link rel="stylesheet" href="~/css/base.css">
  <link rel="stylesheet" href="~/css/components.css">
</head>
<body class="exam-body-protected">
  <div class="app-shell">
    <header class="app-topbar">
      <div class="exam-topbar-group">
        <strong>@take.ExamName</strong>
        <span class="badge badge--info" id="topbar-section-badge">@q.SkillName · @q.SectionName</span>
      </div>
      <div class="exam-topbar-group">
        <span id="save-status" class="save-status save-status--saved" role="status" aria-live="polite">Saved</span>
        <span id="timer-box" class="timer" role="timer" aria-label="Time remaining">
          <span class="text-sm text-muted">Time remaining</span>
          <span id="timer-display" class="timer__value">--:--:--</span>
        </span>
        @if (hasListening || hasSpeaking)
        {
          @await Html.PartialAsync("_AudioEmergencySwitcher", new AudioEquipmentCheckModel(
              ShowInput: hasSpeaking,
              ShowOutput: hasListening))
        }
        <button type="button" class="btn btn--ghost btn--sm" id="btn-open-exit-modal">Exit</button>
      </div>
    </header>

    <main class="app-main">
      <div class="container" style="max-width: 1200px">
        <form id="anti-forgery-holder" style="display:none;">@Html.AntiForgeryToken()</form>

        <script id="exam-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(questions, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))</script>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
          <div class="alert alert--danger mb-4" role="alert">@Model.ErrorMessage</div>
        }

        <!-- Exam Integrity & Disciplinary Warning Banner -->
        <div id="integrity-warning" class="alert alert--warning mb-4" style="display:none;" role="alert">
          <strong>Warning:</strong> Tab switching or leaving the exam screen detected (<span id="integrity-count">0</span> time(s)). This activity is recorded in the exam audit trail.
        </div>

        <!-- Offline Network Warning Banner -->
        <div id="network-warning" class="alert alert--danger mb-4" style="display:none;" role="alert">
          <strong>Connection offline:</strong> Network lost. Your answers are buffered safely on this device and will automatically sync when reconnected.
        </div>

        <div class="exam-layout">
          <!-- Question Content Pane (Exam Shell Swap Target) -->
          <div class="stack" id="question-pane">
            <!-- Audio Player Container -->
            <div id="exam-audio-wrapper" class="mb-3" style="@(!string.IsNullOrEmpty(q.AudioPath) ? "" : "display:none;")">
              @if (!string.IsNullOrEmpty(q.AudioPath))
              {
                @await Html.PartialAsync("_ExamAudioPlayer", new ExamAudioPlayerModel(
                    AudioPath: q.AudioPath,
                    AllowReplay: false,
                    SectionTitle: "Listening Audio",
                    BadgeText: "READY",
                    StartMs: q.AudioStartMs,
                    EndMs: q.AudioEndMs,
                    PlayerId: "main-exam-audio",
                    Mode: "exam"
                ))
              }
            </div>
            @await Html.PartialAsync("_ExamAudioPlayer", new ExamAudioPlayerModel(
                AudioPath: string.Empty,
                Mode: "exam",
                TemplateOnly: true
            ))

            <!-- Passage Card Container -->
            <div id="passage-card" class="card mb-3" style="@(!string.IsNullOrEmpty(q.Passage) ? "" : "display:none;")">
              <div class="card__body">
                <p id="passage-text" class="no-margin passage">@q.Passage</p>
              </div>
            </div>

            <!-- Image Container -->
            <div id="image-container" class="mb-3" style="@(!string.IsNullOrEmpty(q.ImagePath) ? "" : "display:none;")">
              <img id="question-image" src="@q.ImagePath" alt="@(q.ImageAlt ?? "Question illustration")" class="question__image" />
            </div>

            <div class="question" id="question-card">
              <div class="question__meta row row--between">
                <div class="row row--tight">
                  <span class="question__number" id="question-number-display">Question @q.DisplayOrder</span>
                  <span class="badge badge--muted" id="question-section-display">@q.SectionName</span>
                </div>
                <div>
                  <button type="button" class="btn btn--ghost btn--sm @(q.IsFlagged ? "btn--primary" : "")" id="flag-btn"
                          aria-pressed="@(q.IsFlagged ? "true" : "false")"
                          data-flagged="@(q.IsFlagged ? "true" : "false")">
                    @(q.IsFlagged ? "Flagged for review" : "Flag for review")
                  </button>
                </div>
              </div>

              <p class="question__stem" id="question-stem-display">
                @q.Stem
              </p>

              <div class="option-list" id="option-list" role="radiogroup" aria-label="Answer for question @q.DisplayOrder">
                @foreach (var opt in q.Options)
                {
                  var isSelected = opt.OptionId == q.SelectedOptionId;
                  <label class="option @(isSelected ? "is-selected" : "")">
                    <input class="option__input js-option-radio" type="radio" name="selectedOptionId"
                           value="@opt.OptionId" @(isSelected ? "checked" : "")>
                    <span class="option__marker">@opt.Label</span>
                    <span class="option__text">@opt.Text</span>
                  </label>
                }
              </div>
              <div id="free-response-container" class="stack" style="display:none; margin-top: 1rem;"></div>
            </div>

            <!-- Bottom Question Navigation Row -->
            <div class="row row--between mt-4" style="align-items: center;">
              <div>
                <button type="button" class="btn" id="btn-prev" @(prevOrder.HasValue ? "" : "disabled")>Previous</button>
              </div>

              <div class="row" style="gap: var(--space-3);">
                <button type="button" class="btn btn--primary" id="btn-next">@(isLastQuestion ? "Review & Submit exam" : "Next question")</button>
              </div>
            </div>
          </div>

          <!-- Sidebar Navigator (Exam Shell Persistent) -->
          <aside class="exam-sidebar stack">
            <div class="card">
              <div class="card__header">
                <div class="row row--between">
                  <strong class="text-sm">Exam Progress</strong>
                  <span class="text-xs text-muted" id="progress-text">@take.AnsweredCount/@take.TotalQuestions answered</span>
                </div>
              </div>
              <div class="card__body stack">
                <div class="progress" role="progressbar" aria-valuenow="@take.AnsweredCount" aria-valuemin="0" aria-valuemax="@take.TotalQuestions">
                  <div class="progress__bar" id="progress-bar" style="width: @progressPercent%"></div>
                </div>
                <div class="row row--between text-xs text-muted">
                  <span>Flagged: <strong id="sidebar-flagged-count">@take.FlaggedCount</strong></span>
                  <span>Unanswered: <strong id="sidebar-unanswered-count">@(take.TotalQuestions - take.AnsweredCount)</strong></span>
                </div>
              </div>
            </div>

            <div class="card">
              <div class="card__header">
                <strong class="text-sm">Questions (1–@take.TotalQuestions)</strong>
              </div>
              <div class="card__body stack">
                <div class="navigator__grid" role="group" aria-label="Question Navigator" id="navigator-grid">
                  @foreach (var item in take.Navigator)
                  {
                    var statusClass = item.IsAnswered ? "is-answered" : "is-unanswered";
                    var markClass = item.IsFlagged ? "is-marked" : "";
                    var currentClass = item.IsCurrent ? "is-current" : "";
                    <button type="button"
                       class="navigator__cell @statusClass @markClass @currentClass"
                       id="nav-cell-@item.QuestionId"
                       data-question-id="@item.QuestionId"
                       data-display-order="@item.DisplayOrder"
                       title="Question @item.DisplayOrder@(item.IsAnswered ? " · Answered" : " · Unanswered")@(item.IsFlagged ? " · Flagged" : "")">
                      @item.DisplayOrder
                    </button>
                  }
                </div>

                <div class="text-xs stack mt-2" style="gap: var(--space-1)">
                  <div class="row" style="align-items: center; gap: var(--space-2);">
                    <span class="navigator__cell navigator__cell--swatch is-answered" aria-hidden="true">1</span> Answered
                  </div>
                  <div class="row" style="align-items: center; gap: var(--space-2);">
                    <span class="navigator__cell navigator__cell--swatch is-marked" aria-hidden="true">2</span> Flagged for review
                  </div>
                  <div class="row" style="align-items: center; gap: var(--space-2);">
                    <span class="navigator__cell navigator__cell--swatch is-unanswered" aria-hidden="true">3</span> Unanswered
                  </div>
                </div>
              </div>
            </div>

            <button type="button" class="btn btn--danger js-open-submit-modal" id="btn-sidebar-submit" style="width: 100%;">
              Submit exam
            </button>
          </aside>
        </div>
      </div>
    </main>
  </div>

  <!-- Submit Confirmation Modal -->
  <div id="submit-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="submit-modal-title">
    <div class="modal">
      <div class="modal__header">
        <h2 id="submit-modal-title" class="no-margin">Submit exam?</h2>
      </div>
      <div class="modal__body stack">
        <div id="modal-sync-pending" class="alert alert--info" style="display:none;">
          <strong>Synchronizing latest answers…</strong> Please wait a moment while your answers are being recorded on the server.
        </div>

        <div id="modal-unanswered-warning" class="alert alert--warning" style="@(take.AnsweredCount < take.TotalQuestions ? "" : "display:none;")">
          <strong>You have <span id="modal-unanswered-count">@(take.TotalQuestions - take.AnsweredCount)</span> unanswered questions.</strong>
          Unanswered questions count as incorrect, and answers cannot be changed after you submit.
        </div>
        <div id="modal-all-answered" class="alert alert--success" style="@(take.AnsweredCount >= take.TotalQuestions ? "" : "display:none;")">
          <strong>All @take.TotalQuestions questions have been answered.</strong>
          Answers cannot be changed after you submit.
        </div>

        <div class="grid-3">
          <div class="stat">
            <div class="stat__label">Answered</div>
            <div class="stat__value" id="modal-stat-answered">@take.AnsweredCount</div>
          </div>
          <div class="stat">
            <div class="stat__label">Flagged</div>
            <div class="stat__value" id="modal-stat-flagged">@take.FlaggedCount</div>
          </div>
          <div class="stat">
            <div class="stat__label">Unanswered</div>
            <div class="stat__value" id="modal-stat-unanswered">@(take.TotalQuestions - take.AnsweredCount)</div>
          </div>
        </div>

        <p class="text-sm text-muted no-margin">
          Once submitted, your responses will be scored and your scaled band computed immediately.
        </p>
      </div>
      <div class="modal__footer">
        <button type="button" class="btn js-close-submit-modal">Go back and continue</button>
        <form method="post" action="/exams/take/@take.AttemptId/submit" id="submit-exam-form" style="display:inline;">
          @Html.AntiForgeryToken()
          <button type="submit" class="btn btn--danger" id="btn-modal-submit-now">Submit now</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Exit / Cancel Modal -->
  <div id="exit-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="exit-modal-title">
    <div class="modal">
      <div class="modal__header">
        <h2 id="exit-modal-title" class="no-margin">Exit or Cancel Exam?</h2>
      </div>
      <div class="modal__body stack">
        <div class="alert alert--danger">
          <strong>Cancelling abandons the exam and forfeits your 1 credit.</strong>
          An abandoned attempt will not be scored and will not appear in your completed tests.
        </div>
        <p class="text-sm text-muted no-margin">
          You can exit back to the test list to resume later before the countdown expires.
        </p>
      </div>
      <div class="modal__footer">
        <button type="button" class="btn js-close-exit-modal">Stay on test</button>
        <a class="btn" href="/exams">Exit (resume later)</a>
        <form method="post" action="/exams/take/@take.AttemptId/cancel" id="cancel-exam-form" style="display:inline;">
          @Html.AntiForgeryToken()
          <button type="submit" class="btn btn--danger">Cancel & abandon (lose credit)</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Time's Up Auto-Submit Modal -->
  <div id="times-up-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="times-up-title">
    <div class="modal">
      <div class="modal__header">
        <h2 id="times-up-title" class="no-margin">Time is up</h2>
      </div>
      <div class="modal__body stack">
        <div class="alert alert--warning">
          <strong>Your exam deadline has expired.</strong>
          The exam is being submitted automatically and scored on the questions you answered.
        </div>
        <div class="progress mx-auto" style="max-width: 280px">
          <div class="progress__bar" style="width: 100%"></div>
        </div>
      </div>
    </div>
  </div>

  <form id="auto-submit-form" method="post" action="/exams/take/@take.AttemptId/submit" style="display:none;">
    @Html.AntiForgeryToken()
  </form>

  <script src="~/js/icons.js"></script>
  <script src="~/js/ee-audio.js"></script>
  <script src="~/js/exam-audio.js"></script>
  <script src="~/js/keyboard-nav.js"></script>
  <script>
    (function () {
      "use strict";

      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      // 1. Data Model & Initialization
      var examDataEl = document.getElementById('exam-data');
      var questions = [];
      try {
        questions = JSON.parse(examDataEl ? examDataEl.textContent : '[]');
      } catch (e) {
        console.error('Failed to parse exam payload:', e);
      }

      var attemptId = @take.AttemptId;
      var totalQuestions = questions.length || @take.TotalQuestions;
      var currentDisplayOrder = @q.DisplayOrder;
      var expiresAt = @take.ExpiresAt.ToUnixTimeMilliseconds();
      var csrfToken = document.querySelector('#anti-forgery-holder input[name="__RequestVerificationToken"]').value;

      var questionMap = {};
      questions.forEach(function (q) {
        questionMap[q.displayOrder] = q;
      });

      // Local Answer & State Registry (optimistic in-memory cache)
      var localAnswers = {};
      questions.forEach(function (q) {
        localAnswers[q.questionId] = {
          selectedOptionId: q.selectedOptionId,
          isFlagged: q.isFlagged,
          responseText: q.responseText || '',
          responseAudioPath: q.responseAudioPath || null,
          responseDurationMs: q.responseDurationMs || null
        };
      });

      // Restore uncommitted answers from localStorage backup if present
      var storageKey = 'ee_exam_pending_' + attemptId;
      var pendingQueue = [];
      try {
        var rawStored = localStorage.getItem(storageKey);
        if (rawStored) {
          var parsed = JSON.parse(rawStored);
          if (Array.isArray(parsed) && parsed.length > 0) {
            pendingQueue = parsed;
            pendingQueue.forEach(function (item) {
              if (localAnswers[item.questionId]) {
                localAnswers[item.questionId].selectedOptionId = item.selectedOptionId;
                localAnswers[item.questionId].isFlagged = item.isFlagged;
                if (typeof item.responseText === 'string') {
                  localAnswers[item.questionId].responseText = item.responseText;
                }
              }
            });
          }
        }
      } catch (e) {
        console.warn('LocalStorage restore error:', e);
      }

      // UI Elements
      var saveStatus = document.getElementById('save-status');
      var timerDisplay = document.getElementById('timer-display');
      var timerBox = document.getElementById('timer-box');
      var topbarBadge = document.getElementById('topbar-section-badge');
      var flagBtn = document.getElementById('flag-btn');
      var btnPrev = document.getElementById('btn-prev');
      var btnNext = document.getElementById('btn-next');
      var optionList = document.getElementById('option-list');
      var freeResponseContainer = document.getElementById('free-response-container');
      var passageCard = document.getElementById('passage-card');
      var passageText = document.getElementById('passage-text');
      var imageContainer = document.getElementById('image-container');
      var questionImage = document.getElementById('question-image');
      var questionNumberDisplay = document.getElementById('question-number-display');
      var questionSectionDisplay = document.getElementById('question-section-display');
      var questionStemDisplay = document.getElementById('question-stem-display');
      var audioWrapper = document.getElementById('exam-audio-wrapper');

      var submitModal = document.getElementById('submit-modal');
      var exitModal = document.getElementById('exit-modal');
      var timesUpModal = document.getElementById('times-up-modal');
      var autoSubmitForm = document.getElementById('auto-submit-form');
      var submitExamForm = document.getElementById('submit-exam-form');
      var cancelExamForm = document.getElementById('cancel-exam-form');

      function getQuestionAudioKey(item) {
        if (!item || !item.audioPath || !item.audioPath.trim()) return null;
        var key = item.audioPath.trim();
        if (item.audioStartMs != null || item.audioEndMs != null) {
          key += ':' + (item.audioStartMs || 0) + '-' + (item.audioEndMs || 0);
        }
        return key;
      }

      var currentAudioKey = getQuestionAudioKey(questionMap[currentDisplayOrder]);
      var audioStorageKey = 'ee_exam_audio_' + attemptId;
      var playedAudios = {};
      try {
        var rawStoredAudios = localStorage.getItem(audioStorageKey);
        if (rawStoredAudios) {
          playedAudios = JSON.parse(rawStoredAudios) || {};
        }
      } catch (e) {
        console.warn('Audio storage read error:', e);
      }

      function getAudioProgress(key) {
        if (!key || !playedAudios[key]) return { completed: false, currentTime: 0 };
        var entry = playedAudios[key];
        if (typeof entry === 'boolean') {
          return { completed: entry, currentTime: 0 };
        }
        return {
          completed: !!entry.completed,
          currentTime: Number(entry.currentTime) || 0
        };
      }

      function recordAudioProgress(key, progress) {
        if (!key || !progress) return;
        var existing = getAudioProgress(key);
        var completed = !!(progress.completed || existing.completed);
        var currentTime = Math.max(existing.currentTime, Number(progress.currentTime) || 0);
        playedAudios[key] = {
          completed: completed,
          currentTime: currentTime
        };
        try {
          localStorage.setItem(audioStorageKey, JSON.stringify(playedAudios));
        } catch (e) {}
      }

      // If initial question audio was already completed or listened in this attempt, re-render with saved progress
      var initialProgress = getAudioProgress(currentAudioKey);
      if (currentAudioKey && (initialProgress.completed || initialProgress.currentTime > 0) && audioWrapper && window.createExamAudioHtml) {
        var initialQ = questionMap[currentDisplayOrder] || {
          audioPath: '@Html.Raw(q.AudioPath ?? "")',
          audioStartMs: @(q.AudioStartMs.HasValue ? q.AudioStartMs.Value.ToString() : "null"),
          audioEndMs: @(q.AudioEndMs.HasValue ? q.AudioEndMs.Value.ToString() : "null")
        };
        audioWrapper.innerHTML = window.createExamAudioHtml({
          mode: 'exam',
          audioPath: initialQ.audioPath,
          startMs: initialQ.audioStartMs,
          endMs: initialQ.audioEndMs,
          playerId: 'main-exam-audio',
          completed: initialProgress.completed,
          currentTime: initialProgress.currentTime
        });
        if (window.initExamAudio) window.initExamAudio();
      }

      document.addEventListener('examaudiotimeupdate', function (e) {
        if (currentAudioKey && e.detail) {
          recordAudioProgress(currentAudioKey, {
            currentTime: e.detail.currentTime,
            completed: e.detail.completed
          });
        }
      });

      document.addEventListener('examaudioended', function () {
        if (currentAudioKey) {
          recordAudioProgress(currentAudioKey, {
            completed: true
          });
        }
      });

      var isFlushing = false;
      var isSubmitting = false;
      var activeRecorder = null;
      var activeRecordingStream = null;
      var activeAudioChunks = [];
      var activeAudioTimer = null;
      var prepTimer = null;
      var activeRecordingStartedAt = 0;
      var isSpeakingPreparing = false;
      var isSpeakingRecording = false;
      var isAudioUploading = false;

      function renderFreeResponse(q) {
        var answer = localAnswers[q.questionId] || {};
        var isSpeaking = (q.modality || '').toLowerCase() === 'speaking';
        optionList.style.display = 'none';
        freeResponseContainer.style.display = 'block';

        if (!isSpeaking) {
          var minWords = Number(q.minWords) || 0;
          var maxWords = Number(q.maxWords) || 0;
          freeResponseContainer.innerHTML =
            '<label class="field__label" for="free-response-text">Written response</label>' +
            '<p class="text-sm text-muted">Word limit: ' + minWords + '–' + maxWords + ' words.</p>' +
            '<textarea id="free-response-text" class="field__input" rows="12" maxlength="20000" aria-describedby="free-response-word-count"></textarea>' +
            '<p id="free-response-word-count" class="text-sm text-muted" aria-live="polite"></p>';
          var responseInput = document.getElementById('free-response-text');
          var wordCount = document.getElementById('free-response-word-count');
          responseInput.value = answer.responseText || '';

          function updateWordCount() {
            var trimmed = responseInput.value.trim();
            var count = trimmed ? trimmed.split(/\s+/).length : 0;
            wordCount.textContent = count + ' words' +
              (minWords || maxWords ? ' · required ' + minWords + '–' + maxWords : '');
          }

          responseInput.addEventListener('input', function () {
            updateWordCount();
            saveAnswer(q.questionId, null, !!(localAnswers[q.questionId] && localAnswers[q.questionId].isFlagged), responseInput.value);
          });
          updateWordCount();
          return;
        }

        var existingAudio = answer.responseAudioPath;
        freeResponseContainer.innerHTML =
          '<p class="text-sm">Preparation time: ' + (Number(q.prepSeconds) || 0) + ' seconds · ' +
            'Response time: ' + (Number(q.responseSeconds) || 0) + ' seconds.</p>' +
          '<p id="speaking-recording-status" class="text-sm" aria-live="polite">' +
            (existingAudio ? 'A saved recording is attached. Record again to replace it.' : 'No recording saved yet.') +
          '</p>' +
          '<div class="row" style="gap:.5rem; flex-wrap:wrap;">' +
            '<button type="button" id="speaking-record-start" class="btn btn--primary">Start recording</button>' +
            '<button type="button" id="speaking-record-stop" class="btn" style="display:none;">Stop recording</button>' +
          '</div>';
        var startButton = document.getElementById('speaking-record-start');
        var stopButton = document.getElementById('speaking-record-stop');
        var status = document.getElementById('speaking-recording-status');

        startButton.addEventListener('click', function () {
          startMockSpeakingCapture(q, status, startButton, stopButton);
        });
        stopButton.addEventListener('click', function () {
          stopMockSpeakingCapture();
        });
      }

      async function startMockSpeakingCapture(q, status, startButton, stopButton) {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia || typeof MediaRecorder === 'undefined') {
          status.textContent = 'This browser does not support audio recording.';
          return;
        }

        startButton.disabled = true;
        isSpeakingPreparing = true;
        status.textContent = 'Requesting microphone access…';
        try {
          activeRecordingStream = await navigator.mediaDevices.getUserMedia({ audio: true });
          var prepSeconds = Number(q.prepSeconds) || 0;
          if (prepSeconds > 0) {
            var remainingPrep = prepSeconds;
            status.textContent = 'Preparation time: ' + remainingPrep + ' seconds.';
            await new Promise(function (resolve) {
              prepTimer = window.setInterval(function () {
                remainingPrep--;
                if (remainingPrep <= 0) {
                  window.clearInterval(prepTimer);
                  prepTimer = null;
                  resolve();
                } else {
                  status.textContent = 'Preparation time: ' + remainingPrep + ' seconds.';
                }
              }, 1000);
            });
          }

          isSpeakingPreparing = false;
          activeAudioChunks = [];
          activeRecorder = new MediaRecorder(activeRecordingStream);
          activeRecorder.addEventListener('dataavailable', function (event) {
            if (event.data && event.data.size > 0) activeAudioChunks.push(event.data);
          });
          activeRecorder.addEventListener('stop', function () {
            uploadMockSpeakingRecording(q, status, startButton, stopButton);
          }, { once: true });
          activeRecorder.start();
          activeRecordingStartedAt = Date.now();
          isSpeakingRecording = true;
          startButton.style.display = 'none';
          stopButton.style.display = '';
          status.textContent = 'Recording…';
          var responseSeconds = Number(q.responseSeconds) || 0;
          if (responseSeconds > 0) {
            activeAudioTimer = window.setTimeout(stopMockSpeakingCapture, responseSeconds * 1000);
          }
        } catch (error) {
          isSpeakingPreparing = false;
          if (activeRecordingStream) {
            activeRecordingStream.getTracks().forEach(function (track) { track.stop(); });
            activeRecordingStream = null;
          }
          if (prepTimer) {
            window.clearInterval(prepTimer);
            prepTimer = null;
          }
          startButton.disabled = false;
          status.textContent = 'Microphone access failed. Check browser permissions and try again.';
        }
      }

      function stopMockSpeakingCapture() {
        if (activeAudioTimer) {
          window.clearTimeout(activeAudioTimer);
          activeAudioTimer = null;
        }
        if (prepTimer) {
          window.clearInterval(prepTimer);
          prepTimer = null;
        }
        if (activeRecorder && activeRecorder.state !== 'inactive') {
          activeRecorder.stop();
        }
      }

      async function uploadMockSpeakingRecording(q, status, startButton, stopButton) {
        isSpeakingRecording = false;
        isAudioUploading = true;
        if (activeRecordingStream) {
          activeRecordingStream.getTracks().forEach(function (track) { track.stop(); });
          activeRecordingStream = null;
        }
        stopButton.style.display = 'none';
        status.textContent = 'Uploading recording…';
        var blob = new Blob(activeAudioChunks, { type: activeAudioChunks[0] ? activeAudioChunks[0].type : 'audio/webm' });
        var durationMs = Math.max(1, Date.now() - activeRecordingStartedAt);

        try {
          var tokenInput = document.querySelector('#anti-forgery-holder input[name="__RequestVerificationToken"]');
          var formData = new FormData();
          formData.append('attemptId', attemptId);
          formData.append('questionId', q.questionId);
          formData.append('audioFile', blob, 'recording.webm');
          formData.append('durationMs', durationMs);
          formData.append('__RequestVerificationToken', tokenInput ? tokenInput.value : '');
          var response = await fetch('/speaking/upload-audio', { method: 'POST', body: formData });
          if (!response.ok) {
            throw new Error('Audio upload failed (' + response.status + ').');
          }

          var state = localAnswers[q.questionId] || {};
          state.responseAudioPath = 'saved';
          state.responseDurationMs = durationMs;
          localAnswers[q.questionId] = state;
          status.textContent = 'Recording saved. Record again to replace it.';
          saveAnswer(q.questionId, null, !!state.isFlagged, state.responseText || '');
          updateProgressStats();
        } catch (error) {
          status.textContent = 'Recording could not be saved. Check your connection and record again.';
          startButton.style.display = '';
        } finally {
          isAudioUploading = false;
          startButton.disabled = false;
          activeRecorder = null;
          activeAudioChunks = [];
        }
      }

      // 3. In-Memory 0ms Question Swapping (Exam Shell)
      function renderQuestion(displayOrder) {
        var q = questionMap[displayOrder];
        if (!q) return;

        currentDisplayOrder = displayOrder;

        // Topbar badge & Document title
        if (topbarBadge) topbarBadge.textContent = (q.skillName || '') + ' · ' + (q.sectionName || '');
        document.title = '@take.ExamName — Question ' + q.displayOrder + ' — extra efficient';

        // URL synchronization without history pollution
        window.history.replaceState({ page: 'exam-shell', q: displayOrder }, '', '/exams/take/' + attemptId + '?q=' + displayOrder);

        // Audio continuity & isolation
        var newAudioKey = getQuestionAudioKey(q);

        if (newAudioKey !== currentAudioKey) {
          if (currentAudioKey !== null) {
            var stoppedList = null;
            if (window.stopExamAudio) {
              stoppedList = window.stopExamAudio(audioWrapper);
            }
            var stoppedTime = (stoppedList && stoppedList[0]) ? stoppedList[0].currentTime : 0;
            if (stoppedTime > 0) {
              recordAudioProgress(currentAudioKey, { currentTime: stoppedTime });
            }
          }

          if (newAudioKey) {
            audioWrapper.style.display = 'block';
            var progress = getAudioProgress(newAudioKey);
            audioWrapper.innerHTML = window.createExamAudioHtml({
              mode: 'exam',
              audioPath: q.audioPath,
              startMs: q.audioStartMs,
              endMs: q.audioEndMs,
              playerId: 'main-exam-audio',
              completed: progress.completed,
              currentTime: progress.currentTime
            });
            if (window.initExamAudio) window.initExamAudio();
          } else {
            audioWrapper.style.display = 'none';
            audioWrapper.innerHTML = '';
          }
          currentAudioKey = newAudioKey;
        } else if (newAudioKey) {
          audioWrapper.style.display = 'block';
        }

        // Passage Pane
        if (q.passage && q.passage.trim().length > 0) {
          passageText.textContent = q.passage;
          passageCard.style.display = 'block';
        } else {
          passageCard.style.display = 'none';
        }

        // Image Pane
        if (q.imagePath && q.imagePath.trim().length > 0) {
          questionImage.src = q.imagePath;
          questionImage.alt = q.imageAlt || 'Question illustration';
          imageContainer.style.display = 'block';
        } else {
          imageContainer.style.display = 'none';
        }

        // Question Meta & Stem
        questionNumberDisplay.textContent = 'Question ' + q.displayOrder;
        questionSectionDisplay.textContent = q.sectionName;
        questionStemDisplay.textContent = q.stem;

        // Flag State
        var isFlagged = !!(localAnswers[q.questionId] && localAnswers[q.questionId].isFlagged);
        flagBtn.setAttribute('data-flagged', isFlagged ? 'true' : 'false');
        flagBtn.setAttribute('aria-pressed', isFlagged ? 'true' : 'false');
        flagBtn.textContent = isFlagged ? 'Flagged for review' : 'Flag for review';
        if (isFlagged) {
          flagBtn.classList.add('btn--primary');
        } else {
          flagBtn.classList.remove('btn--primary');
        }

        // Options List (Instant render, no entrance animation)
        var selectedOptId = localAnswers[q.questionId] ? localAnswers[q.questionId].selectedOptionId : null;
        var isFreeResponse = (q.questionType || '').toLowerCase() === 'free_response';
        optionList.setAttribute('aria-label', 'Answer for question ' + q.displayOrder);
        var optionsHtml = '';
        (q.options || []).forEach(function (opt) {
          var isSelected = opt.optionId === selectedOptId;
          optionsHtml += '<label class="option ' + (isSelected ? 'is-selected' : '') + '">';
          optionsHtml += '<input class="option__input js-option-radio" type="radio" name="selectedOptionId" value="' + opt.optionId + '" ' + (isSelected ? 'checked' : '') + '>';
          optionsHtml += '<span class="option__marker">' + escapeHtml(opt.label) + '</span>';
          optionsHtml += '<span class="option__text">' + escapeHtml(opt.text) + '</span>';
          optionsHtml += '</label>';
        });
        optionList.innerHTML = optionsHtml;
        optionList.style.display = isFreeResponse ? 'none' : '';

        // Rebind radio selection listeners
        var radios = optionList.querySelectorAll('.js-option-radio');
        radios.forEach(function (radio) {
          radio.addEventListener('change', function () {
            var val = parseInt(this.value, 10);
            optionList.querySelectorAll('.option').forEach(function (lbl) { lbl.classList.remove('is-selected'); });
            var parentLabel = radio.closest('.option');
            if (parentLabel) parentLabel.classList.add('is-selected');
            saveAnswer(q.questionId, val, !!(localAnswers[q.questionId] && localAnswers[q.questionId].isFlagged));
          });
        });
        if (isFreeResponse) {
          renderFreeResponse(q);
        } else {
          freeResponseContainer.style.display = 'none';
          freeResponseContainer.innerHTML = '';
        }

        // Previous & Next navigation buttons
        if (btnPrev) {
          btnPrev.disabled = (displayOrder <= 1);
        }
        if (btnNext) {
          if (displayOrder >= totalQuestions) {
            btnNext.textContent = 'Review & Submit exam';
            btnNext.className = 'btn btn--danger js-open-submit-modal';
          } else {
            btnNext.textContent = 'Next question';
            btnNext.className = 'btn btn--primary';
          }
        }

        // Navigator Grid active indicator
        document.querySelectorAll('.navigator__cell').forEach(function (cell) {
          cell.classList.remove('is-current');
        });
        var activeCell = document.getElementById('nav-cell-' + q.questionId);
        if (activeCell) {
          activeCell.classList.add('is-current');
        }

        window.scrollTo({ top: 0, behavior: 'instant' });
      }

      function goToQuestion(targetOrder) {
        if (targetOrder < 1 || targetOrder > totalQuestions) return;
        if (isSpeakingPreparing || isSpeakingRecording || isAudioUploading) {
          saveStatus.textContent = isAudioUploading
            ? 'Wait for the recording to finish uploading.'
            : (isSpeakingPreparing ? 'Wait for preparation to finish before changing questions.' : 'Stop the recording before changing questions.');
          saveStatus.className = 'save-status save-status--error';
          return;
        }
        renderQuestion(targetOrder);
      }

      // 4. Progress Stats Updater
      function updateProgressStats() {
        var answered = 0;
        var flagged = 0;
        questions.forEach(function (q) {
          var a = localAnswers[q.questionId];
          if (a && (
            (a.selectedOptionId !== null && a.selectedOptionId !== undefined) ||
            (typeof a.responseText === 'string' && a.responseText.trim().length > 0) ||
            !!a.responseAudioPath
          )) answered++;
          if (a && a.isFlagged) flagged++;
        });
        var unanswered = totalQuestions - answered;
        var pct = Math.round((answered / Math.max(1, totalQuestions)) * 100);

        var progressText = document.getElementById('progress-text');
        var progressBar = document.getElementById('progress-bar');
        var flaggedText = document.getElementById('sidebar-flagged-count');
        var unansweredText = document.getElementById('sidebar-unanswered-count');

        if (progressText) progressText.textContent = answered + '/' + totalQuestions + ' answered';
        if (progressBar) progressBar.style.width = pct + '%';
        if (flaggedText) flaggedText.textContent = flagged;
        if (unansweredText) unansweredText.textContent = unanswered;

        // Modal counters
        var mAns = document.getElementById('modal-stat-answered');
        var mFlag = document.getElementById('modal-stat-flagged');
        var mUnans = document.getElementById('modal-stat-unanswered');
        var mUnansCount = document.getElementById('modal-unanswered-count');
        var mUnansWarn = document.getElementById('modal-unanswered-warning');
        var mAllAns = document.getElementById('modal-all-answered');

        if (mAns) mAns.textContent = answered;
        if (mFlag) mFlag.textContent = flagged;
        if (mUnans) mUnans.textContent = unanswered;
        if (mUnansCount) mUnansCount.textContent = unanswered;
        if (mUnansWarn) mUnansWarn.style.display = (unanswered > 0) ? 'block' : 'none';
        if (mAllAns) mAllAns.style.display = (unanswered <= 0) ? 'block' : 'none';
      }

      // 5. Optimistic Answer Queue & Sync
      function triggerFlush() {
        if (isFlushing || pendingQueue.length === 0) {
          if (pendingQueue.length === 0) {
            saveStatus.textContent = 'Saved';
            saveStatus.className = 'save-status save-status--saved';
            var submitQueueMsg = document.getElementById('modal-sync-pending');
            var submitNowBtn = document.getElementById('btn-modal-submit-now');
            if (submitQueueMsg) submitQueueMsg.style.display = 'none';
            if (submitNowBtn) submitNowBtn.disabled = false;
          }
          return;
        }

        isFlushing = true;
        saveStatus.textContent = 'Saving…';
        saveStatus.className = 'save-status save-status--saving';

        var item = pendingQueue[0];
        var body = new URLSearchParams();
        body.append('__RequestVerificationToken', csrfToken);
        if (item.selectedOptionId !== null && item.selectedOptionId !== undefined) {
          body.append('SelectedOptionId', item.selectedOptionId);
        }
        body.append('ResponseText', item.responseText || '');
        body.append('IsFlagged', item.isFlagged ? 'true' : 'false');

        fetch('/exams/take/' + attemptId + '/answers/' + item.questionId, {
          method: 'POST',
          keepalive: true,
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          body: body.toString()
        })
        .then(function (res) {
          if (!res.ok) {
            return res.json().then(function (err) { throw err; });
          }
          return res.json();
        })
        .then(function (data) {
          isFlushing = false;
          if (data.isAutoSubmitted && data.redirectUrl) {
            isSubmitting = true;
            timesUpModal.style.display = 'flex';
            window.location.href = data.redirectUrl;
            return;
          }

          // Anti-Clock-Tampering: calibrate local timer against authoritative server remaining seconds
          if (typeof data.remainingSeconds === 'number') {
            expiresAt = Date.now() + (data.remainingSeconds * 1000);
          }

          // Pop processed job and persist remaining queue to storage
          pendingQueue.shift();
          try {
            localStorage.setItem(storageKey, JSON.stringify(pendingQueue));
          } catch (e) {}

          triggerFlush();
        })
        .catch(function (err) {
          isFlushing = false;
          if (err && err.code === 'attempt_expired') {
            isSubmitting = true;
            timesUpModal.style.display = 'flex';
            window.location.href = '/exams/result/' + attemptId;
            return;
          }

          saveStatus.textContent = 'Sync error · Retrying';
          saveStatus.className = 'save-status save-status--error';

          item.retryCount = (item.retryCount || 0) + 1;
          setTimeout(function () {
            triggerFlush();
          }, Math.min(8000, 1500 * item.retryCount));
        });
      }

      function saveAnswer(questionId, selectedOptionId, flagged, responseText) {
        // Immediate in-memory registration
        var previousAnswer = localAnswers[questionId] || {};
        localAnswers[questionId] = {
          selectedOptionId: selectedOptionId,
          isFlagged: flagged,
          responseText: typeof responseText === 'string' ? responseText : (previousAnswer.responseText || ''),
          responseAudioPath: previousAnswer.responseAudioPath || null,
          responseDurationMs: previousAnswer.responseDurationMs || null
        };

        // Immediate Navigator cell UI reflection
        var cell = document.getElementById('nav-cell-' + questionId);
        if (cell) {
          var isAnswered = (selectedOptionId !== null && selectedOptionId !== undefined)
            || (localAnswers[questionId].responseText.trim().length > 0)
            || !!localAnswers[questionId].responseAudioPath;
          if (isAnswered) {
            cell.classList.add('is-answered');
            cell.classList.remove('is-unanswered');
          } else {
            cell.classList.remove('is-answered');
            cell.classList.add('is-unanswered');
          }
          if (flagged) {
            cell.classList.add('is-marked');
          } else {
            cell.classList.remove('is-marked');
          }
        }

        updateProgressStats();

        // Enqueue save job (debouncing redundant requests for same question)
        pendingQueue = pendingQueue.filter(function (job) { return job.questionId !== questionId; });
        pendingQueue.push({
          questionId: questionId,
          selectedOptionId: selectedOptionId,
          responseText: localAnswers[questionId].responseText,
          isFlagged: flagged,
          retryCount: 0
        });

        try {
          localStorage.setItem(storageKey, JSON.stringify(pendingQueue));
        } catch (e) {}

        triggerFlush();
      }

      // 6. Navigation Event Listeners
      if (btnPrev) {
        btnPrev.addEventListener('click', function () {
          goToQuestion(currentDisplayOrder - 1);
        });
      }

      if (btnNext) {
        btnNext.addEventListener('click', function () {
          if (currentDisplayOrder >= totalQuestions) {
            openSubmitModal();
          } else {
            goToQuestion(currentDisplayOrder + 1);
          }
        });
      }

      // Navigator grid cells click handler
      var navGrid = document.getElementById('navigator-grid');
      if (navGrid) {
        navGrid.addEventListener('click', function (e) {
          var targetCell = e.target.closest('.navigator__cell');
          if (targetCell) {
            var targetOrder = parseInt(targetCell.getAttribute('data-display-order'), 10);
            if (!isNaN(targetOrder)) {
              goToQuestion(targetOrder);
            }
          }
        });
      }

      // Flag toggle button
      if (flagBtn) {
        flagBtn.addEventListener('click', function () {
          var currentQ = questionMap[currentDisplayOrder];
          if (!currentQ) return;
          var curFlagged = !!(localAnswers[currentQ.questionId] && localAnswers[currentQ.questionId].isFlagged);
          var newFlagged = !curFlagged;

          flagBtn.setAttribute('data-flagged', newFlagged ? 'true' : 'false');
          flagBtn.setAttribute('aria-pressed', newFlagged ? 'true' : 'false');
          flagBtn.textContent = newFlagged ? 'Flagged for review' : 'Flag for review';
          if (newFlagged) {
            flagBtn.classList.add('btn--primary');
          } else {
            flagBtn.classList.remove('btn--primary');
          }

          var curSelected = localAnswers[currentQ.questionId] ? localAnswers[currentQ.questionId].selectedOptionId : null;
          saveAnswer(currentQ.questionId, curSelected, newFlagged);
        });
      }

      // Initial option change listeners
      var initialRadios = optionList.querySelectorAll('.js-option-radio');
      initialRadios.forEach(function (radio) {
        radio.addEventListener('change', function () {
          var currentQ = questionMap[currentDisplayOrder];
          if (!currentQ) return;
          var val = parseInt(this.value, 10);
          optionList.querySelectorAll('.option').forEach(function (lbl) { lbl.classList.remove('is-selected'); });
          var parentLabel = radio.closest('.option');
          if (parentLabel) parentLabel.classList.add('is-selected');
          saveAnswer(currentQ.questionId, val, !!(localAnswers[currentQ.questionId] && localAnswers[currentQ.questionId].isFlagged));
        });
      });

      // 7. Exam Timer Loop
      function updateTimer() {
        var now = Date.now();
        var diff = Math.max(0, Math.floor((expiresAt - now) / 1000));

        var hours = Math.floor(diff / 3600);
        var minutes = Math.floor((diff % 3600) / 60);
        var seconds = diff % 60;

        var hStr = hours < 10 ? '0' + hours : '' + hours;
        var mStr = minutes < 10 ? '0' + minutes : '' + minutes;
        var sStr = seconds < 10 ? '0' + seconds : '' + seconds;

        timerDisplay.textContent = hStr + ':' + mStr + ':' + sStr;

        if (diff <= 300 && diff > 60) {
          timerBox.className = 'timer timer--warning';
        } else if (diff <= 60) {
          timerBox.className = 'timer timer--critical';
        }

        if (diff <= 0) {
          timerDisplay.textContent = '00:00:00';
          timerBox.className = 'timer timer--critical';
          if (!isSubmitting) {
            isSubmitting = true;
            timesUpModal.style.display = 'flex';
            setTimeout(function () {
              if (window.stopExamAudio) window.stopExamAudio();
              try {
                localStorage.removeItem(storageKey);
                localStorage.removeItem(audioStorageKey);
              } catch (err) {}
              autoSubmitForm.submit();
            }, 1000);
          }
        }
      }

      updateTimer();
      setInterval(updateTimer, 1000);

      // 8. Exam Integrity Guards & Non-Happy Paths

      // History Trap: Intercept browser Back navigation and display Exit modal
      window.history.pushState({ page: 'exam-shell', q: currentDisplayOrder }, '', window.location.href);
      window.addEventListener('popstate', function () {
        window.history.pushState({ page: 'exam-shell', q: currentDisplayOrder }, '', window.location.href);
        exitModal.style.display = 'flex';
      });

      // Accidental tab close / refresh protection
      window.addEventListener('beforeunload', function (e) {
        if (!isSubmitting) {
          e.preventDefault();
          e.returnValue = 'Your exam attempt is currently in progress. Leaving may cause unsaved responses to be lost.';
          return e.returnValue;
        }
      });

      // Disable Context Menu (Right Click)
      document.addEventListener('contextmenu', function (e) {
        e.preventDefault();
      });

      // Disable Destructive Keyboard Shortcuts (F5, Ctrl+R, Ctrl+U, F12, Ctrl+Shift+I)
      document.addEventListener('keydown', function (e) {
        if (e.key === 'F5' || (e.ctrlKey && (e.key === 'r' || e.key === 'R'))) {
          e.preventDefault();
          return;
        }
        if ((e.ctrlKey && (e.key === 'u' || e.key === 'U')) ||
            e.key === 'F12' ||
            (e.ctrlKey && e.shiftKey && (e.key === 'i' || e.key === 'I'))) {
          e.preventDefault();
          return;
        }
      });

      // Tab Switching / Focus Loss Monitoring
      var tabSwitchCount = 0;
      var integrityWarning = document.getElementById('integrity-warning');
      var integrityCount = document.getElementById('integrity-count');

      document.addEventListener('visibilitychange', function () {
        if (document.hidden && !isSubmitting) {
          tabSwitchCount++;
          if (integrityWarning) {
            integrityWarning.style.display = 'block';
            if (integrityCount) integrityCount.textContent = tabSwitchCount;
          }
        }
      });

      // Online / Offline Detection
      var networkWarning = document.getElementById('network-warning');
      window.addEventListener('online', function () {
        if (networkWarning) networkWarning.style.display = 'none';
        triggerFlush();
      });

      window.addEventListener('offline', function () {
        if (networkWarning) networkWarning.style.display = 'block';
        saveStatus.textContent = 'Offline';
        saveStatus.className = 'save-status save-status--error';
      });

      // 9. Modals Management
      function openSubmitModal() {
        if (isSpeakingPreparing || isSpeakingRecording || isAudioUploading) {
          saveStatus.textContent = isAudioUploading
            ? 'Wait for the recording to finish uploading before submitting.'
            : (isSpeakingPreparing ? 'Wait for preparation to finish before submitting.' : 'Stop and save the recording before submitting.');
          saveStatus.className = 'save-status save-status--error';
          return;
        }
        updateProgressStats();
        var submitQueueMsg = document.getElementById('modal-sync-pending');
        var submitNowBtn = document.getElementById('btn-modal-submit-now');
        if (pendingQueue.length > 0) {
          if (submitQueueMsg) submitQueueMsg.style.display = 'block';
          if (submitNowBtn) submitNowBtn.disabled = true;
        } else {
          if (submitQueueMsg) submitQueueMsg.style.display = 'none';
          if (submitNowBtn) submitNowBtn.disabled = false;
        }
        submitModal.style.display = 'flex';
      }

      var openSubmitBtns = document.querySelectorAll('.js-open-submit-modal');
      var closeSubmitBtns = document.querySelectorAll('.js-close-submit-modal');
      openSubmitBtns.forEach(function (btn) {
        btn.addEventListener('click', openSubmitModal);
      });
      closeSubmitBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          submitModal.style.display = 'none';
        });
      });

      var openExitBtn = document.getElementById('btn-open-exit-modal');
      var closeExitBtns = document.querySelectorAll('.js-close-exit-modal');
      if (openExitBtn) {
        openExitBtn.addEventListener('click', function () {
          exitModal.style.display = 'flex';
        });
      }
      closeExitBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          exitModal.style.display = 'none';
        });
      });

      window.addEventListener('click', function (e) {
        if (e.target === submitModal) submitModal.style.display = 'none';
        if (e.target === exitModal) exitModal.style.display = 'none';
      });

      // Form submission cleans up storage buffer
      if (submitExamForm) {
        submitExamForm.addEventListener('submit', function (e) {
          if (isSpeakingPreparing || isSpeakingRecording || isAudioUploading) {
            e.preventDefault();
            saveStatus.textContent = isAudioUploading
              ? 'Wait for the recording to finish uploading before submitting.'
              : (isSpeakingPreparing ? 'Wait for preparation to finish before submitting.' : 'Stop and save the recording before submitting.');
            saveStatus.className = 'save-status save-status--error';
            return;
          }
          if (pendingQueue.length > 0) {
            e.preventDefault();
            var submitQueueMsg = document.getElementById('modal-sync-pending');
            var submitNowBtn = document.getElementById('btn-modal-submit-now');
            if (submitQueueMsg) submitQueueMsg.style.display = 'block';
            if (submitNowBtn) submitNowBtn.disabled = true;
            return;
          }
          if (window.stopExamAudio) window.stopExamAudio();
          isSubmitting = true;
          try {
            localStorage.removeItem(storageKey);
            localStorage.removeItem(audioStorageKey);
          } catch (err) {}
        });
      }

      if (autoSubmitForm) {
        autoSubmitForm.addEventListener('submit', function () {
          if (window.stopExamAudio) window.stopExamAudio();
          isSubmitting = true;
          try {
            localStorage.removeItem(storageKey);
            localStorage.removeItem(audioStorageKey);
          } catch (err) {}
        });
      }

      if (cancelExamForm) {
        cancelExamForm.addEventListener('submit', function () {
          if (window.stopExamAudio) window.stopExamAudio();
          isSubmitting = true;
          try {
            localStorage.removeItem(storageKey);
            localStorage.removeItem(audioStorageKey);
          } catch (err) {}
        });
      }

      // Start initial queue flush if uncommitted items restored
      renderQuestion(currentDisplayOrder);
      if (pendingQueue.length > 0) {
        triggerFlush();
      }
    })();
  </script>
</body>
</html>
