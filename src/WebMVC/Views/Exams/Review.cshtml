@model ExamReviewViewModel
@{
    Layout = "_LearnerLayout";
    var rev = Model.Review;
    ViewData["Title"] = $"Review — {rev.ExamName}";
    ViewData["Description"] = $"Mock exam detailed answer review for {rev.ExamName}.";

}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/dashboard" class="breadcrumbs__item">Home</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/exams/history" class="breadcrumbs__item">Exam history</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Review</span>
</nav>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
  <div class="alert alert--danger" role="alert">@Model.ErrorMessage</div>
}

<div class="row row--between mb-4">
  <div>
    <h1 class="m-0 mb-1">Review — @rev.ExamName</h1>
    <p class="text-sm text-muted no-margin">
      <strong>@rev.TotalScore points</strong>
      @if (rev.SkillScores.Count > 0)
      {
        <span>· @Model.SkillScoresDisplay</span>
      }
      · Completed on @Model.SubmittedAtDisplay
    </p>
  </div>
  <div class="row row--tight">
    <a class="btn" href="/exams/result/@rev.AttemptId">Back to results</a>
    <a class="btn btn--ghost" href="/exams/history">Back to history</a>
  </div>
</div>

<!-- Filter Toolbar -->
<div class="card mb-4">
  <div class="card__body row row--wrap" style="gap: var(--space-4); align-items: flex-end;">
    <div class="field mb-0" style="flex: 0 0 220px;">
      <label class="field__label" for="review-part-select">Part / Section</label>
      <select class="field__input" id="review-part-select">
        <option value="all">All @rev.TotalQuestions questions</option>
        @foreach (var part in Model.Sections)
        {
          <option value="@part.Code">@part.Code — @part.Name (@part.Count)</option>
        }
      </select>
    </div>

    <div class="field mb-0" style="flex: 0 0 220px;">
      <label class="field__label" for="review-filter-select">Filter by Status</label>
      <select class="field__input" id="review-filter-select">
        <option value="all">All questions</option>
        <option value="incorrect">Only incorrect questions</option>
        <option value="blank">Only questions left blank</option>
        <option value="flagged">Only flagged questions</option>
        <option value="correct">Only correct questions</option>
      </select>
    </div>

    <div class="row row--tight" style="margin-left: auto; align-self: center;">
      <span class="badge badge--success">@rev.CorrectCount correct</span>
      <span class="badge badge--danger">@rev.IncorrectCount incorrect</span>
      <span class="badge badge--muted">@rev.BlankCount left blank</span>
      <span class="badge badge--warning">@rev.FlaggedCount flagged</span>
    </div>
  </div>
</div>

<div class="exam-layout">
  <!-- Main Questions Column -->
  <div class="stack" id="questions-container" style="flex: 1; min-width: 0;">
    @foreach (var item in Model.Questions)
    {
      var q = item.Question;
      <div class="card question-item"
           id="question-card-@q.QuestionId"
           data-question-id="@q.QuestionId"
           data-order="@q.DisplayOrder"
           data-part="@q.SectionCode"
           data-status="@item.Status"
           data-flagged="@(q.IsFlagged ? "true" : "false")">
        <div class="card__body">
          <!-- Question Meta Header -->
          <div class="question__meta row row--between mb-3">
            <div class="row row--tight">
              <span class="question__number font-bold">Question @q.DisplayOrder</span>
              <span class="badge badge--muted">@q.SectionCode — @q.SectionName</span>
              @if (q.IsCorrect == true)
              {
                <span class="badge badge--success">Correct answer</span>
              }
              else if (q.IsCorrect == false)
              {
                <span class="badge badge--danger">Your answer is incorrect</span>
              }
              else
              {
                <span class="badge badge--warning">Blank</span>
              }
            </div>

            @if (q.IsFlagged)
            {
              <span class="badge badge--warning">Flagged for review</span>
            }
          </div>

          <!-- Audio player if present -->
          @if (!string.IsNullOrEmpty(q.AudioPath))
          {
            <partial name="_ExamAudioPlayer" model="item.AudioPlayer" />
          }

          <!-- Passage if present -->
          @if (!string.IsNullOrEmpty(q.Passage))
          {
            <div class="card mb-3">
              <div class="card__body">
                <p class="no-margin passage">@q.Passage</p>
              </div>
            </div>
          }

          <!-- Image if present -->
          @if (!string.IsNullOrEmpty(q.ImagePath))
          {
            <div class="mb-3">
              <img src="@q.ImagePath" alt="@(q.ImageAlt ?? "Question illustration")" class="question__image" />
            </div>
          }

          <!-- Stem -->
          <p class="question__stem">
            @q.Stem
          </p>

          <!-- Options -->
          <div class="option-list mb-3" role="group" aria-label="Answers for Question @q.DisplayOrder">
            @foreach (var option in item.Options)
            {
              var opt = option.Option;
              <div class="option @option.CssClass @(option.IsSelected ? "option--selected" : "")">
                <span class="option__marker">@opt.Label</span>
                <span class="option__text">@opt.Text</span>
                @if (opt.IsCorrect && option.IsSelected)
                {
                  <span class="badge badge--success">Your answer · Correct</span>
                }
                else if (opt.IsCorrect)
                {
                  <span class="badge badge--success">Correct answer</span>
                }
                else if (option.IsSelected)
                {
                  <span class="badge badge--danger">Your answer</span>
                }
              </div>

              @if (!string.IsNullOrWhiteSpace(opt.Rationale))
              {
                <div class="text-xs text-muted mb-2 ml-2">
                  <strong>Option @opt.Label:</strong> @opt.Rationale
                </div>
              }
            }
          </div>

          <!-- Explanation -->
          @if (!string.IsNullOrWhiteSpace(q.Explanation))
          {
            <div class="explain mb-3">
              <div class="explain__title"><strong>Explanation</strong></div>
              <p class="no-margin mt-1">@q.Explanation</p>
            </div>
          }

          <!-- Transcript -->
          @if (!string.IsNullOrWhiteSpace(q.Transcript))
          {
            <div class="explain explain--neutral mt-2">
              <strong>Transcript:</strong> @q.Transcript
            </div>
          }
        </div>
      </div>
    }

    <div id="no-filtered-results" class="card d-none">
      <div class="card__body text-center p-4">
        <p class="text-muted no-margin">No questions match the selected filters.</p>
      </div>
    </div>
  </div>

  <!-- Sidebar Navigator (reflects answered, flagged, and unanswered states) -->
  <aside class="exam-sidebar stack" style="flex: 0 0 300px;">
    <div class="card">
      <div class="card__header">
        <div class="row row--between">
          <strong class="text-sm">Question Navigator</strong>
          <span class="text-xs text-muted">@rev.TotalQuestions questions</span>
        </div>
      </div>
      <div class="card__body stack">
        <div class="navigator__grid" role="group" aria-label="Question Navigator">
          @foreach (var cell in Model.Navigator)
          {
            var nav = cell.Item;
            <a href="#question-card-@nav.QuestionId"
               class="navigator__cell @cell.CssClass"
               id="nav-cell-@nav.QuestionId"
               data-target-id="@nav.QuestionId"
               data-order="@nav.DisplayOrder"
               title="@cell.Title">
              @nav.DisplayOrder
            </a>
          }
        </div>

        <div class="text-xs stack mt-2" style="gap: var(--space-1)">
          <div class="row row--middle row--tight">
            <span class="navigator__cell navigator__cell--swatch is-answered" aria-hidden="true">1</span> Answered
          </div>
          <div class="row row--middle row--tight">
            <span class="navigator__cell navigator__cell--swatch is-marked" aria-hidden="true">2</span> Flagged for review
          </div>
          <div class="row row--middle row--tight">
            <span class="navigator__cell navigator__cell--swatch is-unanswered" aria-hidden="true">3</span> Unanswered
          </div>
        </div>
      </div>
    </div>
  </aside>
</div>

<script src="~/js/exams/completed-review.js" asp-append-version="true"></script>
