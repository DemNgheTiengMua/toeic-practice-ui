@model ExamResultViewModel
@inject DateTimeFormatter Dates
@{
    Layout = "_LearnerLayout";
    var res = Model.Result;
    var isGradingPending = res.Status == Contracts.AttemptStatusDto.Submitted;
    ViewData["Title"] = $"Results — {res.ExamName}";
    ViewData["Description"] = $"Mock exam results for {res.ExamName}.";
    var isGraded = res.Status == Contracts.AttemptStatusDto.Graded;
    var isAwaitingGrading = res.Status == Contracts.AttemptStatusDto.Submitted;
    var pendingFreeResponses = Math.Max(0, res.FreeResponseCount - res.GradedFreeResponseCount - res.FailedFreeResponseCount);

    var hours = res.DurationSeconds / 3600;
    var minutes = (res.DurationSeconds % 3600) / 60;
    var seconds = res.DurationSeconds % 60;
    var durationStr = hours > 0
        ? $"{hours}h {minutes}m {seconds}s"
        : $"{minutes}m {seconds}s";
}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/dashboard" class="breadcrumbs__item">Home</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/exams" class="breadcrumbs__item">Exams</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Results</span>
</nav>

<div class="row row--between" style="align-items: baseline;">
  <div>
    <h1 class="m-0 mb-1">Results — @res.ExamName</h1>
    <p class="text-sm text-muted no-margin">
      Completed @Dates.Format(res.SubmittedAt) · Time taken: <strong>@durationStr</strong>
    </p>
  </div>

  <div class="row" style="gap: var(--space-2);">
    @if (isGraded)
    {
      <a class="btn btn--primary" href="/exams/review/@res.AttemptId">Review answers</a>
    }
    <a class="btn" href="/exams/history">Exam history</a>
    <a class="btn btn--ghost" href="/exams">All exams</a>
  </div>

</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
  <div class="alert alert--danger" role="alert">@Model.ErrorMessage</div>
}

@if (res.IsAutoSubmitted)
{
  <div class="alert alert--warning" role="status">
    <strong>Time is up.</strong> The exam was submitted automatically when your deadline expired.
  </div>
}
@if (isGradingPending)
{
  <div class="alert alert--info" role="status">
    <strong>AI grading is in progress.</strong> Your free responses are saved. This page refreshes automatically when grading is complete; the score shown is for scored multiple-choice sections.
  </div>
}

@if (isAwaitingGrading)
{
  <section id="grading-status-card"
           class="card mt-4"
           role="status"
           aria-live="polite"
           data-status-url="/exams/result/@res.AttemptId/status"
           style="border: 2px solid #14181d; border-radius: 0; box-shadow: none;">
    <div class="card__body">
      <strong id="grading-status-title">AI grading in progress</strong>
      <p id="grading-status-message" class="text-sm no-margin mt-1">
        Objective skill scores are available below. @pendingFreeResponses free response(s) are waiting for grading.
      </p>
    </div>
  </section>
}

<!-- Score Hero -->
<div class="score-hero">
  <div class="score-hero__total">
    <div class="score-hero__total-value">@(isGraded ? res.TotalScore.ToString() : "—")</div>
    <div class="score-hero__total-label">
      @(isGraded ? $"Total scaled score · {res.CertCode}" : "Composite score pending AI grading")
    </div>
    @if (isGraded && res.ScoreDelta.HasValue)
    {
      <p class="score-hero__delta" role="status">
        <span class="score-hero__delta-value">@(res.ScoreDelta.Value >= 0 ? $"+{res.ScoreDelta.Value}" : res.ScoreDelta.Value.ToString())</span>
        <span class="score-hero__delta-label">vs. previous attempt</span>
      </p>
    }
  </div>

  @foreach (var skill in res.SkillScores)
  {
    <div class="score-hero__section">
      <div class="score-hero__section-value">@skill.ScaledScore</div>
      <div class="text-sm text-muted">@skill.SkillName</div>
      <p class="text-xs text-muted m-0 mt-1">@skill.RawScore / @skill.TotalQuestions</p>
    </div>
  }
</div>

@if (isGraded && !string.IsNullOrEmpty(res.BandCode))
{
  <div class="card">
    <div class="card__header"><strong>Proficiency Level / Score Band</strong></div>
    <div class="card__body">
      <div class="cefr">
        <div class="cefr__head">
          <span class="cefr__current">@res.BandCode</span>
          <span class="text-sm text-muted">@res.BandName · @res.CertName</span>
        </div>
      </div>
    </div>
  </div>
}

<!-- AI Insight Panel (Ticket #20) -->
@if (isGraded)
{
  <partial name="_AiInsightPanel" model='new WebMVC.Models.AiInsightPanelViewModel("attempt", res.AttemptId, Model.Insight)' />
}

<!-- Breakdown by Skill Table -->
<div class="card mt-4">
  <div class="card__header"><strong>Skill Performance Breakdown</strong></div>
  <div class="card__body">
    <table class="table table--striped">
      <thead>
        <tr>
          <th>Skill</th>
          <th>Raw Score</th>
          <th>Total Questions</th>
          <th>Scaled Score</th>
          <th>Accuracy</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var skill in res.SkillScores)
        {
          var pct = skill.TotalQuestions > 0 ? (int)Math.Round((double)skill.RawScore / skill.TotalQuestions * 100) : 0;
          <tr>
            <td><strong>@skill.SkillName</strong></td>
            <td>@skill.RawScore</td>
            <td>@skill.TotalQuestions</td>
            <td><strong>@skill.ScaledScore</strong></td>
            <td>@pct%</td>
          </tr>
        }
      </tbody>
      <tfoot>
        <tr>
          <th>Total</th>
          <th>@res.SkillScores.Sum(s => s.RawScore)</th>
          <th>@res.SkillScores.Sum(s => s.TotalQuestions)</th>
          <th><strong>@res.TotalScore</strong></th>
          <th>
            @{
              var totalRaw = res.SkillScores.Sum(s => s.RawScore);
              var totalQuestions = res.SkillScores.Sum(s => s.TotalQuestions);
              var totalPct = totalQuestions > 0 ? (int)Math.Round((double)totalRaw / totalQuestions * 100) : 0;
            }
            @totalPct%
          </th>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

@if (isAwaitingGrading)
{
  <script>
    (function () {
      "use strict";
      var card = document.getElementById("grading-status-card");
      if (!card) return;

      var message = document.getElementById("grading-status-message");
      var title = document.getElementById("grading-status-title");
      var intervalId;

      async function refreshGradingStatus() {
        try {
          var response = await fetch(card.dataset.statusUrl, {
            credentials: "same-origin",
            headers: { "Accept": "application/json" },
            cache: "no-store"
          });
          if (!response.ok) throw new Error("Status request failed.");

          var status = await response.json();
          if (status.isGraded) {
            window.clearInterval(intervalId);
            window.location.reload();
            return;
          }

          var pending = Math.max(0, status.freeResponseCount - status.gradedFreeResponseCount - status.failedFreeResponseCount);
          if (status.failedFreeResponseCount > 0 && pending === 0) {
            title.textContent = "Some responses could not be graded";
            message.textContent = status.failedFreeResponseCount + " response(s) need grading service attention. Objective skill scores remain available below.";
            window.clearInterval(intervalId);
            return;
          }

          message.textContent = "Objective skill scores are available below. " + pending + " free response(s) are waiting for grading.";
        } catch (error) {
          message.textContent = "Unable to refresh grading status. The page will try again shortly.";
        }
      }

      intervalId = window.setInterval(refreshGradingStatus, 3000);
      refreshGradingStatus();
    })();
  </script>
}
