@model ExamResultViewModel
@{
    Layout = "_LearnerLayout";
    var res = Model.Result;
    ViewData["Title"] = $"Results — {res.ExamName}";
    ViewData["Description"] = $"Mock exam results for {res.ExamName}.";
}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/dashboard" class="breadcrumbs__item">Home</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/exams" class="breadcrumbs__item">Exams</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Results</span>
</nav>

<div class="row row--between" style="align-items: baseline;">
  <div>
    <h1 class="m-0 mb-1">Results — @res.ExamName</h1>
    <p class="text-sm text-muted no-margin">
      Completed @Model.SubmittedAtDisplay · Time taken: <strong>@Model.DurationDisplay</strong>
    </p>
  </div>

  <div class="row" style="gap: var(--space-2);">
    @if (Model.IsGraded)
    {
      <a class="btn btn--primary" href="/exams/review/@res.AttemptId">Review answers</a>
    }
    <a class="btn" href="/exams/history">Exam history</a>
    <a class="btn btn--ghost" href="/exams">All exams</a>
  </div>

</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
  <div class="alert alert--danger" role="alert">@Model.ErrorMessage</div>
}

@if (TempData["ShellSuccess"] is string syncSuccess)
{
  <div class="alert alert--success" role="status">@syncSuccess</div>
}

@if (res.IsAutoSubmitted)
{
  <div class="alert alert--warning" role="status">
    <strong>Time is up.</strong> The exam was submitted automatically when your deadline expired.
  </div>
}
@if (Model.IsAwaitingGrading)
{
  <div class="alert alert--info" role="status">
    <strong>AI grading is in progress.</strong> Your free responses are saved. This page refreshes automatically when grading is complete; the score shown is for scored multiple-choice sections.
  </div>
}

@if (Model.IsAwaitingGrading)
{
  <section id="grading-status-card"
           class="card mt-4"
           role="status"
           aria-live="polite"
           data-status-url="/exams/result/@res.AttemptId/status"
           style="border: 2px solid #14181d; border-radius: 0; box-shadow: none;">
    <div class="card__body">
      <strong id="grading-status-title">AI grading in progress</strong>
      <p id="grading-status-message" class="text-sm no-margin mt-1">
        Objective skill scores are available below. @Model.PendingFreeResponses free response(s) are waiting for grading.
      </p>
    </div>
  </section>
}

<!-- Score Hero -->
<div class="score-hero">
  <div class="score-hero__total">
    <div class="score-hero__total-value">@Model.TotalScoreDisplay</div>
    <div class="score-hero__total-label">
      @Model.TotalScoreLabel
    </div>
    @if (Model.IsGraded && res.ScoreDelta.HasValue)
    {
      @* The colour is the verdict, so it has to follow the sign. This block was always green, so a
         learner who dropped 710 points was shown the drop on a success-coloured placard.
         The class is computed into a variable first: a nested ternary inside the attribute value is
         not parsed by Razor and renders as literal source. *@
      var deltaClass = res.ScoreDelta.Value < 0 ? "score-hero__delta--down"
          : res.ScoreDelta.Value > 0 ? "score-hero__delta--up"
          : "score-hero__delta--flat";
      <p class="score-hero__delta @deltaClass" role="status">
        <span class="score-hero__delta-value">@Model.ScoreDeltaDisplay</span>
        <span class="score-hero__delta-label">vs. previous attempt</span>
      </p>
    }
  </div>

  @foreach (var item in Model.Skills)
  {
    <div class="score-hero__section">
      <div class="score-hero__section-value">@item.ScaledScoreDisplay</div>
      <div class="text-sm text-muted">@item.Score.SkillName</div>
      <p class="text-xs text-muted m-0 mt-1">@item.Score.RawScore / @item.Score.TotalQuestions</p>
    </div>
  }
</div>

@if (Model.IsGraded && !string.IsNullOrEmpty(res.BandCode))
{
  <div class="card">
    <div class="card__header"><strong>Band on this certificate's own scale</strong></div>
    <div class="card__body">
      <div class="cefr">
        <div class="cefr__head">
          @* The band's own name, never its code: "below_A1" is a database key, and printing it put
             an underscore in front of a learner. The band table already carries the readable name.
             #222 / PRN-03: this is a certificate band, NOT a CEFR level. *@
          <span class="cefr__current">@(string.IsNullOrWhiteSpace(res.BandName) ? res.BandCode : res.BandName)</span>
          <span class="text-sm text-muted">@res.CertName band for a score of @Model.TotalScoreDisplay</span>
        </div>
      </div>
    </div>
  </div>
}

@* #222: the projected level, separately labelled and deliberately beside the certificate score rather
   than merged into it. A certificate band is not a CEFR level (PRN-03), so the two placards say which
   quantity each one is. *@
@if (Model.IsGraded && Model.Projection.Available)
{
  <div class="card mt-4">
    <div class="card__header"><strong>Projected level from this paper</strong></div>
    <div class="card__body">
      @if (Model.Projection.Historical)
      {
        <p class="text-sm no-margin">@Model.Projection.CannotJudgeText</p>
      }
      else if (Model.Projection.CannotJudgeText is not null)
      {
        <p class="text-sm no-margin">@Model.Projection.CannotJudgeText</p>
        <p class="text-xs text-muted mt-2 no-margin">@Model.Projection.ScopeNote</p>
      }
      else
      {
        @if (Model.Projection.WeakestProjectedText is not null)
        {
          <div class="cefr">
            <div class="cefr__head">
              <span class="cefr__current">@Model.Projection.WeakestProjectedText</span>
              <span class="text-sm text-muted">weakest projected skill on this paper</span>
            </div>
          </div>
        }

        <table class="table table--striped mt-3">
          <thead>
            <tr>
              <th scope="col">Skill</th>
              <th scope="col">Certificate score</th>
              <th scope="col">Projected level</th>
              <th scope="col">Outcome</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var row in Model.Projection.Skills)
            {
              <tr>
                <td><strong>@row.SkillName</strong></td>
                <td>@row.ScoreDisplay</td>
                <td>
                  @if (row.LevelLabel is not null)
                  {
                    <strong>@row.LevelLabel</strong>
                  }
                  else
                  {
                    <span class="text-muted">—</span>
                  }
                </td>
                <td><span class="badge @row.OutcomeClass">@row.OutcomeLabel</span></td>
              </tr>
            }
          </tbody>
        </table>

        <p class="text-xs text-muted mt-2">@Model.Projection.ScopeNote</p>

        <div class="mt-3" style="border-top: 1px solid var(--color-border); padding-top: var(--space-3);">
          <p class="text-sm no-margin">@Model.Projection.StoredStateText</p>

          @if (Model.Projection.SyncOffered)
          {
            <form method="post" action="/exams/result/@res.AttemptId/projection/sync" class="mt-3 no-margin">
              @Html.AntiForgeryToken()
              <p class="text-sm no-margin mb-2">
                This paper projects a different level for: <strong>@Model.Projection.SyncSummaryText</strong>.
                Syncing replaces your stored level with this paper's projection.
              </p>
              <button type="submit" class="btn btn--primary">Sync my level to this paper</button>
            </form>
          }
          else
          {
            <p class="text-xs text-muted no-margin">
              This paper projects the same level you already have stored, so there is nothing to sync.
            </p>
          }
        </div>
      }
    </div>
  </div>
}

<!-- AI Insight Panel (Ticket #20) -->
@if (Model.IsGraded)
{
  <partial name="_AiInsightPanel" model="Model.InsightPanel" />
}

<!-- Breakdown by Skill Table -->
<div class="card mt-4">
  <div class="card__header"><strong>Skill Performance Breakdown</strong></div>
  <div class="card__body">
    <table class="table table--striped">
      <thead>
        <tr>
          <th>Skill</th>
          <th>Raw Score</th>
          <th>Total Questions</th>
          <th>Scaled Score</th>
          <th>Accuracy</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var item in Model.Skills)
        {
          var skill = item.Score;
          <tr>
            <td><strong>@skill.SkillName</strong></td>
            <td>@skill.RawScore</td>
            <td>@skill.TotalQuestions</td>
            <td><strong>@item.ScaledScoreDisplay</strong></td>
            <td>@item.AccuracyPercent%</td>
          </tr>
        }
      </tbody>
      <tfoot>
        <tr>
          <th>Total</th>
          <th>@Model.TotalRawScore</th>
          <th>@Model.TotalQuestions</th>
          <th><strong>@Model.TotalScoreDisplay</strong></th>
          <th>
            @Model.AccuracyPercent%
          </th>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

@if (Model.IsAwaitingGrading)
{
  <script src="~/js/exams/result.js" asp-append-version="true"></script>
}
