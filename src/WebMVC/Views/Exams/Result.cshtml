@model ExamResultViewModel
@inject DateTimeFormatter Dates
@{
    Layout = "_LearnerLayout";
    var res = Model.Result;
    ViewData["Title"] = $"Results — {res.ExamName}";
    ViewData["Description"] = $"Mock exam results for {res.ExamName}.";

    var hours = res.DurationSeconds / 3600;
    var minutes = (res.DurationSeconds % 3600) / 60;
    var seconds = res.DurationSeconds % 60;
    var durationStr = hours > 0
        ? $"{hours}h {minutes}m {seconds}s"
        : $"{minutes}m {seconds}s";
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/dashboard" class="breadcrumbs__item">Home</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/exams" class="breadcrumbs__item">Exams</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Results</span>
</nav>

<div class="row row--between" style="align-items: baseline;">
  <div>
    <h1 class="m-0 mb-1">Results — @res.ExamName</h1>
    <p class="text-sm text-muted no-margin">
      Completed @Dates.Format(res.SubmittedAt) · Time taken: <strong>@durationStr</strong>
    </p>
  </div>
  <div class="row" style="gap: var(--space-2);">
    @if (res.Status == Contracts.AttemptStatusDto.Graded)
    {
      <a class="btn btn--primary" href="/exams/review/@res.AttemptId">Review answers</a>
    }
    <a class="btn" href="/exams/history">Exam history</a>
    <a class="btn btn--ghost" href="/exams">All exams</a>
  </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
  <div class="alert alert--danger" role="alert">@Model.ErrorMessage</div>
}

@if (res.IsAutoSubmitted)
{
  <div class="alert alert--warning" role="status">
    <strong>Time is up.</strong> The exam was submitted automatically when your deadline expired.
  </div>
}

@if (res.Status == Contracts.AttemptStatusDto.Submitted)
{
  var pendingResponses = Math.Max(0, res.FreeResponseCount - res.GradedFreeResponseCount - res.FailedFreeResponseCount);
  <section class="card" id="ai-grading-status"
           data-status-url="@Url.Action("GradingStatus", "Exams", new { attemptId = res.AttemptId })"
           data-pending="@pendingResponses">
    <div class="card__header"><strong>AI grading in progress</strong></div>
    <div class="card__body" aria-live="polite">
      <p id="ai-grading-message" class="m-0">
        Objective skill scores are available below. Writing or speaking responses are being graded asynchronously.
      </p>
      <p class="text-sm text-muted mt-2 mb-0" id="ai-grading-counts">
        @res.GradedFreeResponseCount of @res.FreeResponseCount free responses graded
        @if (res.FailedFreeResponseCount > 0)
        {
          <span> · @res.FailedFreeResponseCount could not be graded</span>
        }
      </p>
    </div>
  </section>
}

<!-- Score Hero -->
<div class="score-hero">
  <div class="score-hero__total">
    <div class="score-hero__total-value">
      @(res.Status == Contracts.AttemptStatusDto.Graded ? res.TotalScore.ToString() : "Pending")
    </div>
    <div class="score-hero__total-label">
      @(res.Status == Contracts.AttemptStatusDto.Graded ? $"Total scaled score · {res.CertCode}" : "Final composite score pending AI grading")
    </div>
    @if (res.Status == Contracts.AttemptStatusDto.Graded && res.ScoreDelta.HasValue)
    {
      <p class="score-hero__delta" role="status">
        <span class="score-hero__delta-value">@(res.ScoreDelta.Value >= 0 ? $"+{res.ScoreDelta.Value}" : res.ScoreDelta.Value.ToString())</span>
        <span class="score-hero__delta-label">vs. previous attempt</span>
      </p>
    }
  </div>

  @foreach (var skill in res.SkillScores)
  {
    <div class="score-hero__section">
      <div class="score-hero__section-value">@skill.ScaledScore</div>
      <div class="text-sm text-muted">@skill.SkillName</div>
      <p class="text-xs text-muted m-0 mt-1">@skill.RawScore/@skill.TotalQuestions correct</p>
    </div>
  }
</div>

@if (res.Status == Contracts.AttemptStatusDto.Submitted)
{
  <script>
    (function () {
      var statusCard = document.getElementById('ai-grading-status');
      if (!statusCard) return;

      var statusUrl = statusCard.dataset.statusUrl;
      var message = document.getElementById('ai-grading-message');
      var counts = document.getElementById('ai-grading-counts');
      var timer;

      function poll() {
        fetch(statusUrl, { headers: { 'Accept': 'application/json' } })
          .then(function (response) {
            if (!response.ok) throw new Error('Could not refresh grading status.');
            return response.json();
          })
          .then(function (data) {
            var pending = Math.max(0, data.freeResponseCount - data.gradedFreeResponseCount - data.failedFreeResponseCount);
            counts.textContent = data.gradedFreeResponseCount + ' of ' + data.freeResponseCount + ' free responses graded'
              + (data.failedFreeResponseCount > 0 ? ' · ' + data.failedFreeResponseCount + ' could not be graded' : '');

            if (data.status === 'graded') {
              window.location.reload();
              return;
            }

            if (pending === 0 && data.failedFreeResponseCount > 0) {
              message.textContent = 'AI grading could not finish for one or more responses. Objective scores remain available; the final composite score is unavailable.';
              statusCard.querySelector('.card__header strong').textContent = 'AI grading needs attention';
              return;
            }

            message.textContent = 'Objective skill scores are available below. Writing or speaking responses are being graded asynchronously.';
            timer = window.setTimeout(poll, 4000);
          })
          .catch(function () {
            message.textContent = 'Could not refresh grading status. Retrying shortly.';
            timer = window.setTimeout(poll, 8000);
          });
      }

      timer = window.setTimeout(poll, 4000);
      window.addEventListener('beforeunload', function () {
        if (timer) window.clearTimeout(timer);
      });
    })();
  </script>
}

@if (!string.IsNullOrEmpty(res.BandCode))
{
  <div class="card">
    <div class="card__header"><strong>Proficiency Level / Score Band</strong></div>
    <div class="card__body">
      <div class="cefr">
        <div class="cefr__head">
          <span class="cefr__current">@res.BandCode</span>
          <span class="text-sm text-muted">@res.BandName · @res.CertName</span>
        </div>
      </div>
    </div>
  </div>
}

<!-- AI Insight Panel (Ticket #20) -->
<partial name="_AiInsightPanel" model='new WebMVC.Models.AiInsightPanelViewModel("attempt", res.AttemptId, Model.Insight)' />

<!-- Breakdown by Skill Table -->
<div class="card mt-4">
  <div class="card__header"><strong>Skill Performance Breakdown</strong></div>
  <div class="card__body">
    <table class="table table--striped">
      <thead>
        <tr>
          <th>Skill</th>
          <th>Raw Score</th>
          <th>Total Questions</th>
          <th>Scaled Score</th>
          <th>Accuracy</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var skill in res.SkillScores)
        {
          var pct = skill.TotalQuestions > 0 ? (int)Math.Round((double)skill.RawScore / skill.TotalQuestions * 100) : 0;
          <tr>
            <td><strong>@skill.SkillName</strong></td>
            <td>@skill.RawScore</td>
            <td>@skill.TotalQuestions</td>
            <td><strong>@skill.ScaledScore</strong></td>
            <td>@pct%</td>
          </tr>
        }
      </tbody>
      <tfoot>
        <tr>
          <th>Total</th>
          <th>@res.SkillScores.Sum(s => s.RawScore)</th>
          <th>@res.SkillScores.Sum(s => s.TotalQuestions)</th>
          <th><strong>@(res.Status == Contracts.AttemptStatusDto.Graded ? res.TotalScore.ToString() : "Pending")</strong></th>
          <th>
            @{
              var totalRaw = res.SkillScores.Sum(s => s.RawScore);
              var totalQuestions = res.SkillScores.Sum(s => s.TotalQuestions);
              var totalPct = totalQuestions > 0 ? (int)Math.Round((double)totalRaw / totalQuestions * 100) : 0;
            }
            @totalPct%
          </th>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
