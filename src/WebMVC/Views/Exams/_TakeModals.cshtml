@model ExamTakeViewModel
@{
    var take = Model.Display;
}
<!-- Submit Confirmation Modal -->
<div id="submit-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="submit-modal-title">
  <div class="modal">
    <div class="modal__header">
      <h2 id="submit-modal-title" class="no-margin">Submit exam?</h2>
    </div>
    <div class="modal__body stack">
      <div id="modal-sync-pending" class="alert alert--info" style="display:none;">
        <strong>Synchronizing latest answers…</strong> Please wait a moment while your answers are being recorded on the server.
      </div>

      <div id="modal-unanswered-warning" class="alert alert--warning" style="@(!take.AllAnswered ? "" : "display:none;")">
        <strong>You have <span id="modal-unanswered-count">@take.UnansweredCount</span> unanswered questions.</strong>
        Unanswered questions count as incorrect, and answers cannot be changed after you submit.
      </div>
      <div id="modal-all-answered" class="alert alert--success" style="@(take.AllAnswered ? "" : "display:none;")">
        <strong>All @take.TotalQuestions questions have been answered.</strong>
        Answers cannot be changed after you submit.
      </div>

      <div class="grid-3">
        <div class="stat">
          <div class="stat__label">Answered</div>
          <div class="stat__value" id="modal-stat-answered">@take.AnsweredCount</div>
        </div>
        <div class="stat">
          <div class="stat__label">Flagged</div>
          <div class="stat__value" id="modal-stat-flagged">@take.FlaggedCount</div>
        </div>
        <div class="stat">
          <div class="stat__label">Unanswered</div>
          <div class="stat__value" id="modal-stat-unanswered">@take.UnansweredCount</div>
        </div>
      </div>

      <p class="text-sm text-muted no-margin">
        Once submitted, your responses will be scored and your scaled band computed immediately.
      </p>
    </div>
    <div class="modal__footer">
      <button type="button" class="btn js-close-submit-modal">Go back and continue</button>
      <form method="post" action="/exams/take/@take.AttemptId/submit" id="submit-exam-form" style="display:inline;">
        @Html.AntiForgeryToken()
        <div class="exam-draft-submit-fields"></div>
        <button type="submit" class="btn btn--danger" id="btn-modal-submit-now">Submit now</button>
      </form>
    </div>
  </div>
</div>

<!-- Exit / Cancel Modal -->
<div id="exit-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="exit-modal-title">
  <div class="modal">
    <div class="modal__header">
      <h2 id="exit-modal-title" class="no-margin">Exit or Cancel Exam?</h2>
    </div>
    <div class="modal__body stack">
      <div class="alert alert--danger">
        <strong>Cancelling abandons the exam and forfeits your 1 credit.</strong>
        An abandoned attempt will not be scored and will not appear in your completed tests.
      </div>
      <p class="text-sm text-muted no-margin">
        You can exit back to the test list to resume later before the countdown expires.
      </p>
    </div>
    <div class="modal__footer">
      <button type="button" class="btn js-close-exit-modal">Stay on test</button>
      <a class="btn" href="/exams" id="btn-exit-resume-later">Exit (resume later)</a>
      <form method="post" action="/exams/take/@take.AttemptId/cancel" id="cancel-exam-form" style="display:inline;">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn--danger">Cancel & abandon (lose credit)</button>
      </form>
    </div>
  </div>
</div>

<!-- Time's Up Auto-Submit Modal -->
<div id="times-up-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="times-up-title">
  <div class="modal">
    <div class="modal__header">
      <h2 id="times-up-title" class="no-margin">Time is up</h2>
    </div>
    <div class="modal__body stack">
      <div class="alert alert--warning">
        <strong>Your exam deadline has expired.</strong>
        The exam is being submitted automatically and scored on the questions you answered.
      </div>
      <div class="progress mx-auto" style="max-width: 280px">
        <div class="progress__bar" style="width: 100%"></div>
      </div>
    </div>
  </div>
</div>

<form id="auto-submit-form" method="post" action="/exams/take/@take.AttemptId/submit" style="display:none;">
  @Html.AntiForgeryToken()
  <div class="exam-draft-submit-fields"></div>
</form>

<!-- Accessibility Theme & Font Size Modal -->
<div id="accessibility-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="accessibility-modal-title">
  <div class="modal" style="max-width: 480px; border: 2px solid #14181d; border-radius: 0; box-shadow: none;">
    <div class="modal__header" style="border-bottom: 2px solid #14181d;">
      <h2 id="accessibility-modal-title" class="no-margin" style="font-family: 'IBM Plex Sans Condensed', sans-serif; text-transform: uppercase;">Accessibility & Theme Settings</h2>
    </div>
    <div class="modal__body stack" style="gap: 1.25rem;">
      <div>
        <label class="text-sm text-bold" style="font-family: 'IBM Plex Sans Condensed', sans-serif; text-transform: uppercase; display: block; margin-bottom: 0.5rem;">Font Size</label>
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem;">
          <button type="button" class="btn js-font-size-btn" data-size="standard" style="border-radius: 0; font-weight: 700;">Standard (100%)</button>
          <button type="button" class="btn js-font-size-btn" data-size="large" style="border-radius: 0; font-weight: 700;">Large (115%)</button>
          <button type="button" class="btn js-font-size-btn" data-size="xlarge" style="border-radius: 0; font-weight: 700;">Extra Large (130%)</button>
        </div>
      </div>
      <div>
        <label class="text-sm text-bold" style="font-family: 'IBM Plex Sans Condensed', sans-serif; text-transform: uppercase; display: block; margin-bottom: 0.5rem;">Contrast Theme</label>
        <div class="stack" style="gap: 0.5rem;">
          <button type="button" class="btn js-theme-btn" data-theme="standard" style="border-radius: 0; text-align: left; padding: 0.5rem 0.75rem; font-weight: 700;">
            Black on White (Standard)
          </button>
          <button type="button" class="btn js-theme-btn" data-theme="inverted" style="border-radius: 0; text-align: left; padding: 0.5rem 0.75rem; font-weight: 700;">
            White on Black (Inverted)
          </button>
          <button type="button" class="btn js-theme-btn" data-theme="high-contrast" style="border-radius: 0; text-align: left; padding: 0.5rem 0.75rem; font-weight: 700;">
            Yellow on Black (High Contrast)
          </button>
        </div>
      </div>
    </div>
    <div class="modal__footer" style="border-top: 1px solid #ccd2d6;">
      <button type="button" class="btn btn--primary" id="btn-close-accessibility-modal">Apply & Close</button>
    </div>
  </div>
</div>

<!-- Floating Highlighter Popover -->
<div id="highlighter-popover" class="highlighter-popover" style="display:none;" role="toolbar" aria-label="Highlighter Toolbar">
  <button type="button" class="btn btn--sm js-hl-action" data-action="highlight" style="background: #f2b705; color: #14181d; border: 2px solid #14181d; font-weight: 700;">Highlight</button>
  <button type="button" class="btn btn--sm js-hl-action" data-action="note" style="background: #ffffff; color: #14181d; border: 2px solid #14181d; font-weight: 700;">Note</button>
  <button type="button" class="btn btn--sm js-hl-action" data-action="clear" style="background: #b31217; color: #ffffff; border: 2px solid #14181d; font-weight: 700;">Clear</button>
</div>

<!-- Sticky Note Modal -->
<div id="sticky-note-modal" class="modal-overlay" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="sticky-note-title">
  <div class="modal" style="max-width: 440px; border: 2px solid #14181d; border-radius: 0; box-shadow: none;">
    <div class="modal__header" style="border-bottom: 2px solid #14181d;">
      <h3 id="sticky-note-title" class="no-margin" style="font-family:'IBM Plex Sans Condensed', sans-serif; text-transform:uppercase;">Candidate Note</h3>
    </div>
    <div class="modal__body stack" style="gap: 0.75rem;">
      <p class="text-xs text-muted mb-1" id="sticky-note-quote" style="font-style: italic; border-left: 2px solid #f2b705; padding-left: 0.5rem;"></p>
      <textarea id="sticky-note-input" class="input" rows="3" placeholder="Type your notes here..." style="width: 100%; border: 2px solid #14181d; border-radius: 0; box-shadow: none;"></textarea>
    </div>
    <div class="modal__footer" style="border-top: 1px solid #ccd2d6;">
      <button type="button" class="btn btn--ghost" id="btn-cancel-note">Cancel</button>
      <button type="button" class="btn btn--primary" id="btn-save-note">Save Note</button>
    </div>
  </div>
</div>

<!-- Reading Review Screen Modal (#review-screen-modal) -->
<div id="review-screen-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="review-screen-title">
  <div class="modal" style="max-width: 800px; width: 90%; border: 2px solid #14181d; border-radius: 0; box-shadow: none;">
    <div class="modal__header" style="border-bottom: 2px solid #14181d; display: flex; justify-content: space-between; align-items: center; background: #fafbfc; padding: 0.75rem 1rem;">
      <h2 id="review-screen-title" class="no-margin" style="font-family: 'IBM Plex Sans Condensed', sans-serif; text-transform: uppercase; font-size: 1.25rem;">
        READING REVIEW SCREEN
      </h2>
      <button type="button" class="btn btn--ghost btn--sm js-close-review-modal" aria-label="Close review screen">[X]</button>
    </div>
    <div class="modal__body stack" style="gap: 1.25rem; max-height: 70vh; overflow-y: auto; padding: 1.25rem;">
      <!-- Stats Summary -->
      <div class="grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;">
        <div class="stat" style="border: 2px solid #14181d; padding: 0.75rem; background: #fff;">
          <div class="stat__label" style="font-family: 'IBM Plex Sans Condensed', sans-serif; text-transform: uppercase; font-size: 0.75rem;">Answered</div>
          <div class="stat__value" id="review-stat-answered" style="font-family: 'IBM Plex Mono', monospace; font-size: 1.5rem; font-weight: 700;">0</div>
        </div>
        <div class="stat" style="border: 2px solid #14181d; padding: 0.75rem; background: #fff;">
          <div class="stat__label" style="font-family: 'IBM Plex Sans Condensed', sans-serif; text-transform: uppercase; font-size: 0.75rem;">Flagged</div>
          <div class="stat__value" id="review-stat-flagged" style="font-family: 'IBM Plex Mono', monospace; font-size: 1.5rem; font-weight: 700; color: #b28500;">0</div>
        </div>
        <div class="stat" style="border: 2px solid #14181d; padding: 0.75rem; background: #fff;">
          <div class="stat__label" style="font-family: 'IBM Plex Sans Condensed', sans-serif; text-transform: uppercase; font-size: 0.75rem;">Unanswered</div>
          <div class="stat__value" id="review-stat-unanswered" style="font-family: 'IBM Plex Mono', monospace; font-size: 1.5rem; font-weight: 700; color: #b31217;">0</div>
        </div>
      </div>

      <!-- 3 Quick-Action Buttons -->
      <div class="row" style="gap: 0.75rem; flex-wrap: wrap;">
        <button type="button" class="btn btn--primary btn--sm" id="btn-review-first-unanswered">
          Jump to First Unanswered
        </button>
        <button type="button" class="btn btn--secondary btn--sm" id="btn-review-only-unanswered">
          Review Only Unanswered
        </button>
        <button type="button" class="btn btn--secondary btn--sm" id="btn-review-only-flagged">
          Review Only Flagged
        </button>
        <button type="button" class="btn btn--ghost btn--sm" id="btn-review-show-all">
          Show All
        </button>
      </div>

      <!-- Questions Grid List -->
      <div id="review-questions-list" style="border: 2px solid #14181d; display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 1px; background: #ccd2d6;">
      </div>

      <!-- Unit 1 completion action -->
      <div id="review-unit-transition-container" style="display:none; border-top: 2px solid #14181d; padding-top: 1rem;">
        <button type="button" class="btn btn--primary" id="btn-review-finish-unit" style="width: 100%;">
          Finish Stage 1 & Proceed to Stage 2
        </button>
      </div>
    </div>
    <div class="modal__footer" style="border-top: 2px solid #14181d; display: flex; justify-content: flex-end; gap: 0.75rem; padding: 0.75rem 1rem;">
      <button type="button" class="btn js-close-review-modal">Return to Exam</button>
    </div>
  </div>
</div>

<!-- Hybrid Group-Lock Irreversible Confirmation Modal (#group-lock-modal) -->
<div id="group-lock-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="group-lock-modal-title">
  <div class="modal" style="max-width: 550px; border: 2px solid #14181d; border-radius: 0; box-shadow: none;">
    <div class="modal__header" style="border-bottom: 2px solid #14181d; background: #fafbfc; padding: 1rem 1.25rem;">
      <h2 id="group-lock-modal-title" class="no-margin" style="font-family: 'IBM Plex Sans Condensed', sans-serif; text-transform: uppercase; font-size: 1.25rem; color: #b31217;">
        CONFIRM QUESTION GROUP LOCK
      </h2>
    </div>
    <div class="modal__body stack" style="gap: 1rem; padding: 1.25rem;">
      <div class="alert alert--danger" style="border: 2px solid #b31217; border-radius: 0; box-shadow: none; font-weight: 500;">
        Confirm transition to next question: Current section will be locked permanently and remaining time will not carry over.
      </div>
      <p class="no-margin" style="font-size: 0.9375rem;">
        You will not be able to review or modify your answers in this question group after confirming.
      </p>
    </div>
    <div class="modal__footer" style="border-top: 2px solid #14181d; padding: 1rem 1.25rem; display: flex; justify-content: flex-end; gap: 0.75rem;">
      <button type="button" class="btn js-close-group-lock-modal">Cancel</button>
      <button type="button" class="btn btn--danger" id="btn-confirm-group-lock">
        Confirm &amp; Proceed
      </button>
    </div>
  </div>
</div>

<!-- Adaptive Stage Unit Locking Confirmation Modal (#unit-lock-modal) -->
<div id="unit-lock-modal" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="unit-lock-modal-title">
  <div class="modal" style="max-width: 550px; border: 2px solid #14181d; border-radius: 0; box-shadow: none;">
    <div class="modal__header" style="border-bottom: 2px solid #14181d; background: #fafbfc; padding: 1rem 1.25rem;">
      <h2 id="unit-lock-modal-title" class="no-margin" style="font-family: 'IBM Plex Sans Condensed', sans-serif; text-transform: uppercase; font-size: 1.25rem; color: #b31217;">
        CONFIRM STAGE LOCK (IRREVERSIBLE)
      </h2>
    </div>
    <div class="modal__body stack" style="gap: 1rem; padding: 1.25rem;">
      <div class="alert alert--danger" style="border: 2px solid #b31217; border-radius: 0; box-shadow: none; font-weight: 500;">
        Once confirmed, Stage 1 will be permanently locked and you cannot return to it.
      </div>
      <p class="no-margin" style="font-size: 0.9375rem;">
        You have completed all questions in Stage 1. The system will permanently lock your Stage 1 answers and unlock Stage 2 adaptive questions.
      </p>
    </div>
    <div class="modal__footer" style="border-top: 2px solid #14181d; padding: 1rem 1.25rem; display: flex; justify-content: flex-end; gap: 0.75rem;">
      <button type="button" class="btn js-close-unit-lock-modal">Cancel</button>
      <button type="button" class="btn btn--danger" id="btn-confirm-unit-lock">
        Confirm &amp; Proceed
      </button>
    </div>
  </div>
</div>
