@model WebMVC.Models.ExamPreflightViewModel
@{
    Layout = "_LearnerLayout";
    var p = Model.Preflight;
    ViewData["Title"] = $"Pre-flight Check — {p.ExamName}";
    ViewData["Description"] = $"Equipment readiness and asset verification for {p.ExamName}.";
    var audioCount = p.AudioUrls.Count;
}

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="/dashboard" class="breadcrumbs__item">Home</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/exams" class="breadcrumbs__item">Test List</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <a href="/exams/@p.ExamId/instructions" class="breadcrumbs__item">@p.ExamName</a>
  <span class="breadcrumbs__separator" aria-hidden="true">›</span>
  <span class="breadcrumbs__item" aria-current="page">Pre-flight Verification</span>
</nav>

<div class="placard mb-4" style="border: 2px solid var(--ink); padding: var(--space-4); background: var(--color-surface);">
  <div class="row row--between row--middle">
    <div>
      <div class="row row--middle gap-2 mb-1">
        <span class="badge badge--info font-sign">@p.CertCode</span>
        <span class="badge font-sign">ATTEMPT #@p.AttemptId</span>
        @if (p.RequiresMicrophone)
        {
          <span class="badge badge--warning font-sign">SPEAKING EXAM</span>
        }
      </div>
      <h1 class="m-0 mb-1" style="font-family: var(--font-sign); text-transform: uppercase; letter-spacing: var(--tracking-sign);">
        Pre-Flight Readiness Check: @p.ExamName
      </h1>
      <p class="text-sm text-muted no-margin">
        Certificate: <strong>@p.CertName</strong> · Duration: <strong class="font-mono">@p.DurationMinutes min</strong> · 
        All audio assets and input devices must be verified before the exam sitting begins.
      </p>
    </div>
    <div class="text-right">
      <div class="font-sign text-xs text-muted">GATE STATUS</div>
      <span id="gate-status-badge" class="badge @(p.IsVerified ? "badge--success" : "badge--warning") font-sign" style="font-size: var(--text-sm);">
        @(p.IsVerified ? "VERIFIED & READY" : "CHECKS PENDING")
      </span>
    </div>
  </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
  <div class="alert alert--danger mb-3" role="alert">@Model.ErrorMessage</div>
}

<div class="stack gap-4">
  <!-- Step 1: Audio Asset Pre-buffering -->
  <section class="card" style="border: 2px solid var(--ink); border-radius: 0; box-shadow: none;">
    <div class="card__header" style="background: var(--color-surface); border-bottom: 2px solid var(--ink); padding: var(--space-3) var(--space-4);">
      <div class="row row--between row--middle">
        <div class="row row--middle gap-2">
          <span class="badge font-sign" style="background: var(--ink); color: #fff;">STEP 1</span>
          <strong class="font-sign" style="letter-spacing: var(--tracking-sign); text-transform: uppercase;">
            Audio Asset Pre-Buffering
          </strong>
        </div>
        <span id="audio-buffer-badge" class="badge badge--warning font-sign" role="status" aria-live="polite">
          @(audioCount > 0 ? "PRE-BUFFERING..." : "NO AUDIO REQUIRED")
        </span>
      </div>
    </div>
    <div class="card__body stack gap-3" style="padding: var(--space-4);">
      <p class="text-sm text-muted no-margin">
        To prevent playback stutters, network lag, or buffering delays during time-critical sections, 100% of exam audio tracks must be buffered to your device before the test begins.
      </p>

      <div>
        <div class="row row--between mb-1">
          <span class="text-xs font-sign text-muted uppercase">Buffering Progress</span>
          <span id="buffer-percentage" class="font-mono text-xs">@(audioCount > 0 ? "0%" : "100%")</span>
        </div>
        <div class="progress" style="height: 12px; border: 1px solid var(--ink); background: var(--color-track);">
          <div id="buffer-progress-bar" class="progress__bar" role="progressbar" style="width: @(audioCount > 0 ? "0%" : "100%");" aria-valuenow="@(audioCount > 0 ? 0 : 100)" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        <div class="row row--between mt-1 text-xs text-muted">
          <span id="buffer-details">@(audioCount > 0 ? $"0 of {audioCount} audio tracks pre-buffered" : "No listening audio tracks in this exam blueprint")</span>
          <span class="font-mono text-xs">Network: <strong id="buffer-net-status">Active</strong></span>
        </div>
      </div>

      <div id="buffer-error-alert" class="alert alert--danger" role="alert" hidden>
        <strong>Network Buffering Warning:</strong> <span id="buffer-error-msg">One or more audio tracks could not be pre-buffered.</span>
        <div class="mt-2">
          <button type="button" id="btn-retry-buffer" class="btn btn--sm btn--primary">Retry Audio Buffering</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Step 2: Speaker & Headphone Check -->
  <section class="card" data-audio-equipment data-show-input="false" data-show-output="true" style="border: 2px solid var(--ink); border-radius: 0; box-shadow: none;">
    <div class="card__header" style="background: var(--color-surface); border-bottom: 2px solid var(--ink); padding: var(--space-3) var(--space-4);">
      <div class="row row--between row--middle">
        <div class="row row--middle gap-2">
          <span class="badge font-sign" style="background: var(--ink); color: #fff;">STEP 2</span>
          <strong class="font-sign" style="letter-spacing: var(--tracking-sign); text-transform: uppercase;">
            Speaker & Headphone Sound Check
          </strong>
        </div>
        <span class="badge badge--success font-sign">READY</span>
      </div>
    </div>
    <div class="card__body stack gap-3" style="padding: var(--space-4);">
      <p class="text-sm text-muted no-margin">
        Verify that you can hear clear audio through your headphones or external speakers. Adjust the volume to a comfortable level.
      </p>

      <div class="grid-2 gap-4">
        <div class="field">
          <label class="field__label font-sign" for="output-select">Audio output device</label>
          <select class="field__input" id="output-select" data-audio-role="output-device" style="border: 2px solid var(--ink); border-radius: 0;">
            <option value="default">System default</option>
          </select>
          <div class="field__hint text-xs text-muted mt-1" data-audio-role="output-support">Output routing supported.</div>
        </div>

        <div class="field">
          <label class="field__label font-sign" for="volume-range">Preferred volume</label>
          <div class="audio-equipment__volume" style="display: flex; align-items: center; gap: var(--space-2);">
            <button type="button" class="btn btn--ghost btn--sm" data-audio-action="toggle-mute" aria-label="Mute audio">Mute</button>
            <input class="audio-equipment__volume-slider" id="volume-range" data-audio-role="volume" type="range" min="0" max="100" value="85" style="flex: 1;" aria-label="Volume">
            <span class="font-mono text-sm" data-audio-role="volume-value">85%</span>
          </div>
        </div>
      </div>

      <div class="row row--middle gap-3 pt-2">
        <button type="button" class="btn btn--sm btn--primary" data-audio-action="speaker-test">
          Play Test Chime
        </button>
        <span class="badge badge--muted font-sign" data-audio-role="speaker-status" role="status" aria-live="polite">TEST READY</span>
      </div>
    </div>
  </section>

  <!-- Step 3: Interactive Microphone Check (Speaking exams only) -->
  @if (p.RequiresMicrophone)
  {
    <section class="card" id="mic-check-card" style="border: 2px solid var(--ink); border-radius: 0; box-shadow: none;">
      <div class="card__header" style="background: var(--color-surface); border-bottom: 2px solid var(--ink); padding: var(--space-3) var(--space-4);">
        <div class="row row--between row--middle">
          <div class="row row--middle gap-2">
            <span class="badge font-sign" style="background: var(--ink); color: #fff;">STEP 3</span>
            <strong class="font-sign" style="letter-spacing: var(--tracking-sign); text-transform: uppercase;">
              Interactive Microphone & Voice Quality Check
            </strong>
          </div>
          <span id="mic-status-badge" class="badge @(p.IsVerified ? "badge--success" : "badge--warning") font-sign" role="status" aria-live="polite">
            @(p.IsVerified ? "MIC VERIFIED" : "CHECK REQUIRED")
          </span>
        </div>
      </div>
      <div class="card__body stack gap-3" style="padding: var(--space-4);">
        <!-- Positioning Guide -->
        <div class="alert alert--info" style="border: 1px solid var(--sign-blue); background: #f0f6ff; padding: var(--space-3); border-radius: 0;">
          <strong class="font-sign" style="text-transform: uppercase; color: var(--sign-blue);">Microphone Positioning Guide:</strong>
          <ul class="text-sm mt-1 mb-0" style="padding-left: var(--space-4);">
            <li>Position your headset or lapel microphone <strong>2 to 3 cm</strong> from the corner of your mouth.</li>
            <li>Do not breathe directly into the microphone capsule.</li>
            <li>Maintain a steady, normal speaking voice during all responses.</li>
          </ul>
        </div>

        <div class="field">
          <label class="field__label font-sign" for="mic-select">Microphone input device</label>
          <select class="field__input" id="mic-select" style="border: 2px solid var(--ink); border-radius: 0;">
            <option value="default">System default microphone</option>
          </select>
        </div>

        <!-- Live Level Meter -->
        <div>
          <div class="row row--between mb-1">
            <span class="text-xs font-sign text-muted uppercase">Microphone Live Level Meter</span>
            <span id="meter-db-text" class="font-mono text-xs">-inf dBFS</span>
          </div>
          <div class="audio-equipment__meter" style="position: relative; height: 20px; border: 2px solid var(--ink); background: var(--color-track); overflow: hidden;">
            <span id="mic-meter-fill" style="display: block; width: 0%; height: 100%; background: var(--sign-green); transition: width 60ms linear;"></span>
            <i class="audio-equipment__tick audio-equipment__tick--voice" style="position: absolute; top: 0; bottom: 0; left: 25%; width: 2px; background: var(--ink);" title="Voice threshold (-45 dBFS)" aria-hidden="true"></i>
            <i class="audio-equipment__tick audio-equipment__tick--loud" style="position: absolute; top: 0; bottom: 0; left: 90%; width: 2px; background: var(--sign-red);" title="Clipping threshold (-6 dBFS)" aria-hidden="true"></i>
          </div>
          <div class="row row--between mt-1 text-xs text-muted">
            <span>Left tick = Voice detect (-45 dBFS)</span>
            <span id="mic-signal-label" class="badge badge--muted font-sign">NO SIGNAL</span>
            <span>Right tick = Overload (-6 dBFS)</span>
          </div>
        </div>

        <!-- Interactive Voice Sample Recording -->
        <div class="card" style="border: 1px solid var(--ink); background: var(--color-track); padding: var(--space-3); border-radius: 0;">
          <div class="stack gap-2">
            <div>
              <strong class="font-sign text-sm text-uppercase">Sample Recording Task:</strong>
              <p class="text-sm mt-1 mb-0" style="font-style: italic; background: #fff; border: 1px solid var(--color-border); padding: var(--space-2) var(--space-3);">
                "The quick brown fox jumps over the lazy dog."
              </p>
            </div>

            <div class="row row--middle gap-3 mt-1">
              <button type="button" id="btn-start-sample" class="btn btn--sm btn--primary">
                Record 3s Sample
              </button>
              <span id="sample-countdown" class="font-mono text-sm" style="display: none;">3s</span>
              <span id="sample-status-text" class="text-xs text-muted">Press to record and verify microphone clarity.</span>
            </div>

            <!-- Recorded Sample Playback & Clarity Prompt -->
            <div id="sample-review-panel" class="stack gap-2 mt-2 pt-2" style="border-top: 1px solid var(--color-border); display: none;">
              <div class="row row--between row--middle">
                <span class="text-sm"><strong>Review Sample:</strong> Audio recorded successfully.</span>
                <button type="button" id="btn-replay-sample" class="btn btn--ghost btn--sm">
                  Replay Audio
                </button>
              </div>

              <div class="alert alert--warning" style="border: 1px solid var(--sign-gold); background: #fffdf0; padding: var(--space-3); border-radius: 0;">
                <p class="text-sm no-margin font-sign"><strong>CLARITY CONFIRMATION:</strong> Is your voice recording clear, audible, and free of excessive static?</p>
                <div class="row gap-2 mt-2">
                  <button type="button" id="btn-mic-confirm-yes" class="btn btn--sm btn--primary">
                    Yes, Audio is Clear
                  </button>
                  <button type="button" id="btn-mic-confirm-no" class="btn btn--sm btn--secondary">
                    No, Re-test
                  </button>
                </div>
              </div>
            </div>

            <div id="mic-confirmed-success" class="alert alert--success mt-2" style="display: none; border-radius: 0;" role="status">
              <strong>Microphone Verified!</strong> Your sample audio is clear. The microphone check is complete.
            </div>
          </div>
        </div>
      </div>
    </section>
  }

  <!-- Gate Summary & Proceed Action -->
  <section class="card placard" style="border: 2px solid var(--ink); border-radius: 0; box-shadow: none; background: var(--color-surface); padding: var(--space-4);">
    <div class="row row--between row--middle">
      <div>
        <div id="gate-pending-notice" class="alert alert--warning no-margin" style="border-radius: 0;" role="status">
          <strong>Pre-flight Checks Pending:</strong> Complete required audio pre-buffering and equipment checks above before entering the exam room.
        </div>
        <div id="gate-ready-notice" class="alert alert--success no-margin" style="border-radius: 0; display: none;" role="status">
          <strong>All Pre-flight Requirements Satisfied:</strong> Your equipment and exam assets are 100% verified. You may now start the test.
        </div>
      </div>

      <form id="verify-preflight-form" method="post" action="/exams/preflight/@p.AttemptId/verify">
        @Html.AntiForgeryToken()
        <button type="submit" id="start-test-btn" class="btn btn--primary btn--lg" style="min-width: 200px; font-weight: 700;" disabled>
          Start Test →
        </button>
      </form>
    </div>
  </section>
</div>

<script>
  (function() {
    "use strict";

    var audioUrls = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(p.AudioUrls));
    var requiresMic = @(p.RequiresMicrophone ? "true" : "false");
    var isAlreadyVerified = @(p.IsVerified ? "true" : "false");

    var state = {
      audioBuffered: audioUrls.length === 0,
      micVerified: !requiresMic || isAlreadyVerified,
      bufferedCount: 0,
      totalAudio: audioUrls.length
    };

    var startBtn = document.getElementById("start-test-btn");
    var gateStatusBadge = document.getElementById("gate-status-badge");
    var gatePendingNotice = document.getElementById("gate-pending-notice");
    var gateReadyNotice = document.getElementById("gate-ready-notice");

    function checkStartReadiness() {
      if (state.audioBuffered && state.micVerified) {
        startBtn.disabled = false;
        if (gateStatusBadge) {
          gateStatusBadge.textContent = "VERIFIED & READY";
          gateStatusBadge.className = "badge badge--success font-sign";
        }
        if (gatePendingNotice) gatePendingNotice.style.display = "none";
        if (gateReadyNotice) gateReadyNotice.style.display = "block";
      } else {
        startBtn.disabled = true;
        if (gateStatusBadge) {
          gateStatusBadge.textContent = "CHECKS PENDING";
          gateStatusBadge.className = "badge badge--warning font-sign";
        }
        if (gatePendingNotice) gatePendingNotice.style.display = "block";
        if (gateReadyNotice) gateReadyNotice.style.display = "none";
      }
    }

    // --- Step 1: Audio Asset Pre-buffering ---
    var bufferBar = document.getElementById("buffer-progress-bar");
    var bufferPct = document.getElementById("buffer-percentage");
    var bufferDetails = document.getElementById("buffer-details");
    var bufferBadge = document.getElementById("audio-buffer-badge");
    var bufferErrorAlert = document.getElementById("buffer-error-alert");
    var bufferErrorMsg = document.getElementById("buffer-error-msg");
    var btnRetryBuffer = document.getElementById("btn-retry-buffer");

    function updateBufferUI(loaded, total, statusText, isError) {
      var pct = total === 0 ? 100 : Math.round((loaded / total) * 100);
      if (bufferBar) {
        bufferBar.style.width = pct + "%";
        bufferBar.setAttribute("aria-valuenow", String(pct));
        bufferBar.className = isError ? "progress__bar progress__bar--danger" : (pct === 100 ? "progress__bar progress__bar--success" : "progress__bar");
      }
      if (bufferPct) bufferPct.textContent = pct + "%";
      if (bufferDetails) {
        bufferDetails.textContent = total > 0 ? (loaded + " of " + total + " audio tracks pre-buffered") : "No audio tracks required";
      }
      if (bufferBadge) {
        bufferBadge.textContent = statusText;
        bufferBadge.className = "badge font-sign " + (isError ? "badge--danger" : (pct === 100 ? "badge--success" : "badge--warning"));
      }
    }

    function preloadViaAudio(url) {
      return new Promise(function(resolve, reject) {
        var audio = new Audio();
        audio.preload = "auto";
        audio.oncanplaythrough = function() { resolve(); };
        audio.onerror = function() { reject(new Error("Playback pre-buffer failed for " + url)); };
        audio.src = url;
        audio.load();
      });
    }

    async function bufferSingleAudio(url) {
      try {
        var resp = await fetch(url, { method: "GET", mode: "cors" });
        if (!resp.ok && resp.status !== 0) {
          await preloadViaAudio(url);
        } else {
          await resp.blob();
        }
      } catch (err) {
        await preloadViaAudio(url);
      }
    }

    async function runAudioBuffering() {
      if (bufferErrorAlert) bufferErrorAlert.hidden = true;
      if (state.totalAudio === 0) {
        state.audioBuffered = true;
        updateBufferUI(0, 0, "READY (NO AUDIO)", false);
        checkStartReadiness();
        return;
      }

      state.bufferedCount = 0;
      updateBufferUI(0, state.totalAudio, "BUFFERING (0/" + state.totalAudio + ")", false);

      for (var i = 0; i < audioUrls.length; i++) {
        var url = audioUrls[i];
        try {
          await bufferSingleAudio(url);
          state.bufferedCount++;
          var isLast = state.bufferedCount === state.totalAudio;
          updateBufferUI(
            state.bufferedCount,
            state.totalAudio,
            isLast ? "100% BUFFERED" : "BUFFERING (" + state.bufferedCount + "/" + state.totalAudio + ")",
            false
          );
        } catch (fetchErr) {
          console.error("Audio pre-buffering error for", url, fetchErr);
          state.audioBuffered = false;
          updateBufferUI(state.bufferedCount, state.totalAudio, "BUFFERING FAILED", true);
          if (bufferErrorAlert) {
            if (bufferErrorMsg) bufferErrorMsg.textContent = "Failed to load audio asset: " + url + ". Please check your connection and retry.";
            bufferErrorAlert.hidden = false;
          }
          checkStartReadiness();
          return;
        }
      }

      state.audioBuffered = true;
      updateBufferUI(state.totalAudio, state.totalAudio, "100% BUFFERED", false);
      checkStartReadiness();
    }

    if (btnRetryBuffer) {
      btnRetryBuffer.addEventListener("click", function() {
        runAudioBuffering();
      });
    }

    // --- Step 3: Interactive Microphone & Voice Sample Check ---
    var micCard = document.getElementById("mic-check-card");
    if (requiresMic && micCard) {
      var micSelect = document.getElementById("mic-select");
      var micMeterFill = document.getElementById("mic-meter-fill");
      var meterDbText = document.getElementById("meter-db-text");
      var micSignalLabel = document.getElementById("mic-signal-label");
      var micStatusBadge = document.getElementById("mic-status-badge");
      var btnStartSample = document.getElementById("btn-start-sample");
      var sampleCountdown = document.getElementById("sample-countdown");
      var sampleStatusText = document.getElementById("sample-status-text");
      var sampleReviewPanel = document.getElementById("sample-review-panel");
      var btnReplaySample = document.getElementById("btn-replay-sample");
      var btnMicYes = document.getElementById("btn-mic-confirm-yes");
      var btnMicNo = document.getElementById("btn-mic-confirm-no");
      var micConfirmedSuccess = document.getElementById("mic-confirmed-success");

      var micStream = null;
      var audioContext = null;
      var animFrameId = null;
      var recordedBlob = null;
      var recordedUrl = null;

      async function enumerateMics() {
        if (!navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices) return;
        try {
          var devices = await navigator.mediaDevices.enumerateDevices();
          var audioInputs = devices.filter(function(d) { return d.kind === "audioinput"; });
          if (micSelect && audioInputs.length > 0) {
            micSelect.innerHTML = "";
            audioInputs.forEach(function(d, index) {
              var opt = document.createElement("option");
              opt.value = d.deviceId;
              opt.textContent = d.label || ("Microphone " + (index + 1));
              micSelect.appendChild(opt);
            });
          }
        } catch (e) {
          console.warn("Could not enumerate audio inputs", e);
        }
      }

      function stopActiveStream() {
        if (animFrameId) cancelAnimationFrame(animFrameId);
        if (micStream) {
          micStream.getTracks().forEach(function(t) { t.stop(); });
          micStream = null;
        }
        if (audioContext && audioContext.state !== "closed") {
          audioContext.close();
          audioContext = null;
        }
        if (micMeterFill) micMeterFill.style.width = "0%";
        if (meterDbText) meterDbText.textContent = "-inf dBFS";
        if (micSignalLabel) {
          micSignalLabel.textContent = "NO SIGNAL";
          micSignalLabel.className = "badge badge--muted font-sign";
        }
      }

      async function startLiveMeter(stream) {
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
        await audioContext.resume();
        var analyser = audioContext.createAnalyser();
        analyser.fftSize = 1024;
        var source = audioContext.createMediaStreamSource(stream);
        source.connect(analyser);

        var samples = new Float32Array(analyser.fftSize);

        function drawMeter() {
          analyser.getFloatTimeDomainData(samples);
          var sum = 0;
          for (var i = 0; i < samples.length; i++) {
            sum += samples[i] * samples[i];
          }
          var rms = Math.sqrt(sum / samples.length);
          var db = rms > 0 ? 20 * Math.log10(rms) : -Infinity;
          var pct = Math.max(0, Math.min(100, (db + 60) * 100 / 60));

          if (micMeterFill) micMeterFill.style.width = pct + "%";
          if (meterDbText) meterDbText.textContent = Number.isFinite(db) ? (Math.round(db) + " dBFS") : "-inf dBFS";

          if (db > -6) {
            if (micSignalLabel) {
              micSignalLabel.textContent = "TOO LOUD";
              micSignalLabel.className = "badge badge--danger font-sign";
            }
          } else if (db > -45) {
            if (micSignalLabel) {
              micSignalLabel.textContent = "VOICE DETECTED";
              micSignalLabel.className = "badge badge--success font-sign";
            }
          } else {
            if (micSignalLabel) {
              micSignalLabel.textContent = "NO SIGNAL";
              micSignalLabel.className = "badge badge--muted font-sign";
            }
          }

          animFrameId = requestAnimationFrame(drawMeter);
        }

        drawMeter();
      }

      async function runSampleRecording() {
        stopActiveStream();
        if (sampleReviewPanel) sampleReviewPanel.style.display = "none";
        if (micConfirmedSuccess) micConfirmedSuccess.style.display = "none";

        var deviceId = micSelect ? micSelect.value : "default";
        var constraints = deviceId && deviceId !== "default" ? { audio: { deviceId: { exact: deviceId } } } : { audio: true };

        try {
          micStream = await navigator.mediaDevices.getUserMedia(constraints);
          await enumerateMics();
          await startLiveMeter(micStream);

          var mediaRecorder = new MediaRecorder(micStream);
          var chunks = [];

          mediaRecorder.ondataavailable = function(e) {
            if (e.data && e.data.size > 0) chunks.push(e.data);
          };

          mediaRecorder.onstop = function() {
            var blob = new Blob(chunks, { type: mediaRecorder.mimeType || "audio/webm" });
            recordedBlob = blob;
            if (recordedUrl) URL.revokeObjectURL(recordedUrl);
            recordedUrl = URL.createObjectURL(blob);

            stopActiveStream();

            if (sampleCountdown) sampleCountdown.style.display = "none";
            if (btnStartSample) {
              btnStartSample.disabled = false;
              btnStartSample.textContent = "Record Again";
            }
            if (sampleStatusText) sampleStatusText.textContent = "Recording finished. Playing back your sample...";
            if (sampleReviewPanel) sampleReviewPanel.style.display = "block";

            // Automatically play back sample
            var playback = new Audio(recordedUrl);
            playback.onended = function() {
              if (sampleStatusText) sampleStatusText.textContent = "Playback complete. Please answer the clarity question below.";
            };
            playback.play().catch(function(e) {
              console.warn("Auto playback error", e);
              if (sampleStatusText) sampleStatusText.textContent = "Recorded. Click Replay Audio to listen.";
            });
          };

          mediaRecorder.start();
          if (btnStartSample) btnStartSample.disabled = true;
          if (sampleCountdown) {
            sampleCountdown.style.display = "inline";
            sampleCountdown.textContent = "3s";
          }
          if (sampleStatusText) sampleStatusText.textContent = "Recording sample... Speak now.";

          var remainingSecs = 3;
          var interval = setInterval(function() {
            remainingSecs--;
            if (sampleCountdown) sampleCountdown.textContent = remainingSecs + "s";
            if (remainingSecs <= 0) {
              clearInterval(interval);
              if (mediaRecorder.state !== "inactive") mediaRecorder.stop();
            }
          }, 1000);

        } catch (err) {
          console.error("Microphone check error", err);
          stopActiveStream();
          if (btnStartSample) btnStartSample.disabled = false;
          if (sampleStatusText) sampleStatusText.textContent = "Could not access microphone: " + (err.message || "Permission denied");
          if (micStatusBadge) {
            micStatusBadge.textContent = "MIC ACCESS BLOCKED";
            micStatusBadge.className = "badge badge--danger font-sign";
          }
        }
      }

      if (btnStartSample) {
        btnStartSample.addEventListener("click", function() {
          runSampleRecording();
        });
      }

      if (btnReplaySample) {
        btnReplaySample.addEventListener("click", function() {
          if (recordedUrl) {
            var audio = new Audio(recordedUrl);
            audio.play();
          }
        });
      }

      if (btnMicYes) {
        btnMicYes.addEventListener("click", function() {
          state.micVerified = true;
          if (micStatusBadge) {
            micStatusBadge.textContent = "MIC VERIFIED";
            micStatusBadge.className = "badge badge--success font-sign";
          }
          if (sampleReviewPanel) sampleReviewPanel.style.display = "none";
          if (micConfirmedSuccess) micConfirmedSuccess.style.display = "block";
          if (sampleStatusText) sampleStatusText.textContent = "Microphone check confirmed clear.";
          checkStartReadiness();
        });
      }

      if (btnMicNo) {
        btnMicNo.addEventListener("click", function() {
          state.micVerified = false;
          if (micStatusBadge) {
            micStatusBadge.textContent = "CHECK REQUIRED";
            micStatusBadge.className = "badge badge--warning font-sign";
          }
          if (sampleReviewPanel) sampleReviewPanel.style.display = "none";
          if (micConfirmedSuccess) micConfirmedSuccess.style.display = "none";
          if (sampleStatusText) sampleStatusText.textContent = "Adjust your device or position, then click Record again.";
          checkStartReadiness();
        });
      }

      // Initial microphone enumeration
      enumerateMics();
    }

    // Start audio asset pre-buffering immediately on page load
    runAudioBuffering();
    checkStartReadiness();
  })();
</script>
