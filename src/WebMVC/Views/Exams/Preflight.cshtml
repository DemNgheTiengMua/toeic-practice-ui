@model ExamPreflightViewModel
@{
    Layout = "_LearnerLayout";
    ViewData["Title"] = Model.PageTitle;
    ViewData["Description"] = Model.PageDescription;
}
@section Styles {
  <link rel="stylesheet" href="~/css/exams/preflight.css" asp-append-version="true">
}
<partial name="_PreflightHeader" model="Model" />
@if (Model.HasError)
{
  <div class="alert alert--danger mb-3" role="alert">@Model.ErrorMessage</div>
}
<div class="stack gap-4">
  <partial name="_PreflightAudioBuffer" model="Model" />
  <partial name="_PreflightSpeakers" model="Model" />
  @if (Model.Preflight.RequiresMicrophone)
  {
    <partial name="_PreflightMicrophone" model="Model" />
  }
  <partial name="_PreflightGate" model="Model" />
</div>
<script type="application/json" id="exam-preflight-data">@Html.Raw(Model.PageDataJson)</script>
@section Scripts {
  <script src="~/js/exams/preflight.js" asp-append-version="true"></script>
}
