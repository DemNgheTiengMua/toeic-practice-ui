  "ApiBaseUrl": "http://localhost:5001",
  "ApiResilience": {
    "ConnectTimeoutMs": 2000,
    "HeaderTimeoutMs": 30000,
    "FailureThreshold": 3,
    "BreakDurationMs": 10000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
