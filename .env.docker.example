# #287: the one file the container stack reads. Copy it, do not edit this one:
#
#   cp .env.docker.example .env.docker
#
# .env.docker is gitignored. Nothing here is committed with a real value.
#
# Every value below is required unless a comment says otherwise. Docker compose passes the file
# verbatim into the containers, so the key names are the .NET configuration keys with `__` as the
# section separator (Jwt:SigningKey -> Jwt__SigningKey).

# --- JWT signing key: MANDATORY -------------------------------------------------------------
# The API refuses to boot without a base64 key that decodes to at least 32 bytes, so an empty or
# invented value is a startup failure with an explanation rather than a silently weak token.
#
# Generate one:
#   Linux/macOS/Git Bash : openssl rand -base64 32
#   PowerShell           : [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#
# Paste the output after the `=`. Generate your own; do not reuse a teammate's, and never commit it.
# The key that leaked into this repository's history in 7aad51e is rejected by name.
Jwt__SigningKey=

Jwt__Issuer=extra-efficient
Jwt__Audience=extra-efficient

# --- Database -------------------------------------------------------------------------------
# SA password for the container's SQL Server. It must satisfy SQL Server's default policy:
# 8+ characters, with an upper-case letter, a lower-case letter, a digit and a symbol.
# TrustServerCertificate is required: the container's certificate is self-signed.
MSSQL_SA_PASSWORD=Str0ng!Passw0rd
ConnectionStrings__CompanionDb=Server=db,1433;Database=ExtraEfficiency;User ID=sa;Password=Str0ng!Passw0rd;TrustServerCertificate=True

# --- Payment gateway ------------------------------------------------------------------------
# `mock` cannot charge anyone and is the default for a demo stack.
# To exercise a real payOS checkout, change this one line to `payos`, fill in the three PAYOS_*
# values below, and `docker compose up -d api`. PAYOS_WEBHOOK_URL must be a URL payOS can reach
# from the internet; localhost is not reachable by their servers.
Payment__Gateway=mock
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_WEBHOOK_URL=

# --- API documentation: A COMPLETE BACK DOOR WHILE IT IS ON ---------------------------------
# true serves /openapi/v1.json, /scalar and POST /api/auth/demo-sign-in. The last of those mints a
# full admin token for the demo account below with no credentials. That is what makes the
# documentation clickable for a reviewer and what makes it unacceptable on the public internet.
# Set to false to remove all three routes together; see docs/DOCKER.md.
OpenApi__Enabled=true
OpenApi__DemoEmail=admin@demo.local
OpenApi__DemoPassword=Demo1234!

# --- AI providers ---------------------------------------------------------------------------
# `fake` grades and writes insights from deterministic offline fakes: no SpeechSuper or Claude key
# is needed and no quota is spent. Set to `real` and supply the four keys below to use the real
# providers (both are paid).
AI_PROVIDER=fake
SPEECHSUPER_APP_KEY=
SPEECHSUPER_SECRET_KEY=
CLAUDE_API_KEY=

# --- Links sent in email --------------------------------------------------------------------
# Activation and password-reset links point at the web app the teammate opens in a browser.
AuthLinks__PublicBaseUrl=http://localhost:5000
