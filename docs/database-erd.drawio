        <mxCell id="title" value="TOEIC L&amp;R - Database Schema (ERD)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="700" height="24" as="geometry" />
