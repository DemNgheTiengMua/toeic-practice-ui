                                                              },
                                                              {
                                                                  "displayOrder":  2,
                                                                  "stem":  "Ms. Reynolds has _____ submitted her finalized quarterly expense report to accounting.",
                                                                  "cefrLevel":  "B1",
                                                                  "questionType":  "mcq",
                                                                  "categoryCode":  "grammar_pos",
                                                                  "explanation":  "An adverb is required between the auxiliary \u0027has\u0027 and past participle \u0027submitted\u0027.",
                                                                  "hint":  "Choose the adverb modifying the verb.",
                                                                  "options":  [
                                                                                  {
                                                                                      "label":  "A",
                                                                                      "text":  "already",
                                                                                      "isCorrect":  true,
                                                                                      "rationale":  "\u0027Already\u0027 fits between auxiliary and past participle."
                                                                                  },
                                                                                  {
                                                                                      "label":  "B",
                                                                                      "text":  "ready",
                                                                                      "isCorrect":  false,
                                                                                      "rationale":  "Adjective cannot modify the verb phrase here."
                                                                                  },
                                                                                  {
                                                                                      "label":  "C",
                                                                                      "text":  "readiness",
                                                                                      "isCorrect":  false,
                                                                                      "rationale":  "Noun cannot occupy this adverbial position."
                                                                                  },
                                                                                  {
                                                                                      "label":  "D",
                                                                                      "text":  "readily",
                                                                                      "isCorrect":  false,
                                                                                      "rationale":  "Semantically awkward in this context compared to \u0027already\u0027."
                                                                                  }
                                                                              ],
                                                                  "itemType":  "sentence_cloze"
                                                              }
                                                          ]
                                        }
                                    ]
